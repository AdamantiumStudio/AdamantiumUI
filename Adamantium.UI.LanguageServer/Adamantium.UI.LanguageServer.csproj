<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj" />
		<!-- The generator's Roslyn type model, so completion resolves types exactly as the build does. -->
		<ProjectReference Include="..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj" />
	</ItemGroup>

	<!-- Colors as the framework reads them. -->
	<ItemGroup Condition="'$(UseEngineSource)' == 'true'">
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseEngineSource)' != 'true'">
		<PackageReference Include="Adamantium.Mathematics" Version="$(AdamantiumEngineVersion)" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Localization\*.alang" LogicalName="Localization/%(Filename)%(Extension)" WithCulture="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<!-- Go-to-definition into external assemblies (no source): decompile the type on demand. -->
		<PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
	</ItemGroup>

</Project>
