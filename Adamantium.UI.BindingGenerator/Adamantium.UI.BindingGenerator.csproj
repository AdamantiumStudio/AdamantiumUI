<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the UI's generated bindings into the libraries that carry them (Adamantium.UI.WebView); nothing references
       it and it does not ship. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <!-- QuantumBinding from source or from its package: Directory.Build.props decides. -->
  <ItemGroup Condition="'$(UseQuantumBindingSource)' == 'true'">
    <ProjectReference Include="$(QuantumBindingDir)QuantumBinding.Generator\QuantumBinding.Generator.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseQuantumBindingSource)' != 'true'">
    <PackageReference Include="QuantumBinding.Generator" Version="$(QuantumBindingVersion)" />
  </ItemGroup>

</Project>
