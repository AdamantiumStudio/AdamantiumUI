<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:m="clr-namespace:Adamantium.UI.Core.Media;assembly=Adamantium.UI.Core"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- Stroked SDF tiles, each under its own rotation, shear and scale, all in one instanced batch; the draw count stays
         put while dragging Spread. -->
    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock x:Name="TransformsHeading" Text="{Localize TransformsStrings.Title}"/>
            <TextBlock Text="{Localize TransformsStrings.Hint}"
                       Foreground="#94A3B8" Margin="0,4,0,0"/>

            <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                <StackPanel Orientation="Vertical" Width="220" Margin="0,0,18,8">
                    <TextBlock x:Name="RotationLabel" Text="{Localize TransformsStrings.Rotation}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider AutomationProperties.AutomationId="Rotation" AutomationProperties.LabeledBy="{Binding ElementName=RotationLabel}" Value="{Binding Transforms.Rotation, Mode=TwoWay}" Minimum="0" Maximum="360" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Width="220" Margin="0,0,18,8">
                    <TextBlock x:Name="SkewXLabel" Text="{Localize TransformsStrings.SkewX}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider AutomationProperties.AutomationId="SkewX" AutomationProperties.LabeledBy="{Binding ElementName=SkewXLabel}" Value="{Binding Transforms.SkewX, Mode=TwoWay}" Minimum="-60" Maximum="60" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Width="220" Margin="0,0,18,8">
                    <TextBlock x:Name="SkewYLabel" Text="{Localize TransformsStrings.SkewY}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider AutomationProperties.AutomationId="SkewY" AutomationProperties.LabeledBy="{Binding ElementName=SkewYLabel}" Value="{Binding Transforms.SkewY, Mode=TwoWay}" Minimum="-60" Maximum="60" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Width="220" Margin="0,0,18,8">
                    <TextBlock x:Name="TileScaleLabel" Text="{Localize TransformsStrings.Scale}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider AutomationProperties.AutomationId="TileScale" AutomationProperties.LabeledBy="{Binding ElementName=TileScaleLabel}" Value="{Binding Transforms.Scale, Mode=TwoWay}" Minimum="0.3" Maximum="1.6" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Width="220" Margin="0,0,18,8">
                    <TextBlock x:Name="SpreadLabel" Text="{Localize TransformsStrings.Spread}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <Slider AutomationProperties.AutomationId="Spread" AutomationProperties.LabeledBy="{Binding ElementName=SpreadLabel}" Value="{Binding Transforms.Spread, Mode=TwoWay}" Minimum="0" Maximum="6" Width="200"/>
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <ListBox AutomationProperties.LabeledBy="{Binding ElementName=TransformsHeading}" Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Transforms.Tiles}">
            <ListBox.ItemContainerStyle>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemWidth="86" ItemHeight="86"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- RenderTransformOrigin is a FRACTION of the element's own size, so each tile turns and shears about
                         its own center whatever size it is given. -->
                    <Border Width="56" Height="56" CornerRadius="12"
                            Background="{Binding Color, Converter={conv:StringToBrushConverter}}"
                            BorderBrush="#0F172A" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <m:Transform RotationAngle="{Binding Angle}"
                                         SkewX="{Binding SkewX}"
                                         SkewY="{Binding SkewY}"
                                         ScaleX="{Binding Scale}"
                                         ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</View>
