<View x:KeepAlive="Required"
      xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters"
      xmlns:app="clr-namespace:Adamantium.UI.Sandbox">
    <ResourceContext.Resources>
        <DataTemplate x:Key="RectTileTemplate">
            <Rectangle Fill="{Binding Color, Converter={conv:StringToBrushConverter}}"
                       CornerRadius="10"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3"/>
        </DataTemplate>

        <DataTemplate x:Key="EllipseTileTemplate">
            <Ellipse Fill="{Binding Color, Converter={conv:StringToBrushConverter}}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3"/>
        </DataTemplate>
    </ResourceContext.Resources>
    <!-- A virtualized wrap grid with cell width/height sliders; "Ellipses" swaps the item template (from the Local-scoped
         LayoutResources) between rounded rects and ellipses. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{Localize LayoutStrings.Width}" VerticalAlignment="Center"/>
            <!-- The range comes from the view-model, which also decides the size the tab opens at - the same number in
                 markup and in code is how the two drift apart. -->
            <Slider Width="180" Minimum="{Binding MinCell}" Maximum="{Binding MaxCell}"
                    Value="{Binding CellWidth, Mode=TwoWay}" Margin="8,0,0,0"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding CellWidth}" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <TextBlock Text="{Localize LayoutStrings.Height}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Slider Width="180" Minimum="{Binding MinCell}" Maximum="{Binding MaxCell}"
                    Value="{Binding CellHeight, Mode=TwoWay}" Margin="8,0,0,0"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding CellHeight}" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <CheckBox Content="{Localize LayoutStrings.Ellipses}" IsChecked="{Binding ShowEllipses, Mode=TwoWay}" VerticalAlignment="Center" Margin="24,0,0,0"/>

            <!-- The bind budget, live. 0 = no budget at all (one honest pass), higher = smaller slices. Fixed-width
                 readout for the same reason as the opacity one below: a changing string re-measures the row. -->
            <TextBlock Text="{Localize LayoutStrings.BindMs}" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <Slider Width="140" Minimum="0" Maximum="32" Margin="8,0,0,0"
                    Value="{Binding BindBudgetMs, Mode=TwoWay}"
                    TickFrequency="1" IsSnapToTickEnabled="true"/>
            <TextBlock Text="{Binding BindBudgetMs}" Width="36" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>

            <!-- Fades the WHOLE tile grid by hand. Element Opacity composites down the tree, and the cost of that is the
                 point of this control: the value goes into the subtree's opacity SLOT, so dragging this should not cost
                 the frame anything however many tiles are on screen. Bound straight to the ListBox below by name - no
                 view-model property, because what is being watched is the renderer, not the binding. -->
            <TextBlock Text="{Localize LayoutStrings.Opacity}" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <Slider Width="180" Minimum="0" Maximum="1" Margin="8,0,0,0"
                    Value="{Binding Opacity, ElementName=TileGrid, Mode=TwoWay}"/>
            <!-- FIXED width on purpose. The text changes on every step of the drag ("0.55" -> "0.5" -> "0.475"), and a
                 different string is a different desired size - which re-measures the row, then the Grid, then the tile
                 grid under it. Measured at a 94 ms layout peak while dragging: the readout, not the opacity, was the
                 cost. A fixed width keeps the desired size constant, so the change stops at this element. -->
            <TextBlock Text="{Binding Opacity, ElementName=TileGrid}" Width="56"
                       VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="TileGrid"
                 Margin="0 14 0 0"
                 ItemsSource="{Binding TileSource}"
                 SelectedItem="{Binding SelectedRect, Mode=TwoWay}">
            <!-- The base template (rounded rectangle) is a Setter, NOT a local ItemTemplate attribute: a local value
                 (priority Local=1) would outrank the DataTrigger's Setter (Trigger=3) and the toggle could never swap it.
                 As a Setter (Style=5) the trigger wins while ShowEllipses is true (-> ellipses) and falls back to the
                 rectangle when it's false. Changing the effective ItemTemplate regenerates the containers. -->
            <ListBox.Styles>
                <Style Selector="ListBox">
                    <Setter Property="ItemTemplate" Value="{ResourceReference RectTileTemplate}"/>
                    <DataTrigger Binding="{Binding ShowEllipses}" Value="true">
                        <Setter Property="ItemTemplate" Value="{ResourceReference EllipseTileTemplate}"/>
                    </DataTrigger>
                </Style>
            </ListBox.Styles>
            <!-- These rows carry NO chrome: a tile is the whole row, and the cell is the demo's number. A theme whose
                 rows inset their selection plate (macOS puts it in 4 and down 1) spends that out of the tile, which at
                 the minimum cell of 24 is a third of the width and none of the height - so the tiles come out narrow.
                 The inset is a keyed value, so saying it here is how a view opts out of it. -->
            <ListBox.ItemContainerStyle>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <!-- ...and no inset either: the tile IS the row. A theme that insets its selection plate spends
                         that out of the tile, and at the minimum cell of 24 macOS's 4-across-1-down is a third of the
                         width and none of the height - so the tiles come out narrow while both sliders read 24. -->
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- ScrollBindBudget: ms per pass for binding while scrolling (0 = bind all); a slider, since the best
                         value depends on window size. -->
                    <WrapPanel Orientation="Horizontal"
                               ItemWidth="{Binding CellWidth}"
                               ItemHeight="{Binding CellHeight}"
                               ScrollBindBudget="{Binding BindBudgetMs}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Paging instead of virtualizing, on the same 60 000 tiles. A Grid, so the pager gets a bounded width to fit. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <CheckBox Grid.Column="0" Content="{Localize LayoutStrings.PageTiles}"
                      IsChecked="{Binding IsPaged, Mode=TwoWay}"
                      VerticalAlignment="Center" MarginRight="24"/>
            <DataPager Grid.Column="1" Source="{Binding Paged}" IsEnabled="{Binding IsPaged}"
                       PageSizes="{Binding PageSteps}" PageSize="500" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</View>
