<View x:KeepAlive="Required"
      xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters"
      xmlns:nav="clr-namespace:Adamantium.UI.Controls.Navigation;assembly=Adamantium.UI.Controls"
      xmlns:local="clr-namespace:Adamantium.UI.Sandbox">
    <!-- DataContext is the LayoutViewModel. This file is the tab's FRAME: the stand selector and the region the stands
         are navigated into. Each stand is its own view of the same view-model. -->
    <Grid RowDefinitions="Auto,*"
          Margin="24">
        <WrapPanel Grid.Row="0"
                   Orientation="Horizontal"
                   MarginBottom="10">
            <RadioButton Classes="Toggle"
                         AutomationProperties.AutomationId="TilesStand"
                         Content="{Localize LayoutStrings.Tiles}"
                         MarginRight="6"
                         IsChecked="{Binding Stand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Tiles, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         AutomationProperties.AutomationId="SkeletonsStand"
                         Content="{Localize LayoutStrings.Skeletons}"
                         MarginRight="6"
                         IsChecked="{Binding Stand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Skeletons, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         AutomationProperties.AutomationId="ExpandersStand"
                         Content="{Localize LayoutStrings.Expanders}"
                         MarginRight="6"
                         IsChecked="{Binding Stand, Converter={conv:EnumToBoolConverter}, ConverterParameter=Expanders, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         AutomationProperties.AutomationId="TiledPanelStand"
                         Content="{Localize LayoutStrings.TiledPanel}"
                         MarginRight="6"
                         IsChecked="{Binding Stand, Converter={conv:EnumToBoolConverter}, ConverterParameter=TiledPanel, Mode=TwoWay}"/>
        </WrapPanel>

        <ContentControl Grid.Row="1"
                        AutomationProperties.AutomationId="LayoutStand"
                        nav:RegionManager.RegionName="{x:Static local:RegionNames.LayoutStand}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        ContentTransition="SlideLeft"/>
    </Grid>
</View>
