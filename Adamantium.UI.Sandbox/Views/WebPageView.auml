<View x:KeepAlive="Enabled"
      xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:web="clr-namespace:Adamantium.UI.WebView;assembly=Adamantium.UI.WebView"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- The WebView as its steps come: back, forward, reload or stop and the address, which follows the page; the page;
         and below, for the stand, how its frames come and what it is doing. Popups come with their step. Kept between
         visits, so the page is where it was when the tab comes back. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="8" ColumnSpacing="6">
            <Button Command="{Binding GoBackCommand, ElementName=Page}" ToolTipService.ToolTip="Back" Padding="8 4"
                    AutomationProperties.AutomationId="WebBack" AutomationProperties.Name="Back">
                <IconPresenter Icon="{ObservableResource WebBackIcon}" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="1" Command="{Binding GoForwardCommand, ElementName=Page}" ToolTipService.ToolTip="Forward"
                    Padding="8 4" AutomationProperties.AutomationId="WebForward" AutomationProperties.Name="Forward">
                <IconPresenter Icon="{ObservableResource WebForwardIcon}" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="2" Command="{Binding ReloadCommand, ElementName=Page}" ToolTipService.ToolTip="Reload"
                    Padding="8 4" AutomationProperties.AutomationId="WebReload" AutomationProperties.Name="Reload"
                    Visibility="{Binding IsLoading, ElementName=Page, Converter={conv:BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <IconPresenter Icon="{ObservableResource WebReloadIcon}" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="2" Command="{Binding StopCommand, ElementName=Page}" ToolTipService.ToolTip="Stop"
                    Padding="8 4" AutomationProperties.AutomationId="WebStop" AutomationProperties.Name="Stop"
                    Visibility="{Binding IsLoading, ElementName=Page, Converter={conv:BoolToVisibilityConverter}}">
                <IconPresenter Icon="{ObservableResource WebStopIcon}" Width="16" Height="16"/>
            </Button>
            <TextBox Grid.Column="3" Text="{Binding Address, Mode=TwoWay}" AutomationProperties.AutomationId="WebAddress">
                <TextBox.InputBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding GoCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="4" Content="Go" Command="{Binding GoCommand}" AutomationProperties.AutomationId="WebGo"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <web:WebView x:Name="Page" Engine="{Binding Engine}" Source="{Binding Source, Mode=TwoWay}"
                         Bridge="{Binding Bridge}"
                         AllowSharedTexture="{Binding AllowSharedTexture}"
                         IsDevToolsOpen="{Binding DevToolsOpen, Mode=TwoWay}"
                         DevToolsDock="{Binding DevToolsDock}"
                         AutomationProperties.AutomationId="WebPage"/>
            <!-- What the page opened last - a link to a new tab, window.open, its page source - beside it, as a browser
                 shows it in a tab of its own, the page that opened it still there. -->
            <ContentControl Grid.Column="1" Content="{Binding OpenedPage}" AutomationProperties.AutomationId="WebOpened">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,*" Width="520" Margin="8,0,8,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharEllipses"
                                           AutomationProperties.AutomationId="WebOpenedTitle"/>
                                <Button Grid.Column="1" Content="Close" Padding="8 2"
                                        Command="{Ancestor View, DataContext.CloseOpenedCommand}"
                                        AutomationProperties.AutomationId="WebOpenedClose"/>
                            </Grid>
                            <web:WebView Grid.Row="1" Engine="{Ancestor View, DataContext.Engine}"
                                         NewPage="{Binding Page}" Source="{Binding Source, Mode=TwoWay}"
                                         Title="{Binding Title, Mode=OneWayToSource}"
                                         AutomationProperties.AutomationId="WebOpenedPage"/>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8" Spacing="16">
            <CheckBox Content="Shared texture" IsChecked="{Binding AllowSharedTexture, Mode=TwoWay}"
                      AutomationProperties.AutomationId="WebSharedTexture"/>
            <CheckBox Content="DevTools" IsChecked="{Binding DevToolsOpen, Mode=TwoWay}"
                      AutomationProperties.AutomationId="WebDevToolsOpen"/>
            <DropDown ItemsSource="{Binding DevToolsDocks}" SelectedItem="{Binding DevToolsDock, Mode=TwoWay}"
                      AutomationProperties.AutomationId="WebDevToolsDock" AutomationProperties.Name="DevTools side"/>
            <TextBlock Text="{Binding Title, ElementName=Page}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="WebTitle"/>
            <TextBlock Text="loading" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, ElementName=Page, Converter={conv:BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding LoadError.Text, ElementName=Page}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="WebError"/>
            <TextBlock Text="{Binding StatusText, ElementName=Page}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="WebStatus"/>
            <TextBlock Text="{Binding FramePath, ElementName=Page}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="WebFramePath"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding FrameRate, ElementName=Page}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="WebFrameRate"/>
                <TextBlock Text="fps" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</View>
