<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:web="clr-namespace:Adamantium.UI.WebView;assembly=Adamantium.UI.WebView">
    <!-- Step 1 of the WebView: the address, gone to on Enter, and the page it draws. Input, popups and the navigation
         buttons come with their steps. -->
    <Grid RowDefinitions="Auto,*">
        <TextBox Text="{Binding Address, Mode=TwoWay}" Margin="8" AutomationProperties.AutomationId="WebAddress">
            <TextBox.InputBindings>
                <KeyBinding Gesture="Enter" Command="{Binding GoCommand}"/>
            </TextBox.InputBindings>
        </TextBox>
        <web:WebView Grid.Row="1" Source="{Binding Source}" AutomationProperties.AutomationId="WebPage"/>
    </Grid>
</View>
