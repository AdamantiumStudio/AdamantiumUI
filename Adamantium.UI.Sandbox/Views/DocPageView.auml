<View xmlns="http://adamantium/ui">
    <StackPanel Margin="16">
        <TextBlock Text="{Localize WorkspaceStrings.Doc, number={Binding Number}}" FontSize="20" Margin="0,0,0,8"/>
        <TextBlock Text="{Localize WorkspaceStrings.DocSurface}" TextWrapping="WrapByWords"/>
    </StackPanel>
</View>
