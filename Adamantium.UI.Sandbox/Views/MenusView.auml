<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- The whole menu tree comes from the view-model (MenusViewModel.MenuItems - a tree of MenuNode). A
         HierarchicalDataTemplate projects each node: its body draws the header (Title), ItemsSource="{Binding Children}"
         supplies the submenu, and the SAME template recurses down every level. The ItemContainerStyle binds each generated
         MenuItem's Command / gesture / separator flag from the node. No menu rows are authored in markup. -->
    <ScrollViewer>
    <StackPanel Orientation="Vertical" Margin="24" MaxWidth="900">

        <TextBlock Text="{Localize MenusStrings.Title}"
                   FontSize="20" MarginBottom="4"/>
        <TextBlock Text="{Localize MenusStrings.Hint}"
                   FontSize="13" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="18"/>

        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                BorderThickness="1" CornerRadius="10" Height="180">
            <Border.ContextMenu>
                <ContextMenu ItemsSource="{Binding MenuItems}"
                             AutomationProperties.AutomationId="SurfaceMenu">
                    <ContextMenu.ItemTemplate>
                        <!-- A title is a phrase key, or a name (a file, a percentage) that is no key and is said as it is. -->
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Localize MenusStrings, Key={Binding Title}}"/>
                        </HierarchicalDataTemplate>
                    </ContextMenu.ItemTemplate>
                    <ContextMenu.ItemContainerStyle>
                        <Style Selector="MenuItem">
                            <Setter Property="Command" Value="{Binding Command}"/>
                            <Setter Property="InputGestureText" Value="{Binding Gesture}"/>
                        </Style>
                    </ContextMenu.ItemContainerStyle>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="{Localize MenusStrings.RightClickMe}"
                       AutomationProperties.AutomationId="MenuSurface"
                       FontSize="16" Foreground="{ResourceReference TextFillColorPrimary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Orientation="Horizontal" MarginTop="16">
            <TextBlock Text="{Localize MenusStrings.LastAction}" Foreground="{ResourceReference TextFillColorSecondary}" MarginRight="8"/>
            <TextBlock Text="{Localize MenusStrings.Report, pick={Binding Pick}, item={Localize MenusStrings, Key={Binding PickedItem}}, from={Localize MenusStrings, Key={Binding PickedFrom}}}"
                       AutomationProperties.AutomationId="MenuReport"
                       Foreground="{ResourceReference TextFillColorPrimary}"/>
        </StackPanel>

    </StackPanel>
    </ScrollViewer>
</View>
