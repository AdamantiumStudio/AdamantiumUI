<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors"
      xmlns:nav="clr-namespace:Adamantium.UI.Controls.Navigation;assembly=Adamantium.UI.Controls"
      xmlns:docking="clr-namespace:Adamantium.UI.Controls.Docking;assembly=Adamantium.UI.Controls">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24">

        <TextBlock Grid.Row="0" MarginBottom="12" MaxWidth="820"
                   Text="{Localize DockingStrings.Intro}"
                   Foreground="{ResourceReference TextFillColorSecondary}"/>

        <!-- The application's docking answers (always yes), logged; static limits are Pane.Allowed data (see Errors below).
             Float-only panes are opened with "Create in: Floating". -->
        <Border Grid.Row="1" MarginBottom="12" Padding="10 6 10 6"
                Background="{ResourceReference ControlFillColorDefault}"
                BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="1">
            <TextBlock Text="{Localize DockingStrings.Answer, answer={Binding LastAnswer}, panes={Binding AnsweredPanes}, zone={Localize DockingStrings.ZoneTo, zone={Binding AnsweredZone}}}"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
        </Border>

        <!-- The area as a navigation REGION. Nothing below names a pane, a group or a zone in code: the view model asks
             the region for a NAME, and the docking adapter either activates the pane that name already stands for -
             wherever it has been dragged to since - or opens a new one where "Create in" says. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" MarginBottom="12">
            <TextBlock x:Name="PaneLabel" Text="{Localize DockingStrings.Pane}" VerticalAlignment="Center" MarginRight="6"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <DropDown AutomationProperties.AutomationId="PaneChoice" AutomationProperties.LabeledBy="{Binding ElementName=PaneLabel}"
                      ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                      Width="150" MarginRight="14"/>

            <TextBlock x:Name="CreateInLabel" Text="{Localize DockingStrings.CreateIn}" VerticalAlignment="Center" MarginRight="6"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <DropDown AutomationProperties.AutomationId="PlaceChoice" AutomationProperties.LabeledBy="{Binding ElementName=CreateInLabel}"
                      ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                      MinWidth="120" MarginRight="14">
                <DropDown.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Localize DockingStrings, Key={Binding}}"/>
                    </DataTemplate>
                </DropDown.ItemTemplate>
            </DropDown>

            <Button Content="{Localize DockingStrings.Navigate}" Command="{Binding NavigateCommand}" MinWidth="100" Height="32" MarginRight="8"/>
            <Button Content="{Localize DockingStrings.NewPane}" Command="{Binding NewTabCommand}" MinWidth="100" Height="32" MarginRight="8"/>
            <!-- Sets the open page's PaneZone; the pane follows it, and a drag writes it back. -->
            <Button Content="{Localize DockingStrings.Move}" Command="{Binding MoveCommand}" MinWidth="100" Height="32" MarginRight="24"/>

            <!-- The arrangement is state, so it belongs to the VIEW MODEL: it owns a DockingWorkspace, the area is
                 pointed at it below, and these commands save and restore through it. The control is never told where a
                 layout is kept - that is the application's business. -->
            <Button Content="{Localize DockingStrings.SaveLayout}" Command="{Binding SaveLayoutCommand}" MinWidth="110" Height="32" MarginRight="8"/>
            <Button Content="{Localize DockingStrings.Restore}" Command="{Binding RestoreLayoutCommand}" MinWidth="90" Height="32" MarginRight="8"/>
            <Button Content="{Localize DockingStrings.Forget}" Command="{Binding ForgetLayoutCommand}" MinWidth="80" Height="32" MarginRight="8"/>
            <Button Content="{Localize DockingStrings.ResetLayout}" Command="{Binding ResetLayoutCommand}" MinWidth="80" Height="32" MarginRight="24"/>

            <!-- Pinned tabs: a row of their own (Rider) or sharing the one row (Visual Studio). The area pushes it onto
                 every panel it holds - see DockingArea.PinnedTabsPlacement. -->
            <CheckBox Content="{Localize DockingStrings.PinnedRow}" IsChecked="True"
                      Command="{Binding TogglePinnedRowCommand}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Localize DockingStrings.Layout, report={Binding LayoutState}, file={Binding LayoutFile}}" MarginBottom="12" MaxWidth="900"
                   Foreground="{ResourceReference TextFillColorSecondary}"/>

        <!-- Square corners on purpose: areas meet each other along the splitters, and a rounded corner there leaves a
             notch of background at every junction instead of a clean seam. -->
        <Border Grid.Row="4" BorderThickness="1"
                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                Background="{ResourceReference CardBackgroundFillColorDefault}">
            <docking:DockingArea DividerThickness="6" nav:RegionManager.RegionName="docking"
                    Workspace="{Binding Workspace}" StretchSingleDocumentTab="false"
                    SelectionIndicatorPlacement="Outer" SelectionIndicatorThickness="2">
                <docking:DockingArea.Behaviors>
                    <behaviors:DockingPolicyBehavior/>
                    <!-- The tab menu, built by the APPLICATION and calling the area's own API (ClosePane,
                         CloseOtherPanes, ClosePanesOfGroup, CloseUnpinnedPanes, CloseAllPanes). A behavior rather than
                         markup, so panes opened by CODE get it too - and it stands next to the control, so it works on
                         the pane and the area directly instead of routing through the view model. -->
                    <behaviors:TabContextMenuBehavior/>
                </docking:DockingArea.Behaviors>

                <!-- The documents, declared first so innermost. "Unsaved changes" makes the view-model refuse the close
                     (DockingWorkspace.PaneClosing); try "Close all tabs". -->
                <!-- Each pane names its Id: without one the id is made from the header, and a header said in the
                     user's language would give the pane another id in every language - and lose its saved place. -->
                <docking:PaneGroup Name="documents" Zone="Center">
                    <docking:Pane Id="Scene" Header="{Localize DockingStrings.Scene}">
                        <StackPanel Margin="16">
                            <TextBlock Text="{Localize DockingStrings.Scene}" Opacity="0.7" MarginBottom="10"/>
                            <CheckBox Content="{Localize DockingStrings.Unsaved}"
                                      Command="{Binding ToggleUnsavedCommand}" CommandParameter="Scene" MarginBottom="6"/>
                            <CheckBox Content="{Localize DockingStrings.AskFirst}"
                                      Command="{Binding ToggleAskCommand}" CommandParameter="Scene"/>
                        </StackPanel>
                    </docking:Pane>
                    <docking:Pane Id="Game" Header="{Localize DockingStrings.Game}">
                        <StackPanel Margin="16">
                            <TextBlock Text="{Localize DockingStrings.Game}" Opacity="0.7" MarginBottom="10"/>
                            <CheckBox Content="{Localize DockingStrings.Unsaved}"
                                      Command="{Binding ToggleUnsavedCommand}" CommandParameter="Game" MarginBottom="6"/>
                            <CheckBox Content="{Localize DockingStrings.AskFirst}"
                                      Command="{Binding ToggleAskCommand}" CommandParameter="Game"/>
                        </StackPanel>
                    </docking:Pane>
                </docking:PaneGroup>

                <docking:PaneGroup Name="inspector" Zone="Right" Size="240">
                    <docking:Pane Id="Inspector" Header="{Localize DockingStrings.Inspector}" Kind="Tool" MinSize="120">
                        <TextBlock Text="{Localize DockingStrings.Inspector}" Margin="16" Opacity="0.7"/>
                    </docking:Pane>
                    <docking:Pane Id="Hierarchy" Header="{Localize DockingStrings.Hierarchy}" Kind="Tool" MinSize="120">
                        <TextBlock Text="{Localize DockingStrings.Hierarchy}" Margin="16" Opacity="0.7"/>
                    </docking:Pane>
                    <docking:Pane Id="Properties" Header="{Localize DockingStrings.Properties}" Kind="Tool" MinSize="120">
                        <TextBlock Text="{Localize DockingStrings.Properties}" Margin="16" Opacity="0.7"/>
                    </docking:Pane>
                </docking:PaneGroup>

                <!-- Declared last, so it is OUTERMOST: the console spans the full width beneath everything above. -->
                <docking:PaneGroup Name="console" Zone="Bottom" Size="160">
                    <docking:Pane Id="Console" Header="{Localize DockingStrings.Console}" Kind="Tool">
                        <TextBlock Text="{Localize DockingStrings.Console}" Margin="16" Opacity="0.7"/>
                    </docking:Pane>
                    <docking:Pane Id="Output" Header="{Localize DockingStrings.Output}" Kind="Tool">
                        <TextBlock Text="{Localize DockingStrings.Output}" Margin="16" Opacity="0.7"/>
                    </docking:Pane>
                    <!-- Allowed is the OTHER half of the vocabulary: where a pane may go at all, in data. Drag this one
                         and the compass draws only the EDGES - no center indicator, no tearing it off - because an
                         indicator that quietly declines is worse than no indicator. -->
                    <docking:Pane Id="Errors" Header="{Localize DockingStrings.Errors}" Kind="Tool" Allowed="Center,Top,Bottom,Floating">
                        <TextBlock Text="{Localize DockingStrings.ErrorsHint}"
                                   Margin="16" Opacity="0.7"/>
                    </docking:Pane>
                </docking:PaneGroup>

            </docking:DockingArea>
        </Border>
    </Grid>
</View>
