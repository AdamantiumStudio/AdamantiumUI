<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:nav="clr-namespace:Adamantium.UI.Controls.Navigation;assembly=Adamantium.UI.Controls">
    <!-- DataContext is NavigationDemoViewModel (adopted by the tab's content presenter). No navigation code lives here:
         the buttons run VM commands, and the single ContentControl below is bound to the VM-owned region - the region's
         adapter renders the current page's view and animates the swap. The ContentControl fills the '*' row, so its size
         stays constant across page swaps (the pages just fill it). -->
    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="{Localize NavigationStrings.ViewModelNavigation}" FontSize="18" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="{Localize NavigationStrings.Home}"          Command="{Binding GoHomeCommand}"      MinWidth="90"  Height="32" Margin="0,0,8,0"/>
                <Button Content="{Localize NavigationStrings.DetailsWithId}" Command="{Binding OpenDetailsCommand}" MinWidth="130" Height="32" Margin="0,0,8,0"/>
                <Button Content="{Localize NavigationStrings.Settings}"      Command="{Binding GoSettingsCommand}"  MinWidth="90"  Height="32" Margin="0,0,16,0"/>
                <Button Content="{Localize NavigationStrings.Back}"          Command="{Binding BackCommand}"        MinWidth="70"  Height="32" Margin="0,0,8,0"/>
                <Button Content="{Localize NavigationStrings.Forward}"       Command="{Binding ForwardCommand}"     MinWidth="80"  Height="32"/>
            </StackPanel>

            <!-- Drives the title-bar Workspace command: ON = a new window every click, OFF = single instance (focuses the
                 existing one). Shared via WindowDemoSettings, so this toggle and the title-bar command stay in sync. -->
            <ToggleSwitch Content="{Localize NavigationStrings.AllowDuplicateWindows}" Margin="0,12,0,0"
                          IsChecked="{Binding WindowSettings.AllowDuplicateWindows, Mode=TwoWay}"/>

            <!-- Drives the title-bar Dialog/Help commands: ON = dialogs open in their OWN window, OFF = in-window overlay. -->
            <ToggleSwitch Content="{Localize NavigationStrings.DialogsAsWindows}" Margin="0,8,0,0"
                          IsChecked="{Binding WindowSettings.DialogsAsWindows, Mode=TwoWay}"/>

            <!-- In-window draggable windows (OverlayWindow + OverlayWindowManager). Each click cascades a new one. -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{Localize NavigationStrings.ShowOverlayWindow}" Command="{Binding ShowOverlayWindowCommand}" Height="32" Margin="0,0,8,0"/>
                <Button Content="{Localize NavigationStrings.ShowModalOverlay}"  Command="{Binding ShowOverlayModalCommand}"  Height="32"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,16,300">
            <!-- LEFT: ContentControl region - a SINGLE page (ContentControlRegionAdapter); navigating replaces it. -->
            <Border Grid.Column="0" CornerRadius="8" Padding="2" BorderThickness="1" BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <ContentControl x:Name="Region" nav:Region.Source="{Binding Region}" ContentTransition="SlideLeft"/>
            </Border>

            <!-- RIGHT: ItemsControl region - EVERY active view model shown at once as a list (ItemsControlRegionAdapter).
                 Add/Clear mutate the region; the adapter mirrors ActiveViewModels into the ItemsControl and resolves each
                 view model to its CardPageView. -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
                    <TextBlock Text="{Localize NavigationStrings.ItemsControlRegion}" FontSize="14" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Localize NavigationStrings.AddCard}" Command="{Binding AddCardCommand}"   MinWidth="90" Height="30" Margin="0,0,8,0"/>
                        <Button Content="{Localize NavigationStrings.Clear}"   Command="{Binding ClearCardsCommand}" MinWidth="70" Height="30"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="8" Padding="8" BorderThickness="1" BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <ListBox x:Name="Cards" nav:Region.Source="{Binding CardsRegion}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</View>
