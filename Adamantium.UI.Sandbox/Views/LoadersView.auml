<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- DataContext is the LoadersViewModel. The whole pack is theme-authored: BusyIndicator itself carries no look, only
         IsActive - each indicator here is a class-selected template (see BusyIndicatorStyleSet). One toggle drives them
         all, which is also the honest test: switching them OFF must STOP the (infinite) animations, not merely hide them. -->
    <!-- Scrollable: the zoom below can make the pack several screens tall, and a bench you cannot reach the bottom of is
         not a bench. -->
    <ScrollViewer Margin="24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical">

        <StackPanel Orientation="Horizontal">
            <ToggleSwitch Content="{Localize LoadersStrings.Running}" IsChecked="{Binding IsActive, Mode=TwoWay}"/>
            <TextBlock Text="{Localize LoadersStrings.OneSwitch}"
                       VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.6"/>
        </StackPanel>

        <!-- Zoom, so the detail can actually be judged: a 3px marching dash at x3 is a 9px dash. Each card carries a
             bound LayoutTransform - a LAYOUT one, not a render one, so a magnified card takes the room it occupies and
             the rest reflow around it instead of being drawn over. Binding a Transform is possible because bindings now
             live on the property system rather than on tree elements (see AdamantiumComponent.SetBinding). -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock x:Name="ZoomLabel" Text="{Localize LoadersStrings.Zoom}" VerticalAlignment="Center"/>
            <!-- Snapped to tenths: the exact zoom is never the point, and a free slider just spends its travel on values
                 nobody can tell apart. -->
            <Slider AutomationProperties.LabeledBy="{Binding ElementName=ZoomLabel}" Minimum="0.5" Maximum="4" Value="{Binding Scale, Mode=TwoWay}"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Width="260" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Scale}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6"/>
        </StackPanel>

        <WrapPanel Orientation="Horizontal" Margin="0,24,0,0">

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator IsActive="{Binding IsActive}" Height="56" Width="56"/>
                <TextBlock Text="{Localize LoadersStrings.Ring}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.RingHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Dots" IsActive="{Binding IsActive}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Localize LoadersStrings.Dots}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.DotsHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Ripple" IsActive="{Binding IsActive}" Height="56" Width="56"/>
                <TextBlock Text="{Localize LoadersStrings.Ripple}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.RippleHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Bar" IsActive="{Binding IsActive}" VerticalAlignment="Center"/>
                <TextBlock Text="{Localize LoadersStrings.Bar}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.BarHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Arc" IsActive="{Binding IsActive}" Height="56" Width="56"/>
                <TextBlock Text="{Localize LoadersStrings.Arc}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.ArcHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Ants" IsActive="{Binding IsActive}" Height="56" Width="56"/>
                <TextBlock Text="{Localize LoadersStrings.Ants}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.AntsHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Heartbeat" IsActive="{Binding IsActive}" Height="56" Width="56"/>
                <TextBlock Text="{Localize LoadersStrings.Heartbeat}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.HeartbeatHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Equalizer" IsActive="{Binding IsActive}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Localize LoadersStrings.Equalizer}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.EqualizerHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="180">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Flip" IsActive="{Binding IsActive}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Localize LoadersStrings.Flip}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.FlipHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="16" Width="200">
                <StackPanel.LayoutTransform>
                    <Transform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                </StackPanel.LayoutTransform>
                <BusyIndicator Classes="Shimmer" IsActive="{Binding IsActive}"/>
                <TextBlock Text="{Localize LoadersStrings.Shimmer}" HorizontalTextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Localize LoadersStrings.ShimmerHint}" HorizontalTextAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

        </WrapPanel>

    </StackPanel>
    </ScrollViewer>
</View>
