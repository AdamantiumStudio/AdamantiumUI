<View xmlns="http://adamantium/ui">
    <!-- DataContext is AboutDialogViewModel (resolved by the FooViewModel->FooView convention). Values come from the
         Sandbox assembly's metadata. OK closes the dialog via the VM's RequestClose. -->
    <Grid RowDefinitions="*, Auto">
        <StackPanel Orientation="Vertical"
                    Width="380"
                    HorizontalAlignment="Center"
                    Margin="0 20 0 0">
            <TextBlock Text="{Binding Product}" FontSize="20" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Localize DialogStrings.Version}" FontSize="13" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Version}" FontSize="13"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Localize DialogStrings.Manufacturer}" FontSize="13" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Manufacturer}" FontSize="13"/>
            </StackPanel>
            <TextBlock Text="{Binding Copyright}" FontSize="12" Margin="0,12,0,20"/>
        </StackPanel>
        <Button Grid.Row="1"
                Content="{Localize DialogStrings.Ok}"
                Command="{Binding OkCommand}"
                MinWidth="100"
                Height="32"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0 0 20 20"/>
    </Grid>
</View>
