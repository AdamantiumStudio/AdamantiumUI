<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- Tiles 3D: the TilesHost/FlipTile mosaic with tilt field, flip wave and one shared photo; rotating tiles stay
         instanced. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="24" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Localize TilesStrings.Title}" FontSize="16" VerticalAlignment="Center"/>
                <Button Content="{Localize TilesStrings.FlipAll}" Command="{Binding FlipAllCommand}" MinWidth="120" Height="34" Margin="24,0,0,0"/>
            </StackPanel>

            <!-- Columns and rows come from the view-model; tile size is derived from them and the space. The panel comes
                 from the TilesHost style sets. -->
            <TilesHost AutomationProperties.AutomationId="Tiles"
                       ItemsSource="{Binding Tiles}"
                       Columns="{Binding Columns}" 
                       Rows="{Binding Rows}" 
                       Spacing="6"
                       Width="1092" 
                       Height="637" 
                       HorizontalAlignment="Center"
                       Photo="Textures/luxfon.tga"
                       IsFlipped="{Binding AllFlipped}">
                <TilesHost.ItemTemplate>
                    <DataTemplate>
                        <FlipTile FrontBrush="{Binding Color}"/>
                    </DataTemplate>
                </TilesHost.ItemTemplate>
            </TilesHost>

        </StackPanel>
    </ScrollViewer>
</View>
