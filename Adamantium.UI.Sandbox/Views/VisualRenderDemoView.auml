<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Vertical" Margin="24">

        <TextBlock Text="{Localize VisualRenderStrings.Title}"
                   FontSize="20"
                   MarginBottom="4"/>
        <TextBlock Text="{Localize VisualRenderStrings.Intro}"
                   FontSize="13"
                   Foreground="{ResourceReference TextFillColorSecondary}"
                   MaxWidth="720"
                   HorizontalAlignment="Left"
                   MarginBottom="18"/>

        <StackPanel Orientation="Horizontal">

            <StackPanel Orientation="Vertical" MarginRight="28">
                <TextBlock x:Name="SourceLabel" Text="{Localize VisualRenderStrings.Source}" FontSize="14" MarginBottom="8"/>
                <TextBox AutomationProperties.AutomationId="Source" AutomationProperties.LabeledBy="{Binding ElementName=SourceLabel}"
                         Text="{Binding AumlText, Mode=TwoWay}"
                         Width="380" Height="150"/>
                <Button Content="{Localize VisualRenderStrings.Render}"
                        Command="{Binding RenderSnapshotCommand}"
                        MinWidth="120" Height="34"
                        MarginTop="12"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Localize VisualRenderStrings.Rendered}" FontSize="14" MarginBottom="8"/>
                <!-- The frame hugs the image (no fixed size, Stretch=None so it's shown 1:1); MinWidth/Height keep a visible
                     placeholder before the first Render. -->
                <Border BorderBrush="#40FFFFFF" BorderThickness="1" Padding="1"
                        MinWidth="224" MinHeight="120"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image Source="{Binding Snapshot}" Stretch="None"/>
                </Border>
            </StackPanel>

        </StackPanel>

        <!-- ============ LIVE tree snapshot (the drag-ghost path) ============ -->
        <TextBlock Text="{Localize VisualRenderStrings.LiveTitle}"
                   FontSize="20"
                   MarginTop="36" MarginBottom="4"/>
        <TextBlock Text="{Localize VisualRenderStrings.LiveIntro}"
                   FontSize="13"
                   Foreground="{ResourceReference TextFillColorSecondary}"
                   MaxWidth="720"
                   HorizontalAlignment="Left"
                   MarginBottom="18"/>

        <StackPanel Orientation="Horizontal">

            <StackPanel Orientation="Vertical" MarginRight="28">
                <TextBlock Text="{Localize VisualRenderStrings.LiveTree}" FontSize="14" MarginBottom="8"/>
                <StackPanel x:Name="liveTree"
                            Orientation="Vertical"
                            Background="#FF10151F"
                            Width="240"
                            HorizontalAlignment="Left">
                    <TextBlock x:Name="IAmLiveLabel" Text="{Localize VisualRenderStrings.IAmLive}" Foreground="#FFF2C14E" FontSize="16" Margin="16,14,16,10"/>
                    <CheckBox Content="{Localize VisualRenderStrings.ToggleMe}" IsChecked="True" Margin="16,0,16,10"/>
                    <ToggleSwitch AutomationProperties.LabeledBy="{Binding ElementName=IAmLiveLabel}" IsChecked="True" Margin="16,0,16,10"/>
                    <ProgressBar AutomationProperties.LabeledBy="{Binding ElementName=IAmLiveLabel}" Value="65" Width="200" Margin="16,0,16,16"/>
                </StackPanel>
                <Button Content="{Localize VisualRenderStrings.SnapshotLive}"
                        Command="{Binding SnapshotLiveCommand}"
                        CommandParameter="{Binding ElementName=liveTree}"
                        MinWidth="170" Height="34"
                        MarginTop="12"
                        HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" MarginTop="8">
                    <Button Content="{Localize VisualRenderStrings.ShowGhost}" Command="{Binding ShowGhostCommand}" MinWidth="100" Height="30"/>
                    <Button Content="{Localize VisualRenderStrings.HideGhost}" Command="{Binding HideGhostCommand}" MinWidth="100" Height="30" MarginLeft="8"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Localize VisualRenderStrings.Snapshot}" FontSize="14" MarginBottom="8"/>
                <Border BorderBrush="#40FFFFFF" BorderThickness="1" Padding="1"
                        MinWidth="242" MinHeight="120"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image Source="{Binding LiveSnapshot}" Stretch="None"/>
                </Border>
            </StackPanel>

        </StackPanel>

    </StackPanel>
    </ScrollViewer>
</View>
