<View xmlns="http://adamantium/ui">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Title}" FontSize="18" MarginBottom="6"/>
        <TextBlock Text="{Localize DockingStrings.Origin, restored={Binding Restored}, zone={Localize DockingStrings.OpenedIn, zone={Binding OpenedIn}}}" Opacity="0.7"/>
        <TextBlock MarginTop="12" Opacity="0.7" MaxWidth="420"
                   Text="{Localize DockingStrings.OpenedByRegion}"/>
    </StackPanel>
</View>
