<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Margin="24">

        <TextBlock Text="{Localize ColorPageStrings.Title}"
                   FontSize="20"
                   MarginBottom="4"/>
        <TextBlock Text="{Localize ColorPageStrings.Intro}"
                   FontSize="13"
                   Foreground="{ResourceReference TextFillColorSecondary}"
                   MaxWidth="680"
                   HorizontalAlignment="Left"
                   MarginBottom="18"/>

        <StackPanel Orientation="Horizontal">
            <ColorPicker AutomationProperties.AutomationId="Picker" SelectedColor="{Binding PickedColor, Mode=TwoWay}"
                         VerticalAlignment="Top"/>

            <StackPanel Orientation="Vertical"
                        MarginLeft="32"
                        VerticalAlignment="Top">
                <TextBlock x:Name="WheelLabel" Text="{Localize ColorPageStrings.Wheel}"
                           FontSize="14"
                           MarginBottom="14"/>
                <!-- Two-way to the SAME PickedColor as the inline picker. The wheel picks hue+saturation; its OWN Value slider
                     below picks brightness (so the wheel alone is a full picker and can reach black at 0). All stay in sync
                     and drive the theme accent. The wheel dims toward the value. -->
                <ColorWheel AutomationProperties.AutomationId="Wheel" AutomationProperties.LabeledBy="{Binding ElementName=WheelLabel}"
                            SelectedColor="{Binding PickedColor, Mode=TwoWay}"
                            Value="{Binding WheelValue, Mode=TwoWay}"/>
                <TextBlock x:Name="WheelValueLabel" Text="{Localize ColorPageStrings.Value}" FontSize="12" MarginTop="12" MarginBottom="2"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <Slider AutomationProperties.AutomationId="WheelValue" AutomationProperties.LabeledBy="{Binding ElementName=WheelValueLabel}"
                        Width="256" Minimum="0" Maximum="1" Value="{Binding WheelValue, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical"
                        MarginLeft="32"
                        VerticalAlignment="Top">
                <TextBlock x:Name="SwatchLabel" Text="{Localize ColorPageStrings.Swatch}"
                           FontSize="14"
                           MarginBottom="14"/>
                <!-- Same PickedColor as the inline picker + wheel: the swatch shows it; clicking opens a floating,
                     light-dismissing ColorPicker flyout - editing there stays in sync and drives the theme accent too. -->
                <ColorPickerButton AutomationProperties.AutomationId="Swatch" AutomationProperties.LabeledBy="{Binding ElementName=SwatchLabel}"
                                   SelectedColor="{Binding PickedColor, Mode=TwoWay}"
                                   Width="180" Height="30"
                                   HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel AutomationProperties.LabeledBy="{Binding ElementName=LiveAccentHeading}"
                        Orientation="Vertical"
                        MarginLeft="32"
                        VerticalAlignment="Top">
                <TextBlock x:Name="LiveAccentHeading" Text="{Localize ColorPageStrings.LiveAccent}"
                           FontSize="14"
                           MarginBottom="14"/>
                <CheckBox Content="{Localize ColorPageStrings.Checkbox}"
                          IsChecked="True"
                          MarginBottom="12"/>
                <RadioButton Content="{Localize ColorPageStrings.RadioButton}"
                             IsChecked="True"
                             MarginBottom="12"/>
                <ToggleSwitch AutomationProperties.LabeledBy="{Binding ElementName=LiveAccentHeading}"
                              IsChecked="True"
                              MarginBottom="16"/>
                <Slider AutomationProperties.LabeledBy="{Binding ElementName=LiveAccentHeading}"
                        Width="200"
                        Value="60"
                        MarginBottom="16"/>
                <ProgressBar AutomationProperties.LabeledBy="{Binding ElementName=LiveAccentHeading}"
                             Width="200"
                             Value="60"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
    </ScrollViewer>
</View>
