<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical"
                    Margin="24">

            <TextBlock Text="{Localize DateTimePageStrings.Title}"
                       FontSize="20"
                       MarginBottom="4"/>
            <TextBlock Text="{Localize DateTimePageStrings.Intro}"
                       FontSize="13"
                       TextWrapping="WrapByWords"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginBottom="18"/>

            <!-- How days are selected, whether weeks are numbered, and the language the calendar speaks. -->
            <WrapPanel Orientation="Horizontal">
                <RadioButton AutomationProperties.AutomationId="SingleDateRadio"
                             Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="SingleDate"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=SingleDate, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="SingleRange"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=SingleRange, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="MultipleRange"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=MultipleRange, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="None"
                             MarginRight="24"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=None, Mode=TwoWay}"/>
                <CheckBox AutomationProperties.AutomationId="WeekNumbersCheck"
                          Content="{Localize DateTimePageStrings.WeekNumbers}"
                          IsChecked="{Binding ShowWeekNumbers, Mode=TwoWay}"
                          MarginRight="24"
                          MarginBottom="6"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="Русский"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=ru-RU, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="English (US)"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=en-US, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="日本語"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=ja-JP, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="العربية"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=ar-EG, Mode=TwoWay}"/>
            </WrapPanel>

            <!-- Date and time fields in each format and language; the date is the calendars' own. -->
            <TextBlock Text="{Localize DateTimePageStrings.Fields}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginTop="12"
                       MarginBottom="8"/>
            <Grid ColumnDefinitions="Auto,Auto,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="6"
                  HorizontalAlignment="Left">
                <TextBlock Text="{Localize DateTimePageStrings.ShortDate}"
                           VerticalAlignment="Center"/>
                <DateTimeField AutomationProperties.AutomationId="DateField"
                               Grid.Column="1"
                               Value="{Binding SelectedDate}"
                               Language="{Binding CalendarLanguage}"/>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"><Run Text="{Localize DateTimePageStrings.FieldValue}"/><Run Text="{Binding SelectedDate, StringFormat='{0:G}'}"/></TextBlock>

                <TextBlock Grid.Row="1"
                           Text="{Localize DateTimePageStrings.LongDate}"
                           VerticalAlignment="Center"/>
                <DateTimeField Grid.Row="1"
                               Grid.Column="1"
                               Format="LongDate"
                               Value="{Binding SelectedDate}"
                               Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="2"
                           Text="{Localize DateTimePageStrings.ShortTime}"
                           VerticalAlignment="Center"/>
                <DateTimeField AutomationProperties.AutomationId="TimeField"
                               Grid.Row="2"
                               Grid.Column="1"
                               Format="ShortTime"
                               Value="{Binding MeetingTime}"
                               Language="{Binding CalendarLanguage}"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           VerticalAlignment="Center"><Run Text="{Localize DateTimePageStrings.FieldValue}"/><Run Text="{Binding MeetingTime, StringFormat='{0:G}'}"/></TextBlock>

                <TextBlock Grid.Row="3"
                           Text="{Localize DateTimePageStrings.DateAndTime}"
                           VerticalAlignment="Center"/>
                <DateTimeField Grid.Row="3"
                               Grid.Column="1"
                               Format="ShortDateTime"
                               Value="{Binding MeetingTime}"
                               Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="4"
                           Text="{Localize DateTimePageStrings.Custom}"
                           VerticalAlignment="Center"/>
                <DateTimeField Grid.Row="4"
                               Grid.Column="1"
                               Format="Custom"
                               CustomFormat="dddd, d MMMM yyyy"
                               Value="{Binding SelectedDate}"
                               Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="5"
                           Text="{Localize DateTimePageStrings.CountedField}"
                           VerticalAlignment="Center"/>
                <DateTimeField Grid.Row="5"
                               Grid.Column="1"
                               CalendarSystem="{Binding CalendarSystem}"
                               Value="{Binding SelectedDate}"
                               Language="{Binding CalendarLanguage}"/>
            </Grid>

            <!-- The same fields with a button that opens a calendar, a list of times, or both. -->
            <TextBlock Text="{Localize DateTimePageStrings.Pickers}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginTop="16"
                       MarginBottom="8"/>
            <Grid ColumnDefinitions="Auto,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="6"
                  HorizontalAlignment="Left"
                  MarginBottom="12">
                <TextBlock Text="{Localize DateTimePageStrings.DatePicker}"
                           VerticalAlignment="Center"/>
                <DatePicker AutomationProperties.AutomationId="DatePicker"
                            Grid.Column="1"
                            MinWidth="180"
                            Value="{Binding SelectedDate}"
                            CalendarSystem="{Binding CalendarSystem}"
                            Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="1"
                           Text="{Localize DateTimePageStrings.TimePicker}"
                           VerticalAlignment="Center"/>
                <TimePicker AutomationProperties.AutomationId="TimePicker"
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="180"
                            Value="{Binding MeetingTime}"
                            Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="2"
                           Text="{Localize DateTimePageStrings.DateTimePicker}"
                           VerticalAlignment="Center"/>
                <DateTimePicker AutomationProperties.AutomationId="DateTimePicker"
                                Grid.Row="2"
                                Grid.Column="1"
                                MinWidth="220"
                                Value="{Binding MeetingTime}"
                                CalendarSystem="{Binding CalendarSystem}"
                                Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="3"
                           Text="{Localize DateTimePageStrings.TimeColumns}"
                           VerticalAlignment="Center"/>
                <TimePicker AutomationProperties.AutomationId="TimeColumnsPicker"
                            Grid.Row="3"
                            Grid.Column="1"
                            MinWidth="180"
                            PopupStyle="Columns"
                            TimeInterval="0:05:00"
                            Value="{Binding MeetingTime}"
                            Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="4"
                           Text="{Localize DateTimePageStrings.TimeDial}"
                           VerticalAlignment="Center"/>
                <TimePicker AutomationProperties.AutomationId="TimeDialPicker"
                            Grid.Row="4"
                            Grid.Column="1"
                            MinWidth="180"
                            PopupStyle="Dial"
                            Value="{Binding MeetingTime}"
                            Language="{Binding CalendarLanguage}"/>
            </Grid>

            <!-- Lengths of time part by part. -->
            <TextBlock Text="{Localize DateTimePageStrings.Durations}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginTop="16"
                       MarginBottom="8"/>
            <Grid ColumnDefinitions="Auto,Auto,Auto"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="6"
                  HorizontalAlignment="Left"
                  MarginBottom="12">
                <TextBlock Text="{Localize DateTimePageStrings.Duration}"
                           VerticalAlignment="Center"/>
                <DurationField AutomationProperties.AutomationId="DurationField"
                               Grid.Column="1"
                               Value="{Binding Length}"
                               Language="{Binding CalendarLanguage}"/>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"><Run Text="{Localize DateTimePageStrings.FieldValue}"/><Run Text="{Binding Length, StringFormat='{0:c}'}"/></TextBlock>

                <TextBlock Grid.Row="1"
                           Text="{Localize DateTimePageStrings.DurationDays}"
                           VerticalAlignment="Center"/>
                <DurationField Grid.Row="1"
                               Grid.Column="1"
                               Parts="Days, Hours, Minutes"
                               Value="{Binding Length}"
                               Language="{Binding CalendarLanguage}"/>

                <TextBlock Grid.Row="2"
                           Text="{Localize DateTimePageStrings.DurationMilliseconds}"
                           VerticalAlignment="Center"/>
                <DurationField AutomationProperties.AutomationId="CooldownField"
                               Grid.Row="2"
                               Grid.Column="1"
                               Parts="Seconds, Milliseconds"
                               Minimum="0:00:00"
                               Value="{Binding Cooldown}"
                               Language="{Binding CalendarLanguage}"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           VerticalAlignment="Center"><Run Text="{Localize DateTimePageStrings.FieldValue}"/><Run Text="{Binding Cooldown, StringFormat='{0:c}'}"/></TextBlock>
            </Grid>

            <!-- The same in a table and in an inspector built from the record's type. -->
            <TextBlock Text="{Localize DateTimePageStrings.Table}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginTop="16"
                       MarginBottom="8"/>
            <TreeDataGrid AutomationProperties.AutomationId="ScheduleTable"
                          ItemsSource="{Binding Schedule}"
                          Height="200"
                          MaxWidth="900"
                          HorizontalAlignment="Left"
                          MarginBottom="12">
                <TreeDataGrid.Columns>
                    <DataGridTextColumn Header="{Localize DateTimePageStrings.TaskName}" Binding="{Binding Name}" Width="160"/>
                    <DataGridDateTimeColumn Header="{Localize DateTimePageStrings.Due}" Binding="{Binding Due}" Format="ShortDateTime" Width="170"/>
                    <DataGridDateTimeColumn Header="{Localize DateTimePageStrings.Day}" Binding="{Binding Day}" Width="120"/>
                    <DataGridDateTimeColumn Header="{Localize DateTimePageStrings.Start}" Binding="{Binding Start}" Format="ShortTime" Width="100"/>
                    <DataGridDateTimeColumn Header="{Localize DateTimePageStrings.Stamp}" Binding="{Binding Stamp}" Format="ShortDateTime" Width="170"/>
                    <DataGridDurationColumn Header="{Localize DateTimePageStrings.Length}" Binding="{Binding Length}" Width="120"/>
                </TreeDataGrid.Columns>
            </TreeDataGrid>

            <TextBlock Text="{Localize DateTimePageStrings.Inspector}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginTop="4"
                       MarginBottom="8"/>
            <PropertyGrid AutomationProperties.AutomationId="ScheduleInspector"
                          AutoGenerateSections="True"
                          SelectedObject="{Binding Inspected}"
                          Width="420"
                          Height="260"
                          HorizontalAlignment="Left"
                          MarginBottom="12"/>

            <!-- One clock, every style: hands turned by the compositor, figures changed on the second. -->
            <TextBlock Text="{Localize DateTimePageStrings.Clocks}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginTop="4"
                       MarginBottom="8"/>
            <WrapPanel Orientation="Horizontal"
                       MarginBottom="12">
                <StackPanel Margin="0,0,16,16">
                    <Clock AutomationProperties.AutomationId="ClassicClock"
                           ClockStyle="Classic"
                           Width="160"
                           Height="160"
                           Language="{Binding CalendarLanguage}"/>
                    <TextBlock Text="Classic" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,16">
                    <Clock ClockStyle="Minimal"
                           SecondHandMotion="Sweep"
                           Width="160"
                           Height="160"/>
                    <TextBlock Text="{Localize DateTimePageStrings.MinimalSweep}" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,16">
                    <Clock ClockStyle="Roman"
                           Width="160"
                           Height="160"/>
                    <TextBlock Text="Roman" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,16">
                    <Clock ClockStyle="Dots"
                           ShowSeconds="False"
                           Width="160"
                           Height="160"/>
                    <TextBlock Text="{Localize DateTimePageStrings.DotsNoSeconds}" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal"
                       MarginBottom="12">
                <StackPanel Margin="0,0,24,16">
                    <Clock AutomationProperties.AutomationId="TextClock"
                           ClockStyle="Text"
                           Language="{Binding CalendarLanguage}"/>
                    <TextBlock Text="Text" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
                <StackPanel Margin="0,0,24,16">
                    <Clock ClockStyle="SevenSegment"
                           Language="{Binding CalendarLanguage}"/>
                    <TextBlock Text="SevenSegment" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
                <StackPanel Margin="0,0,24,16">
                    <Clock ClockStyle="Flip"
                           Language="{Binding CalendarLanguage}"/>
                    <TextBlock Text="Flip" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal"
                       MarginBottom="24">
                <StackPanel Margin="0,0,16,0">
                    <Clock ClockStyle="Classic"
                           TimeZone="{Binding Tokyo}"
                           Width="120"
                           Height="120"/>
                    <TextBlock Text="{Localize DateTimePageStrings.Tokyo}" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <Clock ClockStyle="Classic"
                           TimeZone="{Binding NewYork}"
                           Width="120"
                           Height="120"/>
                    <TextBlock Text="{Localize DateTimePageStrings.NewYork}" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
                <StackPanel>
                    <Clock ClockStyle="Text"
                           IsLive="False"
                           Time="{Binding MeetingTime}"
                           ShowSeconds="False"
                           Language="{Binding CalendarLanguage}"/>
                    <TextBlock Text="{Localize DateTimePageStrings.Meeting}" HorizontalAlignment="Center" MarginTop="4"/>
                </StackPanel>
            </WrapPanel>

            <!-- A countdown and a stopwatch on the same clock: its styles, its buttons, what is left filled on a face. -->
            <TextBlock Text="{Localize DateTimePageStrings.Timers}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginBottom="8"/>
            <WrapPanel Orientation="Horizontal"
                       MarginBottom="24">
                <CountdownTimer AutomationProperties.AutomationId="AnalogCountdown"
                                Duration="{Binding TimerLength}"
                                Width="220"
                                Height="270"
                                Margin="0,0,24,16"/>
                <StackPanel Margin="0,0,24,16">
                    <CountdownTimer AutomationProperties.AutomationId="SegmentCountdown"
                                    ClockStyle="SevenSegment"
                                    Duration="{Binding TimerLength}"
                                    CompletedCommand="{Binding TimerDoneCommand}"/>
                    <TextBlock MarginTop="4"><Run Text="{Localize DateTimePageStrings.TimerDone}"/><Run Text="{Binding TimesDone}"/></TextBlock>
                </StackPanel>
                <StopwatchTimer AutomationProperties.AutomationId="Stopwatch"
                                Width="260"
                                Height="420"
                                Margin="0,0,24,16"/>
                <StopwatchTimer AutomationProperties.AutomationId="FlipStopwatch"
                                ClockStyle="Flip"
                                ShowLaps="False"
                                VerticalAlignment="Top"
                                Margin="0,0,24,16"/>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal"
                       MarginTop="12">
                <!-- At the size its content asks for, bound to the page's date. -->
                <StackPanel Orientation="Vertical"
                            Margin="0,0,24,24"
                            VerticalAlignment="Top">
                    <TextBlock Text="{Localize DateTimePageStrings.Plain}"
                               MarginBottom="8"/>
                    <Calendar AutomationProperties.AutomationId="PageCalendar"
                              SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                              SelectionMode="{Binding SelectionMode}"
                              ShowWeekNumbers="{Binding ShowWeekNumbers}"
                              Language="{Binding CalendarLanguage}"
                              HorizontalAlignment="Left"/>
                    <TextBlock MarginTop="8"><Run Text="{Localize DateTimePageStrings.Selected}"/><Run Text="{Binding SelectedDate, StringFormat='{0:D}'}"/></TextBlock>
                </StackPanel>

                <!-- From today for three months, the weekend of Christmas and the past struck through. -->
                <StackPanel Orientation="Vertical"
                            Margin="0,0,24,24"
                            VerticalAlignment="Top">
                    <TextBlock Text="{Localize DateTimePageStrings.Range}"
                               MarginBottom="8"/>
                    <Calendar AutomationProperties.AutomationId="RangeCalendar"
                              DisplayDateStart="{Binding RangeStart}"
                              DisplayDateEnd="{Binding RangeEnd}"
                              SelectionMode="{Binding SelectionMode}"
                              Language="{Binding CalendarLanguage}"
                              HorizontalAlignment="Left">
                        <Calendar.BlackoutDates>
                            <CalendarDateRange Start="2026-12-24"
                                               End="2026-12-26"/>
                            <CalendarDateRange Start="2026-12-31"
                                               End="2027-01-02"/>
                        </Calendar.BlackoutDates>
                    </Calendar>
                </StackPanel>
            </WrapPanel>

            <!-- Months side by side, counted by the chosen calendar, holidays marked and weekends in their own color. -->
            <TextBlock Text="{Localize DateTimePageStrings.Several}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginBottom="8"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Localize DateTimePageStrings.Counting}"
                           VerticalAlignment="Center"
                           MarginRight="8"
                           MarginBottom="6"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.ByLanguage}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Language, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Gregorian}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Gregorian, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Hijri}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=UmAlQura, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Persian}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Persian, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Hebrew}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Hebrew, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Japanese}"
                             MarginRight="24"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Japanese, Mode=TwoWay}"/>
                <TextBlock Text="{Localize DateTimePageStrings.Months}"
                           VerticalAlignment="Center"
                           MarginRight="8"
                           MarginBottom="6"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarMonths"
                             Content="1"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding MonthsShown, Converter={conv:EnumToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarMonths"
                             Content="2"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding MonthsShown, Converter={conv:EnumToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarMonths"
                             Content="3"
                             MarginBottom="6"
                             IsChecked="{Binding MonthsShown, Converter={conv:EnumToBoolConverter}, ConverterParameter=3, Mode=TwoWay}"/>
            </WrapPanel>
            <Calendar AutomationProperties.AutomationId="MonthsCalendar"
                      MonthsShown="{Binding MonthsShown}"
                      CalendarSystem="{Binding CalendarSystem}"
                      MarkedDates="{Binding Holidays}"
                      SelectionMode="{Binding SelectionMode}"
                      ShowWeekNumbers="{Binding ShowWeekNumbers}"
                      Language="{Binding CalendarLanguage}"
                      HorizontalAlignment="Left"
                      MarginTop="6"
                      MarginBottom="24">
                <Calendar.CalendarDayButtonStyle>
                    <Style Selector="CalendarDayButton">
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="DayOfWeek"
                                           Value="Saturday"/>
                                <Condition Property="IsToday"
                                           Value="false"/>
                                <Condition Property="IsInactive"
                                           Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference SystemFillColorCritical}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="DayOfWeek"
                                           Value="Sunday"/>
                                <Condition Property="IsToday"
                                           Value="false"/>
                                <Condition Property="IsInactive"
                                           Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference SystemFillColorCritical}"/>
                        </MultiTrigger>
                    </Style>
                </Calendar.CalendarDayButtonStyle>
            </Calendar>

            <!-- Given a size, the calendar's cells share it: no Viewbox around it. -->
            <TextBlock Text="{Localize DateTimePageStrings.Large}"
                       MarginBottom="8"/>
            <Calendar AutomationProperties.AutomationId="LargeCalendar"
                      Width="640"
                      Height="520"
                      HorizontalAlignment="Left"
                      FontSize="18"
                      SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                      SelectionMode="{Binding SelectionMode}"
                      ShowWeekNumbers="{Binding ShowWeekNumbers}"
                      Language="{Binding CalendarLanguage}"/>
        </StackPanel>
    </ScrollViewer>
</View>
