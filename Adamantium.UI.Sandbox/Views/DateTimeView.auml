<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical"
                    Margin="24">

            <TextBlock Text="{Localize DateTimePageStrings.Title}"
                       FontSize="20"
                       MarginBottom="4"/>
            <TextBlock Text="{Localize DateTimePageStrings.Intro}"
                       FontSize="13"
                       TextWrapping="WrapByWords"
                       Foreground="{ResourceReference TextFillColorSecondary}"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginBottom="18"/>

            <!-- How days are selected, whether weeks are numbered, and the language the calendar speaks. -->
            <WrapPanel Orientation="Horizontal">
                <RadioButton AutomationProperties.AutomationId="SingleDateRadio"
                             Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="SingleDate"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=SingleDate, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="SingleRange"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=SingleRange, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="MultipleRange"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=MultipleRange, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarSelection"
                             Content="None"
                             MarginRight="24"
                             MarginBottom="6"
                             IsChecked="{Binding SelectionMode, Converter={conv:EnumToBoolConverter}, ConverterParameter=None, Mode=TwoWay}"/>
                <CheckBox AutomationProperties.AutomationId="WeekNumbersCheck"
                          Content="{Localize DateTimePageStrings.WeekNumbers}"
                          IsChecked="{Binding ShowWeekNumbers, Mode=TwoWay}"
                          MarginRight="24"
                          MarginBottom="6"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="Русский"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=ru-RU, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="English (US)"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=en-US, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="日本語"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=ja-JP, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarLanguage"
                             Content="العربية"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarLanguage, Converter={conv:EnumToBoolConverter}, ConverterParameter=ar-EG, Mode=TwoWay}"/>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal"
                       MarginTop="12">
                <!-- At the size its content asks for, bound to the page's date. -->
                <StackPanel Orientation="Vertical"
                            Margin="0,0,24,24"
                            VerticalAlignment="Top">
                    <TextBlock Text="{Localize DateTimePageStrings.Plain}"
                               MarginBottom="8"/>
                    <Calendar AutomationProperties.AutomationId="PageCalendar"
                              SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                              SelectionMode="{Binding SelectionMode}"
                              ShowWeekNumbers="{Binding ShowWeekNumbers}"
                              Language="{Binding CalendarLanguage}"
                              HorizontalAlignment="Left"/>
                    <TextBlock MarginTop="8"><Run Text="{Localize DateTimePageStrings.Selected}"/><Run Text="{Binding SelectedDate, StringFormat='{0:D}'}"/></TextBlock>
                </StackPanel>

                <!-- From today for three months, the weekend of Christmas and the past struck through. -->
                <StackPanel Orientation="Vertical"
                            Margin="0,0,24,24"
                            VerticalAlignment="Top">
                    <TextBlock Text="{Localize DateTimePageStrings.Range}"
                               MarginBottom="8"/>
                    <Calendar AutomationProperties.AutomationId="RangeCalendar"
                              DisplayDateStart="{Binding RangeStart}"
                              DisplayDateEnd="{Binding RangeEnd}"
                              SelectionMode="{Binding SelectionMode}"
                              Language="{Binding CalendarLanguage}"
                              HorizontalAlignment="Left">
                        <Calendar.BlackoutDates>
                            <CalendarDateRange Start="2026-12-24"
                                               End="2026-12-26"/>
                            <CalendarDateRange Start="2026-12-31"
                                               End="2027-01-02"/>
                        </Calendar.BlackoutDates>
                    </Calendar>
                </StackPanel>
            </WrapPanel>

            <!-- Months side by side, counted by the chosen calendar, holidays marked and weekends in their own color. -->
            <TextBlock Text="{Localize DateTimePageStrings.Several}"
                       TextWrapping="WrapByWords"
                       MaxWidth="680"
                       HorizontalAlignment="Left"
                       MarginBottom="8"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Localize DateTimePageStrings.Counting}"
                           VerticalAlignment="Center"
                           MarginRight="8"
                           MarginBottom="6"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.ByLanguage}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Language, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Gregorian}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Gregorian, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Hijri}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=UmAlQura, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Persian}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Persian, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Hebrew}"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Hebrew, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarCounting"
                             Content="{Localize DateTimePageStrings.Japanese}"
                             MarginRight="24"
                             MarginBottom="6"
                             IsChecked="{Binding CalendarSystem, Converter={conv:EnumToBoolConverter}, ConverterParameter=Japanese, Mode=TwoWay}"/>
                <TextBlock Text="{Localize DateTimePageStrings.Months}"
                           VerticalAlignment="Center"
                           MarginRight="8"
                           MarginBottom="6"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarMonths"
                             Content="1"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding MonthsShown, Converter={conv:EnumToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarMonths"
                             Content="2"
                             MarginRight="6"
                             MarginBottom="6"
                             IsChecked="{Binding MonthsShown, Converter={conv:EnumToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"/>
                <RadioButton Classes="Toggle"
                             GroupName="CalendarMonths"
                             Content="3"
                             MarginBottom="6"
                             IsChecked="{Binding MonthsShown, Converter={conv:EnumToBoolConverter}, ConverterParameter=3, Mode=TwoWay}"/>
            </WrapPanel>
            <Calendar AutomationProperties.AutomationId="MonthsCalendar"
                      MonthsShown="{Binding MonthsShown}"
                      CalendarSystem="{Binding CalendarSystem}"
                      MarkedDates="{Binding Holidays}"
                      SelectionMode="{Binding SelectionMode}"
                      ShowWeekNumbers="{Binding ShowWeekNumbers}"
                      Language="{Binding CalendarLanguage}"
                      HorizontalAlignment="Left"
                      MarginTop="6"
                      MarginBottom="24">
                <Calendar.CalendarDayButtonStyle>
                    <Style Selector="CalendarDayButton">
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="DayOfWeek"
                                           Value="Saturday"/>
                                <Condition Property="IsToday"
                                           Value="false"/>
                                <Condition Property="IsInactive"
                                           Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference SystemFillColorCritical}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="DayOfWeek"
                                           Value="Sunday"/>
                                <Condition Property="IsToday"
                                           Value="false"/>
                                <Condition Property="IsInactive"
                                           Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference SystemFillColorCritical}"/>
                        </MultiTrigger>
                    </Style>
                </Calendar.CalendarDayButtonStyle>
            </Calendar>

            <!-- Given a size, the calendar's cells share it: no Viewbox around it. -->
            <TextBlock Text="{Localize DateTimePageStrings.Large}"
                       MarginBottom="8"/>
            <Calendar AutomationProperties.AutomationId="LargeCalendar"
                      Width="640"
                      Height="520"
                      HorizontalAlignment="Left"
                      FontSize="18"
                      SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                      SelectionMode="{Binding SelectionMode}"
                      ShowWeekNumbers="{Binding ShowWeekNumbers}"
                      Language="{Binding CalendarLanguage}"/>
        </StackPanel>
    </ScrollViewer>
</View>
