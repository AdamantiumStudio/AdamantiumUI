<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- Navigated into the text tab's region under the key "Decorations"; the DataContext is the tab's own view-model. -->
    <StackPanel Orientation="Vertical">
        <!-- The lines a run sets by name: under, through and over the text, and the wavy one of a spelling error. -->
        <TextBlock Text="{Localize TextStrings.DecorationFlagsTitle}"
                   Margin="0,0,0,6"/>
        <TextBlock AutomationProperties.AutomationId="DecorationFlagsSample"
                   FontSize="22"
                   HorizontalAlignment="Left">
            <TextBlock.Inlines>
                <Run Text="underline"
                     TextDecorations="Underline"/>
                <Run Text="   "/>
                <Run Text="strikethrough"
                     TextDecorations="Strikethrough"/>
                <Run Text="   "/>
                <Run Text="overline"
                     TextDecorations="Overline"/>
                <Run Text="   "/>
                <Run Text="squiggle"
                     TextDecorations="Squiggle"/>
            </TextBlock.Inlines>
        </TextBlock>

        <!-- Decoration lines, as WPF's: lines each with their own brush, thickness, dashes and offset. -->
        <TextBlock Text="{Localize TextStrings.DecorationLinesTitle}"
                   Margin="0,20,0,6"/>
        <TextBlock AutomationProperties.AutomationId="DecorationLinesSample"
                   FontSize="22"
                   HorizontalAlignment="Left">
            <TextBlock.Inlines>
                <Run Text="dashed red">
                    <Run.DecorationLines>
                        <TextDecoration Location="Underline"
                                        Brush="#F87171"
                                        Thickness="2"
                                        DashArray="6 3"/>
                    </Run.DecorationLines>
                </Run>
                <Run Text="   "/>
                <Run Text="thick strike">
                    <Run.DecorationLines>
                        <TextDecoration Location="Strikethrough"
                                        Brush="#38BDF8"
                                        Thickness="4"/>
                    </Run.DecorationLines>
                </Run>
                <Run Text="   "/>
                <Run Text="two lines">
                    <Run.DecorationLines>
                        <TextDecoration Location="Underline"/>
                        <TextDecoration Location="Underline"
                                        Offset="3"/>
                    </Run.DecorationLines>
                </Run>
                <Run Text="   "/>
                <Run Text="baseline">
                    <Run.DecorationLines>
                        <TextDecoration Location="Baseline"
                                        Brush="#A3E635"
                                        DashArray="2 2"/>
                    </Run.DecorationLines>
                </Run>
                <Run Text="   "/>
                <Run Text="dotted overline">
                    <Run.DecorationLines>
                        <TextDecoration Location="Overline"
                                        Brush="#FBBF24"
                                        Thickness="2"
                                        DashArray="2 3"/>
                    </Run.DecorationLines>
                </Run>
            </TextBlock.Inlines>
        </TextBlock>
    </StackPanel>
</View>
