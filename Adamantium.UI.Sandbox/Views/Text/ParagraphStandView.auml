<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- Navigated into the text tab's region under the key "Paragraph"; the DataContext is the tab's own view-model. -->
    <StackPanel Orientation="Vertical"
                Hyphens="{Binding Hyphens}"
                OpticalMarginAlignment="{Binding OpticalMargins}">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ColumnWidthLabel"
                       Text="{Localize TextStrings.ColumnWidth}"
                       VerticalAlignment="Center"/>
            <Slider AutomationProperties.AutomationId="ColumnWidthSlider"
                    AutomationProperties.LabeledBy="{Binding ElementName=ColumnWidthLabel}"
                    Width="240"
                    Minimum="80"
                    Maximum="480"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    IsValueToolTipEnabled="True"
                    Value="{Binding ColumnWidth, Mode=TwoWay}"
                    Margin="8,0,24,0"/>
            <ToggleSwitch AutomationProperties.AutomationId="JustifyToggle"
                          Content="{Localize TextStrings.Justify}"
                          IsChecked="{Binding Justified, Mode=TwoWay}"/>
            <ToggleSwitch AutomationProperties.AutomationId="OpticalMarginsToggle"
                          Content="{Localize TextStrings.OpticalMargins}"
                          IsChecked="{Binding OpticalMargins, Mode=TwoWay}"
                          Margin="24,0,0,0"/>
        </StackPanel>

        <!-- The same paragraph broken a line at a time and as a whole. -->
        <TextBlock Text="{Localize TextStrings.ParagraphTitle}"
                   Margin="0,16,0,8"/>
        <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="{Localize TextStrings.LineAtATime}"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="GreedyColumn"
                               Text="{Binding ProseSample}"
                               Language="en-US"
                               LineBreaking="Greedy"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="{Localize TextStrings.WholeParagraph}"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="ParagraphColumn"
                               Text="{Binding ProseSample}"
                               Language="en-US"
                               LineBreaking="Paragraph"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>
        </WrapPanel>

        <!-- InDesign's justification, each setting over the justified text it changes: how far lines may squeeze and
             stretch their spaces, then their letters, then their glyphs, in percents; tracking in thousandths of an em;
             where the last line stands; where a line of one word stands; and kashidas stretching Arabic words. -->
        <TextBlock Text="{Localize TextStrings.JustificationTitle}"
                   Margin="0,8,0,8"/>
        <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical"
                        Margin="0,0,24,16">
                <Grid ColumnDefinitions="Auto,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      Margin="0,0,0,6">
                    <TextBlock x:Name="WordSpacingLabel"
                               Text="{Localize TextStrings.WordSpacing}"
                               VerticalAlignment="Center"/>
                    <RangeSlider AutomationProperties.AutomationId="WordSpacingRange"
                                 AutomationProperties.LabeledBy="{Binding ElementName=WordSpacingLabel}"
                                 Grid.Column="1"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Minimum="50"
                                 Maximum="200"
                                 TickFrequency="1"
                                 IsSnapToTickEnabled="True"
                                 IsValueToolTipEnabled="True"
                                 LowerValue="{Binding WordMinimum, Mode=TwoWay}"
                                 UpperValue="{Binding WordMaximum, Mode=TwoWay}"
                                 Margin="8,4,0,4"/>
                    <TextBlock x:Name="LetterSpacingLabel"
                               Grid.Row="1"
                               Text="{Localize TextStrings.LetterSpacing}"
                               VerticalAlignment="Center"/>
                    <RangeSlider AutomationProperties.AutomationId="LetterSpacingRange"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LetterSpacingLabel}"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Minimum="-20"
                                 Maximum="50"
                                 TickFrequency="1"
                                 IsSnapToTickEnabled="True"
                                 IsValueToolTipEnabled="True"
                                 LowerValue="{Binding LetterMinimum, Mode=TwoWay}"
                                 UpperValue="{Binding LetterMaximum, Mode=TwoWay}"
                                 Margin="8,4,0,4"/>
                    <TextBlock x:Name="GlyphScalingLabel"
                               Grid.Row="2"
                               Text="{Localize TextStrings.GlyphScaling}"
                               VerticalAlignment="Center"/>
                    <RangeSlider AutomationProperties.AutomationId="GlyphScalingRange"
                                 AutomationProperties.LabeledBy="{Binding ElementName=GlyphScalingLabel}"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Minimum="90"
                                 Maximum="110"
                                 TickFrequency="1"
                                 IsSnapToTickEnabled="True"
                                 IsValueToolTipEnabled="True"
                                 LowerValue="{Binding GlyphMinimum, Mode=TwoWay}"
                                 UpperValue="{Binding GlyphMaximum, Mode=TwoWay}"
                                 Margin="8,4,0,4"/>
                    <TextBlock x:Name="TrackingLabel"
                               Grid.Row="3"
                               Text="{Localize TextStrings.Tracking}"
                               VerticalAlignment="Center"/>
                    <Slider AutomationProperties.AutomationId="TrackingSlider"
                            AutomationProperties.LabeledBy="{Binding ElementName=TrackingLabel}"
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="200"
                            HorizontalAlignment="Left"
                            Minimum="-100"
                            Maximum="200"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            IsValueToolTipEnabled="True"
                            Value="{Binding Tracking, Mode=TwoWay}"
                            Margin="8,4,0,4"/>
                </Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <TextBlock Text="{Localize TextStrings.LastLine}"
                               VerticalAlignment="Center"
                               MarginRight="8"/>
                    <RadioButton AutomationProperties.AutomationId="LastLineStartRadio"
                                 Classes="Toggle"
                                 GroupName="LastLine"
                                 Content="{Localize TextStrings.AlignStart}"
                                 MarginRight="6"
                                 IsChecked="{Binding LastLineAlignment, Converter={conv:EnumToBoolConverter}, ConverterParameter=Left, Mode=TwoWay}"/>
                    <RadioButton AutomationProperties.AutomationId="LastLineCenterRadio"
                                 Classes="Toggle"
                                 GroupName="LastLine"
                                 Content="{Localize TextStrings.AlignCenter}"
                                 MarginRight="6"
                                 IsChecked="{Binding LastLineAlignment, Converter={conv:EnumToBoolConverter}, ConverterParameter=Center, Mode=TwoWay}"/>
                    <RadioButton AutomationProperties.AutomationId="LastLineEndRadio"
                                 Classes="Toggle"
                                 GroupName="LastLine"
                                 Content="{Localize TextStrings.AlignEnd}"
                                 MarginRight="6"
                                 IsChecked="{Binding LastLineAlignment, Converter={conv:EnumToBoolConverter}, ConverterParameter=Right, Mode=TwoWay}"/>
                    <RadioButton AutomationProperties.AutomationId="LastLineJustifyRadio"
                                 Classes="Toggle"
                                 GroupName="LastLine"
                                 Content="{Localize TextStrings.Justify}"
                                 IsChecked="{Binding LastLineAlignment, Converter={conv:EnumToBoolConverter}, ConverterParameter=Justify, Mode=TwoWay}"/>
                </StackPanel>
                <!-- The settings go on the sample only, so the controls above keep their own spacing. -->
                <Border Width="420"
                        HorizontalAlignment="Left"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="JustifiedColumn"
                               Text="{Binding ProseSample}"
                               Language="en-US"
                               TextWrapping="WrapByWords"
                               FontSize="18"
                               WordSpacing="{Binding WordSpacing}"
                               LetterSpacing="{Binding LetterSpacing}"
                               GlyphScaling="{Binding GlyphScaling}"
                               Tracking="{Binding Tracking}"
                               LastLineAlignment="{Binding LastLineAlignment}"
                               HorizontalTextAlignment="Justify"/>
                </Border>
            </StackPanel>

            <!-- A line holding one word: where it stands, or its letters spread across the line. -->
            <StackPanel Orientation="Vertical"
                        Margin="0,0,24,16">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <TextBlock Text="{Localize TextStrings.SingleWord}"
                               VerticalAlignment="Center"
                               MarginRight="8"/>
                    <RadioButton AutomationProperties.AutomationId="SingleWordStartRadio"
                                 Classes="Toggle"
                                 GroupName="SingleWord"
                                 Content="{Localize TextStrings.AlignStart}"
                                 MarginRight="6"
                                 IsChecked="{Binding SingleWordJustification, Converter={conv:EnumToBoolConverter}, ConverterParameter=Left, Mode=TwoWay}"/>
                    <RadioButton AutomationProperties.AutomationId="SingleWordCenterRadio"
                                 Classes="Toggle"
                                 GroupName="SingleWord"
                                 Content="{Localize TextStrings.AlignCenter}"
                                 MarginRight="6"
                                 IsChecked="{Binding SingleWordJustification, Converter={conv:EnumToBoolConverter}, ConverterParameter=Center, Mode=TwoWay}"/>
                    <RadioButton AutomationProperties.AutomationId="SingleWordEndRadio"
                                 Classes="Toggle"
                                 GroupName="SingleWord"
                                 Content="{Localize TextStrings.AlignEnd}"
                                 MarginRight="6"
                                 IsChecked="{Binding SingleWordJustification, Converter={conv:EnumToBoolConverter}, ConverterParameter=Right, Mode=TwoWay}"/>
                    <RadioButton AutomationProperties.AutomationId="SingleWordJustifyRadio"
                                 Classes="Toggle"
                                 GroupName="SingleWord"
                                 Content="{Localize TextStrings.Justify}"
                                 IsChecked="{Binding SingleWordJustification, Converter={conv:EnumToBoolConverter}, ConverterParameter=Justify, Mode=TwoWay}"/>
                </StackPanel>
                <Border Width="300"
                        HorizontalAlignment="Left"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="SingleWordColumn"
                               Text="{Binding SingleWordSample}"
                               Language="en-US"
                               Hyphens="None"
                               TextWrapping="WrapByWords"
                               FontSize="18"
                               SingleWordJustification="{Binding SingleWordJustification}"
                               HorizontalTextAlignment="Justify"/>
                </Border>
            </StackPanel>

            <!-- Arabic justified: once its spaces are at their maximum, a word stretches with a kashida. -->
            <StackPanel Orientation="Vertical"
                        Margin="0,0,24,16">
                <ToggleSwitch AutomationProperties.AutomationId="KashidasToggle"
                              Content="{Localize TextStrings.Kashidas}"
                              IsChecked="{Binding Kashidas, Mode=TwoWay}"
                              Margin="0,0,0,6"/>
                <Border Width="300"
                        HorizontalAlignment="Left"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="ArabicColumn"
                               Text="{Binding ArabicParagraphSample}"
                               Language="ar"
                               TextWrapping="WrapByWords"
                               FontSize="26"
                               Kashidas="{Binding Kashidas}"
                               HorizontalTextAlignment="Justify"/>
                </Border>
            </StackPanel>
        </WrapPanel>

        <!-- Hyphenation: nowhere, at soft hyphens, or also by the patterns of the language; and how the columns below
             break into lines. -->
        <TextBlock Text="{Localize TextStrings.HyphenationTitle}"
                   Margin="0,8,0,8"/>
        <WrapPanel Orientation="Horizontal">
            <RadioButton Classes="Toggle"
                         GroupName="Hyphens"
                         Content="{Localize TextStrings.HyphensNone}"
                         MarginRight="6"
                         MarginBottom="6"
                         IsChecked="{Binding Hyphens, Converter={conv:EnumToBoolConverter}, ConverterParameter=None, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         GroupName="Hyphens"
                         Content="{Localize TextStrings.HyphensManual}"
                         MarginRight="6"
                         MarginBottom="6"
                         IsChecked="{Binding Hyphens, Converter={conv:EnumToBoolConverter}, ConverterParameter=Manual, Mode=TwoWay}"/>
            <RadioButton Classes="Toggle"
                         GroupName="Hyphens"
                         Content="{Localize TextStrings.HyphensAuto}"
                         MarginRight="24"
                         MarginBottom="6"
                         IsChecked="{Binding Hyphens, Converter={conv:EnumToBoolConverter}, ConverterParameter=Auto, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="GreedyRadio"
                         Classes="Toggle"
                         GroupName="LineBreaking"
                         Content="{Localize TextStrings.LineAtATime}"
                         MarginRight="6"
                         MarginBottom="6"
                         IsChecked="{Binding LineBreaking, Converter={conv:EnumToBoolConverter}, ConverterParameter=Greedy, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="ParagraphRadio"
                         Classes="Toggle"
                         GroupName="LineBreaking"
                         Content="{Localize TextStrings.WholeParagraph}"
                         MarginRight="6"
                         MarginBottom="6"
                         IsChecked="{Binding LineBreaking, Converter={conv:EnumToBoolConverter}, ConverterParameter=Paragraph, Mode=TwoWay}"/>
        </WrapPanel>

        <!-- One column per built-in language: each text names its language, which picks the patterns. A word with
             nowhere to break ends its line in an ellipsis instead of covering the next column. -->
        <WrapPanel Orientation="Horizontal"
                   Margin="0,12,0,0"
                   LineBreaking="{Binding LineBreaking}">
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="Русский (ru)"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="RussianColumn"
                               Text="{Binding RussianSample}"
                               Language="ru"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="English (en-US)"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="EnglishColumn"
                               Text="{Binding EnglishSample}"
                               Language="en-US"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="Deutsch (de)"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="GermanColumn"
                               Text="{Binding GermanSample}"
                               Language="de"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="Français (fr)"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="FrenchColumn"
                               Text="{Binding FrenchSample}"
                               Language="fr"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="Español (es)"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="SpanishColumn"
                               Text="{Binding SpanishSample}"
                               Language="es"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>

            <!-- Right to left: lines start on the right, and justified, the last line stays there. -->
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="עברית (he)"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="HebrewColumn"
                               Text="{Binding HebrewSample}"
                               Language="he"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>

            <!-- Japanese breaks between any two characters but by the kinsoku rules: no line starts with a closing
                 bracket, a small kana or a full stop, and none ends with an opening bracket. -->
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="日本語 (ja)"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="JapaneseColumn"
                               Text="{Binding JapaneseSample}"
                               Language="ja"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>

            <!-- Soft hyphens written into words: such a word breaks only at them, the patterns break the others. -->
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="{Localize TextStrings.SoftHyphens}"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <Border Width="{Binding ColumnWidth}"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                    <TextBlock AutomationProperties.AutomationId="SoftHyphenColumn"
                               Text="{Binding SoftHyphenSample}"
                               Language="en-US"
                               TextWrapping="WrapByWords"
                               TextTrimming="CharEllipses"
                               FontSize="18"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                </Border>
            </StackPanel>

            <!-- An editor wraps and hyphenates as it is typed in. -->
            <StackPanel Orientation="Vertical"
                        Margin="0,0,16,16">
                <TextBlock Text="{Localize TextStrings.HyphenationEditor}"
                           Opacity="0.7"
                           Margin="0,0,0,4"/>
                <TextBox AutomationProperties.AutomationId="HyphenationEditor"
                         Text="{Binding HyphenationEditable, Mode=TwoWay}"
                         Language="ru"
                         TextWrapping="WrapByWords"
                         AcceptsReturn="True"
                         FontSize="18"
                         Width="{Binding ColumnWidth}"
                         HorizontalAlignment="Left"
                         HorizontalTextAlignment="{Binding ColumnAlignment}"/>
            </StackPanel>
        </WrapPanel>

        <!-- Drop caps: the first letter across three lines in the text's own face, and a decorative initial across four. -->
        <TextBlock Text="{Localize TextStrings.DropCapsTitle}"
                   Margin="0,8,0,8"/>
        <WrapPanel Orientation="Horizontal">
            <Border Width="420"
                    Padding="6"
                    Margin="0,0,16,16"
                    VerticalAlignment="Top"
                    BorderThickness="1"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <TextBlock AutomationProperties.AutomationId="DropCapText"
                           Text="{Binding ProseSample}"
                           Language="en-US"
                           DropCapLines="3"
                           TextWrapping="WrapByWords"
                           FontSize="18"
                           HorizontalTextAlignment="{Binding ColumnAlignment}"/>
            </Border>
            <Border Width="420"
                    Padding="6"
                    Margin="0,0,16,16"
                    VerticalAlignment="Top"
                    BorderThickness="1"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <TextBlock AutomationProperties.AutomationId="InitialText"
                           Text="{Binding GospelSample}"
                           Language="ru"
                           DropCapLines="4"
                           DropCapFontFamily="{Binding InitialsFont}"
                           TextWrapping="WrapByWords"
                           FontSize="18"
                           HorizontalTextAlignment="{Binding ColumnAlignment}"/>
            </Border>
        </WrapPanel>

        <!-- Frames: the text in three columns, balanced when the block has no height, and flowing around a picture. -->
        <TextBlock Text="{Localize TextStrings.FramesTitle}"
                   Margin="0,8,0,8"/>
        <WrapPanel Orientation="Horizontal">
            <Border Width="660"
                    Padding="6"
                    Margin="0,0,16,16"
                    VerticalAlignment="Top"
                    BorderThickness="1"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <TextBlock AutomationProperties.AutomationId="ColumnsText"
                           Text="{Binding ProseSample}"
                           Language="en-US"
                           Columns="3"
                           ColumnGap="20"
                           TextWrapping="WrapByWords"
                           FontSize="16"
                           HorizontalTextAlignment="{Binding ColumnAlignment}"/>
            </Border>
            <Border Width="420"
                    Padding="6"
                    Margin="0,0,16,16"
                    VerticalAlignment="Top"
                    BorderThickness="1"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <Grid>
                    <TextBlock AutomationProperties.AutomationId="WrapText"
                               Text="{Binding ProseSample}"
                               Language="en-US"
                               Exclusions="0,0,200,162"
                               TextWrapping="WrapByWords"
                               FontSize="16"
                               HorizontalTextAlignment="{Binding ColumnAlignment}"/>
                    <Image Source="Textures/luxfon.tga"
                           Width="188"
                           Height="150"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </WrapPanel>

        <!-- Tab stops: page numbers right-aligned behind dot leaders, prices lined up on the decimal point. -->
        <TextBlock Text="{Localize TextStrings.TabsTitle}"
                   Margin="0,8,0,8"/>
        <WrapPanel Orientation="Horizontal">
            <Border Width="360"
                    Padding="6"
                    Margin="0,0,16,16"
                    VerticalAlignment="Top"
                    BorderThickness="1"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <TextBlock AutomationProperties.AutomationId="ContentsTabs"
                           Text="{Binding ContentsSample}"
                           TabStops="340 Right Leader=."
                           FontSize="18"/>
            </Border>
            <Border Width="260"
                    Padding="6"
                    Margin="0,0,16,16"
                    VerticalAlignment="Top"
                    BorderThickness="1"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <TextBlock AutomationProperties.AutomationId="PriceTabs"
                           Text="{Binding PricesSample}"
                           TabStops="200 Decimal"
                           FontSize="18"/>
            </Border>
        </WrapPanel>
    </StackPanel>
</View>
