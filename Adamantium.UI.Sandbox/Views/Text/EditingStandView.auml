<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- Navigated into the text tab's region under the key "Editing"; the DataContext is the tab's own view-model. -->
    <StackPanel Orientation="Vertical">
        <!-- Live toggle for the floating-label (watermark) effect. Off = a plain static watermark (shown only when the
             field is empty). -->
        <ToggleSwitch Content="{Localize TextStrings.FloatingWatermark}" IsChecked="{Binding FloatingWatermark, Mode=TwoWay}"
                      HorizontalAlignment="Left"/>

        <!-- Editable TextBox: two-way bound to the SAME Message the basics page shows. -->
        <TextBlock Text="{Localize TextStrings.Editable}" Margin="0,12,0,6"/>
        <TextBox AutomationProperties.AutomationId="Message" Text="{Binding Message, Mode=TwoWay}"
                 Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.Message}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <!-- Floating placeholder from empty: the label rests inside the field and animates up + shrinks on focus/typing. -->
        <TextBlock Text="{Localize TextStrings.FloatingTitle}" Margin="0,16,0,6"/>
        <TextBox Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.YourName}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <TextBlock x:Name="ReadOnlyLabel" Text="{Localize TextStrings.ReadOnly}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="ReadOnlyMessage" AutomationProperties.LabeledBy="{Binding ElementName=ReadOnlyLabel}"
                 Text="{Binding Message}" IsReadOnly="True"
                 Width="520" HorizontalAlignment="Left"/>

        <!-- Multi-line editor: AcceptsReturn (Enter inserts a newline), NO wrap so long lines scroll horizontally. Both bars
             are Auto - the horizontal one via the shared ScrollViewer.HorizontalScrollBarVisibility attached policy on the
             TextBox. Arrow keys navigate; selection spans rows. -->
        <TextBlock x:Name="NotesLabel" Text="{Localize TextStrings.MultiLine}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="Notes" AutomationProperties.LabeledBy="{Binding ElementName=NotesLabel}"
                 Text="{Binding Notes, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Width="520" Height="120" HorizontalAlignment="Left"/>
    </StackPanel>
</View>
