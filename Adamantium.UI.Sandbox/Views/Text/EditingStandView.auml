<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- Navigated into the text tab's region under the key "Editing"; the DataContext is the tab's own view-model. -->
    <StackPanel Orientation="Vertical">
        <!-- Live toggle for the floating-label (watermark) effect. Off = a plain static watermark (shown only when the
             field is empty). -->
        <ToggleSwitch Content="{Localize TextStrings.FloatingWatermark}" IsChecked="{Binding FloatingWatermark, Mode=TwoWay}"
                      HorizontalAlignment="Left"/>

        <!-- Editable TextBox: two-way bound to the SAME Message the basics page shows. -->
        <TextBlock Text="{Localize TextStrings.Editable}" Margin="0,12,0,6"/>
        <TextBox AutomationProperties.AutomationId="Message" Text="{Binding Message, Mode=TwoWay}"
                 Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.Message}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <!-- Floating placeholder from empty: the label rests inside the field and animates up + shrinks on focus/typing. -->
        <TextBlock Text="{Localize TextStrings.FloatingTitle}" Margin="0,16,0,6"/>
        <TextBox Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.YourName}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <!-- Character casing: what is typed or pasted goes in upper case, by the rules of the box's language. -->
        <TextBlock Text="{Localize TextStrings.UpperCaseTitle}"
                   Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="UpperCase"
                 CharacterCasing="Upper"
                 Width="520"
                 HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.UpperCaseHint}"/>

        <!-- Text transform: the message above, in the case the buttons choose - bound, so the box and the label follow
             a switch at once; what is typed here reaches the message as typed. -->
        <TextBlock Text="{Localize TextStrings.TextTransformTitle}"
                   Margin="0,16,0,6"/>
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,6">
            <RadioButton AutomationProperties.AutomationId="ShownAsIs"
                         Classes="Toggle"
                         GroupName="ShownCase"
                         MarginRight="6"
                         Content="{Localize TextStrings.ShownAsIs}"
                         IsChecked="{Binding ShownCase, Converter={conv:EnumToBoolConverter}, ConverterParameter=None, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="ShownUppercase"
                         Classes="Toggle"
                         GroupName="ShownCase"
                         MarginRight="6"
                         Content="{Localize TextStrings.ShownUppercase}"
                         IsChecked="{Binding ShownCase, Converter={conv:EnumToBoolConverter}, ConverterParameter=Uppercase, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="ShownLowercase"
                         Classes="Toggle"
                         GroupName="ShownCase"
                         Content="{Localize TextStrings.ShownLowercase}"
                         IsChecked="{Binding ShownCase, Converter={conv:EnumToBoolConverter}, ConverterParameter=Lowercase, Mode=TwoWay}"/>
        </StackPanel>
        <TextBox AutomationProperties.AutomationId="ShownUpper"
                 Text="{Binding Message, Mode=TwoWay}"
                 TextTransform="{Binding ShownCase}"
                 Width="520"
                 HorizontalAlignment="Left"/>
        <TextBlock AutomationProperties.AutomationId="ShownLabel"
                   Text="{Binding Message}"
                   TextTransform="{Binding ShownCase}"
                   Margin="0,6,0,0"/>

        <!-- Spelling, tabs and lines: misspelled words get a wavy line and the menu offers corrections; Tab types a tab;
             the box is three lines tall at least and six at most, then it scrolls. English, whatever the app's language. -->
        <TextBlock Text="{Localize TextStrings.SpellingTitle}"
                   Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="Draft"
                 Text="{Binding Draft, Mode=TwoWay}"
                 SpellCheck.IsEnabled="True"
                 Language="en-US"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="WrapByWords"
                 MinLines="3"
                 MaxLines="6"
                 Width="520"
                 HorizontalAlignment="Left"/>

        <!-- Password boxes: both bound two-way to the same Password, so typing in one shows in the other. -->
        <TextBlock Text="{Localize TextStrings.PasswordTitle}" Margin="0,16,0,6"/>
        <PasswordBox AutomationProperties.AutomationId="Password" Password="{Binding Password, Mode=TwoWay}"
                     Width="520" HorizontalAlignment="Left"
                     Placeholder="{Localize TextStrings.Password}" FloatingPlaceholder="{Binding FloatingWatermark}"/>
        <TextBlock Text="{Localize TextStrings.PasswordToggleTitle}" Margin="0,12,0,6"/>
        <PasswordBox AutomationProperties.AutomationId="PasswordToggle" Password="{Binding Password, Mode=TwoWay}"
                     PasswordRevealMode="Toggle"
                     Width="520" HorizontalAlignment="Left"
                     Placeholder="{Localize TextStrings.Password}"/>
        <TextBlock Text="{Localize TextStrings.PasswordBound, count={Binding PasswordLength}}" Margin="0,6,0,0"
                   Foreground="{ResourceReference TextFillColorSecondary}"/>

        <TextBlock x:Name="ReadOnlyLabel" Text="{Localize TextStrings.ReadOnly}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="ReadOnlyMessage" AutomationProperties.LabeledBy="{Binding ElementName=ReadOnlyLabel}"
                 Text="{Binding Message}" IsReadOnly="True"
                 Width="520" HorizontalAlignment="Left"/>

        <!-- Multi-line editor: AcceptsReturn (Enter inserts a newline), NO wrap so long lines scroll horizontally. Both bars
             are Auto - the horizontal one via the shared ScrollViewer.HorizontalScrollBarVisibility attached policy on the
             TextBox. Arrow keys navigate; selection spans rows. -->
        <TextBlock x:Name="NotesLabel" Text="{Localize TextStrings.MultiLine}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="Notes" AutomationProperties.LabeledBy="{Binding ElementName=NotesLabel}"
                 Text="{Binding Notes, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Width="520" Height="120" HorizontalAlignment="Left"/>
    </StackPanel>
</View>
