<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters"
      xmlns:val="clr-namespace:Adamantium.UI.Sandbox.Validation">
    <!-- A column stands in the grid's LOGICAL tree, so everything on it binds like anything else: its value against the
         row's item, its list of choices against this page's view-model. -->
    <!-- The table on the left, its settings in a panel of their own on the right - they never overlap, and the switches
         stop being a heap along the bottom. -->
    <Grid ColumnDefinitions="*,Auto" Margin="16">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,16,0">

        <TextBlock x:Name="TableHeading" Grid.Row="0" Text="TreeDataGrid" FontSize="18"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,10" TextWrapping="WrapByWords"
                   Foreground="{ObservableResource TextFillColorSecondary}"
                   Text="{Localize GridPageStrings.Intro}"/>

        <!-- The tint comes from the picker below by ELEMENT, not through the view-model: the swatch's brush is the one
             live object and both the button and the table paint from it. -->
        <TreeDataGrid Grid.Row="2" x:Name="Table" AutomationProperties.LabeledBy="{Binding ElementName=TableHeading}"
                      ItemsSource="{Binding TreeSource}"
                      ChildrenPath="{Binding TreeChildrenPath}"
                      KeyPath="{Binding TreeKeyPath}"
                      ParentKeyPath="{Binding TreeParentKeyPath}"
                      GridLinesVisibility="{Binding GridLines}"
                      ShowRowNumbers="{Binding ShowRowNumbers}"
                      SelectionUnit="{Binding SelectionUnit}"
                      AlternationCount="{Binding AlternationCount}"
                      AlternationBrush="{Binding SelectedBrush, ElementName=TintPicker}"
                      ShowGroupPanel="{Binding ShowGroupPanel}"
                      ShowSortPanel="{Binding ShowSortPanel}"
                      ShowSearchPanel="{Binding ShowSearchPanel}"
                      CanUserChooseColumns="{Binding CanChooseColumns}"
                      CanUserFilterColumns="{Binding CanFilterColumns}"
                      ShowNewItemRow="{Binding ShowNewItemRow}"
                      NewRowHint="{Localize GridPageStrings.NewAssembly}"
                      SearchMatchBrush="{Binding SearchMatchBrush}"
                      SearchCurrentMatchBrush="{Binding SearchCurrentMatchBrush}"
                      ValidationErrorBrush="{Binding ValidationErrorBrush}"
                      ValidationMode="{Binding ValidationMode}"
                      RowDetailsHeight="120"
                      Indent="16"
                      ExpanderColumnIndex="2">
            <!-- The record's LONG FORM, opened by the handle in the column ahead of everything. It is a row of the same
                 flat list, so ten thousand records with three panels open build three panels - and the template is the
                 page's own, bound against the record like any other. -->
            <TreeDataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="8"
                            CornerRadius="{ResourceReference CornerRadiusSmall}"
                            Background="{ObservableResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                            BorderThickness="1">
                        <!-- THREE TABS OF THREE HEIGHTS, on purpose: the panel is as tall as what is in it, so switching
                             a tab re-measures it and the rows below move. That is the case a fixed height cannot show. -->
                        <TabControl>
                            <TabItem Header="{Localize GridPageStrings.Details}">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Localize GridPageStrings.Name}" Margin="0,0,16,4"
                                               Foreground="{ObservableResource TextFillColorSecondary}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Localize GridPageStrings.Owner}" Margin="0,0,16,4"
                                               Foreground="{ObservableResource TextFillColorSecondary}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Owner}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Localize GridPageStrings.Region}" Margin="0,0,16,4"
                                               Foreground="{ObservableResource TextFillColorSecondary}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Region}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Localize GridPageStrings.Checksum}" Margin="0,0,16,0"
                                               Foreground="{ObservableResource TextFillColorSecondary}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Checksum}"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{Localize GridPageStrings.Note}">
                                <TextBlock Margin="4" TextWrapping="WrapByWords"
                                           Text="{Binding Name}"/>
                            </TabItem>
                            <TabItem Header="{Localize GridPageStrings.Chart}">
                                <StackPanel Orientation="Horizontal" Margin="4" Spacing="6" VerticalAlignment="Bottom">
                                    <Border Width="26" Height="150" Background="{ThemeResource AccentFillColorDefault}"/>
                                    <Border Width="26" Height="90" Background="{ThemeResource AccentFillColorDefault}"/>
                                    <Border Width="26" Height="210" Background="{ThemeResource AccentFillColorDefault}"/>
                                    <Border Width="26" Height="120" Background="{ThemeResource AccentFillColorDefault}"/>
                                    <Border Width="26" Height="60" Background="{ThemeResource AccentFillColorDefault}"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </DataTemplate>
            </TreeDataGrid.RowDetailsTemplate>

            <!-- A rule over the whole RECORD: neither "done" nor "error" is a wrong value on its own, only the pair is,
                 so the mark goes on the row and on none of its cells. -->
            <TreeDataGrid.RowValidationRule>
                <val:FinishedIsNotAnErrorRule/>
            </TreeDataGrid.RowValidationRule>

            <!-- EVERY column type, so each one's editor can be seen: text, drop-down, check box and a fully templated
                 one. Double-click any cell (or press F2) to open its editor. -->
            <TreeDataGrid.Columns>
                <!-- ONE CELL refuses an edit its column allows: a finished record keeps the code it was filed under.
                     The refusal is an ordinary binding, read off the row. -->
                <!-- FrozenSide is an ordinary bindable property of the column, and the column stands in the grid's
                     logical tree - so a check box on this page pins it with no code behind anything. -->
                <!-- Aggregate is a property OF THE COLUMN, so the strip of totals and a group's header both read the
                     same statement of what this column adds up to. -->
                <DataGridTextColumn Header="{Localize GridPageStrings.Code}" Binding="{Binding Code}" Width="110" SortMemberPath="Code"
                                    CanUserHide="False"
                                    IsReadOnlyBinding="{Binding IsLocked}"
                                    FrozenSide="{Binding CodeSide}"
                                    Aggregate="{Binding CodeAggregate}"
                                    AggregateFormat="{Localize GridPageStrings.RowsTotal}"/>

                <!-- The choices come straight from the view-model - the column binds to it like any element would. -->
                <DataGridDropDownColumn Header="{Localize GridPageStrings.Owner}" Binding="{Binding Owner}" Width="100" SortMemberPath="Owner"
                                        ItemsSource="{Binding OwnerChoices}"/>

                <!-- The carrier is named by the grid's ExpanderColumnIndex above, not by a flag here: "exactly one of
                     these" cannot be said with a boolean per column without admitting two of them claiming it. -->
                <DataGridTextColumn Header="{Localize GridPageStrings.Name}" Binding="{Binding Name}" Width="320" SortMemberPath="Name" MinWidth="160"/>

                <DataGridCheckBoxColumn Header="{Localize GridPageStrings.Done}" Binding="{Binding Done}" Width="60" SortMemberPath="Done"/>

                <!-- ...and the format is the column's too, chosen by the function it writes: a fixed "Σ {0:N0}" went on
                     saying Σ over an average. -->
                <!-- VALIDATION by a rule on the column: the generated sizes run 251..9139, so some of them are outside
                     what this page accepts and are washed the moment the table is shown - no edit required. The limits
                     are BOUND, so moving them repaints the table live. -->
                <DataGridTextColumn Header="{Localize GridPageStrings.Size}" Binding="{Binding Size}" Width="80" SortMemberPath="Size"
                                    Aggregate="{Binding SizeAggregate}"
                                    AggregateFormat="{Localize GridPageStrings.SizeTotal, function={Binding SizeAggregate}}">
                    <DataGridTextColumn.ValidationRule>
                        <val:RangeRule Min="{Binding SizeFloor}" Max="{Binding SizeCeiling}"/>
                    </DataGridTextColumn.ValidationRule>
                    <!-- CONDITIONAL FORMATTING on the same column, and the two are different questions: the rule above
                         says the value is not ACCEPTABLE, this one says what an acceptable value MEANS. It answers
                         "Warning" and the theme decides that is amber. -->
                    <DataGridTextColumn.StateRule>
                        <val:AboveThresholdRule Threshold="{Binding SizeWarnAbove}"/>
                    </DataGridTextColumn.StateRule>
                </DataGridTextColumn>

                <!-- Read-only BY THE COLUMN, which is the other way to refuse an edit: Code refuses one cell at a time
                     instead. Both are honored by the same BeginEdit. -->
                <DataGridTextColumn Header="{Localize GridPageStrings.Checksum}" Binding="{Binding Checksum}" Width="120" IsReadOnly="True"/>

                <!-- From here on the columns exist to overflow the viewport: scroll sideways and only the columns in
                     view carry cells (the header strip follows the same offset). -->
                <!-- A column pinned from the MIDDLE of the table: the pinned zone is a place in the layout, not a
                     prefix of the declaration, so this one leaves its neighbors and joins the left zone. -->
                <DataGridTextColumn Header="{Localize GridPageStrings.Region}" Binding="{Binding Region}" Width="110" SortMemberPath="Region"
                                    FrozenSide="{Binding RegionSide}"/>
                <DataGridTextColumn Header="{Localize GridPageStrings.Batch}" Binding="{Binding Batch}" Width="90" SortMemberPath="Batch"/>
                <DataGridTextColumn Header="{Localize GridPageStrings.Revision}" Binding="{Binding Revision}" Width="90" SortMemberPath="Revision"/>
                <DataGridTextColumn Header="{Localize GridPageStrings.Line}" Binding="{Binding Line}" Width="90" SortMemberPath="Line"/>
                <DataGridTextColumn Header="{Localize GridPageStrings.Shift}" Binding="{Binding Shift}" Width="80" SortMemberPath="Shift"/>
                <DataGridTextColumn Header="{Localize GridPageStrings.Updated}" Binding="{Binding Updated}" Width="110" SortMemberPath="Updated"/>

                <!-- A template column owns both looks. Its cell holds the ROW, so the templates bind to its members and
                     the editor writes straight through. Its cells still carry a MEANING - the model says "Error", the
                     theme decides what that looks like. -->
                <DataGridTemplateColumn Header="{Localize GridPageStrings.Status}" Width="110" SortMemberPath="Status"
                                        FrozenSide="{Binding StatusSide}"
                                        StateBinding="{Binding StatusState}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8 0" HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ObservableResource ControlFillColorSecondary}">
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Status, Mode=TwoWay}" BorderThickness="0" Padding="0"
                                     MinWidth="0" MinHeight="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </TreeDataGrid.Columns>
        </TreeDataGrid>

    </Grid>

    <Border Grid.Column="1" Width="250"
            Background="{ObservableResource CardBackgroundFillColorDefault}"
            BorderBrush="{ObservableResource ControlStrokeColorDefault}"
            BorderThickness="1" CornerRadius="4" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Localize GridPageStrings.Settings}" FontSize="15" Margin="0,0,0,10"/>

                <TextBlock Text="{Localize GridPageStrings.Columns}" FontSize="11" Margin="0,4,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- Offers the handle at the right end of the header band; the flyout behind it is where the choosing
                     happens. Code is not in it: a table of records nobody can identify is not a table, so that column
                     says CanUserHide="False". -->
                <CheckBox Content="{Localize GridPageStrings.ChooseColumns}" Margin="0,0,0,6"
                          IsChecked="{Binding CanChooseColumns, Mode=TwoWay}"/>
                <!-- Every funnel at once, instead of saying CanUserFilter="False" on each column in turn. Switching it
                     off also CLEARS what the funnels set: a table left narrowed with no way to see why is worse than
                     one that cannot be narrowed at all. -->
                <CheckBox Content="{Localize GridPageStrings.FilterColumns}" Margin="0,0,0,6"
                          IsChecked="{Binding CanFilterColumns, Mode=TwoWay}"/>
                <!-- The blank row at the very bottom. Scroll to the end, type into it, press Enter - the record is made
                     THEN, not a keystroke earlier, so Escape leaves nothing behind. -->
                <CheckBox Content="{Localize GridPageStrings.NewRecordRow}" Margin="0,0,0,6"
                          IsChecked="{Binding ShowNewItemRow, Mode=TwoWay}"/>
                <!-- The arrangement written to a FILE and read back - what makes choosing columns worth anything.
                     Hide a column, drag a header, widen one, pin one, sort by one; save; put it all back wrong;
                     restore. -->
                <Grid ColumnDefinitions="*,*" Margin="0,0,0,4">
                    <Button Grid.Column="0" Content="{Localize GridPageStrings.SaveLayout}" Margin="0,0,4,0"
                            Command="{Binding SaveLayoutCommand}"
                            CommandParameter="{Binding ElementName=Table}"/>
                    <Button Grid.Column="1" Content="{Localize GridPageStrings.Restore}"
                            Command="{Binding RestoreLayoutCommand}"
                            CommandParameter="{Binding ElementName=Table}"/>
                </Grid>
                <TextBlock Text="{Localize GridPageStrings.Layout, action={Binding LayoutAction}, bytes={Localize GridPageStrings.Bytes, count={Binding LayoutAmount}}, columns={Localize GridPageStrings.ColumnCount, count={Binding LayoutAmount}}}"
                           FontSize="11" Margin="0,0,0,8"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>

                <!-- The same acts Ctrl+Z and Ctrl+Y reach; the buttons exist because a demo has to be able to SHOW
                     them. Edit a cell, paste a block, delete a row, add one through the placeholder - each is one act
                     and comes back whole. -->
                <TextBlock Text="{Localize GridPageStrings.History}" FontSize="11" Margin="0,4,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <Grid ColumnDefinitions="*,*" Margin="0,0,0,4">
                    <Button Grid.Column="0" Content="{Localize GridPageStrings.Undo}" Margin="0,0,4,0"
                            Command="{Binding UndoEditCommand}"
                            CommandParameter="{Binding ElementName=Table}"/>
                    <Button Grid.Column="1" Content="{Localize GridPageStrings.Redo}"
                            Command="{Binding RedoEditCommand}"
                            CommandParameter="{Binding ElementName=Table}"/>
                </Grid>
                <TextBlock Text="{Localize GridPageStrings.Step, step={Binding HistoryStep}, behind={Localize GridPageStrings.Behind, more={Binding MoreBehind}}, ahead={Localize GridPageStrings.Ahead, one={Binding OneAhead}}}"
                           FontSize="11" Margin="0,0,0,8" TextWrapping="WrapByWords"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>

                <TextBlock Text="{Localize GridPageStrings.Export}" FontSize="11" Margin="0,4,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- What goes out is what is on screen - the visible columns in their order, the rows filtered and
                     sorted, and the whole depth of the tree whatever is folded. Group first and both files still carry
                     the grouped column: on screen its value is in the captions, and a file has no captions. -->
                <Grid ColumnDefinitions="*,*" Margin="0,0,0,4">
                    <Button Grid.Column="0" Content="{Localize GridPageStrings.ExportCsv}" Margin="0,0,4,0"
                            Command="{Binding ExportCsvCommand}"
                            CommandParameter="{Binding ElementName=Table}"/>
                    <Button Grid.Column="1" Content="{Localize GridPageStrings.ExportXlsx}"
                            Command="{Binding ExportXlsxCommand}"
                            CommandParameter="{Binding ElementName=Table}"/>
                </Grid>
                <TextBlock Text="{Localize GridPageStrings.Exported, state={Binding ExportState}, path={Binding ExportPath}}"
                           FontSize="11" Margin="0,0,0,8" TextWrapping="WrapByWords"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- Three pins, one on each kind of column: the first, one from the MIDDLE, and one pinned to the
                     other EDGE. A pinned column leaves its neighbors and joins the zone at its side. -->
                <CheckBox Content="{Localize GridPageStrings.PinCode}" Margin="0,0,0,6"
                          IsChecked="{Binding PinCode, Mode=TwoWay}"/>
                <CheckBox Content="{Localize GridPageStrings.PinRegion}" Margin="0,0,0,6"
                          IsChecked="{Binding PinRegion, Mode=TwoWay}"/>
                <CheckBox Content="{Localize GridPageStrings.PinStatus}" Margin="0,0,0,6"
                          IsChecked="{Binding PinStatus, Mode=TwoWay}"/>

                <TextBlock Text="{Localize GridPageStrings.Search}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- The strip runs the search on Enter and on its button, not per keystroke: one pass reads every
                     shown column of every row. The arrows step through what it found, opening whatever holds it. -->
                <CheckBox Content="{Localize GridPageStrings.SearchPanel}" Margin="0,0,0,4"
                          IsChecked="{Binding ShowSearchPanel, Mode=TwoWay}"/>
                <TextBlock Text="{Localize GridPageStrings.SearchHint}"
                           FontSize="11" Margin="0,0,0,8" TextWrapping="WrapByWords"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>

                <!-- Unchecked, the theme's match colors apply; checked, the page's own. Unchecking must reach built cells
                     too. Swatches stay enabled, having no disabled look. -->
                <CheckBox Content="{Localize GridPageStrings.OwnMatchColors}" Margin="0,0,0,6"
                          IsChecked="{Binding OwnSearchColors, Mode=TwoWay}"/>
                <!-- SAID SEPARATELY, each with its own name. Side by side and unlabeled they read as one setting, and
                     the first search shows exactly ONE washed cell - the current one - so touching the other swatch
                     changed nothing anybody could see and the whole thing read as broken. -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                    <ColorPickerButton Grid.Row="0" Grid.Column="0" Width="72" Height="24" Margin="0,0,8,4"
                                       SelectedColor="{Binding SearchMatchColor, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Localize GridPageStrings.EveryMatch}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <ColorPickerButton Grid.Row="1" Grid.Column="0" Width="72" Height="24" Margin="0,0,8,0"
                                       SelectedColor="{Binding SearchCurrentColor, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Localize GridPageStrings.CurrentMatch}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Localize GridPageStrings.AlphaHint}"
                           FontSize="11" Margin="0,0,0,8" TextWrapping="WrapByWords"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>

                <TextBlock Text="{Localize GridPageStrings.Validation}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- TWO SOURCES on this page at once: the Size column carries a rule with the limits below, and the
                     record itself reports an error on its Status - the grid asks both and paints the cell either way. -->
                <TextBlock Text="{Localize GridPageStrings.ValidationHint}"
                           FontSize="11" Margin="0,0,0,6" TextWrapping="WrapByWords"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- The third source, and the only one no cell can answer: a record marked done AND filed as an error
                     contradicts itself, so the whole ROW is washed. Tick a Done box on an error row to see it. -->
                <!-- And what the table does with a value it refuses. Off: take it and mark it. On: keep the editor and
                     say why - try typing 99999 into Size. -->
                <CheckBox Content="{Localize GridPageStrings.RefuseInvalid}" Margin="0,0,0,6"
                          IsChecked="{Binding BlockOnInvalid, Mode=TwoWay}"/>
                <!-- One above the other: side by side, two spinners and their labels do not fit this panel and the
                     second one loses its buttons off the edge. -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Localize GridPageStrings.From}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                   Value="{Binding SizeFloor, Mode=TwoWay}" Minimum="0" Maximum="10000"
                                   SmallChange="250" SnapsToSmallChange="true" StringFormat="N0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Localize GridPageStrings.To}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding SizeCeiling, Mode=TwoWay}" Minimum="0" Maximum="10000"
                                   SmallChange="250" SnapsToSmallChange="true" StringFormat="N0"/>
                </Grid>
                <!-- A DIFFERENT question from the two above: those say what is allowed, this says what an allowed value
                     MEANS. The rule answers "Warning" and the theme paints it amber - drag this and watch the column
                     repaint live. -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{Localize GridPageStrings.WarnAbove}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding SizeWarnAbove, Mode=TwoWay}" Minimum="0" Maximum="10000"
                                   SmallChange="250" SnapsToSmallChange="true" StringFormat="N0"/>
                </Grid>
                <CheckBox Content="{Localize GridPageStrings.OwnErrorColor}" Margin="0,0,0,6"
                          IsChecked="{Binding OwnValidationColor, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <ColorPickerButton Grid.Column="0" Width="72" Height="24" Margin="0,0,8,0"
                                       SelectedColor="{Binding ValidationErrorColor, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" Text="{Localize GridPageStrings.RejectedValue}" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Localize GridPageStrings.Grouping}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- With the strip on, drag any column header UP into it to group by that column; click a chip there to
                     take the column back out. Groups nest in the order the chips stand in. -->
                <CheckBox Content="{Localize GridPageStrings.GroupingPanel}" Margin="0,0,0,6"
                          IsChecked="{Binding ShowGroupPanel, Mode=TwoWay}"/>

                <TextBlock Text="{Localize GridPageStrings.Tree}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- The SAME records and the same parentage, described the two ways the control accepts: records
                     holding their children, or a flat list joined on keys - the shape a database hands over. The rows
                     on screen must come out identical; that is what makes this a test and not an illustration. -->
                <CheckBox Content="{Localize GridPageStrings.TreeFromKeys}" Margin="0,0,0,4"
                          IsChecked="{Binding TreeFromKeys, Mode=TwoWay}"/>
                <!-- The only thing that CHANGES on screen, and the thing that proves it: hand the table twelve
                     thousand flat records and it still shows ten thousand rows with branches. -->
                <TextBlock Text="{Localize GridPageStrings.TreeSource, keys={Binding TreeFromKeys}, records={Localize GridPageStrings.Records, count={Binding RecordCount}}}"
                           FontSize="11" Margin="0,0,0,6" TextWrapping="WrapByWords"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>

                <TextBlock Text="{Localize GridPageStrings.Sorting}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <!-- A click on a header still sorts by that ONE column. The strip is how a table is sorted by several:
                     drag a header into it to add a key, press a chip to turn it around, drag one to change which key
                     decides. From the second key on, each header also says which key it is. -->
                <CheckBox Content="{Localize GridPageStrings.SortingPanel}" Margin="0,0,0,6"
                          IsChecked="{Binding ShowSortPanel, Mode=TwoWay}"/>

                <TextBlock Text="{Localize GridPageStrings.Totals}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <TextBlock x:Name="SizeColumnLabel" Text="{Localize GridPageStrings.SizeColumn}" Margin="0,0,0,4"/>
                <DropDown AutomationProperties.LabeledBy="{Binding ElementName=SizeColumnLabel}" Margin="0,0,0,6"
                          ItemsSource="{Binding AggregateChoices}"
                          SelectedItem="{Binding SizeAggregate, Mode=TwoWay}">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize GridPageStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                </DropDown>
                <CheckBox Content="{Localize GridPageStrings.CountRows}" Margin="0,0,0,4"
                          IsChecked="{Binding CountRows, Mode=TwoWay}"/>
                <TextBlock Text="{Localize GridPageStrings.TotalsHint}" FontSize="11"
                           Margin="0,0,0,8" TextWrapping="WrapByWords"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>

                <TextBlock Text="{Localize GridPageStrings.Rows}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <CheckBox Content="{Localize GridPageStrings.RowNumbers}" Margin="0,0,0,8"
                          IsChecked="{Binding ShowRowNumbers, Mode=TwoWay}"/>

                <TextBlock x:Name="TintEveryLabel" Text="{Localize GridPageStrings.TintEvery}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.LabeledBy="{Binding ElementName=TintEveryLabel}" InputMode="Integers" Minimum="0" Maximum="4" SmallChange="1" Margin="0,0,0,4"
                               Value="{Binding AlternationCount, Mode=TwoWay}"/>
                <TextBlock Text="{Localize GridPageStrings.TintHint}" FontSize="11" Margin="0,0,0,8"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>

                <TextBlock x:Name="TintColorLabel" Text="{Localize GridPageStrings.TintColor}" Margin="0,0,0,4"/>
                <ColorPickerButton x:Name="TintPicker" AutomationProperties.LabeledBy="{Binding ElementName=TintColorLabel}" Width="72" Height="24" HorizontalAlignment="Left"
                                   Margin="0,0,0,8" SelectedColor="#332F6FED"/>

                <TextBlock Text="{Localize GridPageStrings.Look}" FontSize="11" Margin="0,10,0,6"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <TextBlock x:Name="GridLinesLabel" Text="{Localize GridPageStrings.GridLines}" Margin="0,0,0,4"/>
                <DropDown AutomationProperties.LabeledBy="{Binding ElementName=GridLinesLabel}" Margin="0,0,0,8"
                          ItemsSource="{Binding GridLineChoices}"
                          SelectedItem="{Binding GridLines, Mode=TwoWay}">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize GridPageStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                </DropDown>

                <!-- What a click takes. In FullRow the press, the drag and the arrows all take rows - one funnel
                     answers for the mode, so they cannot disagree. -->
                <TextBlock x:Name="SelectionUnitLabel" Text="{Localize GridPageStrings.SelectionUnit}" Margin="0,0,0,4"/>
                <DropDown AutomationProperties.LabeledBy="{Binding ElementName=SelectionUnitLabel}" Margin="0,0,0,8"
                          ItemsSource="{Binding SelectionUnitChoices}"
                          SelectedItem="{Binding SelectionUnit, Mode=TwoWay}">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize GridPageStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                </DropDown>

                <!-- Whether the table is in edit is an ordinary bindable property, so a view-model (or, as here,
                     another element) can hold a toolbar or postpone a refresh while a cell is open. -->
                <TextBlock Text="{Localize GridPageStrings.Editing}" Margin="0,10,0,0"
                           Foreground="{ObservableResource TextFillColorSecondary}"
                           Visibility="{Binding IsEditing, ElementName=Table, Converter={conv:BoolToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
    </Grid>
</View>
