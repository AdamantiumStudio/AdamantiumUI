<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- DataContext is the ScrollBarViewModel. Both standalone bars are bound to one Offset; the ScrollViewer below is a
         real physical scroll of an oversized image (its bars driven by the presenter's metrics) - the live check that the
         thumb tracks the content after the sub-pixel-coalescing scroll work. -->
    <StackPanel Orientation="Horizontal" Margin="24">
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="OneValueLabel" Text="{Localize ScrollBarStrings.OneValue}" FontSize="18" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal">
                <ScrollBar AutomationProperties.AutomationId="VerticalBar" AutomationProperties.LabeledBy="{Binding ElementName=OneValueLabel}"
                           Orientation="Vertical"
                           Height="200"
                           Minimum="0" Maximum="100" ViewportSize="10"
                           Value="{Binding Offset, Mode=TwoWay}"/>
                <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                    <ScrollBar AutomationProperties.AutomationId="HorizontalBar" AutomationProperties.LabeledBy="{Binding ElementName=OneValueLabel}"
                               Orientation="Horizontal"
                               Width="320"
                               Minimum="0" Maximum="100" ViewportSize="10"
                               Value="{Binding Offset, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="{Localize ScrollBarStrings.Offset}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock AutomationProperties.AutomationId="OffsetText" Text="{Binding Offset}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="48,0,0,0">
            <TextBlock x:Name="DragToPanLabel" Text="{Localize ScrollBarStrings.DragToPan}" FontSize="18" Margin="0,0,0,12"/>
            <ScrollViewer AutomationProperties.AutomationId="Picture" AutomationProperties.LabeledBy="{Binding ElementName=DragToPanLabel}"
                          Width="520" Height="320"
                          PanningMode="Both" IsInertiaEnabled="true"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image Source="Textures/luxfon.tga"/>
            </ScrollViewer>
        </StackPanel>
    </StackPanel>
</View>
