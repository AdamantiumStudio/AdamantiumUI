<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:c="clr-namespace:Adamantium.UI.Controls;assembly=Adamantium.UI.Controls"
      xmlns:m="clr-namespace:Adamantium.UI.Core.Media;assembly=Adamantium.UI.Core"
      xmlns:i="clr-namespace:Adamantium.UI.Core.Input;assembly=Adamantium.UI.Core">
    <!-- DataContext is the RangesViewModel. One shared Value binds a horizontal + vertical Slider, a linear ProgressBar
         and a RingProgressBar; two dropdowns drive the ring's arc start position and sweep direction.
         Scrolls vertically only: with the horizontal bar disabled the content is measured at the viewport WIDTH, so
         nothing here has to fit the window height for the ring section below to be reachable. -->
    <ScrollViewer AutomationProperties.AutomationId="RangesScroll" Margin="24"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical">

        <!-- Section 1: one shared value across a horizontal + vertical Slider and a linear ProgressBar. -->
        <TextBlock x:Name="OneValueLabel" Text="{Localize RangesStrings.OneValue}" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Slider AutomationProperties.AutomationId="ValueSlider" AutomationProperties.LabeledBy="{Binding ElementName=OneValueLabel}" Width="300"
                    Value="{Binding Value, Mode=TwoWay}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="true"
                    Maximum="{Binding Maximum}"
                    IsValueToolTipEnabled="true"
                    IsMoveToPointEnabled="true"/>
            <TextBlock AutomationProperties.AutomationId="ValueText" Text="{Binding Value}" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="ProgressLabel" Text="{Localize RangesStrings.Progress}" Margin="0,20,0,6"/>
        <ProgressBar AutomationProperties.AutomationId="Progress" AutomationProperties.LabeledBy="{Binding ElementName=ProgressLabel}" Width="300" Height="12" Value="{Binding Value}" Maximum="{Binding Maximum}" HorizontalAlignment="Left"/>

        <!-- A SPAN of the same scale: two handles that cannot cross, plus the band between them, which drags the whole
             span at once. MinimumRangeWidth keeps that band grabbable even when the span is squeezed to nothing. -->
        <TextBlock x:Name="RangeLabel" Text="{Localize RangesStrings.Range}" Margin="0,20,0,6"/>
        <!-- The upright one goes FIRST, before the readouts: a number whose width changes as it counts re-lays-out
             everything after it, and a control sitting there would twitch on every step of a drag.
             Snapping to whole units keeps both the values and that width steady. -->
        <StackPanel Orientation="Horizontal">
            <RangeSlider AutomationProperties.AutomationId="SpanUpright" AutomationProperties.LabeledBy="{Binding ElementName=RangeLabel}"
                         Orientation="Vertical" Height="150" Margin="0,0,40,0"
                         Minimum="0" Maximum="{Binding Maximum}"
                         MinimumRangeWidth="16"
                         BandThickness="8"
                         TickFrequency="1" 
                         IsSnapToTickEnabled="true"
                         IsValueToolTipEnabled="true"
                         LowerValue="{Binding SpanStart, Mode=TwoWay}"
                         UpperValue="{Binding SpanEnd, Mode=TwoWay}"/>
            <RangeSlider AutomationProperties.AutomationId="Span" AutomationProperties.LabeledBy="{Binding ElementName=RangeLabel}" Width="300"
                         Minimum="0"
                         Maximum="{Binding Maximum}"
                         MinimumRangeWidth="16"
                         TickFrequency="1" 
                         IsSnapToTickEnabled="true"
                         IsValueToolTipEnabled="true"
                         LowerValue="{Binding SpanStart, Mode=TwoWay}"
                         UpperValue="{Binding SpanEnd, Mode=TwoWay}"
                         VerticalAlignment="Center"/>
            <TextBlock AutomationProperties.AutomationId="SpanStartText" Text="{Binding SpanStart}" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
            <TextBlock Text=" .. " VerticalAlignment="Center" FontSize="16"/>
            <TextBlock AutomationProperties.AutomationId="SpanEndText" Text="{Binding SpanEnd}" VerticalAlignment="Center" FontSize="16"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <Slider AutomationProperties.AutomationId="ValueSliderUpright" AutomationProperties.LabeledBy="{Binding ElementName=OneValueLabel}"
                    Orientation="Vertical"
                    Height="170"
                    Value="{Binding Value, Mode=TwoWay}"
                    Maximum="{Binding Maximum}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="true"
                    IsValueToolTipEnabled="true"/>
            <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                <TextBlock x:Name="MaximumLabel" Text="{Localize RangesStrings.Maximum}"/>
                <Slider AutomationProperties.AutomationId="MaximumSlider" AutomationProperties.LabeledBy="{Binding ElementName=MaximumLabel}" Width="240"
                        Value="{Binding Maximum, Mode=TwoWay}"
                        Minimum="10" 
                        Maximum="200" 
                        TickFrequency="1"
                        IsSnapToTickEnabled="true"
                        IsValueToolTipEnabled="true"/>
                <Button AutomationProperties.AutomationId="ResetAll" Content="{Localize RangesStrings.ResetAll}" Command="{Binding ResetCommand}" MinWidth="130" Height="34"/>
            </StackPanel>
        </StackPanel>

        <!-- Section 2: the same value typed rather than dragged. All three placements stand side by side rather than
             hiding behind a dropdown - the point is to compare them - and ONE switch swaps the pair in every one of
             them at once, which is exactly why placement and order are two knobs and not one enum of six. -->
        <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,28,0,0"/>
        <TextBlock Text="{Localize RangesStrings.NumericTitle}" FontSize="18" Margin="0,24,0,10"/>
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock x:Name="SplitLabel" Text="{Localize RangesStrings.Split}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.AutomationId="NumericSplit" AutomationProperties.LabeledBy="{Binding ElementName=SplitLabel}"
                        Width="150" ButtonsPlacement="Split"
                        Value="{Binding Value, Mode=TwoWay}"
                        Minimum="0" Maximum="{Binding Maximum}"
                        AreButtonsSwapped="{Binding AreNumericButtonsSwapped}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock x:Name="LeftLabel" Text="{Localize RangesStrings.Left}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.AutomationId="NumericLeft" AutomationProperties.LabeledBy="{Binding ElementName=LeftLabel}"
                        Width="150" ButtonsPlacement="Left"
                        Value="{Binding Value, Mode=TwoWay}"
                        Minimum="0" Maximum="{Binding Maximum}"
                        AreButtonsSwapped="{Binding AreNumericButtonsSwapped}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,24,0">
                <TextBlock x:Name="RightLabel" Text="{Localize RangesStrings.Right}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.AutomationId="NumericRight" AutomationProperties.LabeledBy="{Binding ElementName=RightLabel}"
                        Width="150" ButtonsPlacement="Right"
                        Value="{Binding Value, Mode=TwoWay}"
                        Minimum="0" Maximum="{Binding Maximum}"
                        AreButtonsSwapped="{Binding AreNumericButtonsSwapped}"/>
            </StackPanel>
            <CheckBox AutomationProperties.AutomationId="SwapButtons" Content="{Localize RangesStrings.SwapButtons}" VerticalAlignment="Bottom"
                      IsChecked="{Binding AreNumericButtonsSwapped, Mode=TwoWay}"/>
        </StackPanel>

        <!-- The rest of the knobs, one box each, so what every one of them does is visible on its own. -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <!-- StringFormat, switchable: the same value written out five ways. Step 0.25 with snapping, so the digits
                 the format shows are digits the value actually has. -->
            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock x:Name="FormatLabel" Text="{Localize RangesStrings.StringFormat}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.AutomationId="Formatted" AutomationProperties.LabeledBy="{Binding ElementName=FormatLabel}"
                        Width="150" Minimum="0" Maximum="10" Value="2.5"
                        SmallChange="0.25" SnapsToSmallChange="true"
                        StringFormat="{Binding NumericFormat}"/>
                <DropDown AutomationProperties.AutomationId="FormatChoice" AutomationProperties.LabeledBy="{Binding ElementName=FormatLabel}"
                          Width="150" Margin="0,6,0,0"
                          ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding NumericFormat, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock x:Name="IntegersLabel" Text="{Localize RangesStrings.IntegersOnly}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.AutomationId="Integers" AutomationProperties.LabeledBy="{Binding ElementName=IntegersLabel}"
                        Width="150" Minimum="-50" Maximum="50" Value="7"
                        InputMode="Integers" StringFormat="N0"/>
            </StackPanel>
            <!-- The property-panel field: no buttons, and the number is dragged sideways to change it - the gesture a
                 3D tool puts on every numeric field. Shift for a tenth of a step, Ctrl for a page. -->
            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock x:Name="ScrubLabel" Text="{Localize RangesStrings.DragSideways}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.AutomationId="Scrub" AutomationProperties.LabeledBy="{Binding ElementName=ScrubLabel}"
                        Width="150" Minimum="0" Maximum="100" Value="30"
                        AreButtonsVisible="false"
                        IsDragScrubEnabled="true"
                        TracksMouseWheelWhenOver="true"
                        ScrubLeftCursor="{Binding ScrubLeftCursor}"
                        ScrubRightCursor="{Binding ScrubRightCursor}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="ReadOnlyLabel" Text="{Localize RangesStrings.ReadOnly}" Margin="0,0,0,4"/>
                <NumericUpDown AutomationProperties.AutomationId="ReadOnlyNumber" AutomationProperties.LabeledBy="{Binding ElementName=ReadOnlyLabel}"
                        Width="150" Minimum="0" Maximum="100" Value="42" IsReadOnly="true"/>
            </StackPanel>
        </StackPanel>

        <!-- The drag has a direction, so it has two pointers - pick either. The catalog ships no one-way pair yet, so
             both start on the plain double-headed arrow; a real .cur can be handed to the same properties in code. -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="CursorLeftLabel" Text="{Localize RangesStrings.DragCursorLeft}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DropDown AutomationProperties.AutomationId="CursorLeft" AutomationProperties.LabeledBy="{Binding ElementName=CursorLeftLabel}"
                      EnumType="{x:Type i:CursorType}" Width="150"
                      SelectedItem="{Binding ScrubLeftCursorType, Mode=TwoWay}"/>
            <TextBlock x:Name="CursorRightLabel" Text="{Localize RangesStrings.DragCursorRight}" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <DropDown AutomationProperties.AutomationId="CursorRight" AutomationProperties.LabeledBy="{Binding ElementName=CursorRightLabel}"
                      EnumType="{x:Type i:CursorType}" Width="150"
                      SelectedItem="{Binding ScrubRightCursorType, Mode=TwoWay}"/>
        </StackPanel>

        <!-- Section 3: the circular gauge, bound to the SAME value, with its arc start + sweep direction driven by two
             dropdowns. Kept in its own block so it reads as a distinct feature, not mixed into the linear controls. -->
        <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,28,0,0"/>
        <TextBlock x:Name="RingLabel" Text="{Localize RangesStrings.RingTitle}" FontSize="18" Margin="0,24,0,10"/>
        <StackPanel Orientation="Horizontal">
            <RingProgressBar AutomationProperties.AutomationId="Ring" AutomationProperties.LabeledBy="{Binding ElementName=RingLabel}"
                    Width="120" Height="120"
                    Value="{Binding Value}" Maximum="{Binding Maximum}"
                    ShowValueText="true" RingThickness="9"
                    StartPosition="{Binding StartPosition}"
                    Direction="{Binding Direction}"/>
            <StackPanel Orientation="Vertical" Margin="36,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="ArcStartLabel" Text="{Localize RangesStrings.ArcStart}" VerticalAlignment="Center" MinWidth="72" MarginRight="6"/>
                    <DropDown AutomationProperties.AutomationId="ArcStart" AutomationProperties.LabeledBy="{Binding ElementName=ArcStartLabel}"
                              EnumType="{x:Type c:RingStartPosition}" SelectedItem="{Binding StartPosition, Mode=TwoWay}" Width="150">
                        <DropDown.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Localize RangesStrings, Key={Binding}}"/>
                            </DataTemplate>
                        </DropDown.ItemTemplate>
                    </DropDown>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DirectionLabel" Text="{Localize RangesStrings.Direction}" VerticalAlignment="Center" MinWidth="72" MarginRight="6"/>
                    <DropDown AutomationProperties.AutomationId="Direction" AutomationProperties.LabeledBy="{Binding ElementName=DirectionLabel}"
                              EnumType="{x:Type m:SweepDirection}" SelectedItem="{Binding Direction, Mode=TwoWay}" Width="180">
                        <DropDown.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Localize RangesStrings, Key={Binding}}"/>
                            </DataTemplate>
                        </DropDown.ItemTemplate>
                    </DropDown>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</View>
