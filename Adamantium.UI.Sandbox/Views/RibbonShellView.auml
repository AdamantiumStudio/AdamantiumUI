                                      MaxSize="Medium"
                                      Icon="{ObservableResource ReliefNoiseIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Craters}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource CratersIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Ridges}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource RidgesIcon}"/>
                        <RibbonButton Classes="ModuleTool"
