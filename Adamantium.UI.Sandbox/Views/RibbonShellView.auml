<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters"
      xmlns:views="clr-namespace:Adamantium.UI.Sandbox.Views">
    <!-- A module as the menu and the catalog show it: its color, its words, where it stands. The data is the module
         itself, so one template serves the drop-down's rows and the catalog's cards. -->
    <ResourceContext.Resources>
        <!-- The question asked before a module leaves the document: what stays, what gets marked. -->
        <DataTemplate x:Key="DetachQuestion">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Localize RibbonShellStrings.DetachTitle}"
                           FontSize="15"/>
                <TextBlock Text="{Localize RibbonShellStrings.DetachText}"
                           TextWrapping="WrapByWords"
                           Margin="0 8 0 0"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto"
                      Margin="0 10 0 0">
                    <TextBlock Text="{Localize RibbonShellStrings.StaysInFile}"
                               FontSize="12"
                               Margin="0 0 12 4"
                               Foreground="{ResourceReference TextFillColorTertiary}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Localize Table={Binding Phrases}, Key={Binding Content}}"
                               FontSize="12"
                               TextWrapping="WrapByWords"/>
                    <TextBlock Grid.Row="1"
                               Text="{Localize RibbonShellStrings.GetsMarked}"
                               FontSize="12"
                               Margin="0 0 12 0"
                               Foreground="{ResourceReference TextFillColorTertiary}"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Localize Table={Binding Phrases}, Key={Binding Dependents}}"
                               FontSize="12"
                               TextWrapping="WrapByWords"/>
                </Grid>
                <TextBlock Text="{Localize RibbonShellStrings.MarkedHint}"
                           FontSize="12"
                           TextWrapping="WrapByWords"
                           Margin="0 8 0 0"
                           Foreground="{ResourceReference TextFillColorTertiary}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 12 0 0">
                    <Button Content="{Localize RibbonShellStrings.Cancel}"
                            Command="{Binding KeepAttachedCommand}"
                            Margin="0 0 8 0"/>
                    <Button Classes="Accent"
                            Content="{Localize RibbonShellStrings.Detach}"
                            Command="{Binding DetachCommand}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A row of the "Modules" drop-down: the switch is the row itself; the button beside it takes the module out
             of the document, after the question it opens next to the row. -->
        <DataTemplate x:Key="ModuleRow">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Margin="0 5 10 0"
                        VerticalAlignment="Top"
                        Background="{Binding Accent}"/>
                <StackPanel Grid.Column="1"
                            Orientation="Vertical">
                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Name}}"/>
                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Info}}"
                               FontSize="12"
                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="Toolbar"
                        Margin="16 0 0 0"
                        Padding="4"
                        VerticalAlignment="Center"
                        ToolTip="{Localize RibbonShellStrings.DetachFromDocument}"
                        Command="{Binding AskDetachCommand}">
                    <Path Data="M5,1 L5,4 M11,1 L11,4 M3,4 L13,4 L13,7 A5,5 0 0 1 3,7 Z M8,12 L8,15 M1,1 L15,15"
                          Stroke="{ResourceReference TextFillColorSecondary}"
                          StrokeThickness="1.25"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
                <Popup Grid.Column="2"
                       Placement="Right"
                       PlacementAlignment="Start"
                       HorizontalOffset="16"
                       KeepOpen="False"
                       IsOpen="{Binding IsDetachAsked, Mode=TwoWay}">
                    <Border Width="380"
                            Padding="16"
                            CornerRadius="8"
                            Background="{ResourceReference FlyoutSurfaceFill}"
                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                            BorderThickness="1">
                        <ContentPresenter Content="{Binding}"
                                          ContentTemplate="{ResourceReference DetachQuestion}"/>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Where a module stands: a pill (class StatePill, in RibbonShellStyleSet) in the color of its state. -->
        <DataTemplate x:Key="ModuleStateTag">
            <ContentControl Classes="StatePill"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                <TextBlock Text="{Localize RibbonShellStrings.ModuleState, state={Binding State}, version={Binding UpdateVersion}}"
                           FontSize="11"/>
            </ContentControl>
        </DataTemplate>

        <!-- What each module brings to the ribbon: its tabs under a ledge of its own, bound against the module - its
             commands are the module's (class ModuleTool, in RibbonShellStyleSet). A module with no piece of its own
             takes ModuleRibbon. -->
        <DataTemplate x:Key="SurfaceModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.SurfaceHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.Terrain}"
                           KeyTipService.KeyTip="T">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Terrain}"
                                 Icon="M1,13 L6,6 L9,10 L11,7 L15,13 Z">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewTerrain}"
                                      Icon="M1,13 L6,6 L9,10 L11,7 L15,13 Z M12,1 L12,5 M10,3 L14,3"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ImportHeightmap}"
                                      MaxSize="Medium"
                                      Icon="M2,10 L2,14 L14,14 L14,10 M8,2 L8,10 M5,7 L8,10 L11,7"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Sculpt}"
                                 Icon="M1,14 L5,10 L11,10 L15,14 M8,2 L8,7 M6,4 L8,2 L10,4">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Raise}"
                                      CommandParameter="Raised"
                                      Icon="M1,14 L5,10 L11,10 L15,14 M8,2 L8,7 M6,4 L8,2 L10,4"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Lower}"
                                      MaxSize="Medium"
                                      CommandParameter="Lowered"
                                      Icon="M1,10 L5,14 L11,14 L15,10 M8,2 L8,7 M6,5 L8,7 L10,5"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Smooth}"
                                      MaxSize="Medium"
                                      CommandParameter="Smoothed"
                                      Icon="M1,11 L4,8 L7,9 L10,8 L15,9"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Flatten}"
                                      MaxSize="Medium"
                                      Icon="M1,11 L15,11 M4,7 L12,7 M6,4 L10,4"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Stamp}"
                                      MaxSize="Medium"
                                      Icon="M5,2 L11,2 L10,8 L6,8 Z M2,11 L14,11 L14,14 L2,14 Z"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Ground}"
                                 Icon="M3,13 L10,6 L12,8 L5,15 Z M10,6 L12,2 L14,4 L12,8">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PaintGround}"
                                      Icon="M3,13 L10,6 L12,8 L5,15 Z M10,6 L12,2 L14,4 L12,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AutoFill}"
                                      MaxSize="Medium"
                                      Icon="M8,2 L14,8 L8,14 L2,8 Z M2,15 L14,15"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Water}"
                                 Icon="M3,1 L5,5 L4,9 L7,12 L8,15 M7,1 L9,5 L8,9 L11,12 L12,15">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.River}"
                                      Icon="M3,1 L5,5 L4,9 L7,12 L8,15 M7,1 L9,5 L8,9 L11,12 L12,15"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.WaterLevel}"
                                      MaxSize="Medium"
                                      Icon="M1,9 L15,9 M3,12 L13,12 M5,15 L11,15 M8,2 L8,6 M6,4 L8,6 L10,4"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Lake}"
                                      MaxSize="Medium"
                                      Icon="M2,8 A6,4 0 1 0 14,8 A6,4 0 1 0 2,8"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Erosion}"
                                 Icon="M1,13 L5,7 L7,9 L9,5 L15,13 M5,13 L6,11 M10,13 L11,10">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Erosion}"
                                      Icon="M1,13 L5,7 L7,9 L9,5 L15,13 M5,13 L6,11 M10,13 L11,10"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Vegetation}"
                                 Icon="M8,1 L3,9 L6,9 L3,13 L13,13 L10,9 L13,9 Z M8,13 L8,15">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PlantBrush}"
                                      Icon="M8,1 L3,9 L6,9 L3,13 L13,13 L10,9 L13,9 Z M8,13 L8,15"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Zones}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Zones}"
                                 Icon="M2,2 L14,2 L14,14 L2,14 Z M2,8 L8,2 M2,14 L14,2 M8,14 L14,8">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ZoneBrush}"
                                      Icon="M2,2 L14,2 L14,14 L2,14 Z M2,8 L8,2 M2,14 L14,2 M8,14 L14,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Polygon}"
                                      MaxSize="Medium"
                                      Icon="M3,3 L12,2 L14,9 L8,14 L2,10 Z"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.LockZone}"
                                      MaxSize="Medium"
                                      Icon="M4,7 L12,7 L12,14 L4,14 Z M6,7 L6,4 A2,2 0 0 1 10,4 L10,7"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Regenerate}"
                                      MaxSize="Medium"
                                      Icon="M13,8 A5,5 0 1 1 11,4 M11,1 L11,4 L14,4"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Settlements}"
                                 Icon="M2,14 L2,7 L6,4 L10,7 L10,14 Z M10,9 L14,9 L14,14 L10,14">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Settlement}"
                                      Icon="M2,14 L2,7 L6,4 L10,7 L10,14 Z M10,9 L14,9 L14,14 L10,14 M5,14 L5,10 L7,10 L7,14"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.SettlementList}"
                                      MaxSize="Medium"
                                      Icon="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Pinning}"
                                 Icon="M6,2 L10,2 L10,7 L12,9 L4,9 L6,7 Z M8,9 L8,15">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Pin}"
                                      Icon="M6,2 L10,2 L10,7 L12,9 L4,9 L6,7 Z M8,9 L8,15"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Unpin}"
                                      MaxSize="Medium"
                                      Icon="M6,2 L10,2 L10,7 L12,9 L4,9 L6,7 Z M8,9 L8,15 M2,2 L14,14"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Plots}"
                                 Icon="M2,2 L14,2 L14,14 L2,14 Z M8,2 L8,14 M2,8 L8,8 M8,10 L14,10">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.SlicePlots}"
                                      MaxSize="Medium"
                                      Icon="M2,2 L14,2 L14,14 L2,14 Z M8,2 L8,14 M2,8 L8,8 M8,10 L14,10"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.EditBorders}"
                                      MaxSize="Medium"
                                      Icon="M3,3 L13,3 L13,13 L3,13 Z M3,3 L1,1 M13,3 L15,1 M13,13 L15,15 M3,13 L1,15"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Catalog}"
                                 Icon="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.BuildingCatalog}"
                                      Icon="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Roads}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Road}"
                                 Icon="M5,15 L7,1 M11,15 L9,1 M8,3 L8,5 M8,8 L8,10 M8,13 L8,15">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewRoad}"
                                      Icon="M5,15 L7,1 M11,15 L9,1 M8,3 L8,5 M8,8 L8,10 M8,13 L8,15"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AddPoint}"
                                      MaxSize="Medium"
                                      Icon="M8,3 L8,13 M3,8 L13,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.RemovePoint}"
                                      MaxSize="Medium"
                                      Icon="M3,8 L13,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Junction}"
                                      MaxSize="Medium"
                                      Icon="M8,1 L8,15 M1,8 L15,8"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Structures}"
                                 Icon="M1,6 L15,6 M3,6 L3,14 M13,6 L13,14 M3,14 A5,5 0 0 1 13,14">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Bridge}"
                                      Icon="M1,6 L15,6 M3,6 L3,14 M13,6 L13,14 M3,14 A5,5 0 0 1 13,14"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Tunnel}"
                                      MaxSize="Medium"
                                      Icon="M2,14 L2,8 A6,6 0 0 1 14,8 L14,14 Z M5,14 L5,9 A3,3 0 0 1 11,9 L11,14"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Ford}"
                                      MaxSize="Medium"
                                      Icon="M1,10 L4,8 L7,10 L10,8 L13,10 L15,9 M1,13 L4,11 L7,13 L10,11 L13,13 L15,12 M3,2 L3,6 M13,2 L13,6"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Culvert}"
                                      MaxSize="Medium"
                                      Icon="M1,6 L15,6 M1,14 L15,14 M5,14 A3,3 0 0 1 11,14"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Network}"
                                 Icon="M1,5 A2,2 0 1 0 5,5 A2,2 0 1 0 1,5 M11,11 A2,2 0 1 0 15,11 A2,2 0 1 0 11,11 M4,6 L12,10">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ConnectSettlements}"
                                      Icon="M1,5 A2,2 0 1 0 5,5 A2,2 0 1 0 1,5 M11,11 A2,2 0 1 0 15,11 A2,2 0 1 0 11,11 M4,6 L12,10"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Cataclysm}"
                                 Icon="M2,2 L7,7 L5,9 L9,13 M9,13 L11,11 L15,15">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.BreakSection}"
                                      Icon="M2,2 L7,7 L5,9 L9,13 M9,13 L11,11 L15,15"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Restore}"
                                      MaxSize="Medium"
                                      Icon="M3,8 A5,5 0 1 0 5,4 M5,1 L5,4 L2,4"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.MakeTask}"
                                      MaxSize="Medium"
                                      Icon="M3,15 L3,2 M3,2 L13,2 L11,5 L13,8 L3,8"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <DataTemplate x:Key="SpaceModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.SpaceHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.System}"
                           KeyTipService.KeyTip="S">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Stars}"
                                 Icon="M8,1 L9.8,5.6 L14.6,5.8 L10.8,8.8 L12.2,13.6 L8,10.8 L3.8,13.6 L5.2,8.8 L1.4,5.8 L6.2,5.6 Z">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Star}"
                                      CommandParameter="AddedStar"
                                      Icon="M8,1 L9.8,5.6 L14.6,5.8 L10.8,8.8 L12.2,13.6 L8,10.8 L3.8,13.6 L5.2,8.8 L1.4,5.8 L6.2,5.6 Z"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.BinaryStar}"
                                      MaxSize="Medium"
                                      Icon="M1,8 A3,3 0 1 0 7,8 A3,3 0 1 0 1,8 M9,8 A2.5,2.5 0 1 0 14,8 A2.5,2.5 0 1 0 9,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Cluster}"
                                      MaxSize="Medium"
                                      Icon="M2,4 A1.5,1.5 0 1 0 5,4 A1.5,1.5 0 1 0 2,4 M10,3 A1.5,1.5 0 1 0 13,3 A1.5,1.5 0 1 0 10,3 M5,11 A1.5,1.5 0 1 0 8,11 A1.5,1.5 0 1 0 5,11 M11,11 A1,1 0 1 0 13,11 A1,1 0 1 0 11,11"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Bodies}"
                                 Icon="M8,4 A4,4 0 1 0 8,12 A4,4 0 1 0 8,4 M1,10 L15,6">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Planet}"
                                      CommandParameter="AddedPlanet"
                                      Icon="M8,4 A4,4 0 1 0 8,12 A4,4 0 1 0 8,4 M1,10 L15,6"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Moon}"
                                      MaxSize="Medium"
                                      CommandParameter="AddedMoon"
                                      Icon="M10,2 A6,6 0 1 0 14,11 A5,5 0 1 1 10,2 Z"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.DwarfPlanet}"
                                      MaxSize="Medium"
                                      Icon="M5,8 A3,3 0 1 0 11,8 A3,3 0 1 0 5,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AsteroidBelt}"
                                      MaxSize="Medium"
                                      Icon="M1,8 A7,3 0 1 0 15,8 A7,3 0 1 0 1,8 M4,6 L4,6.5 M10,10 L10,10.5 M12,6 L12,6.5"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Orbits}"
                                 Icon="M1,8 A7,4 0 1 0 15,8 A7,4 0 1 0 1,8 M12,6 A1.5,1.5 0 1 0 15,6 A1.5,1.5 0 1 0 12,6">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.SetOrbit}"
                                      MaxSize="Medium"
                                      Icon="M1,8 A7,4 0 1 0 15,8 A7,4 0 1 0 1,8 M12,6 A1.5,1.5 0 1 0 15,6 A1.5,1.5 0 1 0 12,6"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Resonance}"
                                      MaxSize="Medium"
                                      Icon="M1,8 A7,4 0 1 0 15,8 A7,4 0 1 0 1,8 M4,8 A4,2 0 1 0 12,8 A4,2 0 1 0 4,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Lagrange}"
                                      MaxSize="Medium"
                                      Icon="M2,8 A2,2 0 1 0 6,8 A2,2 0 1 0 2,8 M12,8 L12,8.5 M8,3 L8,3.5 M8,13 L8,13.5 M15,8 L15,8.5"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Generator}"
                                 Icon="M2,2 L14,2 L14,14 L2,14 Z M5,5 L5,5.5 M11,5 L11,5.5 M8,8 L8,8.5 M5,11 L5,11.5 M11,11 L11,11.5">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.GenerateSystem}"
                                      Icon="M2,2 L14,2 L14,14 L2,14 Z M5,5 L5,5.5 M11,5 L11,5.5 M8,8 L8,8.5 M5,11 L5,11.5 M11,11 L11,11.5"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Planet}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Basics}"
                                 Icon="M8,4 A4,4 0 1 0 8,12 A4,4 0 1 0 8,4 M13,1 L13,5 M11,3 L15,3">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewPlanet}"
                                      Icon="M8,4 A4,4 0 1 0 8,12 A4,4 0 1 0 8,4 M13,1 L13,5 M11,3 L15,3"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Terrain}"
                                 Icon="M1,10 L3,7 L5,11 L7,5 L9,9 L11,6 L13,10 L15,8">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ReliefNoise}"
                                      MaxSize="Medium"
                                      Icon="M1,10 L3,7 L5,11 L7,5 L9,9 L11,6 L13,10 L15,8"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Craters}"
                                      MaxSize="Medium"
                                      Icon="M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 M5,6 A1.5,1.5 0 1 0 8,6 A1.5,1.5 0 1 0 5,6 M9,10 A1,1 0 1 0 11,10 A1,1 0 1 0 9,10"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Ridges}"
                                      MaxSize="Medium"
                                      Icon="M1,13 L5,5 L8,10 L11,3 L15,13"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Tectonics}"
                                      MaxSize="Medium"
                                      Icon="M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 M3,6 L8,8 L7,14 M8,8 L13,5"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.WaterAndIce}"
                                 Icon="M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 M2,9 L14,9">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.OceanLevel}"
                                      MaxSize="Medium"
                                      Icon="M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 M2,9 L14,9"/>
                        <RibbonButton Classes="ModuleTool"
