                                 Icon="{ObservableResource NewPlanetIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewPlanet}"
                                      Icon="{ObservableResource NewPlanetIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Terrain}"
