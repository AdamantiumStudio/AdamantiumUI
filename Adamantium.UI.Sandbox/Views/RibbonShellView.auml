        <DataTemplate x:Key="CharactersModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.CharactersHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.Skeleton}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Bones}"
                                 Icon="{ObservableResource BonesIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AddBone}"
                                      Icon="{ObservableResource AddBoneIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.MirrorBones}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource MirrorBonesIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Rig}"
                                 Icon="{ObservableResource AutoRigIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AutoRig}"
                                      Icon="{ObservableResource AutoRigIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.IkChain}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource IkChainIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Constraints}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource LockIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Skinning}"
                                 Icon="{ObservableResource BrushIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PaintWeights}"
                                      Icon="{ObservableResource BrushIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NormalizeWeights}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource NormalizeWeightsIcon}"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Animation}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Clips}"
                                 Icon="{ObservableResource ClipsIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewClip}"
                                      Icon="{ObservableResource NewClipIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ImportClip}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource ImportToTrayIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Keys}"
                                 Icon="{ObservableResource SetKeyIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.SetKey}"
                                      Icon="{ObservableResource SetKeyIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AutoKey}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource AutoKeyIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Transitions}"
                                 Icon="{ObservableResource StateGraphIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.StateGraph}"
                                      Icon="{ObservableResource StateGraphIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.BlendTree}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource BlendTreeIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <DataTemplate x:Key="StrategyModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.StrategyHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.Units}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Units}"
                                 Icon="{ObservableResource UnitIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PlaceUnit}"
                                      Icon="{ObservableResource UnitIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.UnitTypes}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource ListIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Orders}"
                                 Icon="{ObservableResource MoveOrderIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.MoveOrder}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource MoveOrderIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AttackOrder}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource AttackOrderIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PatrolOrder}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource PatrolOrderIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Factions}"
                                 Icon="{ObservableResource FlagIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewFaction}"
                                      Icon="{ObservableResource FlagIcon}"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Resources}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Deposits}"
                                 Icon="{ObservableResource DepositIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PlaceDeposit}"
                                      Icon="{ObservableResource DepositIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Economy}"
                                 Icon="{ObservableResource BalanceIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Gathering}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource GatheringIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Storage}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource StorageIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Balance}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource BalanceIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <DataTemplate x:Key="WaterModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.WaterHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.Water}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Rivers}"
                                 Icon="{ObservableResource RiverIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.River}"
                                      Icon="{ObservableResource RiverIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Waterfall}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource WaterfallIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Rapids}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource RapidsIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Lakes}"
                                 Icon="{ObservableResource LakeIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Lake}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource LakeIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.WaterLevel}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource WaterLevelIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Flow}"
                                 Icon="{ObservableResource WindIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.FlowMap}"
                                      Icon="{ObservableResource WindIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <DataTemplate x:Key="ModuleRibbon">
            <RibbonTabSet Header="{Localize Table={Binding Phrases}, Key={Binding Name}}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize Table={Binding Phrases}, Key={Binding Name}}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Tools}"
                                 Icon="{Binding Icon}"
                                 IconTemplate="{ResourceReference ModuleIcon}">
                        <RibbonButton Content="{Localize RibbonShellStrings.Add}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="ModuleToolUsed"
                                      Icon="{Binding Icon}"
                                      IconTemplate="{ResourceReference ModuleIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <!-- A command of the shell as a row of the customize page: its icon and its name. -->
        <DataTemplate x:Key="CommandRow">
            <StackPanel Orientation="Horizontal">
                <Path Data="{Binding Icon}"
                      Stroke="{ResourceReference TextFillColorPrimary}"
                      StrokeThickness="1"
                      Width="16"
                      Height="16"
                      Margin="0 0 10 0"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{Localize RibbonShellStrings, Key={Binding Name}}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- A module's icon on a tile of its color: rimmed with it, washed with it. As big as its presenter. -->
        <DataTemplate x:Key="ModuleTile">
            <Grid>
                <Border CornerRadius="8"
                        Opacity="0.15"
                        Background="{Binding Accent}"/>
                <Border CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{Binding Accent}"/>
                <Image Source="{Binding Icon}"
                       Margin="10"/>
            </Grid>
        </DataTemplate>

        <!-- A tab a module brings, as a chip of the module's color. -->
        <DataTemplate x:Key="ModuleTabChip">
            <Grid Height="24"
                  Margin="0 0 6 0">
                <Border CornerRadius="4"
                        Opacity="0.15"
                        Background="{Binding Module.Accent}"/>
                <Border CornerRadius="4"
                        Opacity="0.6"
                        BorderThickness="1"
                        BorderBrush="{Binding Module.Accent}"/>
                <TextBlock Text="{Localize Table={Binding Module.Phrases}, Key={Binding Name}}"
                           FontSize="12"
                           Margin="10 0"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- A module's icon is a picture, not path data: the ribbon draws it as one. -->
        <DataTemplate x:Key="ModuleIcon">
            <Image Source="{Binding}"
                   Width="16"
                   Height="16"/>
        </DataTemplate>
    </ResourceContext.Resources>
    <!-- An editor shell: a ribbon band, a document surface, a status line. Exercises the three command sizes, commands
         graying out on CanExecute, two-way toggles, ordinary controls inside a group, a separator breaking a column,
         and the quick-access bar in the caption reading the SAME view model (see RibbonWindow.auml). -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The ribbon states WHAT was asked and what it looks like; this shell decides what its own quick-access items
             are made of and owns the list. Bound once here - the properties inherit down to every command in the band.
             The list itself is bound too, READ-ONLY: that is how a command knows to offer "remove" rather than "add",
             without anyone writing a mark back into the ribbon. -->
        <Ribbon Grid.Row="0" x:Name="Band"
                Ribbon.AddToQuickAccessCommand="{Binding AddToQuickAccessCommand}"
                Ribbon.RemoveFromQuickAccessCommand="{Binding RemoveFromQuickAccessCommand}"
                Ribbon.QuickAccessItems="{Binding QuickAccess}"
                IsDrawerOpen="{Binding IsModuleCatalogOpen, Mode=TwoWay}"
                TabSetsSource="{Binding DocumentModules}">

            <!-- The band's commands are drawn from the shell's catalog (classes Shell / ShellToggle, styled in
                 RibbonShellStyleSet): the quick-access bar and the customize page draw from the same commands, so
                 nothing is stated twice and nothing is kept in step. -->

            <!-- Each module of the document brings its tabs: its own piece of view, or the common one. -->
            <Ribbon.TabSetTemplateSelector>
                <views:ModuleRibbonSelector FallbackKey="ModuleRibbon"/>
            </Ribbon.TabSetTemplateSelector>

            <!-- "File": a command that opens a menu, so the flyout is the ContextMenu one already is. The two-pane
                 version - recent files beside the commands - is a later step. -->
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Header="{Localize RibbonShellStrings.File}" IsBackstage="{Binding IsBackstage}">
                    <!-- A row with a PAGE opens it beside the rail and stays lit; a row without one is a command that
                         runs and closes the backstage behind it. -->
                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.New}" Icon="{ObservableResource NewIcon}">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.NewScene}" FontSize="28" Margin="0 0 0 18"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Localize RibbonShellStrings.EmptyScene}" Command="{Binding NewSceneCommand}" Margin="0 0 10 0"/>
                                    <Button Content="{Localize RibbonShellStrings.FromTemplate}" Command="{Binding NewSceneCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Open}" Icon="{ObservableResource OpenIcon}">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.RecentScenes}" FontSize="28" Margin="0 0 0 18"/>
                                <Button Content="city-block.scene" Command="{Binding OpenSceneCommand}" Margin="0 0 0 6"/>
                                <Button Content="character-rig.scene" Command="{Binding OpenSceneCommand}" Margin="0 0 0 6"/>
                                <Button Content="lighting-study.scene" Command="{Binding OpenSceneCommand}"/>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Save}" Command="{Binding SaveCommand}"
                                               Icon="{ObservableResource SaveIcon}"/>

                    <!-- The rows the pane-follows-the-pointer behavior is worth seeing on: run the pointer down
                         Import / Export / Print and the right half changes under it, with nothing clicked. -->
                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Import}" Icon="{ObservableResource ImportIcon}">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.Import}" FontSize="28" Margin="0 0 0 6"/>
                                <TextBlock Text="{Localize RibbonShellStrings.ImportHint}" Opacity="0.7" Margin="0 0 0 18"/>
                                <Button Content="Wavefront .obj" Command="{Binding ImportCommand}" CommandParameter=".obj" Margin="0 0 0 6"/>
                                <Button Content="Autodesk .fbx" Command="{Binding ImportCommand}" CommandParameter=".fbx" Margin="0 0 0 6"/>
                                <Button Content="Khronos .gltf" Command="{Binding ImportCommand}" CommandParameter=".gltf"/>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Export}" Icon="{ObservableResource ExportIcon}">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.Export}" FontSize="28" Margin="0 0 0 6"/>
                                <TextBlock Text="{Localize RibbonShellStrings.ExportHint}" Opacity="0.7" Margin="0 0 0 18"/>
                                <Button Content="Wavefront .obj" Command="{Binding ExportCommand}" CommandParameter=".obj" Margin="0 0 0 6"/>
                                <Button Content="Khronos .gltf" Command="{Binding ExportCommand}" CommandParameter=".gltf" Margin="0 0 0 6"/>
                                <Button Content="{Localize RibbonShellStrings.AdamantiumPackage}" Command="{Binding ExportCommand}" CommandParameter=".apkg"/>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Print}" Icon="{ObservableResource PrintIcon}">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.Print}" FontSize="28" Margin="0 0 0 6"/>
                                <TextBlock Text="{Localize RibbonShellStrings.PrintHint}" Opacity="0.7" Margin="0 0 0 18"/>
                                <TextBlock Text="{Localize RibbonShellStrings.Printer}" Margin="0 0 0 4" Opacity="0.7"/>
                                <DropDown Width="200" HorizontalAlignment="Left" SelectedIndex="0">
                                    <DropDownItem Content="Microsoft Print to PDF"/>
                                    <DropDownItem Content="Office printer (2nd floor)"/>
                                </DropDown>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <!-- The quick-access bar set up the way Word sets up its own: the commands on offer on the left, what
                         is in the bar on the right, in its order. Both lists are the shell's commands as data - the
                         ribbon's buttons stay where they stand. -->
                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Customize}"
                                               Icon="{ObservableResource CustomizeIcon}">
                        <RibbonApplicationMenuItem.PageContent>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="280,Auto,280,Auto"
                                  HorizontalAlignment="Left">
                                <TextBlock Grid.ColumnSpan="4"
                                           Text="{Localize RibbonShellStrings.QuickAccess}"
                                           FontSize="28"
                                           Margin="0 0 0 6"/>
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Text="{Localize RibbonShellStrings.QuickAccessHint}"
                                           Opacity="0.7"
                                           Margin="0 0 0 18"/>

                                <StackPanel Grid.Row="2"
                                            Orientation="Vertical"
                                            Margin="0 0 0 8">
                                    <TextBlock x:Name="ChooseCommandsFromLabel"
                                               Text="{Localize RibbonShellStrings.ChooseCommandsFrom}"
                                               Margin="0 0 0 4"
                                               Opacity="0.7"/>
                                    <DropDown AutomationProperties.AutomationId="CommandSource"
                                              AutomationProperties.LabeledBy="{Binding ElementName=ChooseCommandsFromLabel}"
                                              ItemsSource="{Binding CommandSources}"
                                              SelectedItem="{Binding CommandSource, Mode=TwoWay}">
                                        <DropDown.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize RibbonShellStrings.CommandSource, source={Binding}}"/>
                                            </DataTemplate>
                                        </DropDown.ItemTemplate>
                                    </DropDown>
                                </StackPanel>
                                <TextBlock x:Name="InTheBarLabel"
                                           Grid.Row="2"
                                           Grid.Column="2"
                                           Text="{Localize RibbonShellStrings.InTheBar}"
                                           VerticalAlignment="Bottom"
                                           Margin="0 0 0 12"
                                           Opacity="0.7"/>

                                <ListBox AutomationProperties.AutomationId="CommandChoices"
                                         AutomationProperties.LabeledBy="{Binding ElementName=ChooseCommandsFromLabel}"
                                         Grid.Row="3"
                                         Height="320"
                                         ItemsSource="{Binding CommandChoices}"
                                         SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                         ItemTemplate="{ResourceReference CommandRow}"/>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="1"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Margin="12 0">
                                    <Button Content="{Localize RibbonShellStrings.AddToBar}"
                                            Command="{Binding AddToBarCommand}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0 0 0 8"/>
                                    <Button Content="{Localize RibbonShellStrings.RemoveFromBar}"
                                            Command="{Binding RemoveFromBarCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <ListBox AutomationProperties.AutomationId="BarCommands"
                                         AutomationProperties.LabeledBy="{Binding ElementName=InTheBarLabel}"
                                         Grid.Row="3"
                                         Grid.Column="2"
                                         Height="320"
                                         ItemsSource="{Binding QuickAccess}"
                                         SelectedItem="{Binding SelectedBarItem, Mode=TwoWay}"
                                         ItemTemplate="{ResourceReference CommandRow}"/>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="3"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Margin="12 0 0 0">
                                    <Button Classes="Toolbar"
                                            Padding="6"
                                            Margin="0 0 0 8"
                                            ToolTip="{Localize RibbonShellStrings.MoveUp}"
                                            Command="{Binding MoveUpInBarCommand}">
                                        <Path Data="M8,3 L8,13 M4,7 L8,3 L12,7"
                                              Stroke="{ResourceReference TextFillColorPrimary}"
                                              StrokeThickness="1.25"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Classes="Toolbar"
                                            Padding="6"
                                            ToolTip="{Localize RibbonShellStrings.MoveDown}"
                                            Command="{Binding MoveDownInBarCommand}">
                                        <Path Data="M8,3 L8,13 M4,9 L8,13 L12,9"
                                              Stroke="{ResourceReference TextFillColorPrimary}"
                                              StrokeThickness="1.25"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="4"
                                            Grid.ColumnSpan="4"
                                            Orientation="Horizontal"
                                            Margin="0 16 0 0">
                                    <CheckBox Content="{Localize RibbonShellStrings.ShowBelowRibbon}"
                                              IsChecked="{Binding IsQuickAccessBelow, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                    <Button Content="{Localize RibbonShellStrings.ResetBar}"
                                            Command="{Binding ResetQuickAccessCommand}"
                                            Margin="24 0 0 0"/>
                                </StackPanel>
                            </Grid>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <!-- What the dropped panel shows until the pointer picks a row. The backstage never needs it: it
                         always stands on a chosen row. -->
                    <RibbonApplicationMenu.AuxiliaryPaneContent>
                        <StackPanel>
                            <TextBlock Text="{Localize RibbonShellStrings.RecentScenes}" FontSize="20" Margin="0 0 0 14"/>
                            <TextBlock Text="city-block.scene" Margin="0 0 0 6" Opacity="0.75"/>
                            <TextBlock Text="character-rig.scene" Margin="0 0 0 6" Opacity="0.75"/>
                            <TextBlock Text="lighting-study.scene" Opacity="0.75"/>
                        </StackPanel>
                    </RibbonApplicationMenu.AuxiliaryPaneContent>

                    <RibbonApplicationMenu.FooterPaneContent>
                        <StackPanel Margin="0 0 0 12">
                            <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Exit}" Command="{Binding ExitCommand}"
                                                       Icon="{ObservableResource ExitIcon}"/>
                        </StackPanel>
                    </RibbonApplicationMenu.FooterPaneContent>
                </RibbonApplicationMenu>
            </Ribbon.ApplicationMenu>

            <!-- The SAME collection the caption bar lists. Two instances, one list: each shows itself only while the
                 placement names its own slot, so moving the bar moves nothing. -->
            <Ribbon.FooterContent>
                <RibbonQuickAccess ItemsSource="{Binding QuickAccess}"
                                   Placement="{Binding QuickAccessPlacement}"
                                   Ribbon.RemoveFromQuickAccessCommand="{Binding RemoveFromQuickAccessCommand}"
                                   Margin="6 2 6 3"
                                   HorizontalAlignment="Left">
                    <RibbonQuickAccess.ItemTemplateSelector>
                        <views:ShellQuickAccessTemplateSelector Toggle="{ResourceReference QuickAccessToggleTemplate}"
                                                                DropDown="{ResourceReference QuickAccessDropDownTemplate}"
                                                                Split="{ResourceReference QuickAccessSplitTemplate}"/>
                    </RibbonQuickAccess.ItemTemplateSelector>
                </RibbonQuickAccess>
            </Ribbon.FooterContent>

            <!-- What the document is made of, next to "File". Each module is a switch that leaves the menu open, so
                 several can be flipped in one go; a module that is on brings its own tabs (the contexts below). -->
            <Ribbon.StripContent>
                <RibbonDropDownButton Ribbon.Size="Medium"
                                      Ribbon.CanAddToQuickAccess="False"
                                      Icon="{ObservableResource ModulesIcon}"
                                      KeyTipService.KeyTip="D">
                    <RibbonDropDownButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Localize RibbonShellStrings.Modules}"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="8"
                                    MinWidth="16"
                                    Height="16"
                                    Padding="4 0"
                                    Margin="6 0 0 0"
                                    VerticalAlignment="Center"
                                    Background="{ResourceReference SubtleFillColorTertiary}">
                                <TextBlock Text="{Binding ModuleCount}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RibbonDropDownButton.Content>
                    <RibbonDropDownButton.DropDownMenu>
                        <!-- The modules of THIS document, however many, then the catalog - rows as data. A module's
                             check shows or hides its tabs - it keeps working either way; the button at the row's end
                             takes it out of the document. -->
                        <ContextMenu ItemsSource="{Binding ModulesMenu}">
                            <ContextMenu.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ContentPresenter Content="{Binding Module}"
                                                          ContentTemplate="{ResourceReference ModuleRow}"
                                                          Visibility="{Binding IsModule, Converter={conv:BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Localize RibbonShellStrings, Key={Binding Title}}"
                                                   Visibility="{Binding IsCommand, Converter={conv:BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ContextMenu.ItemTemplate>
                            <ContextMenu.ItemContainerStyle>
                                <Style Selector="MenuItem">
                                    <Setter Property="IsCheckable" Value="{Binding IsModule}"/>
                                    <Setter Property="StaysOpenOnClick" Value="{Binding IsModule}"/>
                                    <Setter Property="IsChecked" Value="{Binding Module.IsShown, Mode=TwoWay}"/>
                                    <Setter Property="Command" Value="{Binding Command}"/>
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </RibbonDropDownButton.DropDownMenu>
                </RibbonDropDownButton>
            </Ribbon.StripContent>

            <!-- The module catalog opens out of the ribbon in place of the band: every module the editor knows of,
                 where each stands with this document, and what can be done with it. -->
            <Ribbon.Drawer>
                <!-- As tall as what it shows, up to the room under the strip; the lists and the details scroll the rest. -->
                <Grid RowDefinitions="Auto,*"
                      Margin="20 16 20 20">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <TextBlock x:Name="CatalogTitle"
                                   Text="{Localize RibbonShellStrings.ModuleCatalogTitle}"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0 0 16 0"/>
                        <TextBox AutomationProperties.AutomationId="CatalogSearch"
                                 Grid.Column="1"
                                 Width="340"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 Margin="0 0 16 0"
                                 Placeholder="{Localize RibbonShellStrings.FindModule}"
                                 ShowsClearButton="True"
                                 Text="{Binding CatalogSearch, Mode=TwoWay}"/>

                        <!-- The filters as one segmented strip, each saying how many modules it lets through. -->
                        <Border Grid.Column="2"
                                Padding="2"
                                CornerRadius="6"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                Background="{ResourceReference SubtleFillColorSecondary}">
                            <ListBox AutomationProperties.AutomationId="CatalogFilters"
                                     Classes="Bare"
                                     ItemsSource="{Binding CatalogFilters}"
                                     SelectedItem="{Binding CatalogFilter, Mode=TwoWay}">
                                <ListBox.ItemContainerStyle>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="12 4"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    IsVirtualizing="False"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Localize RibbonShellStrings.CatalogFilter, filter={Binding Filter}, count={Binding Count}}"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Button AutomationProperties.AutomationId="InstallFromFile"
                                Grid.Column="4"
                                Command="{Binding InstallModuleFromFileCommand}"
                                VerticalAlignment="Center"
                                Margin="0 0 8 0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,2 L10,2 L13,5 L13,14 L4,14 Z M10,2 L10,5 L13,5 M8.5,7 L8.5,12 M6.5,10 L8.5,12 L10.5,10"
                                      Stroke="{ResourceReference TextFillColorPrimary}"
                                      StrokeThickness="1.25"
                                      Width="16"
                                      Height="16"
                                      Margin="0 0 8 0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="{Localize RibbonShellStrings.InstallFromFile}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="CloseCatalog"
                                Grid.Column="5"
                                Classes="Toolbar"
                                Padding="6"
                                VerticalAlignment="Center"
                                ToolTip="{Localize RibbonShellStrings.CloseCatalog}"
                                Command="{Binding CloseModuleCatalogCommand}">
                            <Path Data="M3,3 L13,13 M13,3 L3,13"
                                  Stroke="{ResourceReference TextFillColorSecondary}"
                                  StrokeThickness="1.25"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="200,*,560"
                          Margin="0 16 0 0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock x:Name="SectionsLabel"
                                       Text="{Localize RibbonShellStrings.Sections}"
                                       FontSize="12"
                                       Margin="10 0 0 6"
                                       Foreground="{ResourceReference TextFillColorSecondary}"/>
                            <ListBox AutomationProperties.AutomationId="CatalogSections"
                                     AutomationProperties.LabeledBy="{Binding ElementName=SectionsLabel}"
                                     Grid.Row="1"
                                     Classes="Bare"
                                     ItemsSource="{Binding CatalogSections}"
                                     SelectedItem="{Binding CatalogSection, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Localize RibbonShellStrings.Section, section={Binding Section}}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Count}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ResourceReference TextFillColorSecondary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- The modules as cards: the card is the row itself, rimmed in the accent when picked. -->
                        <ListBox AutomationProperties.AutomationId="CatalogModules"
                                 AutomationProperties.LabeledBy="{Binding ElementName=CatalogTitle}"
                                 Grid.Column="1"
                                 Classes="Bare"
                                 Margin="16 0"
                                 ItemsSource="{Binding CatalogModules}"
                                 SelectedItem="{Binding SelectedModule, Mode=TwoWay}">
                            <ListBox.ItemContainerStyle>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
                                    <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Padding" Value="14 12"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <PropertyTrigger Property="IsSelected" Value="true">
                                        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
                                    </PropertyTrigger>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid MinColumnWidth="400"
                                                 RowSpacing="10"
                                                 ColumnSpacing="10"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <ContentPresenter Width="40"
                                                          Height="40"
                                                          VerticalAlignment="Top"
                                                          Margin="0 0 12 0"
                                                          Content="{Binding}"
                                                          ContentTemplate="{ResourceReference ModuleTile}"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical">
                                            <!-- The pill takes its room first and never gives it up; short of space the
                                                 name gives way, then the version. -->
                                            <DockPanel LastChildFill="False">
                                                <ContentPresenter DockPanel.Dock="Right"
                                                                  Margin="8 0 0 0"
                                                                  Content="{Binding}"
                                                                  ContentTemplate="{ResourceReference ModuleStateTag}"/>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Localize Table={Binding Phrases}, Key={Binding Name}}"
                                                           FontSize="14"
                                                           TextTrimming="CharEllipses"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding Version}"
                                                           FontSize="12"
                                                           Margin="8 0 0 0"
                                                           TextTrimming="CharEllipses"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ResourceReference TextFillColorTertiary}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Info}}"
                                                       FontSize="12"
                                                       Margin="0 4 0 0"
                                                       TextTrimming="CharEllipses"
                                                       Foreground="{ResourceReference TextFillColorSecondary}"/>
                                            <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Adds}}"
                                                       FontSize="11"
                                                       Margin="0 4 0 0"
                                                       TextTrimming="CharEllipses"
                                                       Foreground="{ResourceReference TextFillColorTertiary}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The module last picked in the list, kept when the filter takes it out: what it is, what
                             it brings, and - under the rule - what can be done with it from where it stands. A question
                             comes up above the rule, in the free space. -->
                        <Border Grid.Column="2"
                                Padding="20 18"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                Background="{ResourceReference CardBackgroundFillColorDefault}"
                                DataContext="{Binding ShownModule}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <ContentPresenter Width="48"
                                                      Height="48"
                                                      Margin="0 0 14 0"
                                                      Content="{Binding}"
                                                      ContentTemplate="{ResourceReference ModuleTile}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Vertical"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Name}}"
                                                   FontSize="20"/>
                                        <TextBlock Text="{Localize RibbonShellStrings.VersionLine, builtIn={Binding IsBuiltIn}, version={Binding Version}}"
                                                   FontSize="12"
                                                   Margin="0 2 0 0"
                                                   Foreground="{ResourceReference TextFillColorSecondary}"/>
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2"
                                                      VerticalAlignment="Top"
                                                      Content="{Binding}"
                                                      ContentTemplate="{ResourceReference ModuleStateTag}"/>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Localize Table={Binding Phrases}, Key={Binding Description}}"
                                           TextWrapping="WrapByWords"
                                           Margin="0 14 0 0"/>

                                <StackPanel Grid.Row="2"
                                            Orientation="Vertical"
                                            Margin="0 14 0 0"
                                            Visibility="{Binding HasOwnTabs, Converter={conv:BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Localize RibbonShellStrings.OwnTabs}"
                                               FontSize="12"
                                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                                    <ItemsControl Margin="0 6 0 0"
                                                  ItemsSource="{Binding OwnTabs}"
                                                  ItemTemplate="{ResourceReference ModuleTabChip}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            IsVirtualizing="False"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid Grid.Row="3"
                                      ColumnDefinitions="110,*"
                                      RowDefinitions="Auto,Auto"
                                      Margin="0 14 0 0">
                                    <TextBlock Text="{Localize RibbonShellStrings.DependsOn}"
                                               FontSize="12"
                                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Localize Table={Binding Phrases}, Key={Binding Requires}}"
                                               FontSize="12"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Localize RibbonShellStrings.InThisDocument}"
                                               FontSize="12"
                                               Margin="0 4 0 0"
                                               Foreground="{ResourceReference TextFillColorSecondary}"
                                               Visibility="{Binding HasDocumentData, Converter={conv:BoolToVisibilityConverter}}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Localize Table={Binding Phrases}, Key={Binding Content}}"
                                               FontSize="12"
                                               Margin="0 4 0 0"
                                               TextWrapping="WrapByWords"
                                               Visibility="{Binding HasDocumentData, Converter={conv:BoolToVisibilityConverter}}"/>
                                </Grid>

                                <!-- The questions, each with its own way out, in the free space above the rule - scrolled
                                     there when the drawer is too short to show one whole. -->
                                <ScrollViewer Grid.Row="4"
                                              VerticalAlignment="Bottom"
                                              Margin="0 14 0 14"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical">
                                        <Border Padding="12"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ResourceReference SystemFillColorCaution}"
                                                Visibility="{Binding IsDetachAsked, Converter={conv:BoolToVisibilityConverter}}">
                                            <ContentPresenter Content="{Binding}"
                                                              ContentTemplate="{ResourceReference DetachQuestion}"/>
                                        </Border>
                                        <Border Padding="12"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ResourceReference SystemFillColorCritical}"
                                                Visibility="{Binding IsUninstallAsked, Converter={conv:BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Localize RibbonShellStrings.UninstallTitle}"
                                                           FontSize="15"/>
                                                <TextBlock Text="{Localize RibbonShellStrings.UninstallText}"
                                                           TextWrapping="WrapByWords"
                                                           Margin="0 8 0 0"
                                                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="0 12 0 0">
                                                    <Button Content="{Localize RibbonShellStrings.Cancel}"
                                                            Command="{Binding KeepInstalledCommand}"
                                                            Margin="0 0 8 0"/>
                                                    <Button Classes="Accent"
                                                            Content="{Localize RibbonShellStrings.Remove}"
                                                            Command="{Binding UninstallCommand}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ResourceReference SystemFillColorCritical}"
                                                Visibility="{Binding IsDeleteAsked, Converter={conv:BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Localize RibbonShellStrings.DeleteDataTitle}"
                                                           FontSize="15"/>
                                                <TextBlock Text="{Localize RibbonShellStrings.DeleteDataText}"
                                                           TextWrapping="WrapByWords"
                                                           Margin="0 8 0 0"
                                                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="0 12 0 0">
                                                    <Button Content="{Localize RibbonShellStrings.Cancel}"
                                                            Command="{Binding KeepDataCommand}"
                                                            Margin="0 0 8 0"/>
                                                    <Button Classes="Accent"
                                                            Content="{Localize RibbonShellStrings.Delete}"
                                                            Command="{Binding DeleteDataCommand}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border Grid.Row="5"
                                        Padding="0 14 0 0"
                                        BorderThickness="0 1 0 0"
                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                                    <Border.Triggers>
                                        <DataTrigger Binding="{Binding IsAsking}" Value="true">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <!-- In the document: show or hide its tabs; take it out, or out of the editor. -->
                                        <StackPanel Orientation="Vertical"
                                                    Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=InDocument}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="{Localize RibbonShellStrings.ShowTabs}"
                                                          IsChecked="{Binding IsShown, Mode=TwoWay}"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="{Localize RibbonShellStrings.ShowTabsHint}"
                                                           FontSize="12"
                                                           Margin="10 0 0 0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0 10 0 0">
                                                <Button Classes="Caution"
                                                        Content="{Localize RibbonShellStrings.DetachFromDocument}"
                                                        Command="{Binding AskDetachCommand}"
                                                        Margin="0 0 8 0"/>
                                                <Button Classes="Critical"
                                                        Content="{Localize RibbonShellStrings.AskUninstall}"
                                                        Command="{Binding AskUninstallCommand}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Detached: its data waits in the file. Back in, or the data deleted for good. -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Detached}">
                                            <Button Classes="Accent"
                                                    Content="{Localize RibbonShellStrings.AttachAgain}"
                                                    Command="{Binding AttachCommand}"
                                                    Margin="0 0 8 0"/>
                                            <Button Classes="Critical"
                                                    Content="{Localize RibbonShellStrings.DeleteModuleData}"
                                                    Command="{Binding AskDeleteDataCommand}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Installed}">
                                            <Button Classes="Accent"
                                                    Content="{Localize RibbonShellStrings.AttachToDocument}"
                                                    Command="{Binding AttachCommand}"
                                                    Margin="0 0 8 0"/>
                                            <Button Classes="Critical"
                                                    Content="{Localize RibbonShellStrings.UninstallModule}"
                                                    Command="{Binding UninstallCommand}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=UpdateAvailable}">
                                            <Button Classes="Accent"
                                                    Content="{Localize RibbonShellStrings.UpdateModule}"
                                                    Command="{Binding UpdateCommand}"
                                                    Margin="0 0 8 0"/>
                                            <Button Content="{Localize RibbonShellStrings.AttachToDocument}"
                                                    Command="{Binding AttachCommand}"/>
                                        </StackPanel>

                                        <Button Classes="Accent"
                                                Content="{Localize RibbonShellStrings.InstallModule}"
                                                Command="{Binding InstallCommand}"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Available}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Ribbon.Drawer>

            <!-- ================= HOME ================= -->
            <!-- Alt shows the letters; these are stated so they read like Office's rather than being worked out from
                 the labels. Everything unnamed still gets one - see KeyTipService.AutoAssign. -->
            <RibbonTab Header="{Localize RibbonShellStrings.Home}" KeyTipService.KeyTip="H">
                <RibbonGroup Header="{Localize RibbonShellStrings.Clipboard}" Icon="{ObservableResource ClipboardIcon}">
                    <!-- Split: the body pastes, the arrow offers the rarer ways to paste. Both halves are disabled
                         together - the command gates the whole thing. The rows are the command's own DATA, which is
                         what lets it sit in the quick-access bar and keep its arrow there. -->
                    <RibbonSplitButton Classes="Shell"
                                       DataContext="{Binding Commands.Paste}"
                                       ToolTip="{Localize RibbonShellStrings.PasteTip}">
                        <RibbonSplitButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Localize RibbonShellStrings, Key={Binding Header}}"/>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                                <ContextMenu.ItemContainerStyle>
                                    <Style Selector="MenuItem">
                                        <Setter Property="Command" Value="{Binding Command}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </RibbonSplitButton.DropDownMenu>
                    </RibbonSplitButton>
                    <!-- Medium: small icon, label beside it - three stack into one column. -->
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Cut}"
                                  AutomationProperties.AutomationId="Cut"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Copy}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Duplicate}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Scene}" Icon="{ObservableResource SceneIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Entity}"
                                  ToolTip="{Localize RibbonShellStrings.EntityTip}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Delete}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectAll}"
                                  MaxSize="Medium"
                                  CollapseToSmall="Never"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectNone}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.View}" Icon="{ObservableResource ViewIcon}">
                    <!-- The state these show is the command's own, so this button, the one in the View tab and the one in
                         the quick-access bar are three views of one value - not three values kept in step. -->
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Wireframe}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Grid}"
                                        MaxSize="Medium"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Gizmos}"
                                        MaxSize="Medium"/>
                    <!-- A separator ends the run beside it, so what follows starts a fresh column. -->
                    <Separator/>
                    <!-- A group hosts ORDINARY controls too. They state the same range through the ATTACHED form - a
                         Slider has no reason to grow a `MaxSize` of its own. They are the demo's switches, not commands
                         of the shell, so the quick-access bar is not offered them. -->
                    <CheckBox Content="{Localize RibbonShellStrings.HasSelection}"
                              Ribbon.MaxSize="Medium"
                              Ribbon.CollapseToSmall="Never"
                              Ribbon.CanAddToQuickAccess="False"
                              Margin="4 2"
                              IsChecked="{Binding HasSelection, Mode=TwoWay}"/>
                    <TextBlock x:Name="GridSizeLabel" Text="{Localize RibbonShellStrings.GridSize}" Ribbon.MaxSize="Medium" Ribbon.CollapseToSmall="Never" Margin="6 4 4 0" FontSize="11"/>
                    <!-- Not offered to the quick-access bar at all: a 120-wide control does not belong in a caption
                         strip shared with the window title. Word makes the same call - its zoom slider lives in the
                         status bar and cannot be added either. -->
                    <Slider AutomationProperties.AutomationId="GridSize" AutomationProperties.LabeledBy="{Binding ElementName=GridSizeLabel}"
                            Ribbon.MaxSize="Medium" Ribbon.CollapseToSmall="Never" Ribbon.CanAddToQuickAccess="False"
                            Width="120" Margin="4 2"
                            Minimum="0.1" Maximum="4" Value="{Binding GridSize, Mode=TwoWay}"/>
                    <CheckBox Content="{Localize RibbonShellStrings.Backstage}"
                              Ribbon.MaxSize="Medium"
                              Ribbon.CollapseToSmall="Never"
                              Ribbon.CanAddToQuickAccess="False"
                              Margin="4 2"
                              IsChecked="{Binding IsBackstage, Mode=TwoWay}"/>
                    <Separator/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.MoveQuickAccess}"
                                  MaxSize="Medium"
                                  ToolTip="{Localize RibbonShellStrings.MoveQuickAccessTip}"/>
                </RibbonGroup>

                <!-- A gallery: the choice IS the picture, so it is shown rather than listed. Its items are DATA - the
                     dropped-down copy builds its own cells from the same template. -->
                <RibbonGroup Header="{Localize RibbonShellStrings.Materials}" ShrinkSteps="None" Icon="{ObservableResource MaterialsIcon}">
                    <RibbonGallery ItemsSource="{Binding Materials}"
                                   SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                                   Columns="4"
                                   CompactColumns="2"
                                   Rows="2"
                                   DropDownColumns="4"
                                   Ribbon.CollapseToSmall="Never"
                                   Ribbon.CanAddToQuickAccess="False">
                        <RibbonGallery.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Width="52">
                                    <Rectangle Height="20"
                                               Fill="{Binding Fill}"
                                               CornerRadius="2"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="10"
                                               Margin="0 2 0 0"
                                               HorizontalTextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </RibbonGallery.ItemTemplate>
                    </RibbonGallery>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Arrange}" ShrinkSteps="None" Icon="{ObservableResource ArrangeIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.AlignLeft}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Center}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Distribute}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Group}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Order}" ShrinkSteps="None" Icon="{ObservableResource OrderIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Forward}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Backward}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Lighting}" ShrinkSteps="None" Icon="{ObservableResource LightIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.AddLight}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bake}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Physics}" ShrinkSteps="None" Icon="{ObservableResource PhysicsIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Collider}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Simulate}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <!-- What the contextual tabs hang on. Two toggles rather than a real selection: the point on show is
                     the STRIP - one context, two contexts, and the order they arrive in. The demo's switches, not
                     commands of the shell, so the quick-access bar is not offered them. -->
                <RibbonGroup Header="{Localize RibbonShellStrings.Context}" ShrinkSteps="None" Icon="{ObservableResource SelectionIcon}">
                    <RibbonToggleButton Content="{Localize RibbonShellStrings.Mesh}"
                                        MaxSize="Medium"
                                        Ribbon.CanAddToQuickAccess="False"
                                        IsChecked="{Binding HasMeshSelection, Mode=TwoWay}"
                                        ToolTip="{Localize RibbonShellStrings.MeshTip}"
                                        Icon="{ObservableResource SceneIcon}"/>
                    <RibbonToggleButton Content="{Localize RibbonShellStrings.Light}"
                                        MaxSize="Medium"
                                        Ribbon.CanAddToQuickAccess="False"
                                        IsChecked="{Binding HasLightSelection, Mode=TwoWay}"
                                        ToolTip="{Localize RibbonShellStrings.LightTip}"
                                        Icon="{ObservableResource LightIcon}"/>
                    <RibbonToggleButton Content="{Localize RibbonShellStrings.Ledge}"
                                        MaxSize="Medium"
                                        Ribbon.CanAddToQuickAccess="False"
                                        IsChecked="{Binding ShowContextHeader, Mode=TwoWay}"
                                        ToolTip="{Localize RibbonShellStrings.LedgeTip}"
                                        Icon="{ObservableResource LedgeIcon}"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Tools}" ShrinkSteps="None" Icon="{ObservableResource ToolsIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Measure}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Annotate}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= MODELING ================= -->
            <RibbonTab Header="{Localize RibbonShellStrings.Modeling}" KeyTipService.KeyTip="M">
                <!-- One tool at a time: the four are one choice of the view model, each button a view of it. The bar has
                     no set to hold one of them in, so they are not offered to it. -->
                <RibbonGroup Header="{Localize RibbonShellStrings.Transform}"
                             Icon="{ObservableResource TransformIcon}">
                    <RibbonRadioButton AutomationProperties.AutomationId="SelectGizmo"
                                       GroupName="Gizmo"
                                       Content="{Localize RibbonShellStrings.SelectGizmo}"
                                       Icon="{ObservableResource SelectGizmoIcon}"
                                       Ribbon.CanAddToQuickAccess="False"
                                       IsChecked="{Binding Gizmo, Converter={conv:EnumToBoolConverter}, ConverterParameter=Select, Mode=TwoWay}"/>
                    <RibbonRadioButton AutomationProperties.AutomationId="MoveGizmo"
                                       GroupName="Gizmo"
                                       Content="{Localize RibbonShellStrings.MoveGizmo}"
                                       Icon="{ObservableResource MoveGizmoIcon}"
                                       MaxSize="Medium"
                                       Ribbon.CanAddToQuickAccess="False"
                                       IsChecked="{Binding Gizmo, Converter={conv:EnumToBoolConverter}, ConverterParameter=Move, Mode=TwoWay}"/>
                    <RibbonRadioButton AutomationProperties.AutomationId="RotateGizmo"
                                       GroupName="Gizmo"
                                       Content="{Localize RibbonShellStrings.RotateGizmo}"
                                       Icon="{ObservableResource RotateGizmoIcon}"
                                       MaxSize="Medium"
                                       Ribbon.CanAddToQuickAccess="False"
                                       IsChecked="{Binding Gizmo, Converter={conv:EnumToBoolConverter}, ConverterParameter=Rotate, Mode=TwoWay}"/>
                    <RibbonRadioButton AutomationProperties.AutomationId="ScaleGizmo"
                                       GroupName="Gizmo"
                                       Content="{Localize RibbonShellStrings.ScaleGizmo}"
                                       Icon="{ObservableResource ScaleGizmoIcon}"
                                       MaxSize="Medium"
                                       Ribbon.CanAddToQuickAccess="False"
                                       IsChecked="{Binding Gizmo, Converter={conv:EnumToBoolConverter}, ConverterParameter=Scale, Mode=TwoWay}"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Primitives}" Icon="{ObservableResource PrimitivesIcon}">
                    <!-- Drops a menu instead of doing something. The rows are the command's DATA: a menu of MenuItem
                         CONTROLS cannot be in two places, so it would reach the quick-access bar as an arrow over nothing. -->
                    <RibbonDropDownButton Classes="Shell"
                                          DataContext="{Binding Commands.Add}"
                                          ToolTip="{Localize RibbonShellStrings.AddTip}">
                        <RibbonDropDownButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Localize RibbonShellStrings, Key={Binding Header}}"/>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                                <ContextMenu.ItemContainerStyle>
                                    <Style Selector="MenuItem">
                                        <Setter Property="Command" Value="{Binding Command}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </RibbonDropDownButton.DropDownMenu>
                    </RibbonDropDownButton>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Cube}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Sphere}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Plane}"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Mesh}" Icon="{ObservableResource MeshIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Extrude}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bevel}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Subdivide}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Snapping}"
                             Icon="{ObservableResource SnappingIcon}">
                    <!-- THIS group's commands get the shell's OWN right-click menu instead of the ribbon's. The property
                         is inherited, so the same attribute on <Ribbon> would speak for the whole band; written here it
                         overrides just this group. Its rows are the commands' own DATA - nothing about them reaches the
                         ribbon. Write {x:Null} instead and the commands get no menu at all. -->
                    <Ribbon.CommandContextMenuTemplate>
                        <DataTemplate>
                            <ContextMenu ItemsSource="{Binding MenuRows}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Localize RibbonShellStrings, Key={Binding Header}}"/>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                                <ContextMenu.ItemContainerStyle>
                                    <Style Selector="MenuItem">
                                        <Setter Property="Command" Value="{Binding Command}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </DataTemplate>
                    </Ribbon.CommandContextMenuTemplate>

                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Snap}"/>
                    <!-- Small: the icon alone, three to a column. MaxSize is a RANGE - the adaptive pass may only shrink. -->
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.SnapToVertices}"
                                        MaxSize="Small"
                                        ToolTip="{Localize RibbonShellStrings.SnapToVertices}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.SnapToEdges}"
                                        MaxSize="Small"
                                        ToolTip="{Localize RibbonShellStrings.SnapToEdges}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.SnapToFaces}"
                                        MaxSize="Small"
                                        ToolTip="{Localize RibbonShellStrings.SnapToFaces}"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= MATERIALS ================= -->
            <RibbonTab Header="{Localize RibbonShellStrings.Materials}" KeyTipService.KeyTip="A">
                <RibbonGroup Header="{Localize RibbonShellStrings.Library}" Icon="{ObservableResource LibraryIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.NewMaterial}"
                                  ToolTip="{Localize RibbonShellStrings.NewMaterialTip}"/>
                    <!-- An icon that is not path data at all: a COLOR, drawn as a disc by the command's own template. A
                         look on show, not a command of the shell, so it stays out of the quick-access bar. -->
                    <RibbonButton Content="{Localize RibbonShellStrings.Swatch}"
                                  MaxSize="Medium"
                                  Icon="Coral"
                                  Ribbon.CanAddToQuickAccess="False"
                                  Command="{Binding NewMaterialCommand}"
                                  ToolTip="{Localize RibbonShellStrings.SwatchTip}">
                        <RibbonButton.IconTemplate>
                            <DataTemplate>
                                <Ellipse Width="14" Height="14" EllipseType="EdgeToEdge" Fill="{Binding}"/>
                            </DataTemplate>
                        </RibbonButton.IconTemplate>
                    </RibbonButton>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Channels}" Icon="{ObservableResource ChannelsIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Albedo}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Normal}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Roughness}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Preview}" Icon="{ObservableResource PreviewIcon}">
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Wireframe}"/>
                    <TextBlock Text="{Localize RibbonShellStrings.Shading}" Ribbon.MaxSize="Medium" Ribbon.CollapseToSmall="Never" Margin="6 4 4 0" FontSize="11"/>
                    <DropDown Ribbon.MaxSize="Medium"
                              Ribbon.CollapseToSmall="Never"
                              Ribbon.CanAddToQuickAccess="False"
                              Width="140"
                              Margin="4 2"
                              ItemsSource="{Binding ShadingModes}"
                              SelectedItem="{Binding ShadingMode, Mode=TwoWay}">
                        <DropDown.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Localize RibbonShellStrings, Key={Binding}}"/>
                            </DataTemplate>
                        </DropDown.ItemTemplate>
                    </DropDown>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= VIEW ================= -->
            <RibbonTab Header="{Localize RibbonShellStrings.View}" KeyTipService.KeyTip="V">
                <RibbonGroup Header="{Localize RibbonShellStrings.Display}" Icon="{ObservableResource DisplayIcon}">
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Grid}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Gizmos}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Wireframe}"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Selection}" Icon="{ObservableResource SelectionIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectAll}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectNone}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Delete}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= CONTEXTUAL ================= -->
            <!-- Tabs that turn up under a task. The contexts are declared once on the ribbon; a tab names the one it
                 belongs to by key, because a group is not a visual and cannot be pointed at as an element. -->
            <Ribbon.ContextualGroups>
                <RibbonContextualGroup Key="MeshTools"
                                       Header="{Localize RibbonShellStrings.MeshTools}"
                                       Accent="#B85C2E"
                                       ShowHeader="{Binding ShowContextHeader}"
                                       IsActive="{Binding HasMeshSelection}"/>
                <RibbonContextualGroup Key="LightTools"
                                       Header="{Localize RibbonShellStrings.LightTools}"
                                       Accent="#3F7CBF"
                                       ShowHeader="{Binding ShowContextHeader}"
                                       IsActive="{Binding HasLightSelection}"/>
            </Ribbon.ContextualGroups>

            <!-- TWO tabs in one context: they stand together under ONE ledge spanning both. -->
            <RibbonTab Header="{Localize RibbonShellStrings.Geometry}" ContextualGroupKey="MeshTools" KeyTipService.KeyTip="G">
                <RibbonGroup Header="{Localize RibbonShellStrings.Edit}" Icon="{ObservableResource SplitIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Extrude}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bevel}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Subdivide}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="{Localize RibbonShellStrings.Uv}" ContextualGroupKey="MeshTools" KeyTipService.KeyTip="U">
                <RibbonGroup Header="{Localize RibbonShellStrings.Unwrap}" Icon="{ObservableResource UnwrapIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Unwrap}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Measure}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- A SECOND context, so the strip has to order two of them - the one switched on last stands furthest
                 right and does not shift what someone was already aiming at. -->
            <RibbonTab Header="{Localize RibbonShellStrings.Light}" ContextualGroupKey="LightTools" KeyTipService.KeyTip="L">
                <RibbonGroup Header="{Localize RibbonShellStrings.Emission}" Icon="{ObservableResource EmissionIcon}">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bake}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.AddLight}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <!-- The "document": a stand-in surface the commands land on. -->
        <Border Grid.Row="1" Margin="16" CornerRadius="6"
                Background="{ResourceReference SolidBackgroundFillColorSecondary}"
                BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="1">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Localize RibbonShellStrings.SceneView}" FontSize="22" HorizontalAlignment="Center"
                           Foreground="{ResourceReference TextFillColorPrimary}"/>
                <TextBlock Text="{Localize RibbonShellStrings.Status, action={Binding LastAction}, format={Binding Format}}" FontSize="14" Margin="0 12 0 0" HorizontalAlignment="Center"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <TextBlock Text="{Localize RibbonShellStrings, Key={Binding ShadingMode}}" FontSize="13" Margin="0 16 0 0" HorizontalAlignment="Center"
                           Foreground="{ResourceReference TextFillColorTertiary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Height="26" Background="{ResourceReference SolidBackgroundFillColorTertiary}">
            <TextBlock AutomationProperties.AutomationId="StatusLine"
                       Text="{Localize RibbonShellStrings.Status, action={Binding LastAction}, format={Binding Format}}" VerticalAlignment="Center" Margin="12 0" FontSize="12"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
        </Border>
    </Grid>
</View>

