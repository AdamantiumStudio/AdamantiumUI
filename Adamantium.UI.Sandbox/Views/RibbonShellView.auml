                                 Icon="{ObservableResource CeilingLampIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.CeilingLamp}"
                                      Icon="{ObservableResource CeilingLampIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.WallLamp}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource WallLampIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.FloorLamp}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource FloorLampIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Daylight}"
                                 Icon="{ObservableResource DaylightIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.LightFromWindows}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource WindowOpeningIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Bake}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource BakeIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
