<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters"
      xmlns:views="clr-namespace:Adamantium.UI.Sandbox.Views">
    <!-- A module as the menu and the catalog show it: its color, its words, where it stands. The data is the module
         itself, so one template serves the drop-down's rows and the catalog's cards. -->
    <ResourceContext.Resources>
        <!-- The question asked before a module leaves the document: what stays, what gets marked. -->
        <DataTemplate x:Key="DetachQuestion">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Localize RibbonShellStrings.DetachTitle}"
                           FontSize="15"/>
                <TextBlock Text="{Localize RibbonShellStrings.DetachText}"
                           TextWrapping="WrapByWords"
                           Margin="0 8 0 0"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto"
                      Margin="0 10 0 0">
                    <TextBlock Text="{Localize RibbonShellStrings.StaysInFile}"
                               FontSize="12"
                               Margin="0 0 12 4"
                               Foreground="{ResourceReference TextFillColorTertiary}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Localize Table={Binding Phrases}, Key={Binding Content}}"
                               FontSize="12"
                               TextWrapping="WrapByWords"/>
                    <TextBlock Grid.Row="1"
                               Text="{Localize RibbonShellStrings.GetsMarked}"
                               FontSize="12"
                               Margin="0 0 12 0"
                               Foreground="{ResourceReference TextFillColorTertiary}"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Localize Table={Binding Phrases}, Key={Binding Dependents}}"
                               FontSize="12"
                               TextWrapping="WrapByWords"/>
                </Grid>
                <TextBlock Text="{Localize RibbonShellStrings.MarkedHint}"
                           FontSize="12"
                           TextWrapping="WrapByWords"
                           Margin="0 8 0 0"
                           Foreground="{ResourceReference TextFillColorTertiary}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 12 0 0">
                    <Button Content="{Localize RibbonShellStrings.Cancel}"
                            Command="{Binding KeepAttachedCommand}"
                            Margin="0 0 8 0"/>
                    <Button Classes="Accent"
                            Content="{Localize RibbonShellStrings.Detach}"
                            Command="{Binding DetachCommand}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A row of the "Modules" drop-down: the switch is the row itself; the button beside it takes the module out
             of the document, after the question it opens next to the row. -->
        <DataTemplate x:Key="ModuleRow">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Margin="0 5 10 0"
                        VerticalAlignment="Top"
                        Background="{Binding Accent}"/>
                <StackPanel Grid.Column="1"
                            Orientation="Vertical">
                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Name}}"/>
                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Info}}"
                               FontSize="12"
                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="Toolbar"
                        Margin="16 0 0 0"
                        Padding="4"
                        VerticalAlignment="Center"
                        ToolTip="{Localize RibbonShellStrings.DetachFromDocument}"
                        Command="{Binding AskDetachCommand}">
                    <Path Data="M5,1 L5,4 M11,1 L11,4 M3,4 L13,4 L13,7 A5,5 0 0 1 3,7 Z M8,12 L8,15 M1,1 L15,15"
                          Stroke="{ResourceReference TextFillColorSecondary}"
                          StrokeThickness="1.25"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
                <Popup Grid.Column="2"
                       Placement="Right"
                       PlacementAlignment="Start"
                       HorizontalOffset="16"
                       KeepOpen="False"
                       IsOpen="{Binding IsDetachAsked, Mode=TwoWay}">
                    <Border Width="380"
                            Padding="16"
                            CornerRadius="8"
                            Background="{ResourceReference FlyoutSurfaceFill}"
                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                            BorderThickness="1">
                        <ContentPresenter Content="{Binding}"
                                          ContentTemplate="{ResourceReference DetachQuestion}"/>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Where a module stands, in its own color: in the document, detached with its data kept, an update. -->
        <DataTemplate x:Key="ModuleStateTag">
            <Grid>
                <TextBlock Text="{Localize RibbonShellStrings.ModuleState, state={Binding State}}"
                           FontSize="11"
                           Foreground="{ResourceReference SystemFillColorSuccess}"
                           Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=InDocument}"/>
                <TextBlock Text="{Localize RibbonShellStrings.ModuleState, state={Binding State}}"
                           FontSize="11"
                           Foreground="{ResourceReference TextFillColorSecondary}"
                           Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Installed}"/>
                <TextBlock Text="{Localize RibbonShellStrings.ModuleState, state={Binding State}}"
                           FontSize="11"
                           Foreground="{ResourceReference SystemFillColorCaution}"
                           Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Detached}"/>
                <TextBlock Text="{Localize RibbonShellStrings.ModuleState, state={Binding State}}"
                           FontSize="11"
                           Foreground="{ResourceReference AccentFillColorDefault}"
                           Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=UpdateAvailable}"/>
                <TextBlock Text="{Localize RibbonShellStrings.ModuleState, state={Binding State}}"
                           FontSize="11"
                           Foreground="{ResourceReference TextFillColorTertiary}"
                           Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Available}"/>
            </Grid>
        </DataTemplate>

        <!-- What each module brings to the ribbon: its tabs under a ledge of its own, bound against the module - its
             commands are the module's. A module with no piece of its own takes ModuleRibbon. The quick-access bar
             holds the shell's own commands, so a module's are not offered to it. -->
        <DataTemplate x:Key="SurfaceModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.SurfaceHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.Terrain}"
                           KeyTipService.KeyTip="T">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Sculpt}"
                                 Icon="M1,13 L6,6 L9,10 L11,7 L15,13 Z">
                        <RibbonButton Content="{Localize RibbonShellStrings.Raise}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="Raised"
                                      Icon="M1,14 L5,10 L11,10 L15,14 M8,2 L8,7 M6,4 L8,2 L10,4"/>
                        <RibbonButton Content="{Localize RibbonShellStrings.Lower}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      MaxSize="Medium"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="Lowered"
                                      Icon="M1,10 L5,14 L11,14 L15,10 M8,2 L8,7 M6,5 L8,7 L10,5"/>
                        <RibbonButton Content="{Localize RibbonShellStrings.Smooth}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      MaxSize="Medium"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="Smoothed"
                                      Icon="M1,11 L4,8 L7,9 L10,8 L15,9"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <DataTemplate x:Key="SpaceModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.SpaceHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.System}"
                           KeyTipService.KeyTip="S">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Bodies}"
                                 Icon="M8,4 A4,4 0 1 0 8,12 A4,4 0 1 0 8,4 M1,10 L15,6">
                        <RibbonButton Content="{Localize RibbonShellStrings.Star}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="AddedStar"
                                      Icon="M8,1 L9.8,5.6 L14.6,5.8 L10.8,8.8 L12.2,13.6 L8,10.8 L3.8,13.6 L5.2,8.8 L1.4,5.8 L6.2,5.6 Z"/>
                        <RibbonButton Content="{Localize RibbonShellStrings.Planet}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      MaxSize="Medium"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="AddedPlanet"
                                      Icon="M8,4 A4,4 0 1 0 8,12 A4,4 0 1 0 8,4 M1,10 L15,6"/>
                        <RibbonButton Content="{Localize RibbonShellStrings.Moon}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      MaxSize="Medium"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="AddedMoon"
                                      Icon="M10,2 A6,6 0 1 0 14,11 A5,5 0 1 1 10,2 Z"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <DataTemplate x:Key="ModuleRibbon">
            <RibbonTabSet Header="{Localize Table={Binding Phrases}, Key={Binding Name}}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize Table={Binding Phrases}, Key={Binding Name}}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Tools}"
                                 Icon="{Binding Icon}"
                                 IconTemplate="{ResourceReference ModuleIcon}">
                        <RibbonButton Content="{Localize RibbonShellStrings.Add}"
                                      Ribbon.CanAddToQuickAccess="False"
                                      Command="{Binding UseCommand}"
                                      CommandParameter="ModuleToolUsed"
                                      Icon="{Binding Icon}"
                                      IconTemplate="{ResourceReference ModuleIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <!-- A command of the shell as a row of the customize page: its icon and its name. -->
        <DataTemplate x:Key="CommandRow">
            <StackPanel Orientation="Horizontal">
                <Path Data="{Binding Icon}"
                      Stroke="{ResourceReference TextFillColorPrimary}"
                      StrokeThickness="1"
                      Width="16"
                      Height="16"
                      Margin="0 0 10 0"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{Localize RibbonShellStrings, Key={Binding Name}}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- A module's icon on a tile of its color. -->
        <DataTemplate x:Key="ModuleTile">
            <Border Width="36"
                    Height="36"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{Binding Accent}">
                <Image Source="{Binding Icon}"
                       Width="20"
                       Height="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- A module's icon is a picture, not path data: the ribbon draws it as one. -->
        <DataTemplate x:Key="ModuleIcon">
            <Image Source="{Binding}"
                   Width="16"
                   Height="16"/>
        </DataTemplate>
    </ResourceContext.Resources>
    <!-- An editor shell: a ribbon band, a document surface, a status line. Exercises the three command sizes, commands
         graying out on CanExecute, two-way toggles, ordinary controls inside a group, a separator breaking a column,
         and the quick-access bar in the caption reading the SAME view model (see RibbonWindow.auml). -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The ribbon states WHAT was asked and what it looks like; this shell decides what its own quick-access items
             are made of and owns the list. Bound once here - the properties inherit down to every command in the band.
             The list itself is bound too, READ-ONLY: that is how a command knows to offer "remove" rather than "add",
             without anyone writing a mark back into the ribbon. -->
        <Ribbon Grid.Row="0" x:Name="Band"
                Ribbon.AddToQuickAccessCommand="{Binding AddToQuickAccessCommand}"
                Ribbon.RemoveFromQuickAccessCommand="{Binding RemoveFromQuickAccessCommand}"
                Ribbon.QuickAccessItems="{Binding QuickAccess}"
                IsDrawerOpen="{Binding IsModuleCatalogOpen, Mode=TwoWay}"
                TabSetsSource="{Binding DocumentModules}">

            <!-- The band's commands are drawn from the shell's catalog (classes Shell / ShellToggle, styled in
                 RibbonShellStyleSet): the quick-access bar and the customize page draw from the same commands, so
                 nothing is stated twice and nothing is kept in step. -->

            <!-- Each module of the document brings its tabs: its own piece of view, or the common one. -->
            <Ribbon.TabSetTemplateSelector>
                <views:ModuleRibbonSelector FallbackKey="ModuleRibbon"/>
            </Ribbon.TabSetTemplateSelector>

            <!-- "File": a command that opens a menu, so the flyout is the ContextMenu one already is. The two-pane
                 version - recent files beside the commands - is a later step. -->
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Header="{Localize RibbonShellStrings.File}" IsBackstage="{Binding IsBackstage}">
                    <!-- A row with a PAGE opens it beside the rail and stays lit; a row without one is a command that
                         runs and closes the backstage behind it. -->
                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.New}" Icon="M8,2 L8,14 M2,8 L14,8">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.NewScene}" FontSize="28" Margin="0 0 0 18"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Localize RibbonShellStrings.EmptyScene}" Command="{Binding NewSceneCommand}" Margin="0 0 10 0"/>
                                    <Button Content="{Localize RibbonShellStrings.FromTemplate}" Command="{Binding NewSceneCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Open}" Icon="M2,4 L7,4 L8,6 L14,6 L14,13 L2,13 Z">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.RecentScenes}" FontSize="28" Margin="0 0 0 18"/>
                                <Button Content="city-block.scene" Command="{Binding OpenSceneCommand}" Margin="0 0 0 6"/>
                                <Button Content="character-rig.scene" Command="{Binding OpenSceneCommand}" Margin="0 0 0 6"/>
                                <Button Content="lighting-study.scene" Command="{Binding OpenSceneCommand}"/>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Save}" Command="{Binding SaveCommand}"
                                               Icon="M3,2 L11,2 L13,4 L13,13 L3,13 Z M5,2 L5,6 L11,6 L11,2"/>

                    <!-- The rows the pane-follows-the-pointer behavior is worth seeing on: run the pointer down
                         Import / Export / Print and the right half changes under it, with nothing clicked. -->
                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Import}" Icon="M8,2 L8,10 M5,7 L8,10 L11,7 M3,13 L13,13">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.Import}" FontSize="28" Margin="0 0 0 6"/>
                                <TextBlock Text="{Localize RibbonShellStrings.ImportHint}" Opacity="0.7" Margin="0 0 0 18"/>
                                <Button Content="Wavefront .obj" Command="{Binding ImportCommand}" CommandParameter=".obj" Margin="0 0 0 6"/>
                                <Button Content="Autodesk .fbx" Command="{Binding ImportCommand}" CommandParameter=".fbx" Margin="0 0 0 6"/>
                                <Button Content="Khronos .gltf" Command="{Binding ImportCommand}" CommandParameter=".gltf"/>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Export}" Icon="M8,10 L8,2 M5,5 L8,2 L11,5 M3,13 L13,13">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.Export}" FontSize="28" Margin="0 0 0 6"/>
                                <TextBlock Text="{Localize RibbonShellStrings.ExportHint}" Opacity="0.7" Margin="0 0 0 18"/>
                                <Button Content="Wavefront .obj" Command="{Binding ExportCommand}" CommandParameter=".obj" Margin="0 0 0 6"/>
                                <Button Content="Khronos .gltf" Command="{Binding ExportCommand}" CommandParameter=".gltf" Margin="0 0 0 6"/>
                                <Button Content="{Localize RibbonShellStrings.AdamantiumPackage}" Command="{Binding ExportCommand}" CommandParameter=".apkg"/>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Print}" Icon="M4,6 L4,2 L12,2 L12,6 M4,10 L12,10 L12,14 L4,14 Z M2,6 L14,6 L14,10 L2,10 Z">
                        <RibbonApplicationMenuItem.PageContent>
                            <StackPanel>
                                <TextBlock Text="{Localize RibbonShellStrings.Print}" FontSize="28" Margin="0 0 0 6"/>
                                <TextBlock Text="{Localize RibbonShellStrings.PrintHint}" Opacity="0.7" Margin="0 0 0 18"/>
                                <TextBlock Text="{Localize RibbonShellStrings.Printer}" Margin="0 0 0 4" Opacity="0.7"/>
                                <DropDown Width="200" HorizontalAlignment="Left" SelectedIndex="0">
                                    <DropDownItem Content="Microsoft Print to PDF"/>
                                    <DropDownItem Content="Office printer (2nd floor)"/>
                                </DropDown>
                            </StackPanel>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <!-- The quick-access bar set up the way Word sets up its own: the commands on offer on the left, what
                         is in the bar on the right, in its order. Both lists are the shell's commands as data - the
                         ribbon's buttons stay where they stand. -->
                    <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Customize}"
                                               Icon="M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5 M8,1 L8,3 M8,13 L8,15 M1,8 L3,8 M13,8 L15,8">
                        <RibbonApplicationMenuItem.PageContent>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="280,Auto,280,Auto"
                                  HorizontalAlignment="Left">
                                <TextBlock Grid.ColumnSpan="4"
                                           Text="{Localize RibbonShellStrings.QuickAccess}"
                                           FontSize="28"
                                           Margin="0 0 0 6"/>
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Text="{Localize RibbonShellStrings.QuickAccessHint}"
                                           Opacity="0.7"
                                           Margin="0 0 0 18"/>

                                <StackPanel Grid.Row="2"
                                            Orientation="Vertical"
                                            Margin="0 0 0 8">
                                    <TextBlock Text="{Localize RibbonShellStrings.ChooseCommandsFrom}"
                                               Margin="0 0 0 4"
                                               Opacity="0.7"/>
                                    <DropDown ItemsSource="{Binding CommandSources}"
                                              SelectedItem="{Binding CommandSource, Mode=TwoWay}">
                                        <DropDown.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize RibbonShellStrings.CommandSource, source={Binding}}"/>
                                            </DataTemplate>
                                        </DropDown.ItemTemplate>
                                    </DropDown>
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="{Localize RibbonShellStrings.InTheBar}"
                                           VerticalAlignment="Bottom"
                                           Margin="0 0 0 12"
                                           Opacity="0.7"/>

                                <ListBox Grid.Row="3"
                                         Height="320"
                                         ItemsSource="{Binding CommandChoices}"
                                         SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                         ItemTemplate="{ResourceReference CommandRow}"/>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="1"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Margin="12 0">
                                    <Button Content="{Localize RibbonShellStrings.AddToBar}"
                                            Command="{Binding AddToBarCommand}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0 0 0 8"/>
                                    <Button Content="{Localize RibbonShellStrings.RemoveFromBar}"
                                            Command="{Binding RemoveFromBarCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <ListBox Grid.Row="3"
                                         Grid.Column="2"
                                         Height="320"
                                         ItemsSource="{Binding QuickAccess}"
                                         SelectedItem="{Binding SelectedBarItem, Mode=TwoWay}"
                                         ItemTemplate="{ResourceReference CommandRow}"/>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="3"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Margin="12 0 0 0">
                                    <Button Classes="Toolbar"
                                            Padding="6"
                                            Margin="0 0 0 8"
                                            ToolTip="{Localize RibbonShellStrings.MoveUp}"
                                            Command="{Binding MoveUpInBarCommand}">
                                        <Path Data="M8,3 L8,13 M4,7 L8,3 L12,7"
                                              Stroke="{ResourceReference TextFillColorPrimary}"
                                              StrokeThickness="1.25"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Classes="Toolbar"
                                            Padding="6"
                                            ToolTip="{Localize RibbonShellStrings.MoveDown}"
                                            Command="{Binding MoveDownInBarCommand}">
                                        <Path Data="M8,3 L8,13 M4,9 L8,13 L12,9"
                                              Stroke="{ResourceReference TextFillColorPrimary}"
                                              StrokeThickness="1.25"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="4"
                                            Grid.ColumnSpan="4"
                                            Orientation="Horizontal"
                                            Margin="0 16 0 0">
                                    <CheckBox Content="{Localize RibbonShellStrings.ShowBelowRibbon}"
                                              IsChecked="{Binding IsQuickAccessBelow, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                    <Button Content="{Localize RibbonShellStrings.ResetBar}"
                                            Command="{Binding ResetQuickAccessCommand}"
                                            Margin="24 0 0 0"/>
                                </StackPanel>
                            </Grid>
                        </RibbonApplicationMenuItem.PageContent>
                    </RibbonApplicationMenuItem>

                    <!-- What the dropped panel shows until the pointer picks a row. The backstage never needs it: it
                         always stands on a chosen row. -->
                    <RibbonApplicationMenu.AuxiliaryPaneContent>
                        <StackPanel>
                            <TextBlock Text="{Localize RibbonShellStrings.RecentScenes}" FontSize="20" Margin="0 0 0 14"/>
                            <TextBlock Text="city-block.scene" Margin="0 0 0 6" Opacity="0.75"/>
                            <TextBlock Text="character-rig.scene" Margin="0 0 0 6" Opacity="0.75"/>
                            <TextBlock Text="lighting-study.scene" Opacity="0.75"/>
                        </StackPanel>
                    </RibbonApplicationMenu.AuxiliaryPaneContent>

                    <RibbonApplicationMenu.FooterPaneContent>
                        <StackPanel Margin="0 0 0 12">
                            <RibbonApplicationMenuItem Content="{Localize RibbonShellStrings.Exit}" Command="{Binding ExitCommand}"
                                                       Icon="M6,3 L3,3 L3,13 L6,13 M9,5 L12,8 L9,11 M12,8 L6,8"/>
                        </StackPanel>
                    </RibbonApplicationMenu.FooterPaneContent>
                </RibbonApplicationMenu>
            </Ribbon.ApplicationMenu>

            <!-- The SAME collection the caption bar lists. Two instances, one list: each shows itself only while the
                 placement names its own slot, so moving the bar moves nothing. -->
            <Ribbon.FooterContent>
                <RibbonQuickAccess ItemsSource="{Binding QuickAccess}"
                                   Placement="{Binding QuickAccessPlacement}"
                                   Ribbon.RemoveFromQuickAccessCommand="{Binding RemoveFromQuickAccessCommand}"
                                   Margin="6 2 6 3"
                                   HorizontalAlignment="Left">
                    <RibbonQuickAccess.ItemTemplateSelector>
                        <views:ShellQuickAccessTemplateSelector Toggle="{ResourceReference QuickAccessToggleTemplate}"
                                                                DropDown="{ResourceReference QuickAccessDropDownTemplate}"
                                                                Split="{ResourceReference QuickAccessSplitTemplate}"/>
                    </RibbonQuickAccess.ItemTemplateSelector>
                </RibbonQuickAccess>
            </Ribbon.FooterContent>

            <!-- What the document is made of, next to "File". Each module is a switch that leaves the menu open, so
                 several can be flipped in one go; a module that is on brings its own tabs (the contexts below). -->
            <Ribbon.StripContent>
                <RibbonDropDownButton Ribbon.Size="Medium"
                                      Ribbon.CanAddToQuickAccess="False"
                                      Icon="M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z M5.5,2 L10.5,2 L10.5,7 L5.5,7 Z"
                                      KeyTipService.KeyTip="D">
                    <RibbonDropDownButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Localize RibbonShellStrings.Modules}"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="8"
                                    MinWidth="16"
                                    Height="16"
                                    Padding="4 0"
                                    Margin="6 0 0 0"
                                    VerticalAlignment="Center"
                                    Background="{ResourceReference SubtleFillColorTertiary}">
                                <TextBlock Text="{Binding ModuleCount}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RibbonDropDownButton.Content>
                    <RibbonDropDownButton.DropDownMenu>
                        <!-- The modules of THIS document, however many, then the catalog and the sets - rows as data.
                             A module's check shows or hides its tabs - it keeps working either way; the button at the
                             row's end takes it out of the document. -->
                        <ContextMenu ItemsSource="{Binding ModulesMenu}">
                            <ContextMenu.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid>
                                        <ContentPresenter Content="{Binding Module}"
                                                          ContentTemplate="{ResourceReference ModuleRow}"
                                                          Visibility="{Binding IsModule, Converter={conv:BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Localize RibbonShellStrings, Key={Binding Title}}"
                                                   Visibility="{Binding IsCommand, Converter={conv:BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </ContextMenu.ItemTemplate>
                            <ContextMenu.ItemContainerStyle>
                                <Style Selector="MenuItem">
                                    <Setter Property="IsCheckable" Value="{Binding IsModule}"/>
                                    <Setter Property="StaysOpenOnClick" Value="{Binding IsModule}"/>
                                    <Setter Property="IsChecked" Value="{Binding Module.IsShown, Mode=TwoWay}"/>
                                    <Setter Property="Command" Value="{Binding Command}"/>
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </RibbonDropDownButton.DropDownMenu>
                </RibbonDropDownButton>
            </Ribbon.StripContent>

            <!-- The module catalog opens out of the ribbon in place of the band: every module the editor knows of,
                 where each stands with this document, and what can be done with it. -->
            <Ribbon.Drawer>
                <Grid RowDefinitions="Auto,*"
                      Height="440"
                      Margin="16 12 16 16">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <TextBlock Text="{Localize RibbonShellStrings.ModuleCatalogTitle}"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0 0 20 0"/>
                        <TextBox Grid.Column="1"
                                 Width="240"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 Margin="0 0 16 0"
                                 Placeholder="{Localize RibbonShellStrings.FindModule}"
                                 ShowsClearButton="True"
                                 Text="{Binding CatalogSearch, Mode=TwoWay}"/>
                        <ListBox Grid.Column="2"
                                 VerticalAlignment="Center"
                                 ItemsSource="{Binding CatalogFilters}"
                                 SelectedItem="{Binding CatalogFilter, Mode=TwoWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                IsVirtualizing="False"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Localize RibbonShellStrings.CatalogFilter, filter={Binding}}"
                                               Margin="8 2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Column="4"
                                Content="{Localize RibbonShellStrings.InstallFromFile}"
                                Command="{Binding InstallModuleFromFileCommand}"
                                VerticalAlignment="Center"
                                Margin="0 0 8 0"/>
                        <Button Grid.Column="5"
                                Classes="Toolbar"
                                Padding="6"
                                VerticalAlignment="Center"
                                ToolTip="{Localize RibbonShellStrings.CloseCatalog}"
                                Command="{Binding CloseModuleCatalogCommand}">
                            <Path Data="M3,3 L13,13 M13,3 L3,13"
                                  Stroke="{ResourceReference TextFillColorSecondary}"
                                  StrokeThickness="1.25"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="180,*,400"
                          Margin="0 12 0 0">
                        <ListBox ItemsSource="{Binding CatalogSections}"
                                 SelectedItem="{Binding CatalogSection, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Localize RibbonShellStrings.Section, section={Binding}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Grid.Column="1"
                                 Margin="12 0"
                                 ItemsSource="{Binding CatalogModules}"
                                 SelectedItem="{Binding SelectedModule, Mode=TwoWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*"
                                          Margin="4 6">
                                        <ContentPresenter Content="{Binding}"
                                                          ContentTemplate="{ResourceReference ModuleTile}"
                                                          VerticalAlignment="Top"
                                                          Margin="0 0 12 0"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Name}}"
                                                           FontSize="14"/>
                                                <TextBlock Text="{Binding Version}"
                                                           FontSize="12"
                                                           Margin="8 0 0 0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ResourceReference TextFillColorTertiary}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Info}}"
                                                       FontSize="12"
                                                       Margin="0 2 0 0"
                                                       Foreground="{ResourceReference TextFillColorSecondary}"/>
                                            <ContentPresenter Content="{Binding}"
                                                              ContentTemplate="{ResourceReference ModuleStateTag}"
                                                              Margin="0 4 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The module last picked in the list, kept when the filter takes it out: what it is, and
                             what can be done with it from where it stands. -->
                        <Border Grid.Column="2"
                                Padding="16"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                Background="{ResourceReference SubtleFillColorSecondary}"
                                DataContext="{Binding ShownModule}">
                            <StackPanel Orientation="Vertical">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ContentPresenter Content="{Binding}"
                                                      ContentTemplate="{ResourceReference ModuleTile}"
                                                      Margin="0 0 12 0"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Vertical"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Name}}"
                                                       FontSize="18"/>
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="12"
                                                       Margin="8 0 0 0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ResourceReference TextFillColorTertiary}"/>
                                        </StackPanel>
                                        <ContentPresenter Content="{Binding}"
                                                          ContentTemplate="{ResourceReference ModuleStateTag}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Info}}"
                                           TextWrapping="WrapByWords"
                                           Margin="0 12 0 0"/>
                                <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Adds}}"
                                           FontSize="12"
                                           Margin="0 4 0 0"
                                           Foreground="{ResourceReference TextFillColorSecondary}"/>

                                <!-- In the document: show or hide its tabs, or take it out - after the question. -->
                                <StackPanel Orientation="Vertical"
                                            Margin="0 16 0 0"
                                            Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=InDocument}">
                                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Content}}"
                                               FontSize="12"
                                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                                    <CheckBox Content="{Localize RibbonShellStrings.ShowTabs}"
                                              IsChecked="{Binding IsShown, Mode=TwoWay}"
                                              Margin="0 12 0 0"/>
                                    <TextBlock Text="{Localize RibbonShellStrings.ShowTabsHint}"
                                               FontSize="12"
                                               TextWrapping="WrapByWords"
                                               Margin="0 4 0 0"
                                               Foreground="{ResourceReference TextFillColorTertiary}"/>
                                    <Button Content="{Localize RibbonShellStrings.DetachFromDocument}"
                                            Command="{Binding AskDetachCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0 12 0 0"/>
                                    <Border Padding="12"
                                            Margin="0 12 0 0"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{ResourceReference SystemFillColorCaution}"
                                            Visibility="{Binding IsDetachAsked, Converter={conv:BoolToVisibilityConverter}}">
                                        <ContentPresenter Content="{Binding}"
                                                          ContentTemplate="{ResourceReference DetachQuestion}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Detached: its data waits in the file. Back in, or the data deleted for good. -->
                                <StackPanel Orientation="Vertical"
                                            Margin="0 16 0 0"
                                            Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Detached}">
                                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Content}}"
                                               FontSize="12"
                                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0 12 0 0">
                                        <Button Classes="Accent"
                                                Content="{Localize RibbonShellStrings.AttachAgain}"
                                                Command="{Binding AttachCommand}"
                                                Margin="0 0 8 0"/>
                                        <Button Content="{Localize RibbonShellStrings.DeleteModuleData}"
                                                Command="{Binding AskDeleteDataCommand}"/>
                                    </StackPanel>
                                    <Border Padding="12"
                                            Margin="0 12 0 0"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{ResourceReference SystemFillColorCritical}"
                                            Visibility="{Binding IsDeleteAsked, Converter={conv:BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Localize RibbonShellStrings.DeleteDataTitle}"
                                                       FontSize="15"/>
                                            <TextBlock Text="{Localize RibbonShellStrings.DeleteDataText}"
                                                       TextWrapping="WrapByWords"
                                                       Margin="0 8 0 0"
                                                       Foreground="{ResourceReference TextFillColorSecondary}"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0 12 0 0">
                                                <Button Content="{Localize RibbonShellStrings.Cancel}"
                                                        Command="{Binding KeepDataCommand}"
                                                        Margin="0 0 8 0"/>
                                                <Button Classes="Accent"
                                                        Content="{Localize RibbonShellStrings.Delete}"
                                                        Command="{Binding DeleteDataCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0 16 0 0"
                                            Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Installed}">
                                    <Button Classes="Accent"
                                            Content="{Localize RibbonShellStrings.AttachToDocument}"
                                            Command="{Binding AttachCommand}"
                                            Margin="0 0 8 0"/>
                                    <Button Content="{Localize RibbonShellStrings.UninstallModule}"
                                            Command="{Binding UninstallCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0 16 0 0"
                                            Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=UpdateAvailable}">
                                    <Button Classes="Accent"
                                            Content="{Localize RibbonShellStrings.UpdateModule}"
                                            Command="{Binding UpdateCommand}"
                                            Margin="0 0 8 0"/>
                                    <Button Content="{Localize RibbonShellStrings.AttachToDocument}"
                                            Command="{Binding AttachCommand}"/>
                                </StackPanel>

                                <Button Classes="Accent"
                                        Content="{Localize RibbonShellStrings.InstallModule}"
                                        Command="{Binding InstallCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0 16 0 0"
                                        Visibility="{Binding State, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Available}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Ribbon.Drawer>

            <!-- ================= HOME ================= -->
            <!-- Alt shows the letters; these are stated so they read like Office's rather than being worked out from
                 the labels. Everything unnamed still gets one - see KeyTipService.AutoAssign. -->
            <RibbonTab Header="{Localize RibbonShellStrings.Home}" KeyTipService.KeyTip="H">
                <RibbonGroup Header="{Localize RibbonShellStrings.Clipboard}" Icon="M4,2 L12,2 L12,14 L4,14 Z M6,2 L6,4 L10,4 L10,2">
                    <!-- Split: the body pastes, the arrow offers the rarer ways to paste. Both halves are disabled
                         together - the command gates the whole thing. The rows are the command's own DATA, which is
                         what lets it sit in the quick-access bar and keep its arrow there. -->
                    <RibbonSplitButton Classes="Shell"
                                       DataContext="{Binding Commands.Paste}"
                                       ToolTip="{Localize RibbonShellStrings.PasteTip}">
                        <RibbonSplitButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <MenuItem Header="{Localize RibbonShellStrings, Key={Binding Header}}"
                                                  Command="{Binding Command}"/>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                            </ContextMenu>
                        </RibbonSplitButton.DropDownMenu>
                    </RibbonSplitButton>
                    <!-- Medium: small icon, label beside it - three stack into one column. -->
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Cut}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Copy}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Duplicate}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Scene}" Icon="M8,2 L14,5 L14,11 L8,14 L2,11 L2,5 Z M2,5 L8,8 L14,5 M8,8 L8,14">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Entity}"
                                  ToolTip="{Localize RibbonShellStrings.EntityTip}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Delete}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectAll}"
                                  MaxSize="Medium"
                                  CollapseToSmall="Never"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectNone}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.View}" Icon="M2,8 A6,4 0 0 0 14,8 A6,4 0 0 0 2,8 M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6">
                    <!-- The state these show is the command's own, so this button, the one in the View tab and the one in
                         the quick-access bar are three views of one value - not three values kept in step. -->
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Wireframe}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Grid}"
                                        MaxSize="Medium"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Gizmos}"
                                        MaxSize="Medium"/>
                    <!-- A separator ends the run beside it, so what follows starts a fresh column. -->
                    <Separator/>
                    <!-- A group hosts ORDINARY controls too. They state the same range through the ATTACHED form - a
                         Slider has no reason to grow a `MaxSize` of its own. They are the demo's switches, not commands
                         of the shell, so the quick-access bar is not offered them. -->
                    <CheckBox Content="{Localize RibbonShellStrings.HasSelection}"
                              Ribbon.MaxSize="Medium"
                              Ribbon.CollapseToSmall="Never"
                              Ribbon.CanAddToQuickAccess="False"
                              Margin="4 2"
                              IsChecked="{Binding HasSelection, Mode=TwoWay}"/>
                    <TextBlock Text="{Localize RibbonShellStrings.GridSize}" Ribbon.MaxSize="Medium" Ribbon.CollapseToSmall="Never" Margin="6 4 4 0" FontSize="11"/>
                    <!-- Not offered to the quick-access bar at all: a 120-wide control does not belong in a caption
                         strip shared with the window title. Word makes the same call - its zoom slider lives in the
                         status bar and cannot be added either. -->
                    <Slider Ribbon.MaxSize="Medium" Ribbon.CollapseToSmall="Never" Ribbon.CanAddToQuickAccess="False"
                            Width="120" Margin="4 2"
                            Minimum="0.1" Maximum="4" Value="{Binding GridSize, Mode=TwoWay}"/>
                    <CheckBox Content="{Localize RibbonShellStrings.Backstage}"
                              Ribbon.MaxSize="Medium"
                              Ribbon.CollapseToSmall="Never"
                              Ribbon.CanAddToQuickAccess="False"
                              Margin="4 2"
                              IsChecked="{Binding IsBackstage, Mode=TwoWay}"/>
                    <Separator/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.MoveQuickAccess}"
                                  MaxSize="Medium"
                                  ToolTip="{Localize RibbonShellStrings.MoveQuickAccessTip}"/>
                </RibbonGroup>

                <!-- A gallery: the choice IS the picture, so it is shown rather than listed. Its items are DATA - the
                     dropped-down copy builds its own cells from the same template. -->
                <RibbonGroup Header="{Localize RibbonShellStrings.Materials}" ShrinkSteps="None" Icon="M3,3 L13,3 L13,13 L3,13 Z M3,8 L13,8 M8,3 L8,13">
                    <RibbonGallery ItemsSource="{Binding Materials}"
                                   SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                                   Columns="4"
                                   CompactColumns="2"
                                   Rows="2"
                                   DropDownColumns="4"
                                   Ribbon.CollapseToSmall="Never"
                                   Ribbon.CanAddToQuickAccess="False">
                        <RibbonGallery.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Width="52">
                                    <Rectangle Height="20"
                                               Fill="{Binding Fill}"
                                               CornerRadius="2"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="10"
                                               Margin="0 2 0 0"
                                               HorizontalTextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </RibbonGallery.ItemTemplate>
                    </RibbonGallery>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Arrange}" ShrinkSteps="None" Icon="M2,3 L14,3 M2,8 L10,8 M2,13 L14,13">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.AlignLeft}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Center}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Distribute}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Group}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Order}" ShrinkSteps="None" Icon="M3,3 L11,3 L11,11 L3,11 Z M5,5 L13,5 L13,13 L5,13 Z">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Forward}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Backward}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Lighting}" ShrinkSteps="None" Icon="M8,2 L8,4 M8,12 L8,14 M2,8 L4,8 M12,8 L14,8 M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.AddLight}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bake}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Physics}" ShrinkSteps="None" Icon="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M2,8 L14,8">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Collider}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Simulate}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <!-- What the contextual tabs hang on. Two toggles rather than a real selection: the point on show is
                     the STRIP - one context, two contexts, and the order they arrive in. The demo's switches, not
                     commands of the shell, so the quick-access bar is not offered them. -->
                <RibbonGroup Header="{Localize RibbonShellStrings.Context}" ShrinkSteps="None" Icon="M2,2 L14,2 L14,14 L2,14 Z M5,5 L11,5 L11,11 L5,11 Z">
                    <RibbonToggleButton Content="{Localize RibbonShellStrings.Mesh}"
                                        MaxSize="Medium"
                                        Ribbon.CanAddToQuickAccess="False"
                                        IsChecked="{Binding HasMeshSelection, Mode=TwoWay}"
                                        ToolTip="{Localize RibbonShellStrings.MeshTip}"
                                        Icon="M8,2 L14,5 L14,11 L8,14 L2,11 L2,5 Z M2,5 L8,8 L14,5 M8,8 L8,14"/>
                    <RibbonToggleButton Content="{Localize RibbonShellStrings.Light}"
                                        MaxSize="Medium"
                                        Ribbon.CanAddToQuickAccess="False"
                                        IsChecked="{Binding HasLightSelection, Mode=TwoWay}"
                                        ToolTip="{Localize RibbonShellStrings.LightTip}"
                                        Icon="M8,2 L8,4 M8,12 L8,14 M2,8 L4,8 M12,8 L14,8 M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5"/>
                    <RibbonToggleButton Content="{Localize RibbonShellStrings.Ledge}"
                                        MaxSize="Medium"
                                        Ribbon.CanAddToQuickAccess="False"
                                        IsChecked="{Binding ShowContextHeader, Mode=TwoWay}"
                                        ToolTip="{Localize RibbonShellStrings.LedgeTip}"
                                        Icon="M2,4 L14,4 L14,7 L2,7 Z M2,10 L6,10 M8,10 L14,10"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Tools}" ShrinkSteps="None" Icon="M3,13 L13,3 M10,3 L13,3 L13,6">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Measure}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Annotate}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= MODELING ================= -->
            <RibbonTab Header="{Localize RibbonShellStrings.Modeling}" KeyTipService.KeyTip="M">
                <RibbonGroup Header="{Localize RibbonShellStrings.Primitives}" Icon="M8,2 L14,5 L14,11 L8,14 L2,11 L2,5 Z">
                    <!-- Drops a menu instead of doing something. The rows are the command's DATA: a menu of MenuItem
                         CONTROLS cannot be in two places, so it would reach the quick-access bar as an arrow over nothing. -->
                    <RibbonDropDownButton Classes="Shell"
                                          DataContext="{Binding Commands.Add}"
                                          ToolTip="{Localize RibbonShellStrings.AddTip}">
                        <RibbonDropDownButton.DropDownMenu>
                            <ContextMenu ItemsSource="{Binding DropDownItems}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <MenuItem Header="{Localize RibbonShellStrings, Key={Binding Header}}"
                                                  Command="{Binding Command}"/>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                            </ContextMenu>
                        </RibbonDropDownButton.DropDownMenu>
                    </RibbonDropDownButton>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Cube}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Sphere}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Plane}"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Mesh}" Icon="M2,2 L14,2 L14,14 L2,14 Z M8,2 L8,14 M2,8 L14,8">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Extrude}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bevel}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Subdivide}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Snapping}"
                             Icon="M8,2 L8,14 M2,8 L14,8 M5,5 L11,11 M11,5 L5,11">
                    <!-- THIS group's commands get the shell's OWN right-click menu instead of the ribbon's. The property
                         is inherited, so the same attribute on <Ribbon> would speak for the whole band; written here it
                         overrides just this group. Its rows are the commands' own DATA - nothing about them reaches the
                         ribbon. Write {x:Null} instead and the commands get no menu at all. -->
                    <Ribbon.CommandContextMenuTemplate>
                        <DataTemplate>
                            <ContextMenu ItemsSource="{Binding MenuRows}">
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <MenuItem Header="{Localize RibbonShellStrings, Key={Binding Header}}"
                                                  Command="{Binding Command}"/>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                            </ContextMenu>
                        </DataTemplate>
                    </Ribbon.CommandContextMenuTemplate>

                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Snap}"/>
                    <!-- Small: the icon alone, three to a column. MaxSize is a RANGE - the adaptive pass may only shrink. -->
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.SnapToVertices}"
                                        MaxSize="Small"
                                        ToolTip="{Localize RibbonShellStrings.SnapToVertices}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.SnapToEdges}"
                                        MaxSize="Small"
                                        ToolTip="{Localize RibbonShellStrings.SnapToEdges}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.SnapToFaces}"
                                        MaxSize="Small"
                                        ToolTip="{Localize RibbonShellStrings.SnapToFaces}"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= MATERIALS ================= -->
            <RibbonTab Header="{Localize RibbonShellStrings.Materials}" KeyTipService.KeyTip="A">
                <RibbonGroup Header="{Localize RibbonShellStrings.Library}" Icon="M3,2 L11,2 L13,4 L13,14 L3,14 Z M8,6 L8,11 M5.5,8.5 L10.5,8.5">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.NewMaterial}"
                                  ToolTip="{Localize RibbonShellStrings.NewMaterialTip}"/>
                    <!-- An icon that is not path data at all: a COLOR, drawn as a disc by the command's own template. A
                         look on show, not a command of the shell, so it stays out of the quick-access bar. -->
                    <RibbonButton Content="{Localize RibbonShellStrings.Swatch}"
                                  MaxSize="Medium"
                                  Icon="Coral"
                                  Ribbon.CanAddToQuickAccess="False"
                                  Command="{Binding NewMaterialCommand}"
                                  ToolTip="{Localize RibbonShellStrings.SwatchTip}">
                        <RibbonButton.IconTemplate>
                            <DataTemplate>
                                <Ellipse Width="14" Height="14" EllipseType="EdgeToEdge" Fill="{Binding}"/>
                            </DataTemplate>
                        </RibbonButton.IconTemplate>
                    </RibbonButton>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Channels}" Icon="M2,11 L5,7 L8,11 L11,5 L14,11">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Albedo}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Normal}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Roughness}"
                                  MaxSize="Medium"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Preview}" Icon="M8,2 L14,5 L14,11 L8,14 L2,11 L2,5 Z M2,5 L8,8 L14,5">
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Wireframe}"/>
                    <TextBlock Text="{Localize RibbonShellStrings.Shading}" Ribbon.MaxSize="Medium" Ribbon.CollapseToSmall="Never" Margin="6 4 4 0" FontSize="11"/>
                    <DropDown Ribbon.MaxSize="Medium"
                              Ribbon.CollapseToSmall="Never"
                              Ribbon.CanAddToQuickAccess="False"
                              Width="140"
                              Margin="4 2"
                              ItemsSource="{Binding ShadingModes}"
                              SelectedItem="{Binding ShadingMode, Mode=TwoWay}">
                        <DropDown.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Localize RibbonShellStrings, Key={Binding}}"/>
                            </DataTemplate>
                        </DropDown.ItemTemplate>
                    </DropDown>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= VIEW ================= -->
            <RibbonTab Header="{Localize RibbonShellStrings.View}" KeyTipService.KeyTip="V">
                <RibbonGroup Header="{Localize RibbonShellStrings.Display}" Icon="M2,2 L14,2 L14,14 L2,14 Z M6,2 L6,14 M10,2 L10,14">
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Grid}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Gizmos}"/>
                    <RibbonToggleButton Classes="ShellToggle"
                                        DataContext="{Binding Commands.Wireframe}"/>
                </RibbonGroup>

                <RibbonGroup Header="{Localize RibbonShellStrings.Selection}" Icon="M2,2 L14,2 L14,14 L2,14 Z M5,5 L11,5 L11,11 L5,11 Z">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectAll}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.SelectNone}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Delete}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- ================= CONTEXTUAL ================= -->
            <!-- Tabs that turn up under a task. The contexts are declared once on the ribbon; a tab names the one it
                 belongs to by key, because a group is not a visual and cannot be pointed at as an element. -->
            <Ribbon.ContextualGroups>
                <RibbonContextualGroup Key="MeshTools"
                                       Header="{Localize RibbonShellStrings.MeshTools}"
                                       Accent="#B85C2E"
                                       ShowHeader="{Binding ShowContextHeader}"
                                       IsActive="{Binding HasMeshSelection}"/>
                <RibbonContextualGroup Key="LightTools"
                                       Header="{Localize RibbonShellStrings.LightTools}"
                                       Accent="#3F7CBF"
                                       ShowHeader="{Binding ShowContextHeader}"
                                       IsActive="{Binding HasLightSelection}"/>
            </Ribbon.ContextualGroups>

            <!-- TWO tabs in one context: they stand together under ONE ledge spanning both. -->
            <RibbonTab Header="{Localize RibbonShellStrings.Geometry}" ContextualGroupKey="MeshTools" KeyTipService.KeyTip="G">
                <RibbonGroup Header="{Localize RibbonShellStrings.Edit}" Icon="M2,2 L14,2 L14,14 L2,14 Z M8,2 L8,14">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Extrude}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bevel}"
                                  MaxSize="Medium"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Subdivide}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="{Localize RibbonShellStrings.Uv}" ContextualGroupKey="MeshTools" KeyTipService.KeyTip="U">
                <RibbonGroup Header="{Localize RibbonShellStrings.Unwrap}" Icon="M2,2 L14,2 L14,14 L2,14 Z M2,8 L14,8 M8,2 L8,14">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Unwrap}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Measure}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>

            <!-- A SECOND context, so the strip has to order two of them - the one switched on last stands furthest
                 right and does not shift what someone was already aiming at. -->
            <RibbonTab Header="{Localize RibbonShellStrings.Light}" ContextualGroupKey="LightTools" KeyTipService.KeyTip="L">
                <RibbonGroup Header="{Localize RibbonShellStrings.Emission}" Icon="M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5">
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.Bake}"/>
                    <RibbonButton Classes="Shell"
                                  DataContext="{Binding Commands.AddLight}"
                                  MaxSize="Medium"/>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <!-- The "document": a stand-in surface the commands land on. -->
        <Border Grid.Row="1" Margin="16" CornerRadius="6"
                Background="{ResourceReference SolidBackgroundFillColorSecondary}"
                BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="1">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Localize RibbonShellStrings.SceneView}" FontSize="22" HorizontalAlignment="Center"
                           Foreground="{ResourceReference TextFillColorPrimary}"/>
                <TextBlock Text="{Localize RibbonShellStrings.Status, action={Binding LastAction}, format={Binding Format}}" FontSize="14" Margin="0 12 0 0" HorizontalAlignment="Center"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <TextBlock Text="{Localize RibbonShellStrings, Key={Binding ShadingMode}}" FontSize="13" Margin="0 16 0 0" HorizontalAlignment="Center"
                           Foreground="{ResourceReference TextFillColorTertiary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Height="26" Background="{ResourceReference SolidBackgroundFillColorTertiary}">
            <TextBlock Text="{Localize RibbonShellStrings.Status, action={Binding LastAction}, format={Binding Format}}" VerticalAlignment="Center" Margin="12 0" FontSize="12"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
        </Border>
    </Grid>
</View>

