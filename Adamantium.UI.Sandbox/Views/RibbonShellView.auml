                                      Content="{Localize RibbonShellStrings.OceanLevel}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource OceanLevelIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PolarCaps}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource PolarCapsIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Glaciers}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource GlaciersIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Biomes}"
                                 Icon="{ObservableResource BiomesIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Biomes}"
                                      Icon="{ObservableResource BiomesIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Rings}"
                                 Icon="{ObservableResource RingsIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Rings}"
                                      Icon="{ObservableResource RingsIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Cataclysms}"
                                 Icon="{ObservableResource VolcanoIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Volcano}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource VolcanoIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.MeteorShower}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource MeteorShowerIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Impact}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource ImpactIcon}"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Atmosphere}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Composition}"
                                 Icon="{ObservableResource AtmosphereIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Atmosphere}"
                                      Icon="{ObservableResource AtmosphereIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Scattering}"
                                 Icon="{ObservableResource RayleighIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Rayleigh}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource RayleighIcon}"/>
                        <RibbonButton Classes="ModuleTool"
