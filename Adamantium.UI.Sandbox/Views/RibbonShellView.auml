<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters"
      xmlns:views="clr-namespace:Adamantium.UI.Sandbox.Views">
    <!-- A module as the menu and the catalog show it: its color, its words, where it stands. The data is the module
         itself, so one template serves the drop-down's rows and the catalog's cards. -->
    <ResourceContext.Resources>
        <!-- The question asked before a module leaves the document: what stays, what gets marked. -->
        <DataTemplate x:Key="DetachQuestion">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Localize RibbonShellStrings.DetachTitle}"
                           FontSize="15"/>
                <TextBlock Text="{Localize RibbonShellStrings.DetachText}"
                           TextWrapping="WrapByWords"
                           Margin="0 8 0 0"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto"
                      Margin="0 10 0 0">
                    <TextBlock Text="{Localize RibbonShellStrings.StaysInFile}"
                               FontSize="12"
                               Margin="0 0 12 4"
                               Foreground="{ResourceReference TextFillColorTertiary}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Localize Table={Binding Phrases}, Key={Binding Content}}"
                               FontSize="12"
                               TextWrapping="WrapByWords"/>
                    <TextBlock Grid.Row="1"
                               Text="{Localize RibbonShellStrings.GetsMarked}"
                               FontSize="12"
                               Margin="0 0 12 0"
                               Foreground="{ResourceReference TextFillColorTertiary}"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Localize Table={Binding Phrases}, Key={Binding Dependents}}"
                               FontSize="12"
                               TextWrapping="WrapByWords"/>
                </Grid>
                <TextBlock Text="{Localize RibbonShellStrings.MarkedHint}"
                           FontSize="12"
                           TextWrapping="WrapByWords"
                           Margin="0 8 0 0"
                           Foreground="{ResourceReference TextFillColorTertiary}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 12 0 0">
                    <Button Content="{Localize RibbonShellStrings.Cancel}"
                            Command="{Binding KeepAttachedCommand}"
                            Margin="0 0 8 0"/>
                    <Button Classes="Accent"
                            Content="{Localize RibbonShellStrings.Detach}"
                            Command="{Binding DetachCommand}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A row of the "Modules" drop-down: the switch is the row itself; the button beside it takes the module out
             of the document, after the question it opens next to the row. -->
        <DataTemplate x:Key="ModuleRow">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Margin="0 5 10 0"
                        VerticalAlignment="Top"
                        Background="{Binding Accent}"/>
                <StackPanel Grid.Column="1"
                            Orientation="Vertical">
                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Name}}"/>
                    <TextBlock Text="{Localize Table={Binding Phrases}, Key={Binding Info}}"
                               FontSize="12"
                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="Toolbar"
                        Margin="16 0 0 0"
                        Padding="4"
                        VerticalAlignment="Center"
                        ToolTip="{Localize RibbonShellStrings.DetachFromDocument}"
                        Command="{Binding AskDetachCommand}">
                    <Path Data="M5,1 L5,4 M11,1 L11,4 M3,4 L13,4 L13,7 A5,5 0 0 1 3,7 Z M8,12 L8,15 M1,1 L15,15"
                          Stroke="{ResourceReference TextFillColorSecondary}"
                          StrokeThickness="1.25"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
                <Popup Grid.Column="2"
                       Placement="Right"
                       PlacementAlignment="Start"
                       HorizontalOffset="16"
                       KeepOpen="False"
                       IsOpen="{Binding IsDetachAsked, Mode=TwoWay}">
                    <Border Width="380"
                            Padding="16"
                            CornerRadius="8"
                            Background="{ResourceReference FlyoutSurfaceFill}"
                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                            BorderThickness="1">
                        <ContentPresenter Content="{Binding}"
                                          ContentTemplate="{ResourceReference DetachQuestion}"/>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Where a module stands: a pill (class StatePill, in RibbonShellStyleSet) in the color of its state. -->
        <DataTemplate x:Key="ModuleStateTag">
            <ContentControl Classes="StatePill"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                <TextBlock Text="{Localize RibbonShellStrings.ModuleState, state={Binding State}, version={Binding UpdateVersion}}"
                           FontSize="11"/>
            </ContentControl>
        </DataTemplate>

        <!-- What each module brings to the ribbon: its tabs under a ledge of its own, bound against the module - its
             commands are the module's (class ModuleTool, in RibbonShellStyleSet). A module with no piece of its own
             takes ModuleRibbon. -->
        <DataTemplate x:Key="SurfaceModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.SurfaceHeader}"
                          Accent="{Binding Accent}"
                          IsActive="{Binding IsShown}">
                <RibbonTab Header="{Localize RibbonShellStrings.Terrain}"
                           KeyTipService.KeyTip="T">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Terrain}"
                                 Icon="{ObservableResource TerrainIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewTerrain}"
                                      Icon="{ObservableResource NewTerrainIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ImportHeightmap}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource ImportToTrayIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Sculpt}"
                                 Icon="{ObservableResource RaiseIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Raise}"
                                      CommandParameter="Raised"
                                      Icon="{ObservableResource RaiseIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Lower}"
                                      MaxSize="Medium"
                                      CommandParameter="Lowered"
                                      Icon="{ObservableResource LowerIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Smooth}"
                                      MaxSize="Medium"
                                      CommandParameter="Smoothed"
                                      Icon="{ObservableResource SmoothIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Flatten}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource FlattenIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Stamp}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource StampIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Ground}"
                                 Icon="{ObservableResource BrushIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PaintGround}"
                                      Icon="{ObservableResource BrushIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AutoFill}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource AutoFillIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Water}"
                                 Icon="{ObservableResource RiverIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.River}"
                                      Icon="{ObservableResource RiverIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.WaterLevel}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource WaterLevelIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Lake}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource LakeIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Erosion}"
                                 Icon="{ObservableResource ErosionIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Erosion}"
                                      Icon="{ObservableResource ErosionIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Vegetation}"
                                 Icon="{ObservableResource PlantIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.PlantBrush}"
                                      Icon="{ObservableResource PlantIcon}"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Zones}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Zones}"
                                 Icon="{ObservableResource ZoneIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ZoneBrush}"
                                      Icon="{ObservableResource ZoneIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Polygon}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource PolygonIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.LockZone}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource LockIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Regenerate}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource RegenerateIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Settlements}"
                                 Icon="{ObservableResource SettlementsIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Settlement}"
                                      Icon="{ObservableResource SettlementIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.SettlementList}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource ListIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Pinning}"
                                 Icon="{ObservableResource PinIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Pin}"
                                      Icon="{ObservableResource PinIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Unpin}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource UnpinIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Plots}"
                                 Icon="{ObservableResource PlotsIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.SlicePlots}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource PlotsIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.EditBorders}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource EditBordersIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Catalog}"
                                 Icon="{ObservableResource CatalogIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.BuildingCatalog}"
                                      Icon="{ObservableResource CatalogIcon}"/>
                    </RibbonGroup>
                </RibbonTab>

                <RibbonTab Header="{Localize RibbonShellStrings.Roads}">
                    <RibbonGroup Header="{Localize RibbonShellStrings.Road}"
                                 Icon="{ObservableResource RoadIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NewRoad}"
                                      Icon="{ObservableResource RoadIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.AddPoint}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource AddPointIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.RemovePoint}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource RemovePointIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Junction}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource JunctionIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Structures}"
                                 Icon="{ObservableResource BridgeIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Bridge}"
                                      Icon="{ObservableResource BridgeIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Tunnel}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource TunnelIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Ford}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource FordIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Culvert}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource CulvertIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Network}"
                                 Icon="{ObservableResource ConnectIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.ConnectSettlements}"
                                      Icon="{ObservableResource ConnectIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Cataclysm}"
                                 Icon="{ObservableResource BreakSectionIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.BreakSection}"
                                      Icon="{ObservableResource BreakSectionIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Restore}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource RestoreIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.MakeTask}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource FlagIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

        <DataTemplate x:Key="SpaceModuleRibbon">
            <RibbonTabSet Header="{Localize RibbonShellStrings.SpaceHeader}"
