                    <RibbonGroup Header="{Localize RibbonShellStrings.Stars}"
                                 Icon="{ObservableResource StarIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Star}"
                                      CommandParameter="AddedStar"
                                      Icon="{ObservableResource StarIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.BinaryStar}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource BinaryStarIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Cluster}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource ClusterIcon}"/>
