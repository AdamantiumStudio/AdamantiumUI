                                      Content="{Localize RibbonShellStrings.Resonance}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource ResonanceIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Lagrange}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource LagrangeIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Generator}"
                                 Icon="{ObservableResource GenerateSystemIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.GenerateSystem}"
                                      Icon="{ObservableResource GenerateSystemIcon}"/>
                    </RibbonGroup>
