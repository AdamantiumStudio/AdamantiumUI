                                      MaxSize="Medium"
                                      Icon="{ObservableResource StormsIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.CloudShadows}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource CloudShadowsIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Phenomena}"
                                 Icon="{ObservableResource AurorasIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Auroras}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource AurorasIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.NightGlow}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource NightGlowIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.DustStorms}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource DustStormsIcon}"/>
                    </RibbonGroup>
                    <RibbonGroup Header="{Localize RibbonShellStrings.Climate}"
                                 Icon="{ObservableResource WindIcon}">
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Winds}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource WindIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Precipitation}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource PrecipitationIcon}"/>
                        <RibbonButton Classes="ModuleTool"
                                      Content="{Localize RibbonShellStrings.Seasons}"
                                      MaxSize="Medium"
                                      Icon="{ObservableResource SeasonsIcon}"/>
                    </RibbonGroup>
                </RibbonTab>
            </RibbonTabSet>
        </DataTemplate>

