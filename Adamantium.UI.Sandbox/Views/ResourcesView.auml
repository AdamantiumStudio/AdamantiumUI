<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:local="clr-namespace:Adamantium.UI.Sandbox"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors">
    <!-- Pure declarative demo of live {ObservableResource} vs resolve-once {ResourceReference}, at three scopes:
         a THEME palette key (swap Dark<->Light / cycle the entry), an INLINE local resource (cycled by a view-layer
         behavior) and a GLOBAL dictionary (survives a theme swap). No view-model logic, no controls in the VM. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Margin="24">

        <TextBlock Text="{Localize ResourcesStrings.Title}" FontSize="18" Margin="0,0,0,4"/>

        <!-- THEME resource: swap the whole theme (Up = Dark, Down = Light). The live swatch re-resolves to the new
             palette; the static one keeps the color it resolved once. The rest of the UI re-colors too. -->
        <TextBlock Text="{Localize ResourcesStrings.ThemePalette}" Margin="0,10,0,6"/>
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical" Margin="0,0,32,0">
                <TextBlock Text="{Localize ResourcesStrings.Static}" Margin="0,0,0,6"/>
                <Rectangle Width="140" Height="60" CornerRadius="6" Fill="{ResourceReference SystemFillColorCritical}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Localize ResourcesStrings.Live}" Margin="0,0,0,6"/>
                <Rectangle Width="140" Height="60" CornerRadius="6" Fill="{ObservableResource SystemFillColorCritical}"/>
            </StackPanel>
            <!-- Cycles the palette ENTRY itself (runtime resource override) - the live swatch follows, the static one
                 keeps its resolved-once brush - so the difference shows without swapping the whole theme. -->
            <Button Content="{Localize ResourcesStrings.CycleCritical}" MinWidth="180" Height="36" Margin="32,0,0,0" VerticalAlignment="Bottom">
                <Button.Behaviors>
                    <behaviors:CycleScopedResourceBehavior Key="SystemFillColorCritical" Scope="Theme"/>
                </Button.Behaviors>
            </Button>
        </StackPanel>

        <!-- Which SIDE the window buttons sit on. A platform theme states this once with a setter; here it is a
             checkbox so the difference can be seen on a live window. Left also REVERSES the order - closing stays
             outermost either way - which is the part that is easy to get wrong and impossible to miss on screen. -->
        <CheckBox Content="{Localize ResourcesStrings.CaptionLeft}" IsChecked="{Binding CaptionButtonsOnLeft, Mode=TwoWay}"
                  Margin="0,12,0,0"/>

        <!-- Numbers and dates as bindings write them in the application's LANGUAGE, chosen in the diagnostics panel
             with the theme: they follow it at once, with no template rebuilt. -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Localize ResourcesStrings.Formats}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SampleNumber, StringFormat='{0:N2}'}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock Text="{Binding SampleDate, StringFormat='{0:D}'}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock Text="{Binding SampleDate, StringFormat='{0:t}'}" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- ACCENT: the theme's accent brushes are observable theme properties consumed via {ThemeResource}. Cycling them
             at runtime re-colors the live swatch and every accented control (checked toggle / checkbox / radio) at once. -->
        <TextBlock Text="{Localize ResourcesStrings.AccentTitle}" Margin="0,28,0,6"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="60" Height="60" CornerRadius="6" Margin="0,0,16,0" Fill="{ThemeResource AccentFillColorDefault}"/>
            <ToggleButton Content="{Localize ResourcesStrings.Toggle}" IsChecked="true" Margin="0,0,16,0"/>
            <CheckBox Content="{Localize ResourcesStrings.Checked}" IsChecked="true" Margin="0,0,16,0"/>
            <RadioButton Content="{Localize ResourcesStrings.Selected}" IsChecked="true" Margin="0,0,16,0"/>
            <Button Content="{Localize ResourcesStrings.CycleAccent}" MinWidth="140" Height="36">
                <Button.Behaviors>
                    <behaviors:CycleAccentBehavior/>
                </Button.Behaviors>
            </Button>
        </StackPanel>

        <!-- LOCAL inline resource: a private dictionary on THIS panel (invisible outside it). The Cycle button carries a
             view-layer CycleResourceBehavior that swaps PanelAccent for a new brush; again the live swatch follows and
             the static one keeps its first color. The button is a descendant so the behavior finds the dictionary. -->
        <StackPanel Orientation="Vertical" Margin="0,28,0,0">
            <ResourceContext.Resources>
                <SolidColorBrush x:Key="PanelAccent" Color="#22D3EE"/>
            </ResourceContext.Resources>

            <TextBlock Text="{Localize ResourcesStrings.LocalTitle}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,32,0">
                    <TextBlock Text="{Localize ResourcesStrings.Static}" Margin="0,0,0,6"/>
                    <Rectangle Width="140" Height="60" CornerRadius="6" Fill="{ResourceReference PanelAccent}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Localize ResourcesStrings.Live}" Margin="0,0,0,6"/>
                    <Rectangle Width="140" Height="60" CornerRadius="6" Fill="{ObservableResource PanelAccent}"/>
                </StackPanel>
            </StackPanel>

            <Button Content="{Localize ResourcesStrings.CycleLocal}" MinWidth="180" Height="36" Margin="0,12,0,0">
                <Button.Behaviors>
                    <behaviors:CycleResourceBehavior Key="PanelAccent"/>
                </Button.Behaviors>
            </Button>
        </StackPanel>

        <!-- GLOBAL resource: a dictionary TYPE linked at Global scope (GlobalResources.auml). It belongs to NO theme,
             so toggling the theme above re-colors every palette swatch but leaves these untouched - the scope's whole
             point. Cycle overrides the value at runtime (Scope=Global): live follows, static keeps; and unlike the
             Theme-scope override above, the new value SURVIVES a theme swap. -->
        <StackPanel Orientation="Vertical" Margin="0,28,0,0"
                    ResourceContext.Source="{ResourceLink Source={x:Type local:GlobalResources}, Scope=Global}">
            <TextBlock Text="{Localize ResourcesStrings.GlobalTitle}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,32,0">
                    <TextBlock Text="{Localize ResourcesStrings.Static}" Margin="0,0,0,6"/>
                    <Rectangle Width="140" Height="60" CornerRadius="6" Fill="{ResourceReference GlobalAccent}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Localize ResourcesStrings.Live}" Margin="0,0,0,6"/>
                    <Rectangle Width="140" Height="60" CornerRadius="6" Fill="{ObservableResource GlobalAccent}"/>
                </StackPanel>
                <Button Content="{Localize ResourcesStrings.CycleGlobal}" MinWidth="180" Height="36" Margin="32,0,0,0" VerticalAlignment="Bottom">
                    <Button.Behaviors>
                        <behaviors:CycleScopedResourceBehavior Key="GlobalAccent" Scope="Global"/>
                    </Button.Behaviors>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ═══ Theme SCOPE stand ═══════════════════════════════════════════════════════════════════════════════
             Four panes on different variants: two pinned, one following the OS, one following its own checkbox. -->
        <TextBlock Text="{Localize ResourcesStrings.ScopeTitle}" FontSize="18" Margin="0,28,0,4"/>
        <TextBlock Text="{Localize ResourcesStrings.ScopeHint}"
                   Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" ThemeContext.Theme="{Binding LocalTheme}">

            <Border Width="200" Height="120" CornerRadius="8" Margin="0,0,16,0" Padding="14"
                    ThemeContext.Variant="Light"
                    Background="{ObservableResource SolidBackgroundFillColorBase}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Localize ResourcesStrings.VariantLight}" Foreground="{ObservableResource TextFillColorPrimary}"/>
                    <Rectangle Height="10" CornerRadius="5" Margin="0,10,0,0"
                               Fill="{ThemeResource AccentFillColorDefault}"/>
                </StackPanel>
            </Border>

            <Border Width="200" Height="120" CornerRadius="8" Margin="0,0,16,0" Padding="14"
                    ThemeContext.Variant="Dark"
                    Background="{ObservableResource SolidBackgroundFillColorBase}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Localize ResourcesStrings.VariantDark}" Foreground="{ObservableResource TextFillColorPrimary}"/>
                    <Rectangle Height="10" CornerRadius="5" Margin="0,10,0,0"
                               Fill="{ThemeResource AccentFillColorDefault}"/>
                </StackPanel>
            </Border>

            <Border Width="200" Height="120" CornerRadius="8" Margin="0,0,16,0" Padding="14"
                    ThemeContext.Variant="System"
                    Background="{ObservableResource SolidBackgroundFillColorBase}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Localize ResourcesStrings.VariantSystem}" Foreground="{ObservableResource TextFillColorPrimary}"/>
                    <Rectangle Height="10" CornerRadius="5" Margin="0,10,0,0"
                               Fill="{ThemeResource AccentFillColorDefault}"/>
                </StackPanel>
            </Border>

            <!-- The pane that switches ITSELF: its variant is bound to its own checkbox, so it changes when nobody
                 else does. The application theme buttons above leave it alone, and so does the OS. -->
            <Border Width="200" Height="120" CornerRadius="8" Padding="14"
                    ThemeContext.Variant="{Binding StandVariant}"
                    Background="{ObservableResource SolidBackgroundFillColorBase}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Localize ResourcesStrings.VariantOwn}" Foreground="{ObservableResource TextFillColorPrimary}"/>
                    <CheckBox Content="{Localize ResourcesStrings.Dark}" IsChecked="{Binding StandIsDark, Mode=TwoWay}" Margin="0,6,0,0"
                             />
                    <Rectangle Height="10" CornerRadius="5" Margin="0,8,0,0"
                               Fill="{ThemeResource AccentFillColorDefault}"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </StackPanel>
    </ScrollViewer>
</View>
