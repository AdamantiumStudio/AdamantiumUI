<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- DataContext is the TextViewModel. FontSize is slider-driven; Message is shown by several TextBlocks. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Margin="24">

        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="FontSizeLabel" Text="{Localize TextStrings.FontSize}" VerticalAlignment="Center"/>
            <Slider AutomationProperties.AutomationId="FontSizeSlider" AutomationProperties.LabeledBy="{Binding ElementName=FontSizeLabel}"
                    Width="240" Minimum="10" Maximum="72" Value="{Binding FontSize, Mode=TwoWay}" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding FontSize}" VerticalAlignment="Center" FontSize="16" Margin="12,0,0,0"/>
        </StackPanel>

        <TextBlock Text="{Binding Message}"
                   FontSize="{Binding FontSize}"
                   TextWrapping="WrapByWords"
                   Width="520"
                   HorizontalAlignment="Left"
                   Margin="0,20,0,0"/>

        <TextBlock Text="{Localize TextStrings.Trimmed}" Margin="0,20,0,6"/>
        <Border Width="280" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Message}" TextTrimming="CharEllipses"/>
        </Border>

        <!-- Live toggle for the floating-label (watermark) effect. Off = a plain static watermark (shown only when the
             field is empty). -->
        <ToggleSwitch Content="{Localize TextStrings.FloatingWatermark}" IsChecked="{Binding FloatingWatermark, Mode=TwoWay}"
                      Margin="0,24,0,0" HorizontalAlignment="Left"/>

        <!-- Editable TextBox: two-way bound to the SAME Message, so typing here live-updates every TextBlock above. -->
        <TextBlock Text="{Localize TextStrings.Editable}" Margin="0,12,0,6"/>
        <TextBox AutomationProperties.AutomationId="Message" Text="{Binding Message, Mode=TwoWay}"
                 Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.Message}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <!-- Floating placeholder from empty: the label rests inside the field and animates up + shrinks on focus/typing. -->
        <TextBlock Text="{Localize TextStrings.FloatingTitle}" Margin="0,16,0,6"/>
        <TextBox Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.YourName}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <TextBlock x:Name="ReadOnlyLabel" Text="{Localize TextStrings.ReadOnly}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="ReadOnlyMessage" AutomationProperties.LabeledBy="{Binding ElementName=ReadOnlyLabel}"
                 Text="{Binding Message}" IsReadOnly="True"
                 Width="520" HorizontalAlignment="Left"/>

        <!-- Multi-line editor: AcceptsReturn (Enter inserts a newline), NO wrap so long lines scroll horizontally. Both bars
             are Auto - the horizontal one via the shared ScrollViewer.HorizontalScrollBarVisibility attached policy on the
             TextBox (TextBoxBase now uses the attached props, not its own). Arrow keys navigate; selection spans rows. -->
        <TextBlock x:Name="NotesLabel" Text="{Localize TextStrings.MultiLine}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="Notes" AutomationProperties.LabeledBy="{Binding ElementName=NotesLabel}"
                 Text="{Binding Notes, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Width="520" Height="120" HorizontalAlignment="Left"/>

        <!-- Bindable Runs: a single TextBlock built from Run inlines. The middle run's Text binds to Message (updates
             live while you type in the box above) and its Foreground binds to a VM brush - both bindable, unlike WPF. -->
        <TextBlock Text="{Localize TextStrings.BindableRuns}" Margin="0,20,0,6"/>
        <TextBlock FontSize="16">
            <TextBlock.Inlines>
                <Run Text="{Localize TextStrings.YouTyped}" Foreground="#94A3B8"/>
                <Run Text="{Binding Message}" Foreground="{Binding AccentBrush}"/>
                <Run Text="{Localize TextStrings.Chars, count={Binding MessageLength}}" Foreground="#64748B"/>
            </TextBlock.Inlines>
        </TextBlock>
    </StackPanel>
    </ScrollViewer>
</View>
