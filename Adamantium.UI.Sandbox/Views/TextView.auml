<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- DataContext is the TextViewModel. FontSize is slider-driven; Message is shown by several TextBlocks. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Margin="24">

        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="FontSizeLabel" Text="{Localize TextStrings.FontSize}" VerticalAlignment="Center"/>
            <Slider AutomationProperties.AutomationId="FontSizeSlider"
                    AutomationProperties.LabeledBy="{Binding ElementName=FontSizeLabel}"
                    Width="240"
                    Minimum="6"
                    Maximum="72"
                    TickFrequency="0.1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding FontSize, Mode=TwoWay}"
                    Margin="12,0,0,0"/>
            <TextBlock Text="{Binding FontSize}" VerticalAlignment="Center" FontSize="16" Margin="12,0,0,0"/>
        </StackPanel>

        <TextBlock Text="{Binding Message}"
                   FontSize="{Binding FontSize}"
                   TextWrapping="WrapByWords"
                   Width="520"
                   HorizontalAlignment="Left"
                   Margin="0,20,0,0"/>

        <TextBlock Text="{Localize TextStrings.Trimmed}" Margin="0,20,0,6"/>
        <Border Width="280" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Message}" TextTrimming="CharEllipses"/>
        </Border>

        <!-- Live toggle for the floating-label (watermark) effect. Off = a plain static watermark (shown only when the
             field is empty). -->
        <ToggleSwitch Content="{Localize TextStrings.FloatingWatermark}" IsChecked="{Binding FloatingWatermark, Mode=TwoWay}"
                      Margin="0,24,0,0" HorizontalAlignment="Left"/>

        <!-- Editable TextBox: two-way bound to the SAME Message, so typing here live-updates every TextBlock above. -->
        <TextBlock Text="{Localize TextStrings.Editable}" Margin="0,12,0,6"/>
        <TextBox AutomationProperties.AutomationId="Message" Text="{Binding Message, Mode=TwoWay}"
                 Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.Message}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <!-- Floating placeholder from empty: the label rests inside the field and animates up + shrinks on focus/typing. -->
        <TextBlock Text="{Localize TextStrings.FloatingTitle}" Margin="0,16,0,6"/>
        <TextBox Width="520" HorizontalAlignment="Left"
                 Placeholder="{Localize TextStrings.YourName}" FloatingPlaceholder="{Binding FloatingWatermark}"/>

        <TextBlock x:Name="ReadOnlyLabel" Text="{Localize TextStrings.ReadOnly}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="ReadOnlyMessage" AutomationProperties.LabeledBy="{Binding ElementName=ReadOnlyLabel}"
                 Text="{Binding Message}" IsReadOnly="True"
                 Width="520" HorizontalAlignment="Left"/>

        <!-- Multi-line editor: AcceptsReturn (Enter inserts a newline), NO wrap so long lines scroll horizontally. Both bars
             are Auto - the horizontal one via the shared ScrollViewer.HorizontalScrollBarVisibility attached policy on the
             TextBox (TextBoxBase now uses the attached props, not its own). Arrow keys navigate; selection spans rows. -->
        <TextBlock x:Name="NotesLabel" Text="{Localize TextStrings.MultiLine}" Margin="0,16,0,6"/>
        <TextBox AutomationProperties.AutomationId="Notes" AutomationProperties.LabeledBy="{Binding ElementName=NotesLabel}"
                 Text="{Binding Notes, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Width="520" Height="120" HorizontalAlignment="Left"/>

        <!-- Bindable Runs: a single TextBlock built from Run inlines. The middle run's Text binds to Message (updates
             live while you type in the box above) and its Foreground binds to a VM brush - both bindable, unlike WPF. -->
        <TextBlock Text="{Localize TextStrings.BindableRuns}" Margin="0,20,0,6"/>
        <TextBlock FontSize="16">
            <TextBlock.Inlines>
                <Run Text="{Localize TextStrings.YouTyped}" Foreground="#94A3B8"/>
                <Run Text="{Binding Message}" Foreground="{Binding AccentBrush}"/>
                <Run Text="{Localize TextStrings.Chars, count={Binding MessageLength}}" Foreground="#64748B"/>
            </TextBlock.Inlines>
        </TextBlock>

        <!-- Runs lay out as one text: each carries its own background, lines and size, and they wrap together. -->
        <TextBlock Text="{Localize TextStrings.StyledRuns}"
                   Margin="0,20,0,6"/>
        <TextBlock FontSize="18"
                   TextWrapping="WrapByWords"
                   Width="520"
                   HorizontalAlignment="Left">
            <TextBlock.Inlines>
                <Run Text="{Localize TextStrings.Highlighted}"
                     Background="#7C3AED"/>
                <Run Text=" "/>
                <Run Text="{Localize TextStrings.Underlined}"
                     TextDecorations="Underline"/>
                <Run Text=" "/>
                <Run Text="{Localize TextStrings.Misspelt}"
                     TextDecorations="Squiggle"
                     Foreground="#F87171"/>
                <Run Text=" "/>
                <Run Text="{Localize TextStrings.Struck}"
                     TextDecorations="Strikethrough"/>
                <Run Text=" "/>
                <Run Text="{Localize TextStrings.Large}"
                     FontSize="32"/>
            </TextBlock.Inlines>
        </TextBlock>

        <!-- Faces of one family picked by weight and slant, run by run within one line. -->
        <TextBlock Text="{Localize TextStrings.WeightsTitle}"
                   Margin="0,20,0,6"/>
        <TextBlock FontSize="20">
            <TextBlock.Inlines>
                <Run Text="Light "
                     FontWeight="Light"/>
                <Run Text="Regular "/>
                <Run Text="SemiBold "
                     FontWeight="SemiBold"/>
                <Run Text="Bold "
                     FontWeight="Bold"/>
                <Run Text="Black "
                     FontWeight="Black"/>
                <Run Text="Italic"
                     FontStyle="Italic"/>
            </TextBlock.Inlines>
        </TextBlock>

        <!-- A variable font takes any weight along its axis, not only the named faces, and its widths. -->
        <TextBlock Text="{Localize TextStrings.VariableTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontFamily="Bahnschrift"
                    FontSize="22"
                    Orientation="Vertical">
            <TextBlock>
                <TextBlock.Inlines>
                    <Run Text="300 "
                         FontWeight="300"/>
                    <Run Text="380 "
                         FontWeight="380"/>
                    <Run Text="460 "
                         FontWeight="460"/>
                    <Run Text="540 "
                         FontWeight="540"/>
                    <Run Text="620 "
                         FontWeight="620"/>
                    <Run Text="700"
                         FontWeight="700"/>
                </TextBlock.Inlines>
            </TextBlock>
            <TextBlock>
                <TextBlock.Inlines>
                    <Run Text="Condensed "
                         FontStretch="Condensed"/>
                    <Run Text="SemiCondensed "
                         FontStretch="SemiCondensed"/>
                    <Run Text="Normal"/>
                </TextBlock.Inlines>
            </TextBlock>
        </StackPanel>

        <!-- A family with one face: bold and italic draw that face as it is, unless synthesis is allowed. -->
        <TextBlock Text="{Localize TextStrings.SynthesisTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontFamily="Ink Free"
                    FontSize="22"
                    Orientation="Vertical">
            <TextBlock>
                <TextBlock.Inlines>
                    <Run Text="Regular "/>
                    <Run Text="Bold "
                         FontWeight="Bold"/>
                    <Run Text="Italic "
                         FontStyle="Italic"/>
                    <Run Text="Bold Italic"
                         FontWeight="Bold"
                         FontStyle="Italic"/>
                </TextBlock.Inlines>
            </TextBlock>
            <TextBlock FontSynthesis="Weight, Style">
                <TextBlock.Inlines>
                    <Run Text="Regular "/>
                    <Run Text="Bold "
                         FontWeight="Bold"/>
                    <Run Text="Italic "
                         FontStyle="Italic"/>
                    <Run Text="Bold Italic"
                         FontWeight="Bold"
                         FontStyle="Italic"/>
                </TextBlock.Inlines>
            </TextBlock>
        </StackPanel>

        <!-- Characters the theme's font lacks come from the system's fallback fonts; the last one is in no font. -->
        <TextBlock Text="{Localize TextStrings.FallbackTitle}"
                   Margin="0,20,0,6"/>
        <TextBlock Text="Latin 中文 日本語 한국어 😀 ☃ ∑ ͸"
                   FontSize="20"/>

        <!-- A variation selector picks text or emoji; a sequence joined by ZWJ, a keycap, a skin tone or a flag is one
             emoji. -->
        <TextBlock Text="{Localize TextStrings.EmojiTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontSize="24"
                    Orientation="Vertical">
            <TextBlock Text="❤ ❤&#xFE0F;   ☺ ☺&#xFE0F;   ☕&#xFE0E; ☕"/>
            <TextBlock Text="1&#xFE0F;&#x20E3; #&#xFE0F;&#x20E3; 👍🏽 👩🏾&#x200D;💻 👨&#x200D;👩&#x200D;👧 👩&#x200D;❤&#xFE0F;&#x200D;💋&#x200D;👨 🫱🏻&#x200D;🫲🏿 🏳&#xFE0F;&#x200D;🌈 🏳&#xFE0F;&#x200D;⚧&#xFE0F; 🇺🇦"/>
        </StackPanel>

        <!-- Color glyphs drawn from images: a subset of Noto Color Emoji ('CBDT') and Google's samples ('sbix'). -->
        <TextBlock Text="{Localize TextStrings.BitmapTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontSize="40"
                    Orientation="Vertical">
            <TextBlock FontFamily="{Binding EmbeddedBitmapFont}"
                       Text="8 9 ® ⁉"/>
            <TextBlock FontFamily="{Binding StandardBitmapFont}"
                       Text="simple_linear simple_radial linear_repeat radial_reflect gradient_stop_opacity"/>
        </StackPanel>

        <!-- The same drawings as SVG documents and as a 'COLR' version 1 paint graph: they should look alike. -->
        <TextBlock Text="{Localize TextStrings.SvgTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontSize="40"
                    Orientation="Vertical">
            <TextBlock FontFamily="{Binding SvgFont}"
                       Text="simple_linear simple_radial linear_repeat radial_reflect linear_transform gradient_stop_opacity"/>
            <TextBlock FontFamily="{Binding PaintFont}"
                       Text="simple_linear simple_radial linear_repeat radial_reflect linear_transform gradient_stop_opacity"/>
        </StackPanel>

        <!-- One text in each palette of a color font: ColorPalette picks the font's 'CPAL' palette by its number. -->
        <TextBlock Text="{Localize TextStrings.PaletteTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontFamily="{Binding PaletteFont}"
                    FontSize="40"
                    Orientation="Horizontal">
            <TextBlock Text="&#xF0100;&#xF0101;&#xF0200;&#xF0203;"/>
            <TextBlock ColorPalette="1"
                       Margin="24,0,0,0"
                       Text="&#xF0100;&#xF0101;&#xF0200;&#xF0203;"/>
            <TextBlock ColorPalette="2"
                       Margin="24,0,0,0"
                       Text="&#xF0100;&#xF0101;&#xF0200;&#xF0203;"/>
        </StackPanel>

        <!-- Typography by name and font features by tag, inherited by the text inside. -->
        <TextBlock Text="{Localize TextStrings.TypographyTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontSize="22"
                    Orientation="Vertical">
            <TextBlock Text="Small capitals 1/2 0123456789"/>
            <TextBlock Text="Small capitals 1/2 0123456789"
                       Typography.Capitals="SmallCaps"
                       Typography.NumeralStyle="Oldstyle"/>
            <TextBlock Text="1/2 3/4 7/8"
                       Typography.Fraction="Slashed"/>
        </StackPanel>

        <!-- A panel of OpenType features: each feature that turns a glyph into another, named by the font itself when it
             names it, and characters it changes drawn with it on. -->
        <TextBlock Text="{Localize TextStrings.FeaturesTitle}"
                   Margin="0,20,0,6"/>
        <ItemsControl ItemsSource="{Binding FontFeatureItems}"
                      FontFamily="{Binding FeatureFont}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,2">
                        <TextBlock Text="{Binding Tag}"
                                   Width="110"
                                   FontSize="16"/>
                        <TextBlock Text="{Binding Name}"
                                   Width="420"
                                   FontSize="16"/>
                        <TextBlock Text="{Binding Sample}"
                                   FontFeatures="{Binding Settings}"
                                   FontSize="22"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- A glyph panel: every alternate of one character, with the feature and value that ask for it. -->
        <TextBlock Text="{Localize TextStrings.AlternatesTitle}"
                   Margin="0,20,0,6"/>
        <TextBox AutomationProperties.AutomationId="AlternateCharacter"
                 Text="{Binding AlternateCharacter, Mode=TwoWay}"
                 Placeholder="{Localize TextStrings.AlternateCharacter}"
                 Width="120"
                 HorizontalAlignment="Left"/>
        <ItemsControl ItemsSource="{Binding GlyphAlternates}"
                      FontFamily="{Binding FeatureFont}"
                      Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"
                                Margin="0,0,16,8">
                        <TextBlock Text="{Binding Text}"
                                   FontFeatures="{Binding Settings}"
                                   FontSize="48"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- A variable font's axes by the font's own names, with the names its style attributes give their values. -->
        <TextBlock Text="{Localize TextStrings.AxesTitle}"
                   Margin="0,20,0,6"/>
        <ItemsControl ItemsSource="{Binding AxisItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,2">
                        <TextBlock Text="{Binding Tag}"
                                   Width="70"
                                   FontSize="15"/>
                        <TextBlock Text="{Binding Name}"
                                   Width="260"
                                   FontSize="15"/>
                        <TextBlock Text="{Binding Range}"
                                   Width="180"
                                   FontSize="15"/>
                        <TextBlock Text="{Binding Values}"
                                   FontSize="15"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The optical size follows the text's size; the same size drawn at the smallest and largest optical sizes. -->
        <TextBlock Text="{Localize TextStrings.OpticalSizeTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontFamily="{Binding VariableFont}"
                    Orientation="Horizontal">
            <TextBlock Text="Rag 8" FontSize="10" VerticalAlignment="Bottom"/>
            <TextBlock Text="Rag" FontSize="24" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
            <TextBlock Text="Rag" FontSize="48" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
            <TextBlock Text="Rag" FontSize="96" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>
        <StackPanel FontFamily="{Binding VariableFont}"
                    FontSize="64"
                    Orientation="Horizontal">
            <TextBlock Text="Rag" FontVariations="opsz=8"/>
            <TextBlock Text="Rag" FontVariations="opsz=144" Margin="24,0,0,0"/>
            <TextBlock Text="Rag" FontStyle="Italic" Margin="24,0,0,0"/>
        </StackPanel>

        <!-- FontVariations over the weight: grade, width and parametric axes, by value. -->
        <TextBlock Text="{Localize TextStrings.VariationsTitle}"
                   Margin="0,20,0,6"/>
        <StackPanel FontFamily="{Binding VariableFont}"
                    FontSize="28"
                    Orientation="Vertical">
            <TextBlock Text="GRAD=-200  Hamburgefonstiv" FontVariations="GRAD=-200"/>
            <TextBlock Text="GRAD=150  Hamburgefonstiv" FontVariations="GRAD=150"/>
            <TextBlock Text="wdth=25  Hamburgefonstiv" FontVariations="wdth=25"/>
            <TextBlock Text="wdth=151, wght=900  Hamburgefonstiv" FontVariations="wdth=151, wght=900"/>
            <TextBlock Text="XTRA=323, YTUC=760  Hamburgefonstiv" FontVariations="XTRA=323, YTUC=760"/>
            <TextBlock Text="wght=1000  $ ¢ ₴ ₦" FontVariations="wght=1000"/>
            <TextBlock Text="wght=100  $ ¢ ₴ ₦" FontVariations="wght=100"/>
        </StackPanel>

        <!-- FontVariations in motion: each frame is laid out at its own values and drawn between key instances. -->
        <TextBlock Text="{Localize TextStrings.MovingTitle}"
                   Margin="0,20,0,6"/>
        <ToggleSwitch AutomationProperties.AutomationId="HeavyToggle"
                      Content="{Localize TextStrings.Heavy}"
                      IsChecked="{Binding Heavy, Mode=TwoWay}"
                      HorizontalAlignment="Left"/>
        <TextBlock AutomationProperties.AutomationId="MovingText"
                   Text="Hamburgefonstiv"
                   FontFamily="{Binding VariableFont}"
                   FontSize="72"
                   FontVariations="{Binding MovingVariations}"
                   Margin="0,8,0,0">
            <TextBlock.Transitions>
                <FontVariationListTransition Property="FontVariations"
                                             Duration="0:0:1.5"/>
            </TextBlock.Transitions>
        </TextBlock>
    </StackPanel>
    </ScrollViewer>
</View>
