<View xmlns="http://adamantium/ui">
    <StackPanel Margin="16">
        <TextBlock Text="{Localize NavigationStrings.Details}" FontSize="20" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Localize NavigationStrings.ItemId}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="{Binding Id}" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>
        <ToggleSwitch Content="{Localize NavigationStrings.UnsavedChanges}"
                      IsChecked="{Binding HasUnsavedChanges, Mode=TwoWay}"/>
    </StackPanel>
</View>
