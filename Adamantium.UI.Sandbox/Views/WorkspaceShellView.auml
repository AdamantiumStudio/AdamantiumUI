<View xmlns="http://adamantium/ui"
      xmlns:nav="clr-namespace:Adamantium.UI.Controls.Navigation;assembly=Adamantium.UI.Controls">
    <!-- Second window's content. The TabControl carries no ItemsSource/SelectedItem of its own: nav:RegionManager.RegionName
         binds it to the named "workspace" region, so the manager alone opens/activates/closes tabs. The buttons drive the
         region through the VM. -->
    <Grid RowDefinitions="Auto,*" Margin="16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{Localize WorkspaceStrings.DrivenByNavigation}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="{Localize WorkspaceStrings.OpenDoc}"   Command="{Binding OpenDocCommand}"   MinWidth="100" Height="32" Margin="0,0,8,0"/>
            <Button Content="{Localize WorkspaceStrings.OpenChart}" Command="{Binding OpenChartCommand}" MinWidth="100" Height="32" Margin="0,0,8,0"/>
            <Button Content="{Localize WorkspaceStrings.CloseTab}"  Command="{Binding CloseTabCommand}"  MinWidth="90"  Height="32"/>
        </StackPanel>

        <!-- A page names its kind by a key of the workspace's phrases, and its number fills it in. -->
        <TabControl AutomationProperties.AutomationId="WorkspaceTabs"
                    Grid.Row="1"
                    nav:RegionManager.RegionName="workspace">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Localize WorkspaceStrings, Key={Binding Kind}, number={Binding Number}}" VerticalTextAlignment="Center"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </Grid>
</View>
