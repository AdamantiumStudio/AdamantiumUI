<View x:KeepAlive="Required"
      xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- DataContext is the SceneViewModel. The RenderTargetPanel runs the 3D universe as the backdrop; an overlay
         menu sits on top, shown/hidden via the view-model (a DataTrigger collapses it), and its buttons load models. -->
    <Grid>
        <RenderTargetPanel Background="#0B0E14" MouseLookMode="Drag" IsMouseLookEnabled="{Binding MouseLookEnabled}">
            <RenderTargetPanel.Behaviors>
                <behaviors:DemoUniverseBehavior/>
            </RenderTargetPanel.Behaviors>
        </RenderTargetPanel>

        <!-- Always-visible toggle in the corner, with the camera's travel speed under it. -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
            <Button AutomationProperties.AutomationId="MenuToggle"
                    Content="{Localize SceneStrings.MenuButton, visible={Binding IsMenuVisible}}"
                    Command="{Binding ToggleMenuCommand}"
                    MinWidth="120" Height="34"/>
            <TextBlock x:Name="CameraSpeedLabel" Text="{Localize SceneStrings.CameraSpeed}" MarginTop="10" MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <NumericUpDown AutomationProperties.AutomationId="CameraSpeed"
                           AutomationProperties.LabeledBy="{Binding ElementName=CameraSpeedLabel}"
                           Value="{Binding CameraSpeed, Mode=TwoWay}"
                           Width="120"
                           Minimum="0.01"
                           Maximum="100"
                           SmallChange="0.01"
                           LargeChange="0.1"
                           StringFormat="N2"/>
            <Button AutomationProperties.AutomationId="ResetCamera" Content="{Localize SceneStrings.ResetCamera}" Command="{Binding ResetCameraCommand}"
                    MinWidth="120" Height="30" MarginTop="10"/>
            <TextBlock Text="{Localize SceneStrings.Tool}"
                       MarginTop="10"
                       MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <RadioButton AutomationProperties.AutomationId="SelectTool"
                         Classes="Toggle"
                         GroupName="SceneTool"
                         Content="{Localize SceneStrings.Select}"
                         MinWidth="120"
                         IsChecked="{Binding IsSelecting, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="MoveTool"
                         Classes="Toggle"
                         GroupName="SceneTool"
                         Content="{Localize SceneStrings.Move}"
                         MinWidth="120"
                         MarginTop="4"
                         IsChecked="{Binding IsMoving, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="RotateTool"
                         Classes="Toggle"
                         GroupName="SceneTool"
                         Content="{Localize SceneStrings.Rotate}"
                         MinWidth="120"
                         MarginTop="4"
                         IsChecked="{Binding IsRotating, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="ScaleTool"
                         Classes="Toggle"
                         GroupName="SceneTool"
                         Content="{Localize SceneStrings.Scale}"
                         MinWidth="120"
                         MarginTop="4"
                         IsChecked="{Binding IsScaling, Mode=TwoWay}"/>
            <RadioButton AutomationProperties.AutomationId="PivotTool"
                         Classes="Toggle"
                         GroupName="SceneTool"
                         Content="{Localize SceneStrings.Pivot}"
                         MinWidth="120"
                         MarginTop="4"
                         IsChecked="{Binding IsMovingPivot, Mode=TwoWay}"/>
        </StackPanel>

        <!-- Lights, on the right under the orientation cube (its lowest arrow reaches about 226 points down): a new one is
             placed ahead of the camera and selected, so Move places it, Rotate aims it and its handles drag the range and
             the cone. -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MarginTop="240"
                    MarginRight="16">
            <TextBlock Text="{Localize SceneStrings.Lights}"
                       MarginBottom="4"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <Button AutomationProperties.AutomationId="AddPoint"
                    Content="{Localize SceneStrings.AddPoint}"
                    Command="{Binding AddPointLightCommand}"
                    MinWidth="120"
                    Height="30"/>
            <Button AutomationProperties.AutomationId="AddSpot"
                    Content="{Localize SceneStrings.AddSpot}"
                    Command="{Binding AddSpotLightCommand}"
                    MinWidth="120"
                    Height="30"
                    MarginTop="4"/>
            <Button AutomationProperties.AutomationId="AddDirectional"
                    Content="{Localize SceneStrings.AddDirectional}"
                    Command="{Binding AddDirectionalLightCommand}"
                    MinWidth="120"
                    Height="30"
                    MarginTop="4"/>
            <StackPanel Orientation="Vertical"
                        MarginTop="10"
                        Visibility="{Binding HasSelectedLight, Converter={conv:BoolToVisibilityConverter}}">
                <TextBlock Text="{Localize SceneStrings.LightName, type={Binding SelectedLightType}}"
                           MarginBottom="4"
                           Foreground="{ResourceReference TextFillColorPrimary}"/>
                <TextBlock x:Name="LightColorLabel"
                           Text="{Localize SceneStrings.Color}"
                           MarginBottom="2"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <ColorPickerButton AutomationProperties.AutomationId="LightColor"
                                   AutomationProperties.LabeledBy="{Binding ElementName=LightColorLabel}"
                                   SelectedColor="{Binding Light.Color, Mode=TwoWay, Converter={conv:VectorToColorConverter}}"
                                   Width="120"
                                   Height="30"/>
                <TextBlock x:Name="LightIntensityLabel"
                           Text="{Localize SceneStrings.Intensity}"
                           MarginTop="6"
                           MarginBottom="2"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <NumericUpDown AutomationProperties.AutomationId="LightIntensity"
                               AutomationProperties.LabeledBy="{Binding ElementName=LightIntensityLabel}"
                               Value="{Binding LightIntensity, Mode=TwoWay}"
                               Width="120"
                               IsDragScrubEnabled="true"
                               Minimum="0"
                               Maximum="100"
                               SmallChange="0.1"
                               LargeChange="1"
                               StringFormat="N2"/>
                <StackPanel Orientation="Vertical"
                            Visibility="{Binding HasRange, Converter={conv:BoolToVisibilityConverter}}">
                    <TextBlock x:Name="LightRangeLabel"
                               Text="{Localize SceneStrings.Range}"
                               MarginTop="6"
                               MarginBottom="2"
                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <NumericUpDown AutomationProperties.AutomationId="LightRange"
                                   AutomationProperties.LabeledBy="{Binding ElementName=LightRangeLabel}"
                                   Value="{Binding LightRange, Mode=TwoWay}"
                                   Width="120"
                                   IsDragScrubEnabled="true"
                                   Minimum="0.1"
                                   Maximum="1000"
                                   SmallChange="0.5"
                                   LargeChange="5"
                                   StringFormat="N1"/>
                </StackPanel>
                <StackPanel Orientation="Vertical"
                            Visibility="{Binding IsSpotSelected, Converter={conv:BoolToVisibilityConverter}}">
                    <TextBlock x:Name="ConeAngleLabel"
                               Text="{Localize SceneStrings.ConeAngle}"
                               MarginTop="6"
                               MarginBottom="2"
                               Foreground="{ResourceReference TextFillColorSecondary}"/>
                    <NumericUpDown AutomationProperties.AutomationId="ConeAngle"
                                   AutomationProperties.LabeledBy="{Binding ElementName=ConeAngleLabel}"
                                   Value="{Binding ConeAngle, Mode=TwoWay}"
                                   Width="120"
                                   Minimum="2"
                                   Maximum="179"
                                   SmallChange="1"
                                   LargeChange="10"
                                   StringFormat="N0"/>
                </StackPanel>
                <Button AutomationProperties.AutomationId="DeleteLight"
                        Content="{Localize SceneStrings.DeleteLight}"
                        Command="{Binding RemoveLightCommand}"
                        MinWidth="120"
                        Height="30"
                        MarginTop="8"/>
            </StackPanel>
        </StackPanel>

        <!-- What the UNIVERSE'S OWN rendering costs, opposite corner - not the rate the panel ticks it at, which would
             only ever report the interface back. -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
            <TextBlock Text="{Binding Fps, StringFormat='FPS: {0:F0}'}"
                       HorizontalAlignment="Right"
                       FontSize="18" Foreground="{ResourceReference TextFillColorPrimary}"/>
            <TextBlock Text="{Localize SceneStrings.FrameCost, ms={Binding FrameCostMs}}"
                       HorizontalAlignment="Right" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
        </StackPanel>

        <!-- How to fly it, bottom-left. A world with no landmarks tells a person nothing about what the keyboard does,
             and the keys are the engine's (InputService), not this tab's - so they are stated, not guessed at. -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16">
            <TextBlock Text="{Localize SceneStrings.MoveKeys}"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <TextBlock Text="{Localize SceneStrings.UpDownKeys}" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <TextBlock Text="{Localize SceneStrings.SpeedKeys}" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
            <TextBlock Text="{Localize SceneStrings.CameraKeys}" MarginTop="2"
                       Foreground="{ResourceReference TextFillColorSecondary}"/>
        </StackPanel>

        <!-- The overlay menu: collapsed when IsMenuVisible is false (declarative DataTrigger). Themed - a card surface with
             an accent outline, so it follows a theme/accent swap instead of hardcoded colors. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="280"
                Background="{ResourceReference CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource AccentFillColorDefault}" BorderThickness="1"
                CornerRadius="12" Padding="24">
            <Border.Triggers>
                <DataTrigger Binding="{Binding IsMenuVisible}" Value="false">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Border.Triggers>
            <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Localize SceneStrings.Menu}" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,16"
                           Foreground="{ResourceReference TextFillColorPrimary}"/>
                <Button AutomationProperties.AutomationId="Continue" Content="{Localize SceneStrings.Continue}" Command="{Binding ToggleMenuCommand}" Height="36" Margin="0,0,0,8"/>
                <Button AutomationProperties.AutomationId="LoadF15" Content="{Localize SceneStrings.LoadF15}" Command="{Binding LoadF15Command}" Height="36" Margin="0,0,0,8"/>
                <!-- No Swordman: it is a rigged model and character animation is not connected yet, so loading it
                     takes the application down. Bring the button back with the animation. -->
                <Button AutomationProperties.AutomationId="LoadMonkey" Content="{Localize SceneStrings.LoadMonkey}" Command="{Binding LoadMonkeyCommand}" Height="36"/>
                <TextBlock Text="{Localize SceneStrings.Status, status={Binding Status}, model={Binding Model}, error={Binding LoadError}}" HorizontalAlignment="Center" Margin="0,16,0,0"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</View>
