<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:ui="clr-namespace:Adamantium.UI.Core;assembly=Adamantium.UI.Core">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnDefinitions="*,*" Margin="16">

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="PropertyGrid" FontSize="18"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,12" TextWrapping="WrapByWords"
                   Text="{Localize PropertyPageStrings.Intro}"/>

        <!-- What each inspector is over, and what the toggle below has just done - said in full, because an inspector
             over several objects behaves differently from one over a single object, and a row standing empty is a
             statement, not a gap. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" Text="{Localize PropertyPageStrings.LeftCaption, both={Binding Both}}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,6" Text="{Localize PropertyPageStrings.RightCaption, both={Binding Both}}"/>

        <PropertyGrid Grid.Row="3" Grid.Column="0" x:Name="Inspector" Margin="0,0,8,0"
                      SelectedObjects="{Binding LeftSelection}"
                      NameColumnWidth="150">
            <PropertySection Header="{Localize PropertyPageStrings.General}" IsExpanded="True">
                <!-- DefaultValue is what the line is worth untouched. A row holding anything else marks itself and
                     offers the arrow that puts this back - so an inspector of forty rows says at a glance which of
                     them were edited. The generated half beside it needs none of this: the builder reads the
                     defaults off a fresh instance of the type. -->
                <StringProperty Header="{Localize PropertyPageStrings.Name}" Binding="{Binding Name}" DefaultValue="Player"/>
                <BooleanProperty Header="{Localize PropertyPageStrings.Enabled}" Binding="{Binding IsEnabled}" DefaultValue="True"/>
                <!-- The "..." button: off on every line by default, and named here. The command is the PAGE'S - the
                     inspector only offers the button and hands over what the line is pointed at. Like the list of
                     materials below, it resolves against the page, because a definition stands in the inspector's
                     logical tree while its VALUE binding reads the object being inspected. -->
                <StringProperty Header="{Localize PropertyPageStrings.Tag}" Binding="{Binding Tag}"
                                ShowActionButton="True"
                                ActionCommand="{Binding MoreForTagCommand}"/>
                <!-- A value that may be READ but not written: the binding is one-way and the line says so. -->
                <StringProperty Header="{Localize PropertyPageStrings.Guid}" Binding="{Binding Guid, Mode=OneWay}" IsReadOnly="True"/>
            </PropertySection>

            <PropertySection Header="{Localize PropertyPageStrings.Transform}" IsExpanded="True">
                <!-- A composite: one line folded, three when opened. Its children are indented; their VALUES still line
                     up with every other value - that is what one shared grip is for. -->
                <CompositeProperty Header="{Localize PropertyPageStrings.Position}">
                    <NumericProperty Header="X" Binding="{Binding PositionX}" Step="0.5" DefaultValue="12.5"/>
                    <NumericProperty Header="Y" Binding="{Binding PositionY}" Step="0.5" DefaultValue="0"/>
                    <NumericProperty Header="Z" Binding="{Binding PositionZ}" Step="0.5" DefaultValue="-4"/>
                </CompositeProperty>
            </PropertySection>

            <PropertySection Header="{Localize PropertyPageStrings.Physics}" IsExpanded="True">
                <NumericProperty Header="{Localize PropertyPageStrings.Mass}" Binding="{Binding Mass}" Minimum="0" Maximum="1000" Step="5"
                                 DefaultValue="80"/>
                <ChoiceProperty Header="{Localize PropertyPageStrings.Visibility}" Binding="{Binding Visibility}" EnumType="{x:Type ui:Visibility}"
                                DefaultValue="Visible"/>
                <!-- Two bindings on one line, and they read DIFFERENT things - which is the whole point. The VALUE is
                     read off the object being inspected; every other property of the definition resolves against the
                     page's DataContext, because a definition stands in the inspector's logical tree. So the list of
                     materials comes straight from the view-model, with no provider in between. -->
                <ChoiceProperty Header="{Localize PropertyPageStrings.Material}" Binding="{Binding Material}" ItemsSource="{Binding Materials}"
                                DefaultValue="Steel"/>
                <!-- The one value nobody can type. The swatch opens the full picker in a flyout, so the line costs one
                     row whether the picker is open or not, and dragging inside it moves the object being inspected as
                     the pointer goes. -->
                <ColorProperty Header="{Localize PropertyPageStrings.Tint}" Binding="{Binding Tint}"/>
                <!-- A BRUSH. The line paints the color INTO the brush the object already holds instead of putting a
                     new one there, so everything else painting with that brush follows - see the square below, which
                     is bound to the same instance and is told nothing. That is also why the binding may be one-way:
                     nothing is written back through it. -->
                <SolidColorBrushProperty Header="{Localize PropertyPageStrings.Fill}" Binding="{Binding Fill, Mode=OneWay}"/>
            </PropertySection>
        </PropertyGrid>

        <!-- ShowSearch off: an inspector of a handful of rows does not need a field to find them in, and the row it
             would take is worth more to the rows. The left one keeps it, so the page shows both. -->
        <PropertyGrid Grid.Row="3" Grid.Column="1" Margin="8,0,0,0"
                      SelectedObjects="{Binding RightSelection}"
                      AutoGenerateSections="True"
                      ShowSearch="{Binding Searchable}"
                      NameColumnWidth="170"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox Content="{Localize PropertyPageStrings.PointAtBoth}" IsChecked="{Binding Both, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <CheckBox Content="{Localize PropertyPageStrings.SearchOnRight}" IsChecked="{Binding Searchable, Mode=TwoWay}"
                      Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Localize PropertyPageStrings.Difference, both={Binding Both}}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
            <!-- What the "..." button on a line reports. The command is the APPLICATION'S - the inspector only offers the
                 button and hands over what the line is pointed at; what "more" means for a tag is the page's business. -->
            <TextBlock VerticalAlignment="Center"
                       Text="{Localize PropertyPageStrings.Action, pressed={Binding ActionPressed}, target={Localize PropertyPageStrings.Target, name={Binding ActionTarget}}}"
                       Foreground="{ObservableResource TextFillColorSecondary}"/>

            <!-- Painted with the SAME brush the Fill line edits, and bound to nothing else. It follows the picker
                 because the brush is the one being changed - not because anything here was told to refresh. -->
            <Border Width="18" Height="18" Margin="16,0,6,0" CornerRadius="3"
                    VerticalAlignment="Center" Background="{Binding Entity.Fill}"/>
            <TextBlock VerticalAlignment="Center" Text="{Localize PropertyPageStrings.SameBrush}"
                       Foreground="{ObservableResource TextFillColorSecondary}"/>
        </StackPanel>
    </Grid>
</View>
