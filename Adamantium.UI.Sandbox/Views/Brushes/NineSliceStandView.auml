<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- Navigated into the brushes tab's region under the key "NineSlice"; the DataContext is the tab's own view-model.
         This stand does NOT use the shared figure: the whole subject is the frame's own size, so it drives its own box. -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="{Localize BrushesStrings.NineTitle}" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Border Width="360" Height="240" Margin="10" Background="#101418">
                <Border Width="{Binding SliceWidth}"
                        Height="{Binding SliceHeight}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{Binding LiveNineSlice}"/>
            </Border>
            <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                <TextBlock x:Name="SkinLabel" Text="{Localize BrushesStrings.Skin}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown AutomationProperties.LabeledBy="{Binding ElementName=SkinLabel}" ItemsSource="{Binding Skins}" SelectedItem="{Binding Skin, Mode=TwoWay}" Width="280" MarginBottom="10"/>
                <TextBlock x:Name="WidthLabel" Text="{Localize BrushesStrings.Width}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=WidthLabel}" Value="{Binding SliceWidth, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="340" Width="186"/>
                    <NumericUpDown Width="88" Minimum="40" Maximum="340" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding SliceWidth, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=WidthLabel}"/>
                </StackPanel>
                <TextBlock x:Name="HeightLabel" Text="{Localize BrushesStrings.Height}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=HeightLabel}" Value="{Binding SliceHeight, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="40" Maximum="220" Width="186"/>
                    <NumericUpDown Width="88" Minimum="40" Maximum="220" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding SliceHeight, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=HeightLabel}"/>
                </StackPanel>
                <TextBlock x:Name="CutLabel" Text="{Localize BrushesStrings.Cut}"
                           TextWrapping="WrapByWords" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=CutLabel}" Value="{Binding SliceCut, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0.05" Maximum="0.45" Width="186"/>
                    <NumericUpDown Width="88" Minimum="0.05" Maximum="0.45" SmallChange="0.05"
                                   SnapsToSmallChange="true" StringFormat="N2"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding SliceCut, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=CutLabel}"/>
                </StackPanel>
                <TextBlock x:Name="BorderLabel" Text="{Localize BrushesStrings.Border}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=BorderLabel}" Value="{Binding SliceBorder, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="48" Width="186"/>
                    <NumericUpDown Width="88" Minimum="0" Maximum="48" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding SliceBorder, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=BorderLabel}"/>
                </StackPanel>
                <TextBlock x:Name="EdgeModeLabel" Text="{Localize BrushesStrings.EdgeMode}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown AutomationProperties.LabeledBy="{Binding ElementName=EdgeModeLabel}" ItemsSource="{Binding EdgeModes}" SelectedItem="{Binding SliceEdgeMode, Mode=TwoWay}" Width="280" MarginBottom="10">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize BrushesStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                </DropDown>
                <CheckBox Content="{Localize BrushesStrings.DrawCenter}" IsChecked="{Binding SliceDrawCenter, Mode=TwoWay}" MarginBottom="6"/>
                <CheckBox Content="{Localize BrushesStrings.TileCenter}" IsChecked="{Binding SliceTileCenter, Mode=TwoWay}" MarginBottom="10"/>
                <TextBlock x:Name="TintLabel" Text="{Localize BrushesStrings.Tint}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <ColorPickerButton Width="48" Height="32" SelectedColor="{Binding SliceTint, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=TintLabel}"/>
            </StackPanel>
        </StackPanel>

        <!-- The fixed cases the live panel above is compared against: one 64x64 picture dressing four sizes, then the
             SAME picture as a plain ImageBrush - the corners smear, which is the whole argument for nine-slice. -->
        <TextBlock Text="{Localize BrushesStrings.NineBrushTitle}" FontSize="18" Margin="0,20,0,10"/>
        <TextBlock Text="{Localize BrushesStrings.NineHint}"
                   Foreground="{ResourceReference TextFillColorSecondary}"
                   MarginBottom="8"/>
        <WrapPanel Orientation="Horizontal">
            <Border Width="90" Height="90" Margin="10">
                <Border.Background>
                    <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                </Border.Background>
            </Border>
            <Border Width="240" Height="90" Margin="10">
                <Border.Background>
                    <NineSliceBrush Source="Textures/nine-slice-frame.png" Slice="0.25"/>
                </Border.Background>
                <TextBlock Text="{Localize BrushesStrings.StretchedEdges}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="240" Height="90" Margin="10">
                <Border.Background>
                    <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                    Slice="0.25"
                                    EdgeMode="Repeat"/>
                </Border.Background>
                <TextBlock Text="{Localize BrushesStrings.RepeatedEdges}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="240" Height="140" Margin="10">
                <Border.Background>
                    <NineSliceBrush Source="Textures/nine-slice-frame.png"
                                    Slice="0.25"
                                    EdgeMode="Repeat"
                                    DrawCenter="False"/>
                </Border.Background>
                <TextBlock Text="{Localize BrushesStrings.FrameOnly}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </WrapPanel>

        <TextBlock Text="{Localize BrushesStrings.PlainImage}"
                   Foreground="{ResourceReference TextFillColorSecondary}"
                   MarginTop="12"
                   MarginBottom="6"/>
        <WrapPanel Orientation="Horizontal">
            <Border Width="90" Height="90" Margin="10">
                <Border.Background>
                    <ImageBrush Source="Textures/nine-slice-frame.png"/>
                </Border.Background>
            </Border>
            <Border Width="240" Height="90" Margin="10">
                <Border.Background>
                    <ImageBrush Source="Textures/nine-slice-frame.png"/>
                </Border.Background>
            </Border>
            <Border Width="240" Height="90" Margin="10">
                <Border.Background>
                    <ImageBrush Source="Textures/nine-slice-frame.png" Tint="#66FF88"/>
                </Border.Background>
                <TextBlock Text="{Localize BrushesStrings.Tinted}" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </WrapPanel>
    </StackPanel>
</View>
