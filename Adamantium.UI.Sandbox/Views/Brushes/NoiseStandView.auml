<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- Navigated into the brushes tab's region under the key "Noise"; the DataContext is the tab's own view-model. -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="{Localize BrushesStrings.NoiseTitle}" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Margin="10">
                <Rectangle Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Fill="{Binding LiveNoise}"
                           CornerRadius="{Binding NoiseRadius, Converter={conv:DoubleToCornerRadiusConverter}}"
                           Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Rectangle}"/>
                <Ellipse Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Fill="{Binding LiveNoise}"
                         Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Ellipse}"/>
                <RegularPolygon Width="{Binding PreviewSquare}" Height="{Binding PreviewSquare}" Corners="{Binding ShapeCornerCount}"
                                StartAngle="{Binding ShapeStartAngle}" Fill="{Binding LiveNoise}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Polygon}"/>
                <Polygon Points="{Binding FixedStar}" Fill="{Binding LiveNoise}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Star}"/>
            </Grid>
            <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                <!-- Only for the polygon: on a rect or an ellipse these two numbers mean nothing. -->
                <StackPanel Orientation="Vertical" Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Polygon}">
                    <TextBlock x:Name="CornersLabel" Text="{Localize BrushesStrings.CornersHint}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="6">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=CornersLabel}" Value="{Binding ShapeCorners, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="3" Maximum="24"
                                TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                        <NumericUpDown Width="88" Minimum="3" Maximum="24" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShapeCorners, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=CornersLabel}"/>
                    </StackPanel>
                    <TextBlock x:Name="StartAngleLabel" Text="{Localize BrushesStrings.StartAngleHint}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=StartAngleLabel}" Value="{Binding ShapeStartAngle, Mode=TwoWay}" IsValueToolTipEnabled="True" Minimum="0" Maximum="360"
                                TickFrequency="1" IsSnapToTickEnabled="true" Width="180"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="360" SmallChange="1" SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding ShapeStartAngle, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=StartAngleLabel}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="NoiseTypeLabel" Text="{Localize BrushesStrings.NoiseType}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <DropDown AutomationProperties.LabeledBy="{Binding ElementName=NoiseTypeLabel}" ItemsSource="{Binding NoiseTypes}" SelectedItem="{Binding NoiseKind, Mode=TwoWay}" Width="280" MarginBottom="10">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize BrushesStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                </DropDown>
                <CheckBox Content="{Localize BrushesStrings.Animate}" IsChecked="{Binding NoiseAnimate, Mode=TwoWay}" MarginBottom="6"/>
                <TextBlock x:Name="FlowSpeedLabel" Text="{Localize BrushesStrings.FlowSpeed}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <StackPanel Orientation="Horizontal" MarginBottom="10">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=FlowSpeedLabel}" Value="{Binding NoiseFlowSpeed, Mode=TwoWay}" Minimum="0.1" Maximum="3" Width="186"/>
                    <NumericUpDown Width="88" Minimum="0.1" Maximum="3" SmallChange="0.05"
                                   SnapsToSmallChange="true" StringFormat="N2"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding NoiseFlowSpeed, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=FlowSpeedLabel}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Visibility="{Binding PreviewShape, Converter={conv:EnumVisibilityConverter}, ConverterParameter=Rectangle}">
                    <TextBlock x:Name="CornerRadiusLabel" Text="{Localize BrushesStrings.CornerRadius}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=CornerRadiusLabel}" Value="{Binding NoiseRadius, Mode=TwoWay}" Minimum="0" Maximum="100" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="100" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding NoiseRadius, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=CornerRadiusLabel}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Scale}">
                    <TextBlock x:Name="ScaleLabel" Text="{Localize BrushesStrings.Scale}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=ScaleLabel}" Value="{Binding NoiseScale, Mode=TwoWay}" Minimum="6" Maximum="120" Width="186"/>
                        <NumericUpDown Width="88" Minimum="6" Maximum="120" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding NoiseScale, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=ScaleLabel}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Fbm}">
                    <TextBlock x:Name="OctavesLabel" Text="{Localize BrushesStrings.Octaves}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=OctavesLabel}" Value="{Binding NoiseOctaves, Mode=TwoWay}" Minimum="1" Maximum="8" Width="186"/>
                        <NumericUpDown Width="88" Minimum="1" Maximum="8" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding NoiseOctaves, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=OctavesLabel}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Seed}">
                    <TextBlock x:Name="SeedLabel" Text="{Localize BrushesStrings.Seed}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=SeedLabel}" Value="{Binding NoiseSeed, Mode=TwoWay}" Minimum="0" Maximum="50" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0" Maximum="50" SmallChange="1"
                                       SnapsToSmallChange="true" StringFormat="N0"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding NoiseSeed, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=SeedLabel}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=Fbm}">
                    <TextBlock x:Name="LacunarityLabel" Text="{Localize BrushesStrings.Lacunarity}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LacunarityLabel}" Value="{Binding NoiseLacunarity, Mode=TwoWay}" Minimum="1.5" Maximum="3.5" Width="186"/>
                        <NumericUpDown Width="88" Minimum="1.5" Maximum="3.5" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding NoiseLacunarity, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=LacunarityLabel}"/>
                    </StackPanel>
                    <TextBlock x:Name="GainLabel" Text="{Localize BrushesStrings.Gain}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel Orientation="Horizontal" MarginBottom="10">
                        <Slider AutomationProperties.LabeledBy="{Binding ElementName=GainLabel}" Value="{Binding NoiseGain, Mode=TwoWay}" Minimum="0.2" Maximum="0.8" Width="186"/>
                        <NumericUpDown Width="88" Minimum="0.2" Maximum="0.8" SmallChange="0.05"
                                       SnapsToSmallChange="true" StringFormat="N2"
                                       IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                       Value="{Binding NoiseGain, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="6" AutomationProperties.LabeledBy="{Binding ElementName=GainLabel}"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox Content="{Localize BrushesStrings.FirePalette}" IsChecked="{Binding NoiseFirePalette, Mode=TwoWay}" MarginBottom="6"
                          Visibility="{Binding NoiseKind, Converter={conv:NoiseParamVisibilityConverter}, ConverterParameter=FirePalette}"/>
                <StackPanel Orientation="Vertical">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{conv:CombustibleColorsVisibilityConverter}">
                            <Binding Path="NoiseKind"/>
                            <Binding Path="NoiseFirePalette"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <CheckBox Content="{Localize BrushesStrings.MidColor}" IsChecked="{Binding NoiseUseMid, Mode=TwoWay}" MarginBottom="6"/>
                    <TextBlock x:Name="NoiseColorsLabel" Text="{Localize BrushesStrings.NoiseColors}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                    <StackPanel AutomationProperties.LabeledBy="{Binding ElementName=NoiseColorsLabel}" Orientation="Horizontal">
                        <ColorPickerButton AutomationProperties.Name="1" Width="48" Height="32" SelectedColor="{Binding NoiseColor1, Mode=TwoWay}" MarginRight="8"/>
                        <ColorPickerButton AutomationProperties.Name="2" Width="48" Height="32" SelectedColor="{Binding NoiseMid, Mode=TwoWay}" MarginRight="8"/>
                        <ColorPickerButton AutomationProperties.Name="3" Width="48" Height="32" SelectedColor="{Binding NoiseColor2, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- The swatch row belongs to THIS stand, not to the tab: one labeled square per noise type, so what the
             sliders above can be pointed at is on screen beside them. -->
        <TextBlock Text="{Localize BrushesStrings.NoiseTypesTitle}" FontSize="18" Margin="0,20,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Simplex" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#7DD3FC"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.Simplex}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Perlin" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#86EFAC"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.Perlin}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Value" Scale="42" Octaves="5" Animate="true" FlowSpeed="0.6" Color1="#0B1220" Color2="#FDE68A"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.Value}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Worley" Scale="52" Octaves="2" Color1="#0B1220" Color2="#FCA5A5"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.Worley}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Worley" Scale="56" Octaves="1" Animate="true" FlowSpeed="0.8" Color1="#0B1220" Color2="#C4B5FD"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.WorleyFlow}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Ridged" Scale="60" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#FBBF24"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.Ridged}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Turbulence" Scale="54" Octaves="6" Animate="true" FlowSpeed="0.5" Color1="#0B1220" Color2="#38BDF8"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.Turbulence}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="VoronoiBorders" Scale="46" Animate="true" FlowSpeed="0.7" Color1="#0B1220" Color2="#67E8F9"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.VoronoiBorders}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Margin="10">
                <Rectangle Width="150"
                           Height="110"
                           CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="Circuit"
                                    Scale="90"
                                    Octaves="2"
                                    Animate="true"
                                    FlowSpeed="1.0"
                                    Color1="#030712"
                                    MidColor="#2563EB"
                                    Color2="#E0F2FE"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.Circuit}"
                           HorizontalAlignment="Center"
                           MarginTop="6"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.CombustibleFire}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <Rectangle Width="150" Height="110" CornerRadius="12">
                    <Rectangle.Fill>
                        <NoiseBrush NoiseType="CombustibleVoronoi" Scale="40" Animate="true" FlowSpeed="1.0"
                                    UseFirePalette="false" Color1="#020617" MidColor="#0EA5E9" Color2="#E0F2FE"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Localize BrushesStrings.CombustibleCustom}" HorizontalAlignment="Center" MarginTop="6" Foreground="{ResourceReference TextFillColorSecondary}"/>
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</View>
