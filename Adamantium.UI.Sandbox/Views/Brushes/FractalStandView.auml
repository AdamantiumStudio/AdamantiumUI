<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- Navigated into the brushes tab's region under the key "Fractal"; the DataContext is the tab's own view-model.
         The live stand comes first and the fixed samples follow it - reference belongs to the stand it is about. -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="{Localize BrushesStrings.FractalTitle}" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <FractalView Width="720" Height="580" CornerRadius="12" Margin="10"
                         Fill="{Binding LiveFractal}"
                         CenterX="{Binding FractalCenterX, Mode=TwoWay}"
                         CenterY="{Binding FractalCenterY, Mode=TwoWay}"
                         CenterXFine="{Binding FractalCenterFineX, Mode=TwoWay}"
                         CenterYFine="{Binding FractalCenterFineY, Mode=TwoWay}"
                         ZoomExp="{Binding FractalZoomExp, Mode=TwoWay}"/>
            <StackPanel Orientation="Vertical" Width="300" MarginLeft="16" VerticalAlignment="Center">
                <TextBlock x:Name="FormulaLabel" Text="{Localize BrushesStrings.Formula}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <DropDown AutomationProperties.LabeledBy="{Binding ElementName=FormulaLabel}" ItemsSource="{Binding FractalFormulas}"
                          SelectedItem="{Binding Formula, Mode=TwoWay}"
                          Width="290" Margin="0 10 0 10">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize BrushesStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                </DropDown>
                <CheckBox Content="{Localize BrushesStrings.AutoMorph}"
                          IsChecked="{Binding FractalAnimate, Mode=TwoWay}"
                          MarginBottom="6"/>
                <CheckBox Content="{Localize BrushesStrings.MandelbrotMode}"
                          IsChecked="{Binding FractalMandelbrot, Mode=TwoWay}"
                          MarginBottom="12"/>
                <TextBlock x:Name="PowerLabel" Text="{Localize BrushesStrings.Power}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=PowerLabel}" Value="{Binding FractalPower, Mode=TwoWay}" Minimum="2" Maximum="8" IsMoveToPointEnabled="true" Width="176"/>
                    <NumericUpDown Width="88" Minimum="2" Maximum="8" SmallChange="0.1"
                                   SnapsToSmallChange="true" StringFormat="N2"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalPower, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=PowerLabel}"/>
                </StackPanel>
                <TextBlock x:Name="ZoomLabel" Text="{Localize BrushesStrings.Zoom}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=ZoomLabel}" Value="{Binding FractalZoomExp, Mode=TwoWay}" Minimum="-0.52" Maximum="15" IsMoveToPointEnabled="true" Width="120"/>
                    <NumericUpDown Width="88" Minimum="-0.52" Maximum="15" SmallChange="0.1"
                                   SnapsToSmallChange="true" StringFormat="N2"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalZoomExp, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=ZoomLabel}"/>
                    <TextBlock Text="{Binding ZoomText}" MarginLeft="8" VerticalAlignment="Center" Foreground="{ResourceReference TextFillColorSecondary}"/>
                </StackPanel>
                <TextBlock x:Name="IterationsLabel" Text="{Localize BrushesStrings.Iterations}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=IterationsLabel}" Value="{Binding FractalIterations, Mode=TwoWay}" Minimum="20" Maximum="2000" IsMoveToPointEnabled="true" Width="176"/>
                    <NumericUpDown Width="88" Minimum="20" Maximum="2000" SmallChange="1"
                                   SnapsToSmallChange="true" StringFormat="N0"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalIterations, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=IterationsLabel}"/>
                </StackPanel>
                <TextBlock x:Name="MorphSpeedLabel" Text="{Localize BrushesStrings.MorphSpeed}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=MorphSpeedLabel}" Value="{Binding FractalMorphSpeed, Mode=TwoWay}" Minimum="0" Maximum="4" IsMoveToPointEnabled="true" Width="176"/>
                    <NumericUpDown Width="88" Minimum="0" Maximum="4" SmallChange="0.1"
                                   SnapsToSmallChange="true" StringFormat="N2"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalMorphSpeed, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=MorphSpeedLabel}"/>
                </StackPanel>
                <TextBlock x:Name="JuliaXLabel" Text="{Localize BrushesStrings.JuliaX}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=JuliaXLabel}" Value="{Binding FractalCx, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="176"/>
                    <NumericUpDown Width="88" Minimum="-1" Maximum="1" SmallChange="0.01"
                                   SnapsToSmallChange="true" StringFormat="N3"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalCx, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=JuliaXLabel}"/>
                </StackPanel>
                <TextBlock x:Name="JuliaYLabel" Text="{Localize BrushesStrings.JuliaY}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=JuliaYLabel}" Value="{Binding FractalCy, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="176"/>
                    <NumericUpDown Width="88" Minimum="-1" Maximum="1" SmallChange="0.01"
                                   SnapsToSmallChange="true" StringFormat="N3"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalCy, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=JuliaYLabel}"/>
                </StackPanel>
                <TextBlock x:Name="PanXLabel" Text="{Localize BrushesStrings.PanX}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal" MarginBottom="8">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=PanXLabel}" Value="{Binding FractalFineX, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="176"/>
                    <NumericUpDown Width="88" Minimum="-1" Maximum="1" SmallChange="0.01"
                                   SnapsToSmallChange="true" StringFormat="N3"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalFineX, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=PanXLabel}"/>
                </StackPanel>
                <TextBlock x:Name="PanYLabel" Text="{Localize BrushesStrings.PanY}" Foreground="{ResourceReference TextFillColorSecondary}"/>
                <StackPanel Orientation="Horizontal">
                    <Slider AutomationProperties.LabeledBy="{Binding ElementName=PanYLabel}" Value="{Binding FractalFineY, Mode=TwoWay}" Minimum="-1" Maximum="1" IsMoveToPointEnabled="true" Width="176"/>
                    <NumericUpDown Width="88" Minimum="-1" Maximum="1" SmallChange="0.01"
                                   SnapsToSmallChange="true" StringFormat="N3"
                                   IsDragScrubEnabled="true" TracksMouseWheelWhenOver="true"
                                   Value="{Binding FractalFineY, Mode=TwoWay}" VerticalAlignment="Center" MarginLeft="8" AutomationProperties.LabeledBy="{Binding ElementName=PanYLabel}"/>
                </StackPanel>
            </StackPanel>
            <!-- Colors: right of the controls, in the free zone. Cohesive ColorPickerButton controls - a swatch that
                 reveals the ColorPicker inline (compact when closed), so the editors don't scatter the panel. -->
            <StackPanel Orientation="Vertical" MarginLeft="24" VerticalAlignment="Top">
                <TextBlock Text="{Localize BrushesStrings.FractalColors}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="8"/>
                <TextBlock x:Name="ColorInsideLabel" Text="{Localize BrushesStrings.ColorInside}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <ColorPickerButton AutomationProperties.LabeledBy="{Binding ElementName=ColorInsideLabel}" SelectedColor="{Binding FractalColor1, Mode=TwoWay}" Width="200" Height="30" MarginBottom="12"/>
                <TextBlock x:Name="ColorOutsideLabel" Text="{Localize BrushesStrings.ColorOutside}" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="2"/>
                <ColorPickerButton AutomationProperties.LabeledBy="{Binding ElementName=ColorOutsideLabel}" SelectedColor="{Binding FractalColor2, Mode=TwoWay}" Width="200" Height="30"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Localize BrushesStrings.DragFractal}"
                   Foreground="{ResourceReference TextFillColorSecondary}" Margin="10,6,0,0"/>

        <TextBlock Text="{Localize BrushesStrings.FractalSamples}" FontSize="18" Margin="0,24,0,10"/>
        <WrapPanel Orientation="Horizontal">
            <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                <Rectangle.Fill>
                    <FractalBrush Fractal="Julia" C="-0.8,0.156" Zoom="1.1" Iterations="150" Color1="#0B122B" Color2="#22D3EE"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                <Rectangle.Fill>
                    <FractalBrush Fractal="Julia" C="0.285,0.01" Zoom="1.1" Iterations="150" Color1="#1E1B4B" Color2="#F472B6"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                <Rectangle.Fill>
                    <FractalBrush Fractal="Mandelbrot" Center="-0.5,0" Zoom="0.85" Iterations="200" Color1="#0B1220" Color2="#FDE68A"/>
                </Rectangle.Fill>
            </Rectangle>
            <!-- New formulas (orthogonal to the Julia/Mandelbrot C-mode above): Burning Ship, Multibrot d=5, Newton. -->
            <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                <Rectangle.Fill>
                    <FractalBrush Formula="BurningShip" Fractal="Mandelbrot" Center="-0.4,-0.5" Zoom="0.85" Iterations="200" Color1="#0B1220" Color2="#FB7185"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                <Rectangle.Fill>
                    <FractalBrush Formula="Multibrot" Power="5" Fractal="Mandelbrot" Zoom="0.9" Iterations="180" Color1="#0B1220" Color2="#A78BFA"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="200" Height="160" CornerRadius="12" Margin="10">
                <Rectangle.Fill>
                    <FractalBrush Formula="Newton" Zoom="0.8" Iterations="60" Color1="#22D3EE" Color2="#F472B6"/>
                </Rectangle.Fill>
            </Rectangle>
        </WrapPanel>
    </StackPanel>
</View>
