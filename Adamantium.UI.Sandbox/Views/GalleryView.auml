<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:vm="clr-namespace:Adamantium.UI.Sandbox.ViewModels"
      xmlns:nav="clr-namespace:Adamantium.UI.Controls.Navigation;assembly=Adamantium.UI.Controls"
      xmlns:controls="clr-namespace:Adamantium.UI.Controls;assembly=Adamantium.UI.Controls"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors"
      x:ViewModel="{x:Type vm:GalleryViewModel}"
      x:CreateInDesignTime="True">

    <Grid RowDefinitions="Auto,*" Margin="16">
        <!-- Enum-bound DropDown that moves the tab strip to any edge live (exercises TabControl.TabStripPlacement). -->
        <!-- The members of each enum are said by the page's phrases, a member's name being its key. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{Localize GalleryStrings.TabPlacement}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DropDown EnumType="{x:Type controls:TabStripPlacement}"
                      SelectedItem="{Binding TabPlacement, Mode=TwoWay}"
                      Width="140">
                <DropDown.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Localize GalleryStrings, Key={Binding}}"/>
                    </DataTemplate>
                </DropDown.ItemTemplate>
            </DropDown>
            <TextBlock Text="{Localize GalleryStrings.ContentSlide}" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <DropDown EnumType="{x:Type controls:ContentTransition}"
                      SelectedItem="{Binding SlideMode, Mode=TwoWay}"
                      Width="140">
                <DropDown.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Localize GalleryStrings, Key={Binding}}"/>
                    </DataTemplate>
                </DropDown.ItemTemplate>
            </DropDown>
            <TextBlock Text="{Localize GalleryStrings.Indicator}" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <DropDown EnumType="{x:Type controls:TabIndicatorPlacement}"
                      SelectedItem="{Binding IndicatorPlacement, Mode=TwoWay}"
                      Width="120">
                <DropDown.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Localize GalleryStrings, Key={Binding}}"/>
                    </DataTemplate>
                </DropDown.ItemTemplate>
            </DropDown>
        </StackPanel>

        <!-- Data-driven tabs: the TabControl binds to the root view-model's Tabs collection. Each tab's header comes from
             the ItemTemplate ({Binding Header}); its body is chosen by the framework's ViewLocatorTemplateSelector, which
             maps each tab view-model to its View. No per-tab wiring in markup - add a tab by adding its view-model to
             GalleryViewModel.Tabs. -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    TabStripPlacement="{Binding TabPlacement}"
                    SelectionIndicatorPlacement="{Binding IndicatorPlacement}"
                    ContentTransition="{Binding SlideMode}"
                    DeferContent="True"
                    ShowCloseButton="True">
            <!-- A tab body is thousands of elements; it is built off the loop thread, so the tab itself opens at once
                 and shows this until its content is ready. -->
            <TabControl.LoadingTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <BusyIndicator IsActive="True" Margin="0,0,0,12"/>
                        <TextBlock Text="{Localize GalleryStrings.Loading}" HorizontalTextAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.LoadingTemplate>
            <!-- Drag a tab AWAY from the strip (across it, not along it) and let go: it gets its own window. -->
            <TabControl.Behaviors>
                <behaviors:TabTearOffBehavior/>
            </TabControl.Behaviors>
            <!-- A tab names its page by the key of its title among the gallery's phrases. -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Localize GalleryStrings, Key={Binding Header}}" VerticalTextAlignment="Center"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplateSelector>
                <nav:ViewLocatorTemplateSelector/>
            </TabControl.ContentTemplateSelector>
        </TabControl>
    </Grid>
</View>
