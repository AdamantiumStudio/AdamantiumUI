<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:vm="clr-namespace:Adamantium.UI.Sandbox.ViewModels">
    <!-- DataContext is the ButtonsViewModel, injected by the TabControl's content presenter (no x:ViewModel here). -->
    <StackPanel Orientation="Vertical" Margin="24">

        <!-- Click counter: Button + auto-repeating RepeatButton both invoke AddCommand; Reset zeroes it. The buttons are
             disabled while the ToggleSwitch below is off (Button.IsEnabled bound to the same VM flag). -->
        <TextBlock Text="{Localize ButtonsStrings.Commands}" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="{Localize ButtonsStrings.Add}"
                    Command="{Binding AddCommand}"
                    IsEnabled="{Binding ActionsEnabled}"
                    Width="90" Height="34" Margin="0,0,8,0"/>
            <RepeatButton Content="{Localize ButtonsStrings.HoldToAdd}"
                          Command="{Binding AddCommand}"
                          IsEnabled="{Binding ActionsEnabled}"
                          MinWidth="130" Height="34" Delay="400" Interval="80" Margin="0,0,8,0"/>
            <Button Content="{Localize ButtonsStrings.Reset}" Command="{Binding ResetCommand}" MinWidth="90" Height="34" Margin="0,0,16,0"/>
            <TextBlock Text="{Localize ButtonsStrings.Clicks}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock AutomationProperties.AutomationId="ClickCount" Text="{Binding ClickCount}" VerticalAlignment="Center" FontSize="16"/>
        </StackPanel>

        <!-- Toggle family: each control is two-way bound to a VM flag, and the line beside it says what the flag is -
             one phrase per flag, its case picked by the flag's value. -->
        <TextBlock Text="{Localize ButtonsStrings.Toggles}" FontSize="18" Margin="0,24,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ToggleSwitch Content="{Localize ButtonsStrings.EnableActions}" IsChecked="{Binding ActionsEnabled, Mode=TwoWay}"/>
            <TextBlock Text="{Localize ButtonsStrings.Actions, enabled={Binding ActionsEnabled}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ToggleButton Content="{Localize ButtonsStrings.Notify}" IsChecked="{Binding Notify, Mode=TwoWay}" MinWidth="120" Height="32"/>
            <TextBlock AutomationProperties.AutomationId="NotifyState" Text="{Localize ButtonsStrings.Notifications, on={Binding Notify}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox Content="{Localize ButtonsStrings.AcceptTerms}" IsThreeState="true" IsChecked="{Binding TermsAccepted, Mode=TwoWay}"/>
            <TextBlock Text="{Localize ButtonsStrings.Terms, accepted={Binding TermsAccepted}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Mutually-exclusive radio group -> one selected plan. -->
        <TextBlock Text="{Localize ButtonsStrings.Plan}" FontSize="18" Margin="0,24,0,10"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="{Localize ButtonsStrings.Free}" GroupName="plan" IsChecked="{Binding PlanFree, Mode=TwoWay}" Margin="0,0,16,0"/>
            <RadioButton Content="{Localize ButtonsStrings.Pro}" GroupName="plan" IsChecked="{Binding PlanPro, Mode=TwoWay}" Margin="0,0,16,0"/>
            <TextBlock Text="{Localize ButtonsStrings.Selected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock AutomationProperties.AutomationId="ChosenPlan" Text="{Localize ButtonsStrings.ChosenPlan, pro={Binding PlanPro}}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- DropDown: a string list (via ItemsSource) and an enum (via EnumType - each member said by the page's phrases,
             its name being the key, while the bound value stays the enum). Near the bottom, so opening tests the
             edge-aware flip. -->
        <TextBlock Text="{Localize ButtonsStrings.Dropdowns}" FontSize="18" Margin="0,24,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <DropDown ItemsSource="{Binding Cities}"
                      AutomationProperties.AutomationId="City"
                      AutomationProperties.Name="{Localize ButtonsStrings.CityName}"
                      SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                      Placeholder="{Localize ButtonsStrings.SelectCity}"
                      Width="200"/>
            <TextBlock AutomationProperties.AutomationId="CityChoice" Text="{Localize ButtonsStrings.City, city={Binding SelectedCity}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <DropDown EnumType="{x:Type vm:Priority}"
                      AutomationProperties.AutomationId="Priority"
                      AutomationProperties.Name="{Localize ButtonsStrings.PriorityName}"
                      SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                      Width="220">
                <DropDown.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Localize ButtonsStrings, Key={Binding}}"/>
                    </DataTemplate>
                </DropDown.ItemTemplate>
            </DropDown>
            <TextBlock AutomationProperties.AutomationId="PriorityChoice" Text="{Localize ButtonsStrings.PriorityIs, priority={Binding SelectedPriority}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- ItemTemplate DropDown: each row (and the header) renders a color swatch + name, not plain text. -->
        <StackPanel Orientation="Horizontal">
            <DropDown ItemsSource="{Binding Palette}"
                      AutomationProperties.AutomationId="Color"
                      AutomationProperties.Name="{Localize ButtonsStrings.ColorName}"
                      SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                      Width="200">
                <DropDown.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding Swatch}" Width="16" Height="16"
                                    CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </DropDown.ItemTemplate>
            </DropDown>
            <TextBlock Text="{Localize ButtonsStrings.Color, color={Binding SelectedColor.Name}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
    </StackPanel>
</View>
