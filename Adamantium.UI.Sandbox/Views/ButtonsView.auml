<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:vm="clr-namespace:Adamantium.UI.Sandbox.ViewModels"
      xmlns:conv="clr-namespace:Adamantium.UI.Sandbox.Converters">
    <!-- DataContext is the ButtonsViewModel, injected by the TabControl's content presenter (no x:ViewModel here). -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="24">

            <!-- Click counter: Button + auto-repeating RepeatButton both invoke AddCommand; Reset zeroes it. The buttons are
                 disabled while the ToggleSwitch below is off (Button.IsEnabled bound to the same VM flag). -->
            <TextBlock Text="{Localize ButtonsStrings.Commands}" FontSize="18" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="{Localize ButtonsStrings.Add}"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding ActionsEnabled}"
                        Width="90" Height="34" Margin="0,0,8,0"/>
                <RepeatButton Content="{Localize ButtonsStrings.HoldToAdd}"
                              Command="{Binding AddCommand}"
                              IsEnabled="{Binding ActionsEnabled}"
                              MinWidth="130" Height="34" Delay="400" Interval="80" Margin="0,0,8,0"/>
                <Button Content="{Localize ButtonsStrings.Reset}" Command="{Binding ResetCommand}" MinWidth="90" Height="34" Margin="0,0,16,0"/>
                <TextBlock Text="{Localize ButtonsStrings.Clicks}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock AutomationProperties.AutomationId="ClickCount" Text="{Binding ClickCount}" VerticalAlignment="Center" FontSize="16"/>
            </StackPanel>

            <!-- Toggle family: each control is two-way bound to a VM flag, and the line beside it says what the flag is -
                 one phrase per flag, its case picked by the flag's value. -->
            <TextBlock Text="{Localize ButtonsStrings.Toggles}" FontSize="18" Margin="0,24,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ToggleSwitch Content="{Localize ButtonsStrings.EnableActions}" IsChecked="{Binding ActionsEnabled, Mode=TwoWay}"/>
                <TextBlock Text="{Localize ButtonsStrings.Actions, enabled={Binding ActionsEnabled}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ToggleButton Content="{Localize ButtonsStrings.Notify}" IsChecked="{Binding Notify, Mode=TwoWay}" MinWidth="120" Height="32"/>
                <TextBlock AutomationProperties.AutomationId="NotifyState" Text="{Localize ButtonsStrings.Notifications, on={Binding Notify}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="{Localize ButtonsStrings.AcceptTerms}" IsThreeState="true" IsChecked="{Binding TermsAccepted, Mode=TwoWay}"/>
                <TextBlock Text="{Localize ButtonsStrings.Terms, accepted={Binding TermsAccepted}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- Mutually-exclusive radio group -> one selected plan. -->
            <TextBlock Text="{Localize ButtonsStrings.Plan}" FontSize="18" Margin="0,24,0,10"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{Localize ButtonsStrings.Free}" GroupName="plan" IsChecked="{Binding PlanFree, Mode=TwoWay}" Margin="0,0,16,0"/>
                <RadioButton Content="{Localize ButtonsStrings.Pro}" GroupName="plan" IsChecked="{Binding PlanPro, Mode=TwoWay}" Margin="0,0,16,0"/>
                <TextBlock Text="{Localize ButtonsStrings.Selected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock AutomationProperties.AutomationId="ChosenPlan" Text="{Localize ButtonsStrings.ChosenPlan, pro={Binding PlanPro}}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- SegmentedControl: a few choices of one setting, all in sight. Segments written in markup (chosen by index),
                 and an enum bound via EnumType, each member said by the page's phrases. -->
            <TextBlock Text="{Localize ButtonsStrings.Segmented}" FontSize="18" Margin="0,24,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <SegmentedControl SelectedIndex="{Binding Shading, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="Shading"
                                  AutomationProperties.Name="{Localize ButtonsStrings.ShadingName}">
                    <SegmentedControlItem Content="{Localize ButtonsStrings.Shaded}"/>
                    <SegmentedControlItem Content="{Localize ButtonsStrings.Wireframe}"/>
                    <SegmentedControlItem Content="{Localize ButtonsStrings.ShadedWireframe}"/>
                </SegmentedControl>
                <SegmentedControl IsEnabled="False" SelectedIndex="1" Margin="14,0,0,0">
                    <SegmentedControlItem Content="{Localize ButtonsStrings.Day}"/>
                    <SegmentedControlItem Content="{Localize ButtonsStrings.Week}"/>
                    <SegmentedControlItem Content="{Localize ButtonsStrings.Month}"/>
                </SegmentedControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <SegmentedControl EnumType="{x:Type vm:TextAlign}"
                                  SelectedItem="{Binding Alignment, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="Alignment"
                                  AutomationProperties.Name="{Localize ButtonsStrings.AlignmentName}">
                    <SegmentedControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize ButtonsStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </SegmentedControl.ItemTemplate>
                </SegmentedControl>
                <TextBlock AutomationProperties.AutomationId="AlignmentChoice" Text="{Localize ButtonsStrings.AlignmentIs, align={Binding Alignment}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <!-- Made from view-models by the item template; each segment runs its own model's command, bound through the
                 item container style - the last one's cannot run, so it is disabled. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <SegmentedControl ItemsSource="{Binding Zooms}" SelectedIndex="1"
                                  AutomationProperties.AutomationId="Zoom"
                                  AutomationProperties.Name="{Localize ButtonsStrings.ZoomName}">
                    <SegmentedControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </SegmentedControl.ItemTemplate>
                    <SegmentedControl.ItemContainerStyle>
                        <Style Selector="SegmentedControlItem">
                            <Setter Property="Command" Value="{Binding Apply}"/>
                        </Style>
                    </SegmentedControl.ItemContainerStyle>
                </SegmentedControl>
                <TextBlock AutomationProperties.AutomationId="ZoomChoice" Text="{Localize ButtonsStrings.ZoomIs, zoom={Binding Zoom}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- DropDown: a string list (via ItemsSource) and an enum (via EnumType - each member said by the page's phrases,
                 its name being the key, while the bound value stays the enum). Near the bottom, so opening tests the
                 edge-aware flip. -->
            <TextBlock Text="{Localize ButtonsStrings.Dropdowns}" FontSize="18" Margin="0,24,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <DropDown ItemsSource="{Binding Cities}"
                          AutomationProperties.AutomationId="City"
                          AutomationProperties.Name="{Localize ButtonsStrings.CityName}"
                          SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                          Placeholder="{Localize ButtonsStrings.SelectCity}"
                          Width="200"/>
                <TextBlock AutomationProperties.AutomationId="CityChoice" Text="{Localize ButtonsStrings.City, city={Binding SelectedCity}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <DropDown EnumType="{x:Type vm:Priority}"
                          AutomationProperties.AutomationId="Priority"
                          AutomationProperties.Name="{Localize ButtonsStrings.PriorityName}"
                          SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                          Width="220">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize ButtonsStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                </DropDown>
                <TextBlock AutomationProperties.AutomationId="PriorityChoice" Text="{Localize ButtonsStrings.PriorityIs, priority={Binding SelectedPriority}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- ItemTemplate DropDown: each row (and the header) renders a color swatch + name, not plain text. -->
            <StackPanel Orientation="Horizontal">
                <DropDown ItemsSource="{Binding Palette}"
                          AutomationProperties.AutomationId="Color"
                          AutomationProperties.Name="{Localize ButtonsStrings.ColorName}"
                          SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                          Width="200">
                    <DropDown.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding Swatch}" Width="16" Height="16"
                                        CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <Image AutomationProperties.AutomationId="Unavailable"
                                       Source="{ResourceReference NotSupportedIcon}"
                                       Width="14"
                                       Height="14"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ResourceReference SystemFillColorCaution}"
                                       Visibility="{Binding IsUnavailable, Converter={conv:BoolToVisibilityConverter}}"
                                       ToolTipService.ToolTip="{Localize ButtonsStrings.OutOfStock}"
                                       ToolTipService.ShowOnDisabled="True"/>
                            </StackPanel>
                        </DataTemplate>
                    </DropDown.ItemTemplate>
                    <DropDown.ItemContainerStyle>
                        <Style Selector="DropDownItem">
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                        </Style>
                    </DropDown.ItemContainerStyle>
                </DropDown>
                <TextBlock Text="{Localize ButtonsStrings.Color, color={Binding SelectedColor.Name}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- Drop-down and split buttons: the lists come from the view-model as keys, said by the page's phrases; a pick
                 runs ItemCommand with the key, a split button's body runs its own command. -->
            <TextBlock Text="{Localize ButtonsStrings.ActionButtons}" FontSize="18" Margin="0,24,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <DropDownButton Content="{Localize ButtonsStrings.Export}"
                                AutomationProperties.AutomationId="Export"
                                ItemsSource="{Binding ExportFormats}"
                                ItemCommand="{Binding RunCommand}"
                                Margin="0,0,8,0">
                    <DropDownButton.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize ButtonsStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </DropDownButton.ItemTemplate>
                </DropDownButton>
                <SplitButton Content="{Localize ButtonsStrings.PasteName}"
                             AutomationProperties.AutomationId="Paste"
                             Command="{Binding PasteCommand}"
                             ItemsSource="{Binding PasteKinds}"
                             ItemCommand="{Binding RunCommand}"
                             Margin="0,0,8,0">
                    <SplitButton.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize ButtonsStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </SplitButton.ItemTemplate>
                </SplitButton>
                <ToggleSplitButton Content="{Localize ButtonsStrings.BulletsName}"
                                   AutomationProperties.AutomationId="Bullets"
                                   IsChecked="{Binding Bullets, Mode=TwoWay}"
                                   ItemsSource="{Binding BulletKinds}"
                                   ItemCommand="{Binding ChooseBulletsCommand}">
                    <ToggleSplitButton.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Localize ButtonsStrings, Key={Binding}}"/>
                        </DataTemplate>
                    </ToggleSplitButton.ItemTemplate>
                </ToggleSplitButton>
                <TextBlock AutomationProperties.AutomationId="LastAction"
                           Text="{Localize ButtonsStrings.LastAction, action={Binding LastAction}}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</View>
