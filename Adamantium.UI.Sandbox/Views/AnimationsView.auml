<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:behaviors="clr-namespace:Adamantium.UI.Sandbox.Behaviors">
    <!-- A BENCH, not a showcase: the numbers at the top are the point. Two sections ask the same question from opposite
         sides - many ANIMATIONS against many PAINTERS of one animated brush - so a frame's cost can be attributed to one
         or the other instead of guessed at. Written after 25 orphaned loading pulses took the presented rate from ~900
         to ~200 while the loop never moved: the leak is fixed, the price of an animation is still worth watching. -->
    <ScrollViewer Margin="24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical">
        <TextBlock Text="{Localize AnimationsStrings.Title}" FontSize="20"/>

        <Border Margin="0,16,0,0" Padding="10" Background="#CC202020">
            <TextBlock FontSize="13" Foreground="LightGreen" TextWrapping="WrapBySymbols" Text="collecting...">
                <TextBlock.Behaviors>
                    <behaviors:DiagnosticsOverlayBehavior/>
                </TextBlock.Behaviors>
            </TextBlock>
        </Border>
        <TextBlock x:Name="ManyHeading" Text="{Localize AnimationsStrings.Many}" FontSize="16" Margin="0,28,0,0"/>
        <TextBlock Opacity="0.7" TextWrapping="WrapByWords"
                   Text="{Localize AnimationsStrings.ManyHint}"/>

        <StackPanel AutomationProperties.LabeledBy="{Binding ElementName=ManyHeading}" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="+1" Command="{Binding AddOneCommand}"/>
            <Button Content="+5" Command="{Binding AddFiveCommand}" Margin="8,0,0,0"/>
            <Button Content="+25" Command="{Binding AddTwentyFiveCommand}" Margin="8,0,0,0"/>
            <Button Content="{Localize AnimationsStrings.Clear}" Command="{Binding ClearSpinnersCommand}" Margin="8,0,0,0"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Spinners}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator IsActive="True"
                                   AutomationProperties.AutomationId="RingIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Ring}"
                                   Width="32"
                                   Height="32"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Localize AnimationsStrings.Channels}" FontSize="16" Margin="0,28,0,0"/>
        <TextBlock Opacity="0.7" TextWrapping="WrapByWords"
                   Text="{Localize AnimationsStrings.ChannelsHint}"/>

        <!-- Each kind is named in the words the Loaders page uses for it. -->
        <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{Localize AnimationsStrings.EveryKind}" Command="{Binding AddEveryKindCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Dots}}" Command="{Binding AddDotsCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Ripple}}" Command="{Binding AddRippleCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Arc}}" Command="{Binding AddArcCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Bar}}" Command="{Binding AddBarCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Ants}}" Command="{Binding AddAntsCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Equalizer}}" Command="{Binding AddEqualizerCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Flip}}" Command="{Binding AddFlipCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Heartbeat}}" Command="{Binding AddHeartbeatCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.AddKind, kind={Localize LoadersStrings.Shimmer}}" Command="{Binding AddShimmerCommand}" Margin="0,0,8,8"/>
            <Button Content="{Localize AnimationsStrings.ClearAll}" Command="{Binding ClearKindsCommand}" Margin="0,0,8,8"/>
        </WrapPanel>

        <ItemsControl ItemsSource="{Binding DotsIndicators}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Dots"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="DotsIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Dots}"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding RippleIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Ripple"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="RippleIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Ripple}"
                                   Width="32"
                                   Height="32"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding ArcIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Arc"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="ArcIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Arc}"
                                   Width="32"
                                   Height="32"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding BarIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Bar"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="BarIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Bar}"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding AntsIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Ants"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="AntsIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Ants}"
                                   Width="32"
                                   Height="32"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding EqualizerIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Equalizer"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="EqualizerIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Equalizer}"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding FlipIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Flip"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="FlipIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Flip}"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding HeartbeatIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Heartbeat"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="HeartbeatIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Heartbeat}"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding ShimmerIndicators}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <BusyIndicator Classes="Shimmer"
                                   IsActive="True"
                                   AutomationProperties.AutomationId="ShimmerIndicator"
                                   AutomationProperties.Name="{Localize LoadersStrings.Shimmer}"
                                   Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="PaintersHeading" Text="{Localize AnimationsStrings.Painters}" FontSize="16" Margin="0,28,0,0"/>
        <TextBlock Opacity="0.7" TextWrapping="WrapByWords"
                   Text="{Localize AnimationsStrings.PaintersHint}"/>

        <StackPanel AutomationProperties.LabeledBy="{Binding ElementName=PaintersHeading}" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{Localize AnimationsStrings.TogglePulse}" Command="{Binding ToggleSharedPulseCommand}"/>
            <Button Content="{Localize AnimationsStrings.TenCards}" Command="{Binding AddTenSkeletonsCommand}" Margin="8,0,0,0"/>
            <Button Content="{Localize AnimationsStrings.HundredCards}" Command="{Binding AddHundredSkeletonsCommand}" Margin="8,0,0,0"/>
            <Button Content="{Localize AnimationsStrings.Clear}" Command="{Binding ClearSkeletonsCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Skeletons}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The item IS the shared brush, so this binds to itself and every card paints the same one. -->
                    <Border Width="72" Height="24" Margin="4" CornerRadius="4" Background="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    </ScrollViewer>
</View>
