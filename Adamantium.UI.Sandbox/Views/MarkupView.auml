<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:local="clr-namespace:Adamantium.UI.Sandbox">
    <!-- The AUML vocabulary, demonstrated rather than described. Every section that HAS a wrong answer shows it beside
         the right one - a claim with no control arm proves nothing. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="24">

            <!-- ============ x:Shared="False" ============ -->
            <TextBlock Text="{Localize MarkupStrings.SharedTitle}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Opacity="0.7" MarginBottom="12"
                       Text="{Localize MarkupStrings.SharedHint}"/>

            <!-- ItemContainerStyle, not an inline <X.Styles>: a Styles collection applies the style to THAT element and
                 nothing below it, while a container style is applied to every container the list makes - which is what
                 "one setter, several targets" needs in order to mean anything. -->
            <StackPanel Orientation="Horizontal">

                <!-- The WRONG half, kept on purpose: one ContextMenu handed to both rows. A menu points at ONE placement
                     target, so the two rows fight over it - and the second right-click says so. -->
                <StackPanel Orientation="Vertical" Margin="0,0,32,0">
                    <TextBlock Text="{Localize MarkupStrings.SharedDefault}" MarginBottom="6"/>
                    <ItemsControl ItemsSource="{Binding SharedRows}" Width="220">
                        <ItemsControl.ItemContainerStyle>
                            <Style Selector="ContentPresenter">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="{Localize MarkupStrings.OneMenu}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="34" MarginBottom="6" CornerRadius="4"
                                        Background="{ResourceReference CardBackgroundFillColorDefault}"
                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="1">
                                    <TextBlock Text="{Localize MarkupStrings, Key={Binding}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- The SAME markup plus one directive: each row is handed its own menu. -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="x:Shared=&quot;False&quot;" MarginBottom="6"/>
                    <ItemsControl ItemsSource="{Binding OwnRows}" Width="220">
                        <ItemsControl.ItemContainerStyle>
                            <Style Selector="ContentPresenter">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu x:Shared="False">
                                            <MenuItem Header="{Localize MarkupStrings.OwnMenu}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="34" MarginBottom="6" CornerRadius="4"
                                        Background="{ResourceReference CardBackgroundFillColorDefault}"
                                        BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="1">
                                    <TextBlock Text="{Localize MarkupStrings, Key={Binding}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <TextBlock Opacity="0.7" Margin="0,10,0,0"
                       Text="{Localize MarkupStrings.MenusOnDemand}"/>

            <!-- ============ {x:Static} ============ -->
            <TextBlock Text="{Localize MarkupStrings.StaticTitle}" FontSize="18" Margin="0,32,0,4"/>
            <TextBlock Opacity="0.7" MarginBottom="12"
                       Text="{Localize MarkupStrings.StaticHint}"/>

            <Border Width="{x:Static local:DemoMetrics.SwatchWidth}"
                    Height="{x:Static local:DemoMetrics.SwatchHeight}"
                    CornerRadius="6"
                    Background="{ResourceReference CardBackgroundFillColorDefault}"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                    BorderThickness="1">
                <TextBlock Text="{x:Static local:DemoMetrics.Caption}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- ============ {x:Null} ============ -->
            <TextBlock Text="{Localize MarkupStrings.NullTitle}" FontSize="18" Margin="0,32,0,4"/>
            <TextBlock Opacity="0.7" MarginBottom="12"
                       Text="{Localize MarkupStrings.NullHint}"/>

            <StackPanel Orientation="Horizontal">
                <Border Width="200" Height="56" CornerRadius="6" Margin="0,0,32,0" BorderThickness="2"
                        Background="{ResourceReference CardBackgroundFillColorDefault}">
                    <TextBlock Text="{Localize MarkupStrings.ThemeOutline}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="200" Height="56" CornerRadius="6" BorderThickness="2"
                        BorderBrush="{x:Null}"
                        Background="{ResourceReference CardBackgroundFillColorDefault}">
                    <TextBlock Text="{Localize MarkupStrings.OutlineOff}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- ============ x:DataType ============ -->
            <TextBlock Text="{Localize MarkupStrings.DataTypeTitle}" FontSize="18" Margin="0,32,0,4"/>
            <TextBlock Opacity="0.7" MarginBottom="12"
                       Text="{Localize MarkupStrings.DataTypeHint}"/>

            <!-- A row's title is a phrase key, or a line of markup that is no key and is said as it is. -->
            <ItemsControl ItemsSource="{Binding Rows}" Width="{x:Static local:DemoMetrics.RowWidth}"
                          HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ViewModels.MarkupRow">
                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                BorderThickness="1" CornerRadius="4" Padding="8" MarginBottom="4">
                            <TextBlock Text="{Localize MarkupStrings, Key={Binding Title}}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ x:Load ============ -->
            <TextBlock Text="{Localize MarkupStrings.LoadTitle}" FontSize="18" Margin="0,32,0,4"/>
            <TextBlock Opacity="0.7" MarginBottom="12"
                       Text="{Localize MarkupStrings.LoadHint}"/>

            <CheckBox Content="{Localize MarkupStrings.BuildPanel}"
                      IsChecked="{Binding HeavyShown, Mode=TwoWay}" MarginBottom="6"/>
            <TextBlock Text="{Localize MarkupStrings.TimesBuilt, count={Binding HeavyBuilds}}" MarginBottom="12"/>

            <Border BorderThickness="1" CornerRadius="6" Padding="12" MinHeight="80"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <StackPanel Orientation="Vertical">
                    <local:DemoBuildProbe x:Name="Heavy" x:Load="{Binding HeavyShown}"
                                          CornerRadius="4" Padding="10"
                                          Background="{ResourceReference CardBackgroundFillColorDefault}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Localize MarkupStrings.BuiltOnDemand}" MarginBottom="6"/>
                            <TextBlock Opacity="0.7"
                                       Text="{Localize MarkupStrings.BuiltOnDemandHint}"/>
                            <ItemsControl ItemsSource="{Binding Rows}" MarginTop="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ViewModels.MarkupRow">
                                        <TextBlock Text="{Localize MarkupStrings, Key={Binding Title}}" Opacity="0.7" MarginBottom="2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </local:DemoBuildProbe>
                </StackPanel>
            </Border>

            <!-- The other form: nothing watches a condition, so the element waits to be ASKED for. With no code behind
                 a view, the asker is a behavior - and reading the generated name IS the asking. -->
            <TextBlock Text="{Localize MarkupStrings.AskedTitle}" FontSize="18" Margin="0,32,0,4"/>
            <TextBlock Opacity="0.7" MarginBottom="12"
                       Text="{Localize MarkupStrings.AskedHint}"/>

            <StackPanel Orientation="Horizontal" MarginBottom="6">
                <Button Content="{Localize MarkupStrings.AskForIt}" MarginRight="12">
                    <Button.Behaviors>
                        <local:Behaviors.RevealHeldBackBehavior/>
                    </Button.Behaviors>
                </Button>
                <TextBlock Text="{Localize MarkupStrings.TimesBuilt, count={Binding ManualBuilds}}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border BorderThickness="1" CornerRadius="6" Padding="12" MinHeight="60"
                    BorderBrush="{ResourceReference ControlStrokeColorDefault}">
                <StackPanel Orientation="Vertical">
                    <local:DemoManualProbe x:Name="Manual" x:Load="False"
                                           CornerRadius="4" Padding="10"
                                           Background="{ResourceReference CardBackgroundFillColorDefault}">
                        <TextBlock Text="{Localize MarkupStrings.AskedByName}"/>
                    </local:DemoManualProbe>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</View>
