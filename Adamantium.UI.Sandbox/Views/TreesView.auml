<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- The tree is a REAL drive's file system (TreesViewModel.Nodes). A HierarchicalDataTemplate projects each node - its
         body draws the name (Title), ItemsSource="{Binding Children}" supplies the child nodes, and the SAME template
         recurses down every level. Directories load lazily on expand (the ItemContainerStyle binds each container's
         IsExpanded back to the node). No nodes are authored in markup. -->
    <StackPanel Orientation="Vertical" Margin="24" MaxWidth="900">

        <TextBlock Text="{Localize TreesStrings.Title}"
                   FontSize="20" MarginBottom="4"/>
        <TextBlock Text="{Localize TreesStrings.Hint}"
                   FontSize="13" Foreground="{ResourceReference TextFillColorSecondary}" MarginBottom="14"/>

        <StackPanel Orientation="Horizontal" MarginBottom="12">
            <TextBlock Text="{Localize TreesStrings.Drive}" VerticalAlignment="Center" MarginRight="8"/>
            <DropDown ItemsSource="{Binding Drives}"
                      SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" Width="110" MarginRight="24"/>
            <TextBlock Text="{Localize TreesStrings.SelectionMode}" VerticalAlignment="Center" MarginRight="8"/>
            <DropDown ItemsSource="{Binding SelectionModes}"
                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}" MinWidth="150">
                <DropDown.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Localize TreesStrings, Key={Binding}}"/>
                    </DataTemplate>
                </DropDown.ItemTemplate>
            </DropDown>
            <Button Content="{Localize TreesStrings.Refresh}" Command="{Binding RefreshCommand}" MarginLeft="24"/>
            <Button Content="{Localize TreesStrings.ExpandSelected}" Command="{Binding ExpandSelectedCommand}" MarginLeft="12"/>
        </StackPanel>

        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                BorderThickness="1" CornerRadius="10" Padding="8" Height="420">
            <TreeView ItemsSource="{Binding Nodes}" SelectionMode="{Binding SelectedMode}"
                      SelectedItem="{Binding SelectedNode, Mode=OneWayToSource}"
                      VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}">
                <TreeView.ItemContainerStyle>
                    <!-- Bind each node's expansion + selection back to its view-model: first expand triggers the lazy
                         directory read, and expansion/selection become state ON the node, so they survive a tab switch
                         (the view is recreated, the view-model persists). The scroll position rides along on VerticalOffset. -->
                    <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" VerticalTextAlignment="Center"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

    </StackPanel>
</View>
