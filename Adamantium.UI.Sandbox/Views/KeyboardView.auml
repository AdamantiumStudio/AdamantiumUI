<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions">
    <!-- DataContext is the KeyboardViewModel. Put the mouse down and drive this tab from the keyboard: Tab and
         Shift+Tab step BETWEEN the blocks, the arrows move INSIDE one. The accent ring follows the focus, and shows up
         only for keyboard moves - a click already says where you are. -->
    <ScrollViewer Margin="24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">

            <TextBlock Text="{Localize KeyboardStrings.Title}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="{Localize KeyboardStrings.Intro}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,20"/>

            <!-- 1. An EXPLICIT order. The buttons stand left to right, but Tab visits them by their number - which is the
                    whole point: the order that reads best is often not the order a form is filled in. -->
            <TextBlock Text="{Localize KeyboardStrings.ExplicitOrder}" FontSize="16" Margin="0,0,0,6"/>
            <TextBlock Text="{Localize KeyboardStrings.ExplicitOrderHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="{Localize KeyboardStrings.ThirdA}" Width="110" Height="34" MarginRight="8" KeyboardNavigation.TabIndex="3"/>
                <Button Content="{Localize KeyboardStrings.FirstB}" Width="110" Height="34" MarginRight="8" KeyboardNavigation.TabIndex="1"/>
                <Button Content="{Localize KeyboardStrings.FourthC}" Width="110" Height="34" MarginRight="8" KeyboardNavigation.TabIndex="4"/>
                <Button Content="{Localize KeyboardStrings.SecondD}" Width="110" Height="34" MarginRight="8" KeyboardNavigation.TabIndex="2"/>
                <Button Content="{Localize KeyboardStrings.Skipped}" MinWidth="110" Height="34" KeyboardNavigation.IsTabStop="false"/>
            </StackPanel>

            <!-- 2. A grid: the arrows are a question about the LAYOUT, so the grid answers by row and column. -->
            <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,24,0,0"/>
            <TextBlock Text="{Localize KeyboardStrings.GridTitle}" FontSize="16" Margin="0,20,0,6"/>
            <TextBlock Text="{Localize KeyboardStrings.GridHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <UniformGrid Rows="3" Columns="4" Width="470" HorizontalAlignment="Left"
                         RowSpacing="6" ColumnSpacing="6">
                <Button Content="1"/>
                <Button Content="2"/>
                <Button Content="3"/>
                <Button Content="4"/>
                <Button Content="5"/>
                <Button Content="6"/>
                <Button Content="7"/>
                <Button Content="8"/>
                <Button Content="9"/>
                <Button Content="10"/>
                <Button Content="11"/>
                <Button Content="12"/>
            </UniformGrid>

            <!-- 3. Wrapped lines: along the line, across to the next, and round the end the way reading does. The panel
                    KEEPS the arrows, so one arrow too many cannot cost you your place. -->
            <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,24,0,0"/>
            <TextBlock Text="{Localize KeyboardStrings.WrapTitle}" FontSize="16" Margin="0,20,0,6"/>
            <TextBlock Text="{Localize KeyboardStrings.WrapHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <ListBox Height="150" Width="470" HorizontalAlignment="Left"
                     ItemsSource="{Binding Tiles}"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="110" ItemHeight="34"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- 4. A list: Tab enters it ONCE and leaves it whole; the arrows move the selection, and the view follows. -->
            <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,24,0,0"/>
            <TextBlock Text="{Localize KeyboardStrings.ListTitle}" FontSize="16" Margin="0,20,0,6"/>
            <TextBlock Text="{Localize KeyboardStrings.ListHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <ListBox Width="220" Height="160" ItemsSource="{Binding Rows}"/>
                <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                    <TextBlock Text="{Localize KeyboardStrings.TabLandsHere}" Margin="0,0,0,8"/>
                    <Button Content="{Localize KeyboardStrings.AfterList}" Width="160" Height="34" MarginBottom="8"/>
                    <CheckBox Content="{Localize KeyboardStrings.AndThenHere}"/>
                </StackPanel>
            </StackPanel>

            <!-- 5. The controls whose arrows are their own: the value ones eat them, so the focus stays put. -->
            <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,24,0,0"/>
            <TextBlock Text="{Localize KeyboardStrings.ClaimTitle}" FontSize="16" Margin="0,20,0,6"/>
            <TextBlock Text="{Localize KeyboardStrings.ClaimHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <TextBlock Text="{Localize KeyboardStrings.NumberHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Slider Width="220" Minimum="0" Maximum="100" Value="40" VerticalAlignment="Center"/>
                <NumericUpDown Width="150" Minimum="0" Maximum="100" Value="7" Margin="20,0,0,0"/>
                <TextBox Width="180" Placeholder="{Localize KeyboardStrings.TextTakesThem}" Margin="20,0,0,0"/>
            </StackPanel>

            <!-- 6. Panels with no shape: a Canvas places every child by hand and a DockPanel stacks them against edges,
                    so neither has a row or a column an arrow could walk. Both answer with the order the children were
                    added - the only order they honestly know. -->
            <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,24,0,0"/>
            <TextBlock Text="{Localize KeyboardStrings.ShapelessTitle}" FontSize="16" Margin="0,20,0,6"/>
            <TextBlock Text="{Localize KeyboardStrings.ShapelessHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" MarginBottom="24">
                <Border BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="4"
                        Width="230" Height="130">
                    <!-- Added first, second, third - but placed so that no reading of the layout gives that order. -->
                    <Canvas>
                        <Button Content="{Localize KeyboardStrings.First}" Width="80" Height="30" Canvas.Left="12" Canvas.Top="70"/>
                        <Button Content="{Localize KeyboardStrings.Second}" Width="80" Height="30" Canvas.Left="120" Canvas.Top="16"/>
                        <Button Content="{Localize KeyboardStrings.Third}" Width="80" Height="30" Canvas.Left="30" Canvas.Top="20"/>
                    </Canvas>
                </Border>
                <Border BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="1" CornerRadius="4"
                        Width="230" Height="130" Margin="20,0,0,0">
                    <DockPanel>
                        <Button Content="{Localize KeyboardStrings.Top}" Height="30" DockPanel.Dock="Top"/>
                        <Button Content="{Localize KeyboardStrings.Bottom}" Height="30" DockPanel.Dock="Bottom"/>
                        <Button Content="{Localize KeyboardStrings.Left}" Width="80" DockPanel.Dock="Left"/>
                        <Button Content="{Localize KeyboardStrings.FillsTheRest}"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- 7. An overlay is a place you come BACK from: closing it returns the keyboard to whatever opened it,
                    looking the way it looked. Otherwise the focus is stranded on something no longer on screen and the
                    next Tab starts again from the top of the window. -->
            <Border Height="1" Background="{ResourceReference ControlFillColorTertiary}" Margin="0,24,0,0"/>
            <TextBlock Text="{Localize KeyboardStrings.OverlayTitle}" FontSize="16" Margin="0,20,0,6"/>
            <TextBlock Text="{Localize KeyboardStrings.OverlayHint}"
                       Foreground="{ResourceReference TextFillColorSecondary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" MarginBottom="24">
                <DropDown Width="200" Placeholder="{Localize KeyboardStrings.OpenWithEnter}" ItemsSource="{Binding Tiles}"/>
                <TextBlock Text="{Localize KeyboardStrings.TabLandsAfter}" VerticalAlignment="Center" Margin="20,0,0,0"
                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                <Button Content="{Localize KeyboardStrings.AfterList}" MinWidth="140" Height="34" Margin="20,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</View>
