<ApplicationBlueprint xmlns="http://adamantium/ui"
                      xmlns:x="http://adamantium/ui/xaml/extensions"
                      StartupWindow="MainWindow"
                      SplashWindow="SandboxSplashWindow">
    <ApplicationBlueprint.Resources>
        <ResourceLink Source="ModuleIcons"/>
        <ResourceLink Source="RibbonShellIcons"/>
        <ResourceLink Source="CaptionIcons"/>
    </ApplicationBlueprint.Resources>
    <ApplicationBlueprint.StyleIncludes>
        <StyleInclude Source="RibbonShellStyleSet"/>
    </ApplicationBlueprint.StyleIncludes>
</ApplicationBlueprint>
