		<Platforms>AnyCPU</Platforms>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Product metadata surfaced by the About dialog (read from assembly attributes at runtime). -->
		<Product>Adamantium Engine Sandbox</Product>
		<Version>0.1.0</Version>
		<!-- MEASUREMENT (not yet a decision): a 4K tile grid takes the managed heap from 130MB to 936MB, and the workstation
		     collector then stops every thread for 240-460ms of each second - a quarter to a half of the frame budget, spent
		     where no profiler of ours was looking. Server GC collects per-core and in parallel, which is the shape this
		     workload has. It is a MITIGATION: the real fix is to stop retaining three and a half million objects for sixty
		     thousand components. Keep or drop it on the numbers. -->
		<!-- DROPPED on the numbers, as the note above said to. The retention that made it necessary is much reduced (the
		     record no longer re-records what draws nothing, and the frozen layout is no longer re-published three times a
		     frame), so the workstation collector is what we measure against now. NB on net10.0 the server collector is
		     DATAS-adaptive by default (.NET 9+), so "server" here was never the classic per-core-heap shape anyway. -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

