<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<Platforms>AnyCPU</Platforms>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Product metadata surfaced by the About dialog (read from assembly attributes at runtime). -->
		<Product>Adamantium Engine Sandbox</Product>
		<Version>0.1.0</Version>
		<!-- MEASUREMENT (not yet a decision): a 4K tile grid takes the managed heap from 130MB to 936MB, and the workstation
		     collector then stops every thread for 240-460ms of each second - a quarter to a half of the frame budget, spent
		     where no profiler of ours was looking. Server GC collects per-core and in parallel, which is the shape this
		     workload has. It is a MITIGATION: the real fix is to stop retaining three and a half million objects for sixty
		     thousand components. Keep or drop it on the numbers. -->
		<!-- DROPPED on the numbers, as the note above said to. The retention that made it necessary is much reduced (the
		     record no longer re-records what draws nothing, and the frozen layout is no longer re-published three times a
		     frame), so the workstation collector is what we measure against now. NB on net10.0 the server collector is
		     DATAS-adaptive by default (.NET 9+), so "server" here was never the classic per-core-heap shape anyway. -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.UI\Adamantium.UI.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Automation\Adamantium.UI.Automation.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Themes\Adamantium.UI.Themes.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Sandbox.Modules\Adamantium.UI.Sandbox.Modules.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Sandbox.Content\Adamantium.UI.Sandbox.Content.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="window-icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<None Remove="AumlResources\FluentDarkRepository.xml" />
		<None Remove="Brushes.xml" />
		<None Remove="ControlTemplate.auml" />
		<None Remove="FluentDark.xml" />
		<None Remove="FontData.aff" />
		<Content Update="Effects\structs.hlsl">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<AdditionalFiles Update="ControlTemplate.auml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</AdditionalFiles>
		<AdditionalFiles Remove="obj\**" />
		<None Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
		<ProjectReference Include="..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseEngineSource)' == 'true'">
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Engine\Adamantium.Engine.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Multiverse\Adamantium.Multiverse.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.MVVM\Adamantium.MVVM.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Core\Adamantium.Core.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.MVVM.Generators\Adamantium.MVVM.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.EffectsCompiler\Adamantium.EffectsCompiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Fonts\Adamantium.Fonts.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" SetTargetFramework="TargetFramework=netstandard2.0"/>
		<!-- netstandard2.0 analyzer deps for the source generators above (Roslyn analyzers must be netstandard2.0).
		     Analyzer-ONLY so the netstandard2.0 build isn't copied into this net10.0 output - runtime/compile
		     Core+Mathematics come from the normal net10.0 refs above. -->
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Core\Adamantium.Core.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Mathematics\Adamantium.Mathematics.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Fonts\Adamantium.Fonts.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseEngineSource)' != 'true'">
		<PackageReference Include="Adamantium.Engine" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Multiverse" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.MVVM" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Core" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.EffectsCompiler" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Mathematics" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Fonts" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.MVVM.Generators" Version="$(AdamantiumEngineVersion)" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="$(ProjectDir)**\*.auml" />
		<AdditionalFiles Remove="$(ProjectDir)ControlTemplate.auml" />
		<!-- The pages' words: a language table per page (Localization\*.alang). -->
		<AdditionalFiles Include="$(ProjectDir)**\*.alang" />
		<CompilerVisibleProperty Include="RootNamespace" />
		<CompilerVisibleProperty Include="AdamantiumRequireAutomationId" />
		<CompilerVisibleProperty Include="ProjectDir" />
		<CompilerVisibleProperty Include="MSBuildProjectName" />
		<CompilerVisibleProperty Include="NeutralLanguage" />
		<CompilerVisibleProperty Include="OutputType" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Remove="obj\**" />
	</ItemGroup>

	<!--    <Import Project="$(SolutionDir)Adamantium.targets" />-->
</Project>
