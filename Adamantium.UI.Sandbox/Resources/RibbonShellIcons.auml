<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns="http://adamantium/ui">

    <!-- The commands' icons of the ribbon shell, by key. Each is drawn in a 16-unit box; the empty frame first in every
         icon states that box, so the icons scale alike and none is measured by its own ink. The stroke follows the
         theme's text color. -->

    <DrawingImage x:Key="TerrainIcon">
        <DrawingGroup>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,16,16"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M1,13 L6,6 L9,10 L11,7 L15,13 Z"
                             Stroke="{ObservableResource TextFillColorPrimary}"
                             StrokeThickness="1"/>
        </DrawingGroup>
    </DrawingImage>

    <DrawingImage x:Key="NewTerrainIcon">
        <DrawingGroup>
