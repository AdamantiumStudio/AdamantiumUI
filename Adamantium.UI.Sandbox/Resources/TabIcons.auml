<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns="http://adamantium/ui">

    <!-- The gallery's tab icons, by key: the page's title key and "TabIcon". Monochrome - outlines on half units in
         CurrentColor, the tab's text color, so an icon follows the tab's states; a part filled where it is solid. Each is
         drawn in a 16-unit box, stated by the empty frame first in every icon. -->

    <DrawingImage x:Key="ButtonsTabIcon">
        <DrawingGroup>
            <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
            <GeometryDrawing Geometry="M3.5,4.5 L12.5,4.5 A2,2 0 0 1 14.5,6.5 L14.5,9.5 A2,2 0 0 1 12.5,11.5 L3.5,11.5 A2,2 0 0 1 1.5,9.5 L1.5,6.5 A2,2 0 0 1 3.5,4.5 Z M5,8 L11,8"
                             Stroke="CurrentColor" StrokeThickness="1"/>
        </DrawingGroup>
    </DrawingImage>

