# The Text page: every topic opened in turn in the page's region, the message typed in one box read back in the
# read-only one, the font size set, a line added to the notes and taken out again, and the floating watermark switched.
select id=GalleryTabs/id=Text
wait id=TextView
select id=TextView/name=Editing
wait id=Topic/id=EditingStandView
set id=Message "Hello, automation"
expect id=ReadOnlyMessage value="Hello, automation"
key End --into id=Message
type " again" --into id=Message
expect id=ReadOnlyMessage value="Hello, automation again"
key Ctrl+End Enter --into id=Notes
type "added line" --into id=Notes
key Backspace Backspace Backspace Backspace Backspace Backspace Backspace Backspace Backspace Backspace Backspace --into id=Notes
toggle id=TextView/name="Floating watermark"
toggle id=TextView/name="Floating watermark"
set id=Message "The quick brown fox jumps over the lazy dog"
select id=TextView/name=Faces
wait id=Topic/id=FacesStandView
select id=TextView/name="Color and emoji"
wait id=Topic/id=ColorStandView
select id=TextView/name=OpenType
wait id=Topic/id=OpenTypeStandView
select id=TextView/name="Variable fonts"
wait id=Topic/id=VariableStandView
select id=TextView/name=Scripts
wait id=Topic/id=ScriptsStandView
select id=TextView/name=Paragraph
wait id=Topic/id=ParagraphStandView
select id=GreedyRadio
select id=ParagraphRadio
toggle id=OpticalMarginsToggle
toggle id=OpticalMarginsToggle
set id=ColumnWidthSlider 160
expect id=ColumnWidthSlider value=160
set id=ColumnWidthSlider 220
set id=WordSpacingRange/id=Upper 200
expect id=WordSpacingRange/id=Upper value=200
set id=WordSpacingRange/id=Upper 133
set id=LetterSpacingRange/id=Upper 20
set id=LetterSpacingRange/id=Upper 0
select id=LastLineCenterRadio
select id=SingleWordJustifyRadio
select id=SingleWordStartRadio
select id=LastLineStartRadio
toggle id=KashidasToggle
toggle id=KashidasToggle
select id=TextView/name=Vertical
wait id=Topic/id=VerticalStandView
set id=LineLengthSlider 200
expect id=LineLengthSlider value=200
set id=TiersSlider 2
select id=LineMiddleRadio
select id=LineTopRadio
set id=TiersSlider 1
set id=LineLengthSlider 300
select id=TextView/name=Basics
wait id=Topic/id=BasicsStandView
set id=FontSizeSlider 24
expect id=FontSizeSlider value=24
# Back as the page opens.
set id=FontSizeSlider 22
