# The Trees page: a lazily read file system - a drive opened, a folder chosen, the view model told to open what is
# chosen, its children read, the drive closed again. Folders every Windows has, so it runs on any machine.
select id=GalleryTabs/id=Trees
wait id=Files/type=TreeItem --timeout 20s
expand id=Files/name=C:\
expect id=Files/name=C:\ expanded=Expanded
# The view model opens a node through its row's binding, so the row is brought into view and clicked, as a person
# would; a row with no element yet would open only once it is shown.
scroll id=Files/name=C:\/name=Windows
click id=Files/name=C:\/name=Windows
expect id=Files/name=C:\/name=Windows selected=True
invoke id=TreesView/name="Expand selected (from VM)"
expect id=Files/name=C:\/name=Windows expanded=Expanded
wait id=Files/name=C:\/name=Windows/name=System32 --timeout 10s
collapse id=Files/name=C:\
expect id=Files/name=C:\ expanded=Collapsed
