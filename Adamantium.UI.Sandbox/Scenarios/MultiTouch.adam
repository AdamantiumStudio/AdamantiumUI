# Two to ten fingers at once, inside the application, on the multitouch stand. Each finger on a button of its own
# clicks it, and the stand counts the most that were down together; fingers held still hold, and click nothing. On the
# lists each finger picks the row it taps, and fingers drawn up the lists scroll every one of them alike.
select id=GalleryTabs/id=MultiTouch
wait id=MultiTouchView/id=Tap10 --timeout 20s
invoke id=ResetTouches
touches id=Tap1 id=Tap2 tap
expect id=MostContacts name=2
expect id=Taps1 name=1
expect id=Taps2 name=1
expect id=Taps3 name=0
touches id=Tap1 id=Tap2 id=Tap3 id=Tap4 id=Tap5 tap
expect id=MostContacts name=5
expect id=Taps1 name=2
expect id=Taps5 name=1
expect id=Taps6 name=0
touches id=Tap1 id=Tap2 id=Tap3 id=Tap4 id=Tap5 id=Tap6 id=Tap7 id=Tap8 id=Tap9 id=Tap10 tap
expect id=MostContacts name=10
expect id=Taps1 name=3
expect id=Taps2 name=3
expect id=Taps3 name=2
expect id=Taps4 name=2
expect id=Taps5 name=2
expect id=Taps6 name=1
expect id=Taps7 name=1
expect id=Taps8 name=1
expect id=Taps9 name=1
expect id=Taps10 name=1
# Held still past the holding time, every finger holds: no button clicks on the lift.
touches id=Tap1 id=Tap2 id=Tap3 id=Tap4 id=Tap5 id=Tap6 id=Tap7 id=Tap8 id=Tap9 id=Tap10 hold
expect id=Taps1 name=3
expect id=Taps10 name=1
invoke id=ResetTouches
expect id=MostContacts name=0
expect id=Taps1 name=0
# Each finger picks the row it taps, in its own list.
touches "id=List1/name=1.3" "id=List2/name=2.3" "id=List3/name=3.3" "id=List4/name=4.3" "id=List5/name=5.3" "id=List6/name=6.3" "id=List7/name=7.3" "id=List8/name=8.3" "id=List9/name=9.3" "id=List10/name=10.3" tap
expect id=MostContacts name=10
expect "id=List1/name=1.3" selected=True
expect "id=List4/name=4.3" selected=True
expect "id=List7/name=7.3" selected=True
expect "id=List10/name=10.3" selected=True
# Drawn up together, each scrolls its own list, all alike, and picks nothing more.
touches id=List1 id=List2 id=List3 id=List4 id=List5 id=List6 id=List7 id=List8 id=List9 id=List10 drag 0,-150
expect id=List1 vscroll=22.3
expect id=List5 vscroll=22.3
expect id=List10 vscroll=22.3
expect "id=List10/name=10.3" selected=True
# Back as the page opens.
invoke id=ResetTouches
scroll id=List1 --vertical 0
unselect "id=List1/name=1.3"
scroll id=List2 --vertical 0
unselect "id=List2/name=2.3"
scroll id=List3 --vertical 0
unselect "id=List3/name=3.3"
scroll id=List4 --vertical 0
unselect "id=List4/name=4.3"
scroll id=List5 --vertical 0
unselect "id=List5/name=5.3"
scroll id=List6 --vertical 0
unselect "id=List6/name=6.3"
scroll id=List7 --vertical 0
unselect "id=List7/name=7.3"
scroll id=List8 --vertical 0
unselect "id=List8/name=8.3"
scroll id=List9 --vertical 0
unselect "id=List9/name=9.3"
scroll id=List10 --vertical 0
unselect "id=List10/name=10.3"
expect "id=List10/name=10.3" selected=False
