# The ZoomBox page: each axis slider is bound two-way to the box's own scale, and the box is zoomed as a whole.
select id=GalleryTabs/id=ZoomBox
wait id=ScaleX
set id=ScaleX 2
expect id=Zoom ScaleX=2
set id=ScaleY 0.5
expect id=Zoom ScaleY=0.5
zoom id=Zoom 300
expect id=Zoom zoom=300 ScaleX=3 ScaleY=3
expect id=ScaleX value=3
zoom id=Zoom 100
# Two fingers drawn apart pinch it: about twice, less the few pixels that go to recognizing the pinch. Drawn together,
# back down.
pinch id=Zoom 2
expect id=Zoom zoom=185.8
pinch id=Zoom 0.5
expect id=Zoom zoom=99.1
# Back as the page opens: the box at 1:1 on both axes, scrolled to its start.
zoom id=Zoom 100
scroll id=Zoom --vertical 0 --horizontal 0
set id=ScaleX 1
set id=ScaleY 1
expect id=Zoom ScaleX=1 ScaleY=1 zoom=100
