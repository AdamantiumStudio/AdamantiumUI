# The Layout page: the cell sliders size the virtualized tiles, Ellipses swaps their template, the opacity slider fades
# the whole grid, and paging hands the tiles to the pager.
select id=GalleryTabs/id=Layout
wait id=CellWidth
set id=CellWidth 60
expect id=CellWidth value=60
set id=CellHeight 40
expect id=CellHeight value=40
toggle id=Ellipses
expect id=Ellipses toggle=On
toggle id=Ellipses
set id=GridOpacity 0.5
expect id=TileGrid Opacity=0.5
set id=GridOpacity 1
expect id=TilePager enabled=False
toggle id=PageTiles
expect id=TilePager enabled=True
toggle id=PageTiles
expect id=TilePager enabled=False
# Back as the page opens: the smallest cell.
set id=CellWidth 24
set id=CellHeight 24
# The skeleton stand: held, the list shows loading cards however long it is left; tuned while they pulse; released, the
# tiles load.
select id=SkeletonsStand
wait id=HoldSkeletons
toggle id=HoldSkeletons
wait id=SkeletonGrid IsLoadingItems=True
set id=PulseMax 0.4
set id=SkeletonStagger 150
expect id=SkeletonGrid IsLoadingItems=True
set id=PulseMax 0.15
set id=SkeletonStagger 80
toggle id=HoldSkeletons
wait id=SkeletonGrid IsLoadingItems=False --timeout 30s
select id=TilesStand
wait id=CellWidth
