<Language>
    <Phrase Key="Title" Text="Текст — по одной теме"/>
    <Phrase Key="TopicBasics" Text="Основы"/>
    <Phrase Key="TopicEditing" Text="Редактирование"/>
    <Phrase Key="TopicFaces" Text="Начертания"/>
    <Phrase Key="TopicColor" Text="Цвет и эмодзи"/>
    <Phrase Key="TopicOpenType" Text="OpenType"/>
    <Phrase Key="TopicVariable" Text="Вариативные шрифты"/>
    <Phrase Key="TopicScripts" Text="Письменности"/>
    <Phrase Key="TopicParagraph" Text="Абзац"/>
    <Phrase Key="TopicVertical" Text="Вертикальный"/>
    <Phrase Key="FontSize" Text="Размер шрифта:"/>
    <Phrase Key="Trimmed" Text="Обрезано до одной строки:"/>
    <Phrase Key="FloatingWatermark" Text="Всплывающая подсказка"/>
    <Phrase Key="Editable" Text="Редактируемое (в обе стороны с тем же Message):"/>
    <Phrase Key="Message" Text="Сообщение"/>
    <Phrase Key="FloatingTitle" Text="Всплывающая подсказка (пусто — поставьте фокус или печатайте):"/>
    <Phrase Key="YourName" Text="Ваше имя"/>
    <Phrase Key="ReadOnly" Text="Только чтение:"/>
    <Phrase Key="MultiLine" Text="Многострочное (AcceptsReturn, без переноса → прокрутка по H и V):"/>
    <Phrase Key="BindableRuns" Text="Привязываемые Run:"/>
    <Phrase Key="YouTyped" Text="Вы набрали: "/>
    <Phrase Key="Chars" Count="count" One="  ({count} символ)" Few="  ({count} символа)" Many="  ({count} символов)" Other="  ({count} символа)"/>
    <Phrase Key="StyledRuns" Text="Run с фоном, линиями и размером:"/>
    <Phrase Key="Highlighted" Text="выделено"/>
    <Phrase Key="Underlined" Text="подчёркнуто"/>
    <Phrase Key="Misspelt" Text="ашибка"/>
    <Phrase Key="Struck" Text="зачёркнуто"/>
    <Phrase Key="Large" Text="и крупно"/>
    <Phrase Key="WeightsTitle" Text="Веса и наклоны одного семейства:"/>
    <Phrase Key="VariableTitle" Text="Вариативный шрифт (Bahnschrift): веса между именованными и ширины:"/>
    <Phrase Key="SynthesisTitle" Text="Семейство без полужирного и курсива (Ink Free): как есть, затем FontSynthesis=&quot;Weight, Style&quot;:"/>
    <Phrase Key="FallbackTitle" Text="Подмена шрифтов (последнего символа нет ни в одном шрифте):"/>
    <Phrase Key="EmojiTitle" Text="Эмодзи: текстом или эмодзи по селектору; кейкапы, тоны кожи, сцепленные последовательности, флаги:"/>
    <Phrase Key="BitmapTitle" Text="Цветные глифы-картинки: CBDT (Noto Color Emoji), sbix (образцы Google, слово — картинка):"/>
    <Phrase Key="SvgTitle" Text="SVG-глифы (образцы Google), затем те же рисунки как COLR v1:"/>
    <Phrase Key="PaletteTitle" Text="Палитры одного цветного шрифта (ColorPalette 0, 1 для тёмного фона, 2 для светлого):"/>
    <Phrase Key="TypographyTitle" Text="Типографика (как есть; капитель со старостильными цифрами; дроби):"/>
    <Phrase Key="FeaturesTitle" Text="Свойства OpenType шрифта Source Sans 3, меняющие глифы: тег и значения, имя от самого шрифта, символы с включённым свойством:"/>
    <Phrase Key="AlternatesTitle" Text="Альтернативы символа, каждая нарисована тем свойством и значением, что её дают:"/>
    <Phrase Key="AlternateCharacter" Text="Символ"/>
    <Phrase Key="AxesTitle" Text="Оси Roboto Flex: тег, имя от шрифта (* — скрыта от панелей стилей), диапазон, имена значений:"/>
    <Phrase Key="OpticalSizeTitle" Text="Оптический размер следует за кеглем; затем 64 при opsz=8, при opsz=144 и курсив наклоном:"/>
    <Phrase Key="VariationsTitle" Text="FontVariations поверх веса (у жирных $ ¢ ₴ ₦ шрифт подменяет глифы по осям):"/>
    <Phrase Key="MovingTitle" Text="FontVariations в движении: переход ведёт вес и ширину от одного набора к другому:"/>
    <Phrase Key="Heavy" Text="Жирный и широкий"/>
    <Phrase Key="BidiTitle" Text="Оба направления: иврит и арабский среди латиницы, в абзацах и редакторах:"/>
    <Phrase Key="RightToLeft" Text="Справа налево"/>
    <Phrase Key="NastaliqTitle" Text="Урду насталиком: буквы соединены курсивным присоединением, каждое слово спускается к строке лесенкой:"/>
    <Phrase Key="ChurchSlavonicTitle" Text="Церковнославянский (Ponomar): придыхания, ударения и титла над буквами, буквотитла:"/>
    <Phrase Key="OldCyrillicTitle" Text="Старая кириллица (Monomakh): буквы, которых нет в современной азбуке:"/>
    <Phrase Key="InitialsTitle" Text="Буквицы богослужебных книг (Vertograd) — для первой буквы абзаца:"/>
    <Phrase Key="ParagraphTitle" Text="Один и тот же абзац, разбитый на строки построчно, как в браузере, и целиком, как в TeX и в Paragraph Composer у InDesign:"/>
    <Phrase Key="OpticalMargins" Text="Висячая пунктуация"/>
    <Phrase Key="FramesTitle" Text="Текстовые фреймы: три колонки, выровненные по высоте, когда у блока её нет, и обтекание картинки:"/>
    <Phrase Key="DropCapsTitle" Text="Буквица: первая буква на три строки тем же шрифтом и буквица богослужебных книг (Vertograd) на четыре:"/>
    <Phrase Key="TabsTitle" Text="Табуляция: номера страниц по правому краю за точками-заполнителями, цены по десятичной точке:"/>
    <Phrase Key="LineAtATime" Text="Построчно"/>
    <Phrase Key="WholeParagraph" Text="Весь абзац"/>
    <Phrase Key="HyphenationTitle" Text="Переносы слов по шаблонам их языка (из TeX, алгоритмом Лианга) или по мягким переносам:"/>
    <Phrase Key="HyphensNone" Text="Без переносов"/>
    <Phrase Key="HyphensManual" Text="Только мягкие переносы"/>
    <Phrase Key="HyphensAuto" Text="Автоматически"/>
    <Phrase Key="ColumnWidth" Text="Ширина колонки"/>
    <Phrase Key="Justify" Text="По ширине"/>
    <Phrase Key="SoftHyphens" Text="Мягкие переносы (U+00AD)"/>
    <Phrase Key="HyphenationEditor" Text="Редактор"/>
    <Phrase Key="WordSpacing" Text="Межсловные, мин. и макс. %"/>
    <Phrase Key="LetterSpacing" Text="Межбуквенные, мин. и макс. %"/>
    <Phrase Key="Tracking" Text="Трекинг"/>
    <Phrase Key="GlyphScaling" Text="Масштаб глифов, мин. и макс. %"/>
    <Phrase Key="LastLine" Text="Последняя строка:"/>
    <Phrase Key="SingleWord" Text="Одно слово:"/>
    <Phrase Key="AlignStart" Text="В начале"/>
    <Phrase Key="AlignCenter" Text="По центру"/>
    <Phrase Key="AlignEnd" Text="В конце"/>
    <Phrase Key="LineLength" Text="Длина строки"/>
    <Phrase Key="Tiers" Text="Ярусы"/>
    <Phrase Key="LineTop" Text="Сверху"/>
    <Phrase Key="LineMiddle" Text="По центру"/>
    <Phrase Key="LineBottom" Text="Снизу"/>
    <Phrase Key="VerticalTitle" Text="Японский текст вертикально: строки идут сверху вниз и встают справа налево, каны стоят прямо в вертикальных формах, латиница и год лежат на боку, короткие числа стоят прямо поперёк строки:"/>
</Language>
