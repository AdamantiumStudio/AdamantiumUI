<Language>
    <Phrase Key="Title" Text="Date and time"/>
    <Phrase Key="Intro" Text="Calendar, as WPF's: the days of a month, the months of a year and the years of a decade - the header goes up a level, the arrows back and on; the page slides up and down from month to month and zooms from level to level. Days are selected one, a run or several runs at a time, with Ctrl, Shift and a drag; the keyboard moves through them. The names of months and days, the first day of the week and the week numbers follow the calendar's language. Given a size, the cells share it."/>
    <Phrase Key="WeekNumbers" Text="Week numbers"/>
    <Phrase Key="Plain" Text="At the size its content asks for:"/>
    <Phrase Key="Selected" Text="Selected: "/>
    <Phrase Key="Range" Text="From today for three months, holidays struck through:"/>
    <Phrase Key="Several" Text="Months side by side, counted by the chosen calendar - holidays marked with a dot, weekends in red by a style of the page's own:"/>
    <Phrase Key="Counting" Text="Calendar:"/>
    <Phrase Key="ByLanguage" Text="The language's"/>
    <Phrase Key="Gregorian" Text="Gregorian"/>
    <Phrase Key="Hijri" Text="Hijri (Umm al-Qura)"/>
    <Phrase Key="Persian" Text="Persian"/>
    <Phrase Key="Hebrew" Text="Hebrew"/>
    <Phrase Key="Japanese" Text="Japanese eras"/>
    <Phrase Key="Months" Text="Months:"/>
    <Phrase Key="Large" Text="Given 640 by 520, its cells share the room - no Viewbox around it:"/>
    <Phrase Key="Fields" Text="A date and time field is entered part by part, in the language's order and form: digits fill a part and move on, the up and down arrows step a part round, left, right and Tab move between parts, Backspace empties one. The value comes once every part is entered. The date is bound to the calendar below:"/>
    <Phrase Key="ShortDate" Text="Date"/>
    <Phrase Key="LongDate" Text="Long date"/>
    <Phrase Key="ShortTime" Text="Time"/>
    <Phrase Key="DateAndTime" Text="Date and time"/>
    <Phrase Key="Custom" Text="A pattern of its own, &quot;dddd, d MMMM yyyy&quot;"/>
    <Phrase Key="CountedField" Text="By the chosen calendar"/>
    <Phrase Key="FieldValue" Text="Value: "/>
    <Phrase Key="Pickers" Text="The same fields with a button at the end: it opens a calendar, a list of times, or both (Alt+Down and F4 too). A click on a day or a time picks it, Esc closes."/>
    <Phrase Key="DatePicker" Text="Date picker"/>
    <Phrase Key="TimePicker" Text="Time picker"/>
    <Phrase Key="DateTimePicker" Text="Date and time picker"/>
    <Phrase Key="TimeColumns" Text="Time in columns, 5 minutes apart"/>
    <Phrase Key="TimeDial" Text="Time on a clock face"/>
    <Phrase Key="Clocks" Text="Clocks - one control, ClockStyle choosing the look: hands over four kinds of face, or figures - text, seven-segment, flip cards. The compositor turns the hands; the application's loop is not woken each second. Below, the world's time and a clock showing the bound meeting time."/>
    <Phrase Key="MinimalSweep" Text="Minimal, sweeping seconds"/>
    <Phrase Key="DotsNoSeconds" Text="Dots, no seconds"/>
    <Phrase Key="Tokyo" Text="Tokyo"/>
    <Phrase Key="NewYork" Text="New York"/>
    <Phrase Key="Meeting" Text="Meeting time"/>
    <Phrase Key="Timers" Text="A countdown and a stopwatch on the same clock: its styles, their buttons, and on a face what is left of the countdown filled. The stopwatch takes laps."/>
    <Phrase Key="TimerDone" Text="Countdowns finished: "/>
</Language>
