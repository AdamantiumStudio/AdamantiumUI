<Language>
    <Phrase Key="Commands" Text="Команды"/>
    <Phrase Key="Add" Text="Добавить"/>
    <Phrase Key="HoldToAdd" Text="Держите, чтобы добавлять"/>
    <Phrase Key="Reset" Text="Сбросить"/>
    <Phrase Key="Clicks" Text="Нажатий:"/>

    <Phrase Key="Toggles" Text="Переключатели"/>
    <Phrase Key="EnableActions" Text="Разрешить действия"/>
    <Phrase Key="Actions" Select="enabled" True="Действия разрешены" False="Действия запрещены"/>
    <Phrase Key="Notify" Text="Уведомлять"/>
    <Phrase Key="Notifications" Select="on" True="Уведомления включены" False="Уведомления выключены"/>
    <Phrase Key="AcceptTerms" Text="Принять условия"/>
    <Phrase Key="Terms" Select="accepted" True="приняты" False="отклонены" Other="не решено"/>

    <Phrase Key="Plan" Text="Тариф"/>
    <Phrase Key="Free" Text="Бесплатный"/>
    <Phrase Key="Pro" Text="Pro"/>
    <Phrase Key="Selected" Text="Выбран:"/>
    <Phrase Key="ChosenPlan" Select="pro" True="Pro" False="Бесплатный"/>

    <Phrase Key="Segmented" Text="Сегменты"/>
    <Phrase Key="ShadingName" Text="Отображение"/>
    <Phrase Key="Shaded" Text="Заливка"/>
    <Phrase Key="Wireframe" Text="Каркас"/>
    <Phrase Key="ShadedWireframe" Text="Заливка + каркас"/>
    <Phrase Key="AlignmentName" Text="Выравнивание"/>
    <Phrase Key="AlignmentIs" Select="align" Left="Выравнено слева" Center="По центру" Right="Выравнено справа" Justify="По ширине"/>
    <Phrase Key="Left" Text="Слева"/>
    <Phrase Key="Center" Text="По центру"/>
    <Phrase Key="Right" Text="Справа"/>
    <Phrase Key="Justify" Text="По ширине"/>
    <Phrase Key="ZoomName" Text="Масштаб"/>
    <Phrase Key="ZoomIs" Text="Масштаб: {zoom}%"/>
    <Phrase Key="Day" Text="День"/>
    <Phrase Key="Week" Text="Неделя"/>
    <Phrase Key="Month" Text="Месяц"/>

    <Phrase Key="Dropdowns" Text="Выпадающие списки"/>
    <Phrase Key="SelectCity" Text="Выберите город..."/>
    <Phrase Key="CityName" Text="Город"/>
    <Phrase Key="PriorityName" Text="Приоритет"/>
    <Phrase Key="ColorName" Text="Цвет"/>
    <Phrase Key="OutOfStock" Text="Нет в наличии"/>
    <Phrase Key="City" Select="city" None="Город не выбран" Other="Город: {city}"/>
    <Phrase Key="Low" Text="Низкий приоритет"/>
    <Phrase Key="Normal" Text="Обычный приоритет"/>
    <Phrase Key="High" Text="Высокий приоритет"/>
    <Phrase Key="Critical" Text="Критичный — бросить всё"/>
    <Phrase Key="PriorityIs" Select="priority" Low="Приоритет: низкий" Normal="Приоритет: обычный" High="Приоритет: высокий" Critical="Приоритет: критичный"/>
    <Phrase Key="Color" Select="color" None="Цвет не выбран" Other="Цвет: {color}"/>

    <Phrase Key="ActionButtons" Text="Кнопки с выпадающим списком"/>
    <Phrase Key="Export" Text="Экспорт"/>
    <Phrase Key="PasteName" Text="Вставить"/>
    <Phrase Key="BulletsName" Text="Маркеры"/>
    <Phrase Key="Pdf" Text="В PDF"/>
    <Phrase Key="Png" Text="В PNG"/>
    <Phrase Key="Svg" Text="В SVG"/>
    <Phrase Key="PasteKeep" Text="Сохранить оформление"/>
    <Phrase Key="PasteText" Text="Только текст"/>
    <Phrase Key="BulletDisc" Text="Кружки"/>
    <Phrase Key="BulletNumber" Text="Номера"/>
    <Phrase Key="LastAction" Select="action" None="Пока ничего" Pdf="Выгружено в PDF" Png="Выгружено в PNG"
            Svg="Выгружено в SVG" Paste="Вставлено" PasteKeep="Вставлено с оформлением" PasteText="Вставлено как текст"
            BulletDiscOn="Включены маркеры-кружки" BulletNumberOn="Включён нумерованный список"
            BulletsOff="Маркеры выключены"/>
</Language>
