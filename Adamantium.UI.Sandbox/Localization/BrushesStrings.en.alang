    <Phrase Key="Flat" Text="Flat"/>
    <Phrase Key="Quarter" Text="Quarter"/>
    <Phrase Key="End" Text="End"/>
    <Phrase Key="Burl" Text="Burl"/>
    <Phrase Key="LivingNoise" Text="Living noise"/>
    <Phrase Key="Checkerboard" Text="Checkerboard"/>
    <Phrase Key="Gradient" Text="Gradient"/>
    <Phrase Key="Picture" Text="Picture"/>
    <Phrase Key="Stripes" Text="Stripes"/>
    <Phrase Key="Dots" Text="Dots"/>
    <Phrase Key="Grid" Text="Grid"/>
    <Phrase Key="Hexagon" Text="Hexagon"/>
    <Phrase Key="Hatch" Text="Hatch"/>
    <Phrase Key="Weave" Text="Weave"/>
    <Phrase Key="Simplex" Text="Simplex"/>
    <Phrase Key="Perlin" Text="Perlin"/>
    <Phrase Key="Value" Text="Value"/>
    <Phrase Key="Worley" Text="Worley"/>
    <Phrase Key="Ridged" Text="Ridged"/>
    <Phrase Key="Turbulence" Text="Turbulence"/>
    <Phrase Key="VoronoiBorders" Text="Voronoi borders"/>
    <Phrase Key="CombustibleVoronoi" Text="Combustible Voronoi"/>
    <Phrase Key="Circuit" Text="Circuit"/>
    <Phrase Key="Quadratic" Text="Quadratic"/>
    <Phrase Key="BurningShip" Text="Burning ship"/>
    <Phrase Key="Tricorn" Text="Tricorn"/>
    <Phrase Key="Celtic" Text="Celtic"/>
    <Phrase Key="Multibrot" Text="Multibrot"/>
    <Phrase Key="Newton" Text="Newton"/>
