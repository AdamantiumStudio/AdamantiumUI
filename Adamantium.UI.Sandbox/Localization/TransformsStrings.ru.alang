<Language>
    <Phrase Key="Title" Text="240 скруглённых прямоугольников с обводкой — у каждого СВОЙ поворот и сдвиг, и всё одним инстансным вызовом."/>
    <Phrase Key="Hint" Text="Поворот и сдвиг аффинны: их нельзя запечь в выровненные по осям границы, поэтому до таблицы трансформаций эти плитки целиком выпадали из пакета."/>
    <Phrase Key="Rotation" Text="Поворот (°)"/>
    <Phrase Key="SkewX" Text="Сдвиг X (°)"/>
    <Phrase Key="SkewY" Text="Сдвиг Y (°)"/>
    <Phrase Key="Scale" Text="Масштаб"/>
    <Phrase Key="Spread" Text="Разброс — разница между плитками (0 = одна общая матрица)"/>
</Language>
