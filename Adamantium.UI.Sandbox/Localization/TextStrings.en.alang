    <Phrase Key="UpperCaseHint" Text="Type a code"/>
    <Phrase Key="TextTransformTitle" Text="Text transform, bound (the message shown in the case chosen; it keeps its own):"/>
    <Phrase Key="SpellingTitle" Text="Spelling, tabs and lines (right-click a word with a wavy line; 3 to 6 lines tall):"/>
    <Phrase Key="ShownAsIs" Text="As is"/>
    <Phrase Key="ShownUppercase" Text="UPPERCASE"/>
    <Phrase Key="ShownLowercase" Text="lowercase"/>
    <Phrase Key="PasswordTitle" Text="Password box (the eye shows it while held):"/>
    <Phrase Key="Password" Text="Password"/>
    <Phrase Key="PasswordToggleTitle" Text="The same password, bound to the same property; here the eye is a switch:"/>
    <Phrase Key="PasswordBound" Count="count" One="In the view model: {count} character" Other="In the view model: {count} characters"/>
    <Phrase Key="ReadOnly" Text="Read-only:"/>
    <Phrase Key="MultiLine" Text="Multi-line (AcceptsReturn, no wrap → H + V scroll):"/>
    <Phrase Key="BindableRuns" Text="Bindable runs:"/>
    <Phrase Key="YouTyped" Text="You typed:"/>
    <Phrase Key="Chars" Count="count" One="({count} char)" Other="({count} chars)"/>
    <Phrase Key="StyledRuns" Text="Runs with backgrounds, lines and sizes:"/>
    <Phrase Key="Highlighted" Text="highlighted"/>
    <Phrase Key="Underlined" Text="underlined"/>
    <Phrase Key="Misspelt" Text="mispelled"/>
    <Phrase Key="Struck" Text="struck out"/>
    <Phrase Key="Large" Text="and large"/>
    <Phrase Key="WeightsTitle" Text="Weights and slants of one family:"/>
    <Phrase Key="VariableTitle" Text="A variable font (Bahnschrift): weights between the named ones, and widths:"/>
    <Phrase Key="SynthesisTitle" Text="A family with no bold or italic (Ink Free): as it is, then FontSynthesis=&quot;Weight, Style&quot;:"/>
    <Phrase Key="FallbackTitle" Text="Fallback fonts (the last character is in no font):"/>
    <Phrase Key="EmojiTitle" Text="Emoji: text or emoji by variation selector; keycaps, skin tones, joined sequences, flags:"/>
    <Phrase Key="BitmapTitle" Text="Color glyphs from images: CBDT (Noto Color Emoji), sbix (Google's samples, a word to an image):"/>
    <Phrase Key="SvgTitle" Text="SVG glyphs (Google's samples), then the same drawings as COLR v1:"/>
    <Phrase Key="PaletteTitle" Text="Color palettes of one font (ColorPalette 0, 1 for dark backgrounds, 2 for light):"/>
    <Phrase Key="TypographyTitle" Text="Typography (as is; small capitals with oldstyle figures; fractions):"/>
    <Phrase Key="KerningTitle" Text="Kerning:"/>
    <Phrase Key="KerningMetrics" Text="The font's pairs"/>
    <Phrase Key="KerningOptical" Text="Optical"/>
    <Phrase Key="KerningNone" Text="None"/>
    <Phrase Key="BaselineGridTitle" Text="A baseline grid:"/>
    <Phrase Key="RubyTitle" Text="Ruby (furigana over the base, a longer reading spreading it, an annotation under the line):"/>
    <Phrase Key="StylesTitle" Text="Paragraph and character styles:"/>
    <Phrase Key="FeaturesTitle" Text="OpenType features of Source Sans 3 that change glyphs: tag and values, the font's own name, characters it changes with it on:"/>
    <Phrase Key="AlternatesTitle" Text="Alternates of a character, each drawn with the feature and value that ask for it:"/>
    <Phrase Key="AlternateCharacter" Text="Character"/>
    <Phrase Key="AxesTitle" Text="Axes of Roboto Flex: tag, the font's name (* hidden from style panels), range, names of values:"/>
    <Phrase Key="OpticalSizeTitle" Text="Optical size follows the text's size; then 64 at opsz=8, at opsz=144, and italic by slant:"/>
    <Phrase Key="VariationsTitle" Text="FontVariations over the weight (heavy $ ¢ ₴ ₦ swap their glyphs, as the font varies its features):"/>
    <Phrase Key="MovingTitle" Text="FontVariations in motion: a transition takes weight and width from one setting to the other:"/>
    <Phrase Key="Heavy" Text="Heavy and wide"/>
    <Phrase Key="BidiTitle" Text="Both directions: Hebrew and Arabic among Latin, in paragraphs and editors:"/>
    <Phrase Key="RightToLeft" Text="Right to left"/>
    <Phrase Key="NastaliqTitle" Text="Urdu in Nastaliq: letters joined by cursive attachment, each word stepping down to the baseline:"/>
    <Phrase Key="ChurchSlavonicTitle" Text="Church Slavonic (Ponomar): breathings, accents and titla stacked over the letters, letter-titla:"/>
    <Phrase Key="OldCyrillicTitle" Text="Old Cyrillic (Monomakh): the letters the modern alphabet dropped:"/>
    <Phrase Key="InitialsTitle" Text="Initials of the liturgical books (Vertograd), for drop caps:"/>
    <Phrase Key="ParagraphTitle" Text="The same paragraph broken a line at a time, as browsers do, and as a whole, as TeX and InDesign's Paragraph Composer do:"/>
    <Phrase Key="OpticalMargins" Text="Optical margins"/>
    <Phrase Key="FramesTitle" Text="Text frames: three columns, balanced when the block has no height, and text flowing around a picture:"/>
    <Phrase Key="DropCapsTitle" Text="Drop caps: the first letter across three lines in the text's own face, and an initial of the liturgical books (Vertograd) across four:"/>
    <Phrase Key="TabsTitle" Text="Tab stops: page numbers right-aligned behind dot leaders, prices lined up on the decimal point:"/>
    <Phrase Key="LineAtATime" Text="Line at a time"/>
    <Phrase Key="WholeParagraph" Text="Whole paragraph"/>
    <Phrase Key="HyphenationTitle" Text="Words broken across lines by the hyphenation patterns of their language (TeX's, by Liang's algorithm), or at soft hyphens:"/>
    <Phrase Key="HyphensNone" Text="None"/>
    <Phrase Key="HyphensManual" Text="Soft hyphens only"/>
    <Phrase Key="HyphensAuto" Text="Automatic"/>
    <Phrase Key="ColumnWidth" Text="Column width"/>
    <Phrase Key="Justify" Text="Justify"/>
    <Phrase Key="SoftHyphens" Text="Soft hyphens (U+00AD)"/>
    <Phrase Key="HyphenationEditor" Text="Editor"/>
    <Phrase Key="WordSpacing" Text="Word spacing, min and max %"/>
    <Phrase Key="LetterSpacing" Text="Letter spacing, min and max %"/>
    <Phrase Key="Tracking" Text="Tracking"/>
    <Phrase Key="GlyphScaling" Text="Glyph scaling, min and max %"/>
    <Phrase Key="LastLine" Text="Last line:"/>
    <Phrase Key="JustificationTitle" Text="Justification: each setting over the text it changes:"/>
    <Phrase Key="SpansTitle" Text="Spans: Bold, Italic and Underline nest, a span's color and size go to its runs, a run's own win, LineBreak ends the line:"/>
    <Phrase Key="SpansPlain" Text="Plain, then"/>
    <Phrase Key="SpansBold" Text="bold,"/>
    <Phrase Key="SpansBoldItalic" Text="bold italic"/>
    <Phrase Key="SpansColored" Text="A blue span with"/>
    <Phrase Key="SpansUnderlined" Text="an underlined part"/>
    <Phrase Key="SpansOwnColor" Text="and a red run of its own"/>
    <Phrase Key="ParagraphsTitle" Text="Paragraphs: each on lines of its own, with its own alignment, margins, first-line indent and line height; the room between two is the larger of theirs:"/>
    <Phrase Key="ParagraphsHeading" Text="The Frog King"/>
    <Phrase Key="ParagraphsBody" Text="In olden times, when wishing still helped, there lived a king whose daughters were all beautiful, but the youngest was so beautiful that the sun itself, which has seen so much, was astonished whenever it shone in her face."/>
    <Phrase Key="ParagraphsQuote" Text="“Be quiet, and do not weep,” answered the frog, “I can help you, but what will you give me if I bring your plaything up again?”"/>
    <Phrase Key="ParagraphsLoose" Text="Text outside a paragraph stands as a paragraph of its own, as the block sets it."/>
    <Phrase Key="LinksTitle" Text="Links: one opens its address in the browser, one runs a command; Tab walks them, Enter activates:"/>
    <Phrase Key="LinksBefore" Text="Read about"/>
    <Phrase Key="LinksSite" Text="Adamantium on GitHub"/>
    <Phrase Key="LinksMiddle" Text="or count a click:"/>
    <Phrase Key="LinksCount" Text="click me"/>
    <Phrase Key="InlineControlsTitle" Text="Controls in a line: they stand on the baseline, a tall one raises its line, and they wrap as words do:"/>
    <Phrase Key="InlineControlsAgree" Text="Tick"/>
    <Phrase Key="InlineControlsPress" Text="to agree, then press"/>
    <Phrase Key="InlineControlsSwatch" Text="- or look at this swatch"/>
    <Phrase Key="InlineControlsEnd" Text=", which is taller than the text and raises its line."/>
    <Phrase Key="InlineControlsButton" Text="OK"/>
    <Phrase Key="LineBreakTitle" Text="LineBreak ends the line, not the paragraph: after it the Latin line stays in the Hebrew paragraph and starts on the right; after a newline it is a paragraph of its own:"/>
    <Phrase Key="WithLineBreak" Text="With LineBreak"/>
    <Phrase Key="WithNewline" Text="With a newline"/>
    <Phrase Key="BaselineShiftTitle" Text="Baseline shift: runs raised and lowered off the baseline, the line's height unchanged:"/>
    <Phrase Key="RunShift" Text="Shift of the marked run:"/>
    <Phrase Key="RunShiftBefore" Text="The line holds"/>
    <Phrase Key="RunShiftRun" Text="a shifted run"/>
    <Phrase Key="RunShiftAfter" Text="in its middle."/>
    <Phrase Key="DecorationFlagsTitle" Text="Lines by name: under, through and over the text, and the wavy line of a spelling error:"/>
    <Phrase Key="DecorationLinesTitle" Text="Decoration lines, each with its own brush, thickness, dashes and offset:"/>
    <Phrase Key="TextEffectsTitle" Text="Text effects: characters turned, raised, scaled and recolored where they stand, about each one's center or the element's corner; the line, the caret and selection stay as they were laid out:"/>
    <Phrase Key="TextEffectsWaveTitle" Text="Animated: each letter an effect of its own, its transform or brush animated by name, one after another:"/>
    <Phrase Key="EffectWave" Text="Wave"/>
    <Phrase Key="EffectShake" Text="Shake"/>
    <Phrase Key="EffectArrive" Text="Arrive in turn"/>
    <Phrase Key="EffectTypewriter" Text="Typewriter"/>
    <Phrase Key="EffectDrunk" Text="Wobble"/>
    <Phrase Key="EffectSpin" Text="Spinning letter"/>
    <Phrase Key="EffectPendulum" Text="Pendulum"/>
    <Phrase Key="EffectFlip" Text="Flip board"/>
    <Phrase Key="BaselineAlignmentTitle" Text="Baseline alignment: superscript and subscript where the font sets them; small runs at the top, middle and bottom of the line, and at the text's top and bottom:"/>
    <Phrase Key="LinesTitle" Text="Lines: the distance between baselines, the space between lines and the most lines shown (0 for all); a larger run grows its line:"/>
    <Phrase Key="LinesHeight" Text="Line height:"/>
    <Phrase Key="LinesSpacing" Text="Spacing:"/>
    <Phrase Key="LinesMost" Text="Most lines:"/>
    <Phrase Key="LinesBefore" Text="Text set with a line height of its own keeps an even rhythm down the page, while"/>
    <Phrase Key="LinesLarge" Text="a larger run"/>
    <Phrase Key="LinesAfter" Text="makes room for itself. Spacing opens the lines up, and a block that may show only a few lines ends the last of them in an ellipsis when there is more to read than it holds."/>
    <Phrase Key="Kashidas" Text="Kashidas"/>
    <Phrase Key="SingleWord" Text="Single word:"/>
    <Phrase Key="AlignStart" Text="Start"/>
    <Phrase Key="AlignCenter" Text="Center"/>
    <Phrase Key="AlignEnd" Text="End"/>
    <Phrase Key="LineLength" Text="Line length"/>
    <Phrase Key="Tiers" Text="Tiers"/>
    <Phrase Key="LineTop" Text="Top"/>
    <Phrase Key="LineMiddle" Text="Middle"/>
    <Phrase Key="LineBottom" Text="Bottom"/>
    <Phrase Key="VerticalTitle" Text="Japanese set vertically: lines run down and stack from the right, kana stand upright in their vertical forms, Latin and the year lie turned, and short numbers stand upright across the line:"/>
    <Phrase Key="VerticalEditTitle" Text="The same in a field to edit: the caret lies across its line, Down goes along it and Left to the next line, and the field wraps at its height:"/>
    <Phrase Key="FinishingCurvesTitle" Text="Curves at a large size (Poppins, cubic curves): the outline follows the curve, not the facets of its chords:"/>
    <Phrase Key="FinishingLineBoundsTitle" Text="TextLineBounds, as in WinUI: each label is centered in its box by its layout, and the fill shows the label's own box - whole lines, trimmed to the top of the capitals, and from the capitals to the baseline. With Tight the capitals stand in the middle:"/>
    <Phrase Key="FinishingTrimTitle" Text="Two and a half lines high. With an ellipsis only lines that fit whole are set; untrimmed, the third line is cut by the edge, as CSS clips it:"/>
    <Phrase Key="FinishingHyphensTitle" Text="Automatic hyphenation without a limit and with HyphenLimit = 1 - no more than one line in a row ending in a hyphen:"/>
    <Phrase Key="FinishingTabsTitle" Text="Tabs in right-aligned and centered lines: the name stays at the margin, the text after the tab is aligned, and the leader reaches it:"/>
    <Phrase Key="FinishingVerticalTitle" Text="Vertical text in a wide block: VerticalTextAlignment Top, Center and Bottom place the lines across it - at the right edge, in the middle, at the left:"/>
    <Phrase Key="FinishingDatesTitle" Text="A number keeps the ideograph or kana after it - 2026年, 10月, 3つ do not part:"/>
    <Phrase Key="FinishingColumnsTitle" Text="Underlined text in two columns: in the second column the line stands under the letters, as in the first:"/>
    <Phrase Key="FinishingPlaceholderTitle" Text="The placeholder of a box with tracking 300 is set as its text is:"/>
    <Phrase Key="FinishingPlaceholder" Text="Search the document"/>
    <Phrase Key="FinishingOversetTitle" Text="IsOverset is bound to the label on the right - move the number of lines:"/>
    <Phrase Key="TopicTypesetting" Text="New in typesetting"/>
    <Phrase Key="NewPunctuationTitle" Text="CJK punctuation, as CSS sets it: TextSpacingTrim gives up the blank halves of fullwidth brackets side by side and at the ends of lines, HangingPunctuation hangs a comma or full stop past the edge, and a justified line widens between its letters:"/>
    <Phrase Key="SpacingTrimLabel" Text="TextSpacingTrim:"/>
    <Phrase Key="HangingLabel" Text="HangingPunctuation:"/>
    <Phrase Key="NewHyphenTitle" Text="Hyphenated words set again in their halves: a break inside the ffi ligature (of-fice), and Arabic letters taking their final and initial forms at a soft hyphen:"/>
    <Phrase Key="NewTallLineTitle" Text="Columns: the line of larger text takes the room of its own height, so it does not run into the next row:"/>
    <Phrase Key="NewVerticalTitle" Text="Vertical text: a field to edit and select down its lines, and a button standing upright among a block's lines:"/>
    <Phrase Key="NewVerticalButton" Text="OK"/>
    <Phrase Key="NewThreadedTitle" Text="One text through three frames - the block, an overflow beside it and one under both (TextBlock.OverflowContentTarget, TextBlockOverflow):"/>
    <Phrase Key="NewSvgTitle" Text="Color glyphs of 'SVG', our own font: a style sheet, classes and the CSS cascade, clips in the box's units:"/>
    <Phrase Key="NewSvgLegend" Text="A - colors by classes, the third by its id over its class. B - a fill attribute (red), the sheet over it (purple), !important over the style attribute (gold). C - stripes clipped round in their box (clipPathUnits=objectBoundingBox). D - clipped by its ancestor's clip-path, the left half. E - fill: bogus is dropped, the brown of its group is kept. F - clipped by a use of a moved rectangle."/>
    <Phrase Key="NewAtlasTitle" Text="The color atlas lets go of images no text draws. Each tile below is a color image of our own 'sbix' font, 600 of them, twenty a row - as emoji are. The video card keeps such images in the color atlas, in layers of 1024 by 1024 pixels, 32 of these tiles to a layer. The budget is how many layers the atlas may take before it lets go of images not on the screen. Try it: set the budget to 4, scroll the list to its end and back - the atlas stays at the layers the tiles on the screen need, and the rows scrolled back to come back as they were."/>
    <Phrase Key="ColorBudgetLabel" Text="Budget:"/>
    <Phrase Key="ColorLayersUnit" Text=" layers ≈ "/>
    <Phrase Key="ColorImagesUnit" Text=" images ≈ "/>
    <Phrase Key="ColorMegabytesUnit" Text=" MB"/>
    <Phrase Key="ColorHeldLabel" Text="In the atlas now: "/>
    <Phrase Key="ColorImagesIn" Text=" images in "/>
    <Phrase Key="ColorAllLabel" Text="All 600 at once, as the atlas kept them before it let images go: "/>
    <Phrase Key="ColorAtlasNote" Text="Layers once taken stay taken: the video card does not take a layer of a texture back. Lowering the budget stops the atlas growing - it does not give memory back until the application is started again."/>
</Language>
