    <Phrase Key="WeightsTitle" Text="Weights and slants of one family:"/>
    <Phrase Key="VariableTitle" Text="A variable font (Bahnschrift): weights between the named ones, and widths:"/>
    <Phrase Key="SynthesisTitle" Text="A family with no bold or italic (Ink Free): as it is, then FontSynthesis=&quot;Weight, Style&quot;:"/>
    <Phrase Key="FallbackTitle" Text="Fallback fonts (the last character is in no font):"/>
    <Phrase Key="EmojiTitle" Text="Emoji: text or emoji by variation selector; keycaps, skin tones, joined sequences, flags:"/>
    <Phrase Key="BitmapTitle" Text="Color glyphs from images: CBDT (Noto Color Emoji), sbix (Google's samples, a word to an image):"/>
    <Phrase Key="SvgTitle" Text="SVG glyphs (Google's samples), then the same drawings as COLR v1:"/>
    <Phrase Key="PaletteTitle" Text="Color palettes of one font (ColorPalette 0, 1 for dark backgrounds, 2 for light):"/>
    <Phrase Key="TypographyTitle" Text="Typography (as is; small capitals with oldstyle figures; fractions):"/>
    <Phrase Key="FeaturesTitle" Text="OpenType features of Source Sans 3 that change glyphs: tag and values, the font's own name, characters it changes with it on:"/>
    <Phrase Key="AlternatesTitle" Text="Alternates of a character, each drawn with the feature and value that ask for it:"/>
    <Phrase Key="AlternateCharacter" Text="Character"/>
    <Phrase Key="AxesTitle" Text="Axes of Roboto Flex: tag, the font's name (* hidden from style panels), range, names of values:"/>
    <Phrase Key="OpticalSizeTitle" Text="Optical size follows the text's size; then 64 at opsz=8, at opsz=144, and italic by slant:"/>
    <Phrase Key="VariationsTitle" Text="FontVariations over the weight (heavy $ ¢ ₴ ₦ swap their glyphs, as the font varies its features):"/>
    <Phrase Key="MovingTitle" Text="FontVariations in motion: a transition takes weight and width from one setting to the other:"/>
    <Phrase Key="Heavy" Text="Heavy and wide"/>
    <Phrase Key="BidiTitle" Text="Both directions: Hebrew and Arabic among Latin, in paragraphs and editors:"/>
    <Phrase Key="RightToLeft" Text="Right to left"/>
    <Phrase Key="NastaliqTitle" Text="Urdu in Nastaliq: letters joined by cursive attachment, each word stepping down to the baseline:"/>
    <Phrase Key="ChurchSlavonicTitle" Text="Church Slavonic (Ponomar): breathings, accents and titla stacked over the letters, letter-titla:"/>
    <Phrase Key="OldCyrillicTitle" Text="Old Cyrillic (Monomakh): the letters the modern alphabet dropped:"/>
    <Phrase Key="InitialsTitle" Text="Initials of the liturgical books (Vertograd), for drop caps:"/>
    <Phrase Key="ParagraphTitle" Text="The same paragraph broken a line at a time, as browsers do, and as a whole, as TeX and InDesign's Paragraph Composer do:"/>
    <Phrase Key="OpticalMargins" Text="Optical margins"/>
    <Phrase Key="FramesTitle" Text="Text frames: three columns, balanced when the block has no height, and text flowing around a picture:"/>
    <Phrase Key="DropCapsTitle" Text="Drop caps: the first letter across three lines in the text's own face, and an initial of the liturgical books (Vertograd) across four:"/>
    <Phrase Key="TabsTitle" Text="Tab stops: page numbers right-aligned behind dot leaders, prices lined up on the decimal point:"/>
    <Phrase Key="LineAtATime" Text="Line at a time"/>
    <Phrase Key="WholeParagraph" Text="Whole paragraph"/>
    <Phrase Key="HyphenationTitle" Text="Words broken across lines by the hyphenation patterns of their language (TeX's, by Liang's algorithm), or at soft hyphens:"/>
    <Phrase Key="HyphensNone" Text="None"/>
    <Phrase Key="HyphensManual" Text="Soft hyphens only"/>
    <Phrase Key="HyphensAuto" Text="Automatic"/>
    <Phrase Key="ColumnWidth" Text="Column width"/>
    <Phrase Key="Justify" Text="Justify"/>
    <Phrase Key="SoftHyphens" Text="Soft hyphens (U+00AD)"/>
    <Phrase Key="HyphenationEditor" Text="Editor"/>
    <Phrase Key="WordSpacing" Text="Word spacing, min and max %"/>
    <Phrase Key="LetterSpacing" Text="Letter spacing, min and max %"/>
    <Phrase Key="Tracking" Text="Tracking"/>
    <Phrase Key="GlyphScaling" Text="Glyph scaling, min and max %"/>
    <Phrase Key="LastLine" Text="Last line:"/>
    <Phrase Key="JustificationTitle" Text="Justification: each setting over the text it changes:"/>
    <Phrase Key="SpansTitle" Text="Spans: Bold, Italic and Underline nest, a span's color and size go to its runs, a run's own win, LineBreak ends the line:"/>
    <Phrase Key="SpansPlain" Text="Plain, then "/>
    <Phrase Key="SpansBold" Text="bold, "/>
    <Phrase Key="SpansBoldItalic" Text="bold italic"/>
    <Phrase Key="SpansColored" Text="A blue span with "/>
    <Phrase Key="SpansUnderlined" Text="an underlined part"/>
    <Phrase Key="SpansOwnColor" Text=" and a red run of its own"/>
    <Phrase Key="LinksTitle" Text="Links: one opens its address in the browser, one runs a command; Tab walks them, Enter activates:"/>
    <Phrase Key="LinksBefore" Text="Read about "/>
    <Phrase Key="LinksSite" Text="Adamantium on GitHub"/>
    <Phrase Key="LinksMiddle" Text=", or count a click: "/>
    <Phrase Key="LinksCount" Text="click me"/>
    <Phrase Key="InlineControlsTitle" Text="Controls in a line: they stand on the baseline, a tall one raises its line, and they wrap as words do:"/>
    <Phrase Key="InlineControlsAgree" Text="Tick "/>
    <Phrase Key="InlineControlsPress" Text=" to agree, then press "/>
    <Phrase Key="InlineControlsSwatch" Text=" - or look at this swatch "/>
    <Phrase Key="InlineControlsEnd" Text=", which is taller than the text and raises its line."/>
    <Phrase Key="InlineControlsButton" Text="OK"/>
    <Phrase Key="LineBreakTitle" Text="LineBreak ends the line, not the paragraph: after it the Latin line stays in the Hebrew paragraph and starts on the right; after a newline it is a paragraph of its own:"/>
    <Phrase Key="WithLineBreak" Text="With LineBreak"/>
    <Phrase Key="WithNewline" Text="With a newline"/>
    <Phrase Key="BaselineShiftTitle" Text="Baseline shift: runs raised and lowered off the baseline, the line's height unchanged:"/>
    <Phrase Key="RunShift" Text="Shift of the marked run:"/>
    <Phrase Key="RunShiftBefore" Text="The line holds "/>
    <Phrase Key="RunShiftRun" Text="a shifted run"/>
    <Phrase Key="RunShiftAfter" Text=" in its middle."/>
    <Phrase Key="DecorationLinesTitle" Text="Decoration lines: an overline, and lines each with their own brush, thickness, dashes and offset:"/>
    <Phrase Key="BaselineAlignmentTitle" Text="Baseline alignment: superscript and subscript where the font sets them; small runs at the top, middle and bottom of the line, and at the text's top and bottom:"/>
    <Phrase Key="LinesTitle" Text="Lines: the distance between baselines, the space between lines and the most lines shown (0 for all); a larger run grows its line:"/>
    <Phrase Key="LinesHeight" Text="Line height:"/>
    <Phrase Key="LinesSpacing" Text="Spacing:"/>
    <Phrase Key="LinesMost" Text="Most lines:"/>
    <Phrase Key="LinesBefore" Text="Text set with a line height of its own keeps an even rhythm down the page, while "/>
    <Phrase Key="LinesLarge" Text="a larger run"/>
    <Phrase Key="LinesAfter" Text=" makes room for itself. Spacing opens the lines up, and a block that may show only a few lines ends the last of them in an ellipsis when there is more to read than it holds."/>
    <Phrase Key="Kashidas" Text="Kashidas"/>
    <Phrase Key="SingleWord" Text="Single word:"/>
    <Phrase Key="AlignStart" Text="Start"/>
    <Phrase Key="AlignCenter" Text="Center"/>
    <Phrase Key="AlignEnd" Text="End"/>
    <Phrase Key="LineLength" Text="Line length"/>
    <Phrase Key="Tiers" Text="Tiers"/>
    <Phrase Key="LineTop" Text="Top"/>
    <Phrase Key="LineMiddle" Text="Middle"/>
    <Phrase Key="LineBottom" Text="Bottom"/>
    <Phrase Key="VerticalTitle" Text="Japanese set vertically: lines run down and stack from the right, kana stand upright in their vertical forms, Latin and the year lie turned, and short numbers stand upright across the line:"/>
</Language>
