    <Phrase Key="Ellipse" Text="Эллипс"/>
    <Phrase Key="Polygon" Text="Многоугольник"/>
    <Phrase Key="Star" Text="Звезда"/>
    <Phrase Key="Acrylic" Text="Акрил"/>
    <Phrase Key="Mica" Text="Слюда"/>
    <Phrase Key="LiquidGlass" Text="Жидкое стекло"/>
    <Phrase Key="Velvet" Text="Бархат"/>
    <Phrase Key="Metal" Text="Металл"/>
    <Phrase Key="Wood" Text="Дерево"/>
    <Phrase Key="Desktop" Text="Рабочий стол"/>
    <Phrase Key="Window" Text="Окно"/>
    <Phrase Key="Element" Text="Элемент"/>
    <Phrase Key="Flat" Text="Тангенциальный"/>
    <Phrase Key="Quarter" Text="Радиальный"/>
    <Phrase Key="End" Text="Торцевой"/>
    <Phrase Key="Burl" Text="Кап"/>
    <Phrase Key="LivingNoise" Text="Живой шум"/>
    <Phrase Key="Checkerboard" Text="Шахматка"/>
    <Phrase Key="Gradient" Text="Градиент"/>
    <Phrase Key="Picture" Text="Картинка"/>
    <Phrase Key="Stripes" Text="Полосы"/>
