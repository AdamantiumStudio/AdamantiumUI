    <Phrase Key="VoronoiBorders" Text="Границы Вороного"/>
    <Phrase Key="CombustibleVoronoi" Text="Горящий Вороной"/>
    <Phrase Key="Circuit" Text="Схема"/>
    <Phrase Key="Quadratic" Text="Квадратичная"/>
    <Phrase Key="BurningShip" Text="Горящий корабль"/>
    <Phrase Key="Tricorn" Text="Трикорн"/>
