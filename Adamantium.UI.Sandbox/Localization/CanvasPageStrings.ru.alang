<Language>
    <Phrase Key="Intro" Text="Плоскость без краёв: колесо увеличивает к курсору, средняя кнопка или пробел сдвигают вид, а Home — или двойной щелчок средней кнопкой — возвращает к началу координат. Что делает обычная левая кнопка, решает ИНСТРУМЕНТ — выбор, перо или фигура. Выделенное получает рамку с ручками в экранных пикселях; перетаскивание ручек двигает и меняет размер всего выделения сразу. Delete удаляет его, Escape отпускает."/>
    <Phrase Key="OtherScreen" Text="Чужой экран"/>
    <Phrase Key="OtherScreenHint" Text="Обычная страница контролов. Включите «Доску», и холст сверху станет стеклом: эта страница остаётся живой под ним, пока перо рисует поверх."/>
    <Phrase Key="AButton" Text="Кнопка"/>
    <Phrase Key="ACheckbox" Text="Флажок"/>

    <Phrase Key="ClearTitle" Text="Очистить холст"/>
    <Phrase Key="ClearQuestion" Count="count" One="Удалить {count} объект?" Few="Удалить все {count} объекта?" Many="Удалить все {count} объектов?" Other="Удалить все {count} объекта?"/>
    <Phrase Key="RemoveSocketTitle" Text="Удалить сокет"/>
    <Phrase Key="RemoveSocketQuestion" Text="Удалить «{socket}» из {node}?"/>
    <Phrase Key="SaveGraph" Text="Сохранить граф"/>
    <Phrase Key="OpenGraph" Text="Открыть граф"/>
    <Phrase Key="GraphFiles" Text="Граф"/>
</Language>
