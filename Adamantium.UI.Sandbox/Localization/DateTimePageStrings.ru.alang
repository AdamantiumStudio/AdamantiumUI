<Language>
    <Phrase Key="Title" Text="Дата и время"/>
    <Phrase Key="Intro" Text="Календарь, как в WPF: дни месяца, месяцы года и годы десятилетия — заголовок поднимает на уровень, стрелки листают назад и вперёд; страница уезжает вверх и вниз от месяца к месяцу и приближается от уровня к уровню. Дни выбираются по одному, отрезком или несколькими отрезками — с Ctrl, Shift и протяжкой; клавиатура ходит по ним. Названия месяцев и дней, первый день недели и номера недель — по языку календаря. С заданным размером ячейки делят его поровну."/>
    <Phrase Key="WeekNumbers" Text="Номера недель"/>
    <Phrase Key="Plain" Text="По размеру содержимого:"/>
    <Phrase Key="Selected" Text="Выбрано: "/>
    <Phrase Key="Range" Text="С сегодня на три месяца, праздники зачёркнуты:"/>
    <Phrase Key="Several" Text="Месяцы рядом, счёт по выбранному календарю — праздники отмечены точкой, выходные красным собственным стилем страницы:"/>
    <Phrase Key="Counting" Text="Календарь:"/>
    <Phrase Key="ByLanguage" Text="По языку"/>
    <Phrase Key="Gregorian" Text="Григорианский"/>
    <Phrase Key="Hijri" Text="Хиджра (Умм аль-Кура)"/>
    <Phrase Key="Persian" Text="Персидский"/>
    <Phrase Key="Hebrew" Text="Еврейский"/>
    <Phrase Key="Japanese" Text="Японские эры"/>
    <Phrase Key="Months" Text="Месяцев:"/>
    <Phrase Key="Large" Text="С размером 640 на 520 ячейки делят место — без Viewbox:"/>
</Language>
