    <Phrase Key="ExpandSelected" Text="Expand selected (from VM)"/>
    <Phrase Key="Single" Text="Single"/>
    <Phrase Key="Multiple" Text="Multiple"/>
    <Phrase Key="Extended" Text="Extended"/>
