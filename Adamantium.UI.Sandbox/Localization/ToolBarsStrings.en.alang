<Language>
    <Phrase Key="Hint" Text="Drag a bar by its grip to another place of its row, to another row, below the last row for a new one, or into the tray below. Right-click a tray to show or hide its bars or to lock them. Narrow the upper tray: its last commands go to their bar's menu."/>
    <Phrase Key="Width" Text="Width of the upper tray"/>
    <Phrase Key="Lower" Text="Another tray"/>
    <Phrase Key="Edit" Text="Edit"/>
    <Phrase Key="Text" Text="Text"/>
    <Phrase Key="Paragraph" Text="Paragraph"/>
    <Phrase Key="View" Text="View"/>
    <Phrase Key="Extra" Text="Extra"/>
    <Phrase Key="Cut" Text="Cut"/>
    <Phrase Key="Copy" Text="Copy"/>
    <Phrase Key="Paste" Text="Paste"/>
    <Phrase Key="Bold" Text="Bold"/>
    <Phrase Key="Italic" Text="Italic"/>
    <Phrase Key="Underline" Text="Underline"/>
    <Phrase Key="Left" Text="Left"/>
    <Phrase Key="Center" Text="Center"/>
    <Phrase Key="Right" Text="Right"/>
    <Phrase Key="ZoomIn" Text="Zoom in"/>
    <Phrase Key="ZoomOut" Text="Zoom out"/>
    <Phrase Key="Help" Text="Help"/>
    <Phrase Key="Sections" Text="Sections and a contextual bar"/>
    <Phrase Key="SectionsHint" Text="Narrow it: the bar's last sections go to its menu whole - or, set to wrap, onto a new line of the bar. Stand in a table: its bar shows, and the tray's menu lists it apart. This tray keeps its bars: none goes to another tray, and none comes from one."/>
    <Phrase Key="SectionsWidth" Text="Width of the tray of sections"/>
    <Phrase Key="InTable" Text="In a table"/>
    <Phrase Key="SectionsWrapping" Text="Sections that do not fit"/>
    <Phrase Key="Format" Text="Format"/>
    <Phrase Key="Clipboard" Text="Clipboard"/>
    <Phrase Key="Font" Text="Font"/>
    <Phrase Key="Align" Text="Alignment"/>
    <Phrase Key="Table" Text="Table"/>
    <Phrase Key="TableTools" Text="Table Tools"/>
    <Phrase Key="Tables" Text="Tables"/>
    <Phrase Key="InsertTable" Text="Insert table"/>
    <Phrase Key="InsertRow" Text="Insert row"/>
    <Phrase Key="DeleteRow" Text="Delete row"/>
    <Phrase Key="Side" Text="A bar down the side"/>
    <Phrase Key="SideHint" Text="Down the side the bar is a column as wide as a command. A number stands in its narrow form, its label as its tooltip; the author field and the font list are too wide, so each is folded into a button that opens it beside the column. Turn the tray along: everything stands as before."/>
    <Phrase Key="SideOrientation" Text="The tray runs"/>
    <Phrase Key="Picture" Text="Picture Format"/>
    <Phrase Key="PictureTools" Text="Picture Tools"/>
    <Phrase Key="PictureSize" Text="Size"/>
    <Phrase Key="Crop" Text="Crop"/>
    <Phrase Key="PictureWidth" Text="Width"/>
    <Phrase Key="PictureHeight" Text="Height"/>
    <Phrase Key="Author" Text="Author"/>
    <Phrase Key="Arrange" Text="Arrange"/>
    <Phrase Key="Wrap" Text="Wrap text"/>
    <Phrase Key="Rotate" Text="Rotate"/>
    <Phrase Key="CaptionFont" Text="Caption font"/>
    <Phrase Key="InLine" Text="In line with text"/>
    <Phrase Key="Square" Text="Square"/>
    <Phrase Key="InFront" Text="In front of text"/>
    <Phrase Key="RotateRight" Text="Rotate right"/>
    <Phrase Key="RotateLeft" Text="Rotate left"/>
    <Phrase Key="Nothing" Text="nothing yet"/>
    <Phrase Key="Report" Text="Pressed: {command}"/>
</Language>
