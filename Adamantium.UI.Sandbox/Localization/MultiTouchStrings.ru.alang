<Language>
    <Phrase Key="Hint" Text="Поставьте до десяти пальцев сразу: кнопка каждой колонки считает свои касания, а каждый список крутится под своим пальцем. Каждое касание обведено кругом — тем больше, чем сильнее нажим."/>
    <Phrase Key="Now" Text="Касаний сейчас: {count}"/>
    <Phrase Key="Most" Text="Больше всего сразу:"/>
    <Phrase Key="Reset" Text="Сбросить"/>
    <Phrase Key="Tap" Text="Тап {number}"/>
</Language>
