<Language>
    <Phrase Key="Playground" Text="Площадка растяжения"/>
    <Phrase Key="StretchLabel" Text="Растяжение:"/>
    <Phrase Key="DirectionLabel" Text="Направление:"/>
    <Phrase Key="HorizontalLabel" Text="По горизонтали:"/>
    <Phrase Key="VerticalLabel" Text="По вертикали:"/>
    <Phrase Key="BoxWidth" Text="Ширина рамки:"/>
    <Phrase Key="BoxHeight" Text="Высота рамки:"/>
    <Phrase Key="ElementSize" Text="Размер элемента:"/>

    <Phrase Key="PictureColors" Text="Цвета картинки"/>
    <Phrase Key="Brightness" Text="Яркость"/>
    <Phrase Key="Contrast" Text="Контраст"/>
    <Phrase Key="Saturation" Text="Насыщенность"/>

    <Phrase Key="Formats" Text="Форматы и анимация"/>
    <Phrase Key="OpacityLabel" Text="Непрозрачность:"/>
    <Phrase Key="MipLevel" Text="PNG (мип-уровень 2)"/>

    <Phrase Key="Jpeg2000" Text="JPEG 2000: разрешения и слои качества"/>
    <Phrase Key="Jpeg2000Hint" Text="В одном файле лежат все разрешения и все уровни качества: каждый шаг разрешения уменьшает картинку вдвое, каждый шаг качества отбрасывает последний слой. Читается и декодируется только нужная часть — сколько именно, видно по цифрам. Картинка рисуется в той же рамке, поэтому меньшая часть выглядит грубее."/>
    <Phrase Key="Resolution" Text="Шаг разрешения:"/>
    <Phrase Key="Quality" Text="Шаг качества:"/>
    <Phrase Key="Jpeg2000Size" Text="Декодировано: {width} × {height} пикс."/>
    <Phrase Key="Jpeg2000Layers" Text="Слоёв качества: {shown} из {count}"/>
    <Phrase Key="Jpeg2000Bytes" Text="Прочитано данных: {used} из {total} КБ"/>
    <Phrase Key="Jpeg2000Time" Text="Декодирование: {ms} мс"/>

    <Phrase Key="AnimationControl" Text="Управление анимацией"/>
    <Phrase Key="AnimationHint" Text="Каждый источник играет по своим правилам: диапазон кадров, который он повторяет, задержка между кадрами, идёт ли он вообще и четыре радиуса углов. Число кадров сообщает САМА картинка, когда её файл раскодирован, — оно и ограничивает ползунки диапазона."/>
    <Phrase Key="PlayPause" Select="playing" True="Пауза" False="Играть"/>
    <Phrase Key="FrameCount" Text="кадров:"/>
    <Phrase Key="Delay" Text="Задержка (мс):"/>
    <Phrase Key="Frames" Text="Кадры:"/>
    <Phrase Key="TopLeft" Text="Слева сверху:"/>
    <Phrase Key="BottomLeft" Text="Слева снизу:"/>
    <Phrase Key="TopRight" Text="Справа сверху:"/>
    <Phrase Key="BottomRight" Text="Справа снизу:"/>

    <Phrase Key="None" Text="Нет"/>
    <Phrase Key="Fill" Text="Заполнить"/>
    <Phrase Key="Uniform" Text="Пропорционально"/>
    <Phrase Key="UniformToFill" Text="Пропорционально с заполнением"/>
    <Phrase Key="Both" Text="В обе стороны"/>
    <Phrase Key="DownOnly" Text="Только уменьшать"/>
    <Phrase Key="UpOnly" Text="Только увеличивать"/>
