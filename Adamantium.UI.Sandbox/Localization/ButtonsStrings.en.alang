<Language>
    <Phrase Key="Commands" Text="Commands"/>
    <Phrase Key="Add" Text="Add"/>
    <Phrase Key="HoldToAdd" Text="Hold to add"/>
    <Phrase Key="Reset" Text="Reset"/>
    <Phrase Key="Clicks" Text="Clicks:"/>

    <Phrase Key="Toggles" Text="Toggles"/>
    <Phrase Key="EnableActions" Text="Enable actions"/>
    <Phrase Key="Actions" Select="enabled" True="Actions enabled" False="Actions disabled"/>
    <Phrase Key="Notify" Text="Notify"/>
    <Phrase Key="Notifications" Select="on" True="Notifications ON" False="Notifications OFF"/>
    <Phrase Key="AcceptTerms" Text="Accept terms"/>
    <Phrase Key="Terms" Select="accepted" True="accepted" False="declined" Other="undecided"/>

    <Phrase Key="Plan" Text="Plan"/>
    <Phrase Key="Free" Text="Free"/>
    <Phrase Key="Pro" Text="Pro"/>
    <Phrase Key="Selected" Text="Selected:"/>
    <Phrase Key="ChosenPlan" Select="pro" True="Pro" False="Free"/>

    <Phrase Key="Dropdowns" Text="Dropdowns"/>
    <Phrase Key="SelectCity" Text="Select a city..."/>
    <Phrase Key="CityName" Text="City"/>
    <Phrase Key="PriorityName" Text="Priority"/>
    <Phrase Key="ColorName" Text="Color"/>
    <Phrase Key="City" Select="city" None="No city chosen" Other="City: {city}"/>
    <Phrase Key="Low" Text="Low priority"/>
    <Phrase Key="Normal" Text="Normal priority"/>
    <Phrase Key="High" Text="High priority"/>
    <Phrase Key="Critical" Text="Critical - drop everything"/>
    <Phrase Key="PriorityIs" Select="priority" Low="Priority: low" Normal="Priority: normal" High="Priority: high" Critical="Priority: critical"/>
    <Phrase Key="Color" Select="color" None="No color chosen" Other="Color: {color}"/>
</Language>
