<Language>
    <Phrase Key="Title" Text="Стенд цены анимаций"/>
    <Phrase Key="Many" Text="1. Много анимаций"/>
    <Phrase Key="ManyHint" Text="Каждый индикатор крутит свою бесконечную анимацию и перерисовывает только себя, поэтому цена здесь должна следовать за КОЛИЧЕСТВОМ. Смотрите, какое число двигается: 'loop' — это раскладка плюс запись, 'render' — показанные кадры."/>
    <Phrase Key="Clear" Text="Очистить"/>
    <Phrase Key="Channels" Text="2. То же количество, разные каналы"/>
    <Phrase Key="ChannelsHint" Text="25 индикаторов за нажатие, но классов, которые анимируют РАЗНОЕ. Ring/Dots двигают только трансформации; Ripple ещё анимирует Opacity элемента (канала в компоновщике пока нет); Arc анимирует StrokeTrimEnd — это геометрия, и обводка перестраивается каждый кадр. Количество равное, цена разная — в этом весь смысл."/>
    <Phrase Key="EveryKind" Text="+25 КАЖДОГО вида"/>
    <Phrase Key="AddKind" Text="+25: {kind}"/>
    <Phrase Key="ClearAll" Text="Очистить всё"/>
    <Phrase Key="Painters" Text="3. Одна анимированная кисть, много художников"/>
    <Phrase Key="PaintersHint" Text="Каждая карточка рисует ОДНУ И ТУ ЖЕ кисть, и ведёт её ОДНА анимация — так работают скелеты загрузки. Если цена следует за числом карточек, а не за этой одной анимацией, платят за каждого художника."/>
    <Phrase Key="TogglePulse" Text="Переключить пульс"/>
    <Phrase Key="TenCards" Text="+10 карточек"/>
    <Phrase Key="HundredCards" Text="+100 карточек"/>
</Language>
