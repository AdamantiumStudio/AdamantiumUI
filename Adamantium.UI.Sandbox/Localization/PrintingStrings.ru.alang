<Language>
    <Phrase Key="About" Text="Образец документа печатается через сервис печати: на принтеры системы, в файл PDF или - с примерами принтеров - на выдуманные принтеры, у каждого свои возможности."/>
    <Phrase Key="Pages" Text="Страниц"/>
    <Phrase Key="SystemPrinters" Text="Принтеры системы"/>
    <Phrase Key="SamplePrinters" Text="Примеры принтеров"/>
    <Phrase Key="Print" Text="Печать…"/>
    <Phrase Key="Printed" Text="Отправлено:"/>
    <Phrase Key="PrintedBySystem" Text="Отправлено на принтер."/>
    <Phrase Key="Saved" Text="Сохранено в PDF."/>
    <Phrase Key="Canceled" Text="Не напечатано."/>
    <Phrase Key="CardTitle" Text="Карточка, напечатанная как на экране"/>
    <Phrase Key="CardText" Text="Каждый её элемент ложится на лист так же, как на экран: градиент, скруглённые углы, этот полупрозрачный текст - и тень, снятая картинкой в разрешении печати."/>
    <Phrase Key="PrintCard" Text="Напечатать карточку…"/>
    <Phrase Key="Failed" Text="Не напечатано: принтер или место сохранения не приняли."/>
