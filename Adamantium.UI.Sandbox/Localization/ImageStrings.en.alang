    <Phrase Key="AnimationControl" Text="Animation control"/>
    <Phrase Key="AnimationHint" Text="Each source plays on its own terms: the frame range it loops over, the delay between frames, whether it runs at all, and the four corner radii. The frame count is reported BY the image once its file has decoded, which is what bounds the range sliders."/>
    <Phrase Key="PlayPause" Select="playing" True="Pause" False="Play"/>
    <Phrase Key="FrameCount" Text="frames:"/>
    <Phrase Key="Delay" Text="Delay (ms):"/>
    <Phrase Key="Frames" Text="Frames:"/>
