<Language>
    <Phrase Key="Playground" Text="Stretch playground"/>
    <Phrase Key="StretchLabel" Text="Stretch:"/>
    <Phrase Key="DirectionLabel" Text="Direction:"/>
    <Phrase Key="HorizontalLabel" Text="H alignment:"/>
    <Phrase Key="VerticalLabel" Text="V alignment:"/>
    <Phrase Key="BoxWidth" Text="Box width:"/>
    <Phrase Key="BoxHeight" Text="Box height:"/>
    <Phrase Key="ElementSize" Text="Element size:"/>

    <Phrase Key="PictureColors" Text="Picture colors"/>
    <Phrase Key="Brightness" Text="Brightness"/>
    <Phrase Key="Contrast" Text="Contrast"/>
    <Phrase Key="Saturation" Text="Saturation"/>

    <Phrase Key="Formats" Text="Formats and animation"/>
    <Phrase Key="OpacityLabel" Text="Opacity:"/>
    <Phrase Key="MipLevel" Text="PNG (mip level 2)"/>

    <Phrase Key="Jpeg2000" Text="JPEG 2000: resolutions and quality layers"/>
    <Phrase Key="Jpeg2000Hint" Text="One file holds every resolution and every quality: each resolution step halves the picture, each quality step leaves out the last layer. Only the part asked for is read and decoded - the numbers below say how much that is. The image draws it in the same frame, so a smaller part shows coarser."/>
    <Phrase Key="Resolution" Text="Resolution step:"/>
    <Phrase Key="Quality" Text="Quality step:"/>
    <Phrase Key="Jpeg2000Size" Text="Decoded: {width} × {height} px"/>
    <Phrase Key="Jpeg2000Layers" Text="Quality layers: {shown} of {count}"/>
    <Phrase Key="Jpeg2000Bytes" Text="Data read: {used} of {total} KB"/>
    <Phrase Key="Jpeg2000Time" Text="Decoding took {ms} ms"/>

    <Phrase Key="ColorProfile" Text="Color profile"/>
    <Phrase Key="ColorProfileHint" Text="A file can carry an ICC profile saying what its numbers mean. BitmapImage applies it when ApplyColorProfile is set; by default the pixels are taken as sRGB as stored - right for textures, masks and height maps, wrong for a picture made in another color space."/>
    <Phrase Key="WideGamut" Text="Wide-gamut RGB (Adobe-like primaries, gamma 2.2): read as sRGB its colors come out dull"/>
    <Phrase Key="SrgbProfile" Text="An sRGB profile: applied or not, the picture is the same"/>
    <Phrase Key="AsStored" Text="As stored"/>
    <Phrase Key="ProfileApplied" Text="Profile applied"/>

    <Phrase Key="AnimationControl" Text="Animation control"/>
    <Phrase Key="AnimationHint" Text="Each source plays on its own terms: the frame range it loops over, the delay between frames, whether it runs at all, and the four corner radii. The frame count is reported BY the image once its file has decoded, which is what bounds the range sliders."/>
    <Phrase Key="PlayPause" Select="playing" True="Pause" False="Play"/>
    <Phrase Key="FrameCount" Text="frames:"/>
    <Phrase Key="Delay" Text="Delay (ms):"/>
    <Phrase Key="Frames" Text="Frames:"/>
    <Phrase Key="TopLeft" Text="Top left:"/>
    <Phrase Key="BottomLeft" Text="Bottom left:"/>
    <Phrase Key="TopRight" Text="Top right:"/>
    <Phrase Key="BottomRight" Text="Bottom right:"/>

    <Phrase Key="None" Text="None"/>
    <Phrase Key="Fill" Text="Fill"/>
    <Phrase Key="Uniform" Text="Uniform"/>
    <Phrase Key="UniformToFill" Text="Uniform to fill"/>
    <Phrase Key="Both" Text="Both"/>
    <Phrase Key="DownOnly" Text="Down only"/>
    <Phrase Key="UpOnly" Text="Up only"/>
    <Phrase Key="Center" Text="Center"/>
    <Phrase Key="Left" Text="Left"/>
    <Phrase Key="Right" Text="Right"/>
    <Phrase Key="Top" Text="Top"/>
    <Phrase Key="Bottom" Text="Bottom"/>
    <Phrase Key="Stretch" Text="Stretch"/>
    <Phrase Key="Forward" Text="Forward"/>
    <Phrase Key="Backward" Text="Backward"/>
    <Phrase Key="ForwardLooped" Text="Forward, looped"/>
    <Phrase Key="BackwardLooped" Text="Backward, looped"/>
