    <Phrase Key="Start" Text="Start"/>
    <Phrase Key="Sweep" Text="Sweep"/>
    <Phrase Key="Sector" Text="Sector — closed through the center (off: edge-to-edge, closed by the chord)"/>
    <Phrase Key="Fill" Text="Fill — off leaves the outline alone, the way a ring gauge is drawn"/>

    <Phrase Key="Border" Text="Border — a thickness per side, a radius per corner, all drawn by one SDF instance:"/>
