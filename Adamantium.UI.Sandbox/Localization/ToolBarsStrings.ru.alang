<Language>
    <Phrase Key="Hint" Text="Перетащите полосу за ручку в другое место ряда, в другой ряд, под последний ряд — в новый, или в нижний лоток. Правая кнопка по лотку показывает и прячет полосы и закрепляет их. Сузьте верхний лоток: последние команды уйдут в меню своей полосы."/>
    <Phrase Key="Width" Text="Ширина верхнего лотка"/>
    <Phrase Key="Lower" Text="Другой лоток"/>
    <Phrase Key="Edit" Text="Правка"/>
    <Phrase Key="Text" Text="Текст"/>
    <Phrase Key="Paragraph" Text="Абзац"/>
    <Phrase Key="View" Text="Вид"/>
    <Phrase Key="Extra" Text="Ещё"/>
    <Phrase Key="Cut" Text="Вырезать"/>
    <Phrase Key="Copy" Text="Копировать"/>
    <Phrase Key="Paste" Text="Вставить"/>
    <Phrase Key="Bold" Text="Полужирный"/>
    <Phrase Key="Italic" Text="Курсив"/>
    <Phrase Key="Underline" Text="Подчёркнутый"/>
    <Phrase Key="Left" Text="Влево"/>
    <Phrase Key="Center" Text="По центру"/>
    <Phrase Key="Right" Text="Вправо"/>
    <Phrase Key="ZoomIn" Text="Крупнее"/>
    <Phrase Key="ZoomOut" Text="Мельче"/>
    <Phrase Key="Help" Text="Справка"/>
    <Phrase Key="Sections" Text="Разделы и контекстная полоса"/>
    <Phrase Key="SectionsHint" Text="Сузьте лоток: последние разделы полосы уйдут в её меню целиком - или, если включён перенос, на новую строку полосы. Встаньте в таблицу: появится её полоса, а меню лотка покажет её отдельно. Этот лоток не отдаёт свои полосы и не берёт чужие."/>
    <Phrase Key="SectionsWidth" Text="Ширина лотка с разделами"/>
    <Phrase Key="InTable" Text="В таблице"/>
    <Phrase Key="SectionsWrapping" Text="Разделы, которым не хватило места"/>
    <Phrase Key="Format" Text="Формат"/>
    <Phrase Key="Clipboard" Text="Буфер обмена"/>
    <Phrase Key="Font" Text="Шрифт"/>
    <Phrase Key="Align" Text="Выравнивание"/>
    <Phrase Key="Table" Text="Таблица"/>
    <Phrase Key="TableTools" Text="Работа с таблицами"/>
    <Phrase Key="Tables" Text="Таблицы"/>
    <Phrase Key="InsertTable" Text="Вставить таблицу"/>
    <Phrase Key="InsertRow" Text="Вставить строку"/>
    <Phrase Key="DeleteRow" Text="Удалить строку"/>
    <Phrase Key="Side" Text="Полоска сбоку"/>
    <Phrase Key="SideHint" Text="Сбоку полоска — колонка шириной с команду. Поле с числом стоит в узкой форме, его подпись становится подсказкой; поле автора и список шрифтов слишком широки, и каждое свёрнуто в кнопку, которая открывает его рядом с колонкой. Поверните трей вдоль — всё станет как было."/>
    <Phrase Key="SideOrientation" Text="Трей идёт"/>
    <Phrase Key="Picture" Text="Формат рисунка"/>
    <Phrase Key="PictureTools" Text="Работа с рисунками"/>
    <Phrase Key="PictureSize" Text="Размер"/>
    <Phrase Key="Crop" Text="Обрезать"/>
    <Phrase Key="PictureWidth" Text="Ширина"/>
    <Phrase Key="PictureHeight" Text="Высота"/>
    <Phrase Key="Author" Text="Автор"/>
    <Phrase Key="Arrange" Text="Упорядочить"/>
    <Phrase Key="Wrap" Text="Обтекание текстом"/>
    <Phrase Key="Rotate" Text="Повернуть"/>
    <Phrase Key="CaptionFont" Text="Шрифт подписи"/>
    <Phrase Key="InLine" Text="В тексте"/>
    <Phrase Key="Square" Text="Вокруг рамки"/>
    <Phrase Key="InFront" Text="Перед текстом"/>
    <Phrase Key="RotateRight" Text="Повернуть вправо"/>
    <Phrase Key="RotateLeft" Text="Повернуть влево"/>
    <Phrase Key="Nothing" Text="пока ничего"/>
    <Phrase Key="Report" Text="Нажато: {command}"/>
</Language>
