<View xmlns="http://adamantium/ui"
      xmlns:x="http://adamantium/ui/xaml/extensions"
      xmlns:models="clr-namespace:Adamantium.UI.Sandbox.DrawingBoard.Models">

    <!-- WHAT IS INSIDE A NODE, written HERE because it is a picture. The page's table of kinds hands each node a plain
         state object and nothing else; which of these draws it is decided by the type of that object. A view-model that
         built these controls itself would be a view-model drawing, and the value a person set would then have to be dug
         back out of the visual tree to save it. -->
    <ResourceContext.Resources>
        <models:NodeBodySelector x:Key="NodeBodies">
            <models:NodeBodySelector.Number>
                <DataTemplate>
                    <!-- THOUSANDTHS, and no more. A number here is something a hand dragged to, and the hand cannot
                         mean the seventeen digits that come out of adding a twentieth to itself - "1,0125000000000002"
                         is the arithmetic showing through. -->
                    <NumericUpDown Value="{Binding Value, Mode=TwoWay}"
                                   AutomationProperties.Name="{Localize CanvasPageStrings.NodeNumber}"
                                   Minimum="0" Maximum="4" SmallChange="0.05" StringFormat="0.###"
                                   AreButtonsVisible="False" IsDragScrubEnabled="True"/>
                </DataTemplate>
            </models:NodeBodySelector.Number>

            <models:NodeBodySelector.Color>
                <DataTemplate>
                    <ColorPickerButton SelectedColor="{Binding Color, Mode=TwoWay}"
                                       AutomationProperties.Name="{Localize CanvasPageStrings.NodeColor}"
                                       Height="26" MinWidth="0" Padding="2"/>
                </DataTemplate>
            </models:NodeBodySelector.Color>

            <!-- WHAT CAME OUT, live: the color the whole graph works out, drawn as itself. This is the node that makes
                 the difference between a graph and a picture of one - change a number anywhere upstream and this
                 swatch follows. -->
            <models:NodeBodySelector.Result>
                <DataTemplate>
                    <Border Height="40" CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                            Background="{Binding Result, Converter={ColorToBrushConverter}}"/>
                </DataTemplate>
            </models:NodeBodySelector.Result>

            <!-- A node that is ALL SOCKETS shows nothing between them. -->
            <models:NodeBodySelector.None>
                <DataTemplate>
                    <Grid/>
                </DataTemplate>
            </models:NodeBodySelector.None>

        </models:NodeBodySelector>

        <!-- ...and the same on the DRAWING side: the page says a button is at such a place, and this says what a button
             looks like. A shape needs nothing here - the canvas draws one from its description - so only what is not a
             shape comes past. -->
        <models:PlacedThingSelector x:Key="PlacedThings">
            <models:PlacedThingSelector.Button>
                <DataTemplate>
                    <Button Content="{Binding Text}"/>
                </DataTemplate>
            </models:PlacedThingSelector.Button>

            <models:PlacedThingSelector.Switch>
                <DataTemplate>
                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                </DataTemplate>
            </models:PlacedThingSelector.Switch>

            <models:PlacedThingSelector.Field>
                <DataTemplate>
                    <TextBox Text="{Binding Text, Mode=TwoWay}"
                             AutomationProperties.Name="{Localize CanvasPageStrings.AField}"/>
                </DataTemplate>
            </models:PlacedThingSelector.Field>
        </models:PlacedThingSelector>
    </ResourceContext.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">


        <TextBlock Grid.Row="0" Text="InfiniteCanvas" FontSize="18"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,12" TextWrapping="WrapByWords"
                   Text="{Localize CanvasPageStrings.Intro}"/>

        <!-- Everything that steers the canvas lives in the canvas's own panel. -->

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="0"
                BorderBrush="{ObservableResource ControlStrokeColorDefault}">
            <!-- Square corners on purpose: the clip here is a rectangular scissor, and a rounded frame would let the
                 canvas's own square corners poke out from under it. -->
            <Grid>
            <!-- UNDER the canvas: an ordinary page of controls, so the whiteboard mode has something to be a whiteboard
                 OVER. In the other three modes it is hidden behind the ground and never seen. -->
            <StackPanel Orientation="Vertical" Margin="40,30,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Width="320">
                <TextBlock x:Name="OtherScreenHeading" Text="{Localize CanvasPageStrings.OtherScreen}" FontSize="16"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="WrapByWords"
                           Text="{Localize CanvasPageStrings.OtherScreenHint}"
                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                <Button Content="{Localize CanvasPageStrings.AButton}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                <CheckBox Content="{Localize CanvasPageStrings.ACheckbox}" Margin="0,10,0,0"/>
                <TextBox AutomationProperties.LabeledBy="{Binding ElementName=OtherScreenHeading}" Text="A field" Margin="0,10,0,0" Width="200" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- The scene comes from the page, which owns undo and saving; pin colors come from the SocketKinds table. -->
            <InfiniteCanvas x:Name="Canvas"
                            GridStyle="{Binding GridStyle}"
                            Mode="{Binding Mode, Mode=TwoWay}"
                            Scene="{Binding Scene}"
                            History="{Binding History}"
                            Tools="{Binding Tools}"
                            Selection="{Binding Selection, Mode=TwoWay}"
                            Tool="{Binding Tool, Mode=TwoWay}"
                            DefaultTool="{Binding SelectTool}"
                            Layout="{Binding Layout, Mode=TwoWay}"
                            Ink="{Binding Ink}"
                            ShapeFill="{Binding ShapeFillOrNothing}"
                            InkThickness="{Binding InkThickness}"
                            TextSize="{Binding TextSize}"
                            EraserSize="{Binding EraserSize}"
                            IsDesignMode="{Binding DesignMode}"
                            SnapToGrid="{Binding SnapToGrid}"
                            ShowsPointerReadout="{Binding ShowReadout}"
                            MaxScale="{Binding MaxZoom}"
                            SnapMarkBrush="{Binding SnapMark}"
                            SnapMarkSize="{Binding SnapMarkSize}"
                            OverlayPlacement="TopLeft"
                            Scale="{Binding Scale, Mode=TwoWay}"
                            Offset="{Binding Offset, Mode=TwoWay}"
                            Objects="{Binding Objects}"
                            ObjectTemplateSelector="{ResourceReference PlacedThings}"
                            Nodes="{Binding Nodes}"
                            NodeKinds="{Binding NodeKinds}"
                            SocketKinds="{Binding SocketKinds}"
                            NodeContentSelector="{ResourceReference NodeBodies}"
                            ConfirmsDelete="{Binding AsksBeforeDelete}"/>
            </Grid>
        </Border>

    </Grid>
</View>
