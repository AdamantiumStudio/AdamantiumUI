{
  "$schema": "http://json.schemastore.org/template",
  "author": "Adamantium Studio",
  "classifications": [ "Desktop", "Adamantium", "MVVM" ],
  "identity": "Adamantium.UI.App.CSharp",
  "groupIdentity": "Adamantium.UI.App",
  "name": "Adamantium UI Application",
  "description": "A desktop application on Adamantium UI: a window in AUML markup and its view-model.",
  "shortName": "adamantium-app",
  "sourceName": "AdamantiumApp",
  "defaultName": "AdamantiumApp1",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "theme": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Theme",
      "description": "The theme the application opens on.",
      "choices": [
        { "choice": "Platform", "displayName": "The platform's", "description": "The macOS look on macOS, Fluent elsewhere" },
        { "choice": "Fluent", "displayName": "Fluent", "description": "Fluent design, light and dark" },
        { "choice": "Graphite", "displayName": "Graphite", "description": "An editor's dense look: small type, tight radii, dark and light" },
        { "choice": "MacOs", "displayName": "macOS", "description": "The macOS look, light and dark" }
      ],
      "defaultValue": "Platform"
    },
    "startupTheme": {
      "type": "generated",
      "generator": "switch",
      "replaces": " StartupTheme=\"THEME_NAME\"",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(theme == 'Fluent')", "value": " StartupTheme=\"Fluent\"" },
          { "condition": "(theme == 'Graphite')", "value": " StartupTheme=\"Graphite\"" },
          { "condition": "(theme == 'MacOs')", "value": " StartupTheme=\"MacOs\"" },
          { "condition": "", "value": "" }
        ]
      }
    }
  },
  "primaryOutputs": [
    { "path": "AdamantiumApp.csproj" }
  ]
}
