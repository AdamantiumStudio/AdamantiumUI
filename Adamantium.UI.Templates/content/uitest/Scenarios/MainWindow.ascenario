<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The main window opens with the application's name.">
  <!-- A selector finds by id (an element's AutomationId, else its x:Name), by name or by type: id=Save,
       name=Save as, type=Button,name=OK, a path: id=Toolbar/id=Save. -->
  <Wait Target="id=MainWindow" />
  <Expect Target="id=MainWindow" Type="Window" Name="APP_NAME" />
</Scenario>
