<Project Sdk="Microsoft.NET.Sdk">

    <!-- A universe of another process shown in a RenderTargetPanel. Apart from Adamantium.UI, as the engine keeps
         Adamantium.Multiverse.Remote apart, so an application that shows only its own universes takes no RPC. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <Description>A universe of the Adamantium engine running in another process, shown in a RenderTargetPanel: its frames drawn there, the panel's size, focus and input given to it.</Description>
        <PackageTags>adamantium;ui;engine;remote;viewer</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.Remote.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.UI\Adamantium.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AdamantiumEngineReference Include="Adamantium.Multiverse.Remote" />
    </ItemGroup>

</Project>
