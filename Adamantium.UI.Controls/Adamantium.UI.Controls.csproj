<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <Configurations>Release;Debug</Configurations>
        <Platforms>AnyCPU</Platforms>
        <IsPackable>true</IsPackable>
        <Description>Controls of Adamantium UI: buttons, text, lists and trees, tabs, docking, the ribbon, a tree data grid, a property grid, color pickers, shapes, and an infinite canvas for drawing and node graphs.</Description>
        <PackageTags>adamantium;ui;controls;datagrid;docking;ribbon;tabs;propertygrid</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Adamantium.UI.Core\Adamantium.UI.Core.csproj" />
      <ProjectReference Include="..\Adamantium.Navigation\Adamantium.Navigation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI" />
        <InternalsVisibleTo Include="Adamantium.UITests" />
    </ItemGroup>

</Project>
