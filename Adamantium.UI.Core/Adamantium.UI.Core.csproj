<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>
        <Description>Foundation of Adamantium UI: the element tree, properties and bindings, layout, input, styles and resources, behaviors and the base controls the rest is built from.</Description>
        <PackageTags>adamantium;ui;layout;binding;styles</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.Controls"/>
        <InternalsVisibleTo Include="Adamantium.UI"/>
        <InternalsVisibleTo Include="Adamantium.UI.Automation"/>
        <!-- So a test can put the mouse DEVICE in a state (a button held) instead of only fabricating events about it -
             input behavior that depends on the live button state is otherwise untestable. -->
        <InternalsVisibleTo Include="Adamantium.UITests"/>
        <InternalsVisibleTo Include="Adamantium.XamlTests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.Navigation\Adamantium.Navigation.csproj" />
        <ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj"/>
        <ProjectReference Include="..\Adamantium.UI.EventGenerators\Adamantium.UI.EventGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <AdamantiumEngineReference Include="Adamantium.ECS" />
        <AdamantiumEngineReference Include="Adamantium.Fonts" />
        <AdamantiumEngineReference Include="Adamantium.Mathematics" />
        <AdamantiumEngineReference Include="Adamantium.MVVM" />
        <AdamantiumEngineReference Include="Adamantium.MVVM.Generators" Role="Generator" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="obj\**" />
    </ItemGroup>

</Project>
