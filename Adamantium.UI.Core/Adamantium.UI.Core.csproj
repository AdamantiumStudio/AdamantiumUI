<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>
        <Description>Foundation of Adamantium UI: the element tree, properties and bindings, layout, input, styles and resources, behaviors and the base controls the rest is built from.</Description>
        <PackageTags>adamantium;ui;layout;binding;styles</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.Controls"/>
        <InternalsVisibleTo Include="Adamantium.UI"/>
        <!-- So a test can put the mouse DEVICE in a state (a button held) instead of only fabricating events about it -
             input behavior that depends on the live button state is otherwise untestable. -->
        <InternalsVisibleTo Include="Adamantium.UITests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.Navigation\Adamantium.Navigation.csproj" />
        <ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UseEngineSource)' == 'true'">
        <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.ECS\Adamantium.ECS.csproj"/>
        <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Fonts\Adamantium.Fonts.csproj"/>
        <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseEngineSource)' != 'true'">
        <PackageReference Include="Adamantium.ECS" Version="$(AdamantiumEngineVersion)" />
        <PackageReference Include="Adamantium.Fonts" Version="$(AdamantiumEngineVersion)" />
        <PackageReference Include="Adamantium.Mathematics" Version="$(AdamantiumEngineVersion)" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="obj\**" />
    </ItemGroup>

</Project>
