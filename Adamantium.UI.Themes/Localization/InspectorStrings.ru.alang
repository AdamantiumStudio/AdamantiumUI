    <Phrase Key="HeadWidthHint" Text="Ширина наконечника у основания в толщинах линии"/>
    <Phrase Key="WashHint" Text="Лежит под узлами, поэтому делайте её бледной — она не должна мешать их читать"/>
    <Phrase Key="TitleBarHint" Text="Высота полосы — за неё рамку и перетаскивают"/>
    <Phrase Key="BezierOrderHint" Text="Кривая Безье через N+1 точку имеет степень N — чтобы её изменить, добавьте или уберите точку"/>
    <Phrase Key="NurbsDegreeHint" Text="При нуле степень следует за числом точек"/>
    <Phrase Key="EvenHint" Text="Расположены ли узлы равномерно"/>
