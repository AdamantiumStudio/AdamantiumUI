    <Phrase Key="AngleShapeHint" Text="Degrees clockwise, about the middle of the shape"/>
    <Phrase Key="AngleControlHint" Text="Degrees clockwise, about the middle of the control"/>
    <Phrase Key="HeadLengthHint" Text="How long the head is, measured in line thicknesses"/>
    <Phrase Key="HeadWidthHint" Text="How wide the head is across its base, in line thicknesses"/>
    <Phrase Key="WashHint" Text="Behind the nodes, so keep it faint - it must not change how they read"/>
    <Phrase Key="TitleBarHint" Text="How tall the strip is - and that strip is what the frame is dragged by"/>
    <Phrase Key="BezierOrderHint" Text="A Bezier through N+1 points is of degree N - add or remove a point to change it"/>
    <Phrase Key="NurbsDegreeHint" Text="Zero lets the degree follow the number of points"/>
    <Phrase Key="EvenHint" Text="Whether the knots are evenly spaced"/>
    <Phrase Key="SourceHint" Text="The picture this shows"/>
    <Phrase Key="PictureFillHint" Text="How the picture is fitted to the element"/>
    <Phrase Key="RepeatHint" Text="Whether the picture repeats, and whether every other copy is mirrored"/>
    <Phrase Key="ShowPictureHint" Text="Draw the picture, or leave only the ground behind it"/>
    <Phrase Key="GroundHint" Text="When the background color is painted: only while there is no picture, under it as well, or never"/>
    <Phrase Key="TintHint" Text="A color multiplied into the picture; white leaves it alone"/>
    <Phrase Key="NodeKindHint" Text="What sort of node this is - what the application looks up to know what it does"/>
    <Phrase Key="FoldedHint" Text="Fold the node down to its title strip; its sockets move to the edges"/>
    <Phrase Key="SocketKindHint" Text="What flows through it - two sockets are joined when they agree, and one saying nothing takes anything"/>
    <Phrase Key="TakesHint" Text="How many wires may sit here - zero means as many as come; a full socket loses its oldest"/>
    <Phrase Key="PanelsHint" Text="Where the panels stand, how wide they were pulled, and which were folded away."/>
    <Phrase Key="CameraHint" Text="Where the camera was looking."/>
    <Phrase Key="ConfirmHint" Text="Ask before removing what is selected. Clearing the whole canvas always asks."/>

    <Phrase Key="ActualSize" Text="Size it to the picture's own pixels"/>
    <Phrase Key="RemoveSocket" Text="Remove this socket"/>
    <Phrase Key="AddInput" Text="Add an input"/>
    <Phrase Key="AddOutput" Text="Add an output"/>
</Language>
