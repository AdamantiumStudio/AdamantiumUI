    <Phrase Key="UnsavedTitle" Text="Unsaved changes"/>
    <Phrase Key="SaveOne" Text="Save the changes to '{name}'?"/>
    <Phrase Key="SaveMany" Count="count" One="Save the changes to {count} document?" Other="Save the changes to {count} documents?"/>
