<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- StatusBar: the window's own ground under a hairline, small secondary type, as an IDE's. Its fields line up from
         the left, a field docked right from the right. Built on the keys every theme has, so one set serves them all. -->
    <Style Selector="StatusBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="0 1 0 0"/>
        <Setter Property="Padding" Value="4 0"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBar">
                    <!-- Its words are fields to press, not text to select: a press on one acts. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            TextBlock.IsTextSelectionEnabled="False">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A field: its words in the caption size and secondary color; one that acts on a press lights under the pointer
         and darker while pressed, as a toolbar button does. -->
    <Style Selector="StatusBarItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <Setter Property="Padding" Value="6 2"/>
        <Setter Property="Margin" Value="1 2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBarItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            TextBlock.IsTextSelectionEnabled="False">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="StatusBarItem">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsInteractive" Value="true"/>
                <Condition Property="IsPointerOver" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsInteractive" Value="true"/>
                <Condition Property="IsPressed" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </MultiTrigger>
    </Style>

</StyleSet>
