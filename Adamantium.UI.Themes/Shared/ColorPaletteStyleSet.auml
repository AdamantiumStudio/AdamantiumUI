<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ColorPalette: the choice of no color, the grid of swatches, and the picker under "More colors". Its buttons are
         the theme's own, so one set serves every theme. -->
    <Style Selector="ColorPalette">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorPalette">
                    <StackPanel Margin="{TemplateBinding Padding}" Spacing="6">
                        <Button x:Name="PART_NoColor"
                                Content="{TemplateBinding NoColorText}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"/>
                        <ItemsControl ItemsSource="{TemplateBinding ColorPlaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- One row for the colors applied through "More colors", as Word's "Recent colors": shown once
                             there are some, empty places after them. -->
                        <StackPanel x:Name="RecentRow" Visibility="Collapsed" Spacing="6">
                            <TextBlock Text="{Localize ColorPickerStrings.RecentColors}"
                                       FontSize="12"
                                       Foreground="{ResourceReference TextFillColorSecondary}"/>
                            <ItemsControl ItemsSource="{TemplateBinding RecentPlaces}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <Button x:Name="PART_MoreColors"
                                Content="{Localize ColorPickerStrings.MoreColors}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"/>
                        <StackPanel x:Name="PART_More" Visibility="Collapsed" Spacing="6">
                            <ColorPicker x:Name="PART_Picker"/>
                            <Button x:Name="PART_Apply"
                                    Content="{Localize ColorPickerStrings.Apply}"
                                    HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ColorPalette">
        <PropertyTrigger Property="IsMoreColorsOpen" Value="true">
            <Setter TargetName="PART_More" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ColorPalette">
        <PropertyTrigger Property="HasRecentColors" Value="true">
            <Setter TargetName="RecentRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ColorPaletteSwatch">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorPaletteSwatch">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding SwatchBrush}"
                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                            BorderThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ColorPaletteSwatch">
        <!-- An empty place: an outline, nothing to press. -->
        <PropertyTrigger Property="HasColor" Value="false">
            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ResourceReference TextFillColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ResourceReference TextFillColorPrimary}"/>
            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
        </PropertyTrigger>
    </Style>

    <!-- The color picked last, which the split button's body applies, is ringed in the accent. -->
    <Style Selector="ColorPaletteSwatch">
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
