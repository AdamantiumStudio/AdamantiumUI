<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Calendar, as WinUI draws one: a header that goes up a level, arrows up and down, and under them a page - the
         names of the days over six weeks of them, month by month, or the months of a year, the years of a decade. The
         calendar holds two pages and slides or zooms from one to the other; the cells share whatever room it is given.
         Built from keys every theme answers, so one set serves every theme. -->
    <Style Selector="Calendar">
        <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style Selector="Calendar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  Margin="0,0,0,4">
                                <Button x:Name="PART_Header"
                                        Classes="CalendarHeader"
                                        Focusable="False"
                                        Content="{TemplateBinding HeaderText}"
                                        AutomationProperties.HelpText="{Localize CalendarStrings.HeaderHelp}"/>
                                <RepeatButton x:Name="PART_Previous"
                                              Grid.Column="1"
                                              Classes="CalendarArrow"
                                              Focusable="False"
                                              AutomationProperties.Name="{Localize CalendarStrings.Previous}">
                                    <Image Source="{ResourceReference ChevronUpIcon}"
                                           Width="10"
                                           Height="10"/>
                                </RepeatButton>
                                <RepeatButton x:Name="PART_Next"
                                              Grid.Column="2"
                                              Classes="CalendarArrow"
                                              Focusable="False"
                                              AutomationProperties.Name="{Localize CalendarStrings.Next}">
                                    <Image Source="{ResourceReference ChevronDownIcon}"
                                           Width="10"
                                           Height="10"/>
                                </RepeatButton>
                            </Grid>
                            <Grid x:Name="PART_Pages"
                                  Grid.Row="1"
                                  ClipToBounds="True"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A page: the months side by side, or - a level up - the months of a year or the years of a decade in their
         place; the months keep their room, so the calendar keeps its size. -->
    <Style Selector="CalendarPage">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarPage">
                    <Grid>
                        <UniformGrid x:Name="PART_Months"
                                     Rows="1"
                                     ColumnSpacing="16"/>
                        <UniformGrid x:Name="PART_Cells"
                                     Columns="4"
                                     Rows="3"
                                     Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="CalendarPage">
        <PropertyTrigger Property="DisplayMode" Value="Year">
            <Setter TargetName="PART_Months" Property="Visibility" Value="Hidden"/>
            <Setter TargetName="PART_Cells" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="DisplayMode" Value="Decade">
            <Setter TargetName="PART_Months" Property="Visibility" Value="Hidden"/>
            <Setter TargetName="PART_Cells" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- A month: its name where several are shown, the names of the days, six weeks numbered beside them. -->
    <Style Selector="CalendarMonth">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarMonth">
                    <Grid RowDefinitions="Auto,Auto,*"
                          ColumnDefinitions="Auto,*">
                        <TextBlock x:Name="Title"
                                   Grid.ColumnSpan="2"
                                   Classes="CalendarMonthTitle"
                                   Text="{TemplateBinding Title}"
                                   Visibility="Collapsed"/>
                        <UniformGrid x:Name="PART_DayNames"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Columns="7"
                                     Rows="1"/>
                        <UniformGrid x:Name="PART_WeekNumbers"
                                     Grid.Row="2"
                                     Columns="1"
                                     Rows="6"
                                     Visibility="Collapsed"/>
                        <UniformGrid x:Name="PART_Days"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Columns="7"
                                     Rows="6"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="CalendarMonth">
        <PropertyTrigger Property="IsTitleShown" Value="true">
            <Setter TargetName="Title" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowWeekNumbers" Value="true">
            <Setter TargetName="PART_WeekNumbers" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="TextBlock.CalendarMonthTitle">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style Selector="Button.CalendarHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="RepeatButton.CalendarArrow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.CalendarDayName">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorSecondary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style Selector="TextBlock.CalendarWeekNumber">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorTertiary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- A day: its number in the middle of a cell that takes the room it is given. -->
    <Style Selector="CalendarDayButton">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="CalendarDayButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"/>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}"/>
                        <Border x:Name="Strike"
                                Height="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Background="{ResourceReference TextFillColorSecondary}"
                                Visibility="Collapsed"/>
                        <Border x:Name="Mark"
                                Width="4"
                                Height="4"
                                CornerRadius="2"
                                Margin="0,0,0,3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefault}"
                                Visibility="Collapsed"/>
                        <Border x:Name="Cursor"
                                Margin="-1"
                                BorderBrush="{ResourceReference TextFillColorPrimary}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Later triggers win: today's accent over hover, a selected today ringed in the accent's text color, an unusable
         today only ringed in the accent; the keyboard's ring sits outside the selection's. -->
    <Style Selector="CalendarDayButton">
        <PropertyTrigger Property="IsInactive" Value="true">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorTertiary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference SubtleFillColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference SubtleFillColorTertiary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsToday" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsToday" Value="true"/>
                <Condition Property="IsSelected" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ThemeResource AccentForegroundColor}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsBlackedOut" Value="true">
            <Setter TargetName="Strike" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsMarked" Value="true">
            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsMarked" Value="true"/>
                <Condition Property="IsToday" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Mark" Property="Background" Value="{ThemeResource AccentForegroundColor}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsToday" Value="true"/>
                <Condition Property="IsEnabled" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsCursor" Value="true">
            <Setter TargetName="Cursor" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- A month or a year: its name in the middle of a cell that takes the room it is given. -->
    <Style Selector="CalendarButton">
        <Setter Property="Padding" Value="4,14"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="CalendarButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"/>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}"/>
                        <Border x:Name="Cursor"
                                Margin="-1"
                                BorderBrush="{ResourceReference TextFillColorPrimary}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="CalendarButton">
        <PropertyTrigger Property="IsInactive" Value="true">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorTertiary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference SubtleFillColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ResourceReference SubtleFillColorTertiary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsCurrent" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="HasSelectedDates" Value="true">
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsCurrent" Value="true"/>
                <Condition Property="HasSelectedDates" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ThemeResource AccentForegroundColor}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsCurrent" Value="true"/>
                <Condition Property="IsEnabled" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsCursor" Value="true">
            <Setter TargetName="Cursor" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
