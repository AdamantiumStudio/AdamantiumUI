<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The clock's face: a round plate and what is marked round its edge, laid out by the face to its size. Built from
         keys every theme answers, so one set serves every theme. -->
    <Style Selector="ClockFace">
        <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ClockFace">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="1"/>
                        <Grid x:Name="PART_Marks"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.ClockFaceTick">
        <Setter Property="Background" Value="{ResourceReference TextFillColorTertiary}"/>
    </Style>

    <Style Selector="Border.ClockFaceHourTick">
        <Setter Property="Background" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="Border.ClockFaceDot">
        <Setter Property="Background" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="TextBlock.ClockFaceLabel">
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="TextBlock.ClockFaceLabelChosen">
        <Setter Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
    </Style>

    <!-- The clock: a face with hands, or figures - built by the clock into its display. -->
    <Style Selector="Clock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Clock">
                    <Grid x:Name="PART_Display"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.ClockHourHand">
        <Setter Property="Width" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="Border.ClockMinuteHand">
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="Border.ClockSecondHand">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
    </Style>

    <Style Selector="Border.ClockHub">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
    </Style>

    <Style Selector="TextBlock.ClockText">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- A segment is lit or not - one class or the other, never both: two styles setting one property on one element
         apply in no promised order. -->
    <Style Selector="Border.ClockSegmentOff">
        <Setter Property="Background" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="Opacity" Value="0.08"/>
    </Style>

    <Style Selector="Border.ClockSegmentOn">
        <Setter Property="Background" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- The part being set (Clock.MarkedParts): its lit segments, its figures, in the accent. -->
    <Style Selector="Border.ClockSegmentMarked">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="TextBlock.ClockTextMarked">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
    </Style>

    <Style Selector="TextBlock.ClockFlipFigureMarked">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
    </Style>

    <Style Selector="Border.ClockColonDot">
        <Setter Property="Background" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="Border.ClockFlipCard">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>

    <Style Selector="TextBlock.ClockPeriod">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="6,0,0,4"/>
    </Style>

    <!-- What is left of a countdown: a ring round the rim, apart from the hands. -->
    <Style Selector="Ellipse.ClockRemaining">
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="RingThickness" Value="4"/>
    </Style>

    <!-- A countdown: its clock - or, standing at its whole length, a field to set that length in - and under it what
         starts, pauses and resets it. The start button gives way to the pause button while it runs. -->
    <Style Selector="CountdownTimer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CountdownTimer">
                    <Grid RowDefinitions="*,Auto">
                        <Clock x:Name="PART_Clock"
                               ClockStyle="{TemplateBinding ClockStyle}"
                               ShowSeconds="{TemplateBinding ShowSeconds}"
                               MarkedParts="{Binding ActivePart, ElementName=PART_Duration}"/>
                        <!-- The length set in figures as large as the clock's room takes, with no frame: the part
                             being typed is marked by its figures alone. Over a clock in figures it is not seen - the
                             clock shows the length and lights the part being typed. -->
                        <Viewbox x:Name="Length"
                                 Margin="8,0"
                                 Visibility="Collapsed">
                            <DurationField x:Name="PART_Duration"
                                           Value="{TemplateBinding Duration, Mode=TwoWay}"
                                           Minimum="0:00:00"
                                           Maximum="36500.00:00:00"
                                           MinWidth="0"
                                           MinHeight="0"
                                           FieldSegment.Marking="Figures">
                                <DurationField.Template>
                                    <ControlTemplate TargetType="Control">
                                        <FieldSegmentPanel x:Name="PART_Segments"
                                                           VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </DurationField.Template>
                            </DurationField>
                        </Viewbox>
                        <StackPanel x:Name="Buttons"
                                    Grid.Row="1"
                                    Classes="ClockButtons">
                            <Button x:Name="PART_Start"
                                    Classes="ClockButton"
                                    Content="{Localize ClockStrings.Start}"/>
                            <Button x:Name="PART_Pause"
                                    Classes="ClockButton"
                                    Visibility="Collapsed"
                                    Content="{Localize ClockStrings.Pause}"/>
                            <Button x:Name="PART_Reset"
                                    Classes="ClockButton"
                                    Content="{Localize ClockStrings.Reset}"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="CountdownTimer">
        <PropertyTrigger Property="IsRunning" Value="true">
            <Setter TargetName="PART_Start" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_Pause" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsAtStart" Value="true"/>
                <Condition Property="ShowDurationField" Value="true"/>
                <Condition Property="IsAnalog" Value="true"/>
            </MultiTrigger.Conditions>
            <!-- Hidden, not collapsed: the clock keeps its room, so the field fills it and nothing moves on start. -->
            <Setter TargetName="PART_Clock" Property="Visibility" Value="Hidden"/>
            <Setter TargetName="Length" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsAtStart" Value="true"/>
                <Condition Property="ShowDurationField" Value="true"/>
                <Condition Property="IsAnalog" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Length" Property="Visibility" Value="Visible"/>
            <Setter TargetName="Length" Property="Opacity" Value="0"/>
        </MultiTrigger>
        <PropertyTrigger Property="ShowButtons" Value="false">
            <Setter TargetName="Buttons" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <!-- A stopwatch: its clock, what starts, pauses, laps and resets it, and the laps taken listed under them. -->
    <Style Selector="StopwatchTimer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StopwatchTimer">
                    <Grid RowDefinitions="*,Auto,Auto">
                        <Clock x:Name="PART_Clock"
                               ClockStyle="{TemplateBinding ClockStyle}"
                               ShowSeconds="{TemplateBinding ShowSeconds}"/>
                        <StackPanel x:Name="Buttons"
                                    Grid.Row="1"
                                    Classes="ClockButtons">
                            <Button x:Name="PART_Start"
                                    Classes="ClockButton"
                                    Content="{Localize ClockStrings.Start}"/>
                            <Button x:Name="PART_Pause"
                                    Classes="ClockButton"
                                    Visibility="Collapsed"
                                    Content="{Localize ClockStrings.Pause}"/>
                            <Button x:Name="PART_Lap"
                                    Classes="ClockButton"
                                    Content="{Localize ClockStrings.Lap}"/>
                            <Button x:Name="PART_Reset"
                                    Classes="ClockButton"
                                    Content="{Localize ClockStrings.Reset}"/>
                        </StackPanel>
                        <ListBox x:Name="PART_Laps"
                                 Grid.Row="2"
                                 Classes="ClockLaps"
                                 AutomationProperties.Name="{Localize ClockStrings.Laps}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="16">
                                        <TextBlock><Run Text="{Localize ClockStrings.Lap}"/><Run Text=" "/><Run Text="{Binding Number}"/></TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeText}"/>
                                        <TextBlock Grid.Column="2"
                                                   Classes="ClockLapTotal"
                                                   Text="{Binding TotalText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="StopwatchTimer">
        <PropertyTrigger Property="IsRunning" Value="true">
            <Setter TargetName="PART_Start" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_Pause" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowButtons" Value="false">
            <Setter TargetName="Buttons" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowLaps" Value="false">
            <Setter TargetName="PART_Lap" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_Laps" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="HasLaps" Value="false">
            <Setter TargetName="PART_Laps" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="StackPanel.ClockButtons">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style Selector="Button.ClockButton">
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Margin" Value="3,0"/>
    </Style>

    <Style Selector="ListBox.ClockLaps">
        <Setter Property="MaxHeight" Value="160"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style Selector="TextBlock.ClockLapTotal">
        <Setter Property="Foreground" Value="{ResourceReference TextFillColorSecondary}"/>
    </Style>

</StyleSet>
