<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Hue around, saturation outward, value as a black veil (1 - Value). Sized for a properties column, with a small
         black/white hairline square marker that hides almost no hues. -->

    <Style Selector="ColorWheel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorWheel">
                    <Border x:Name="PART_Wheel"
                            Width="{ResourceReference ColorWheelSize}"
                            Height="{ResourceReference ColorWheelSize}">
                        <Grid>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ConicGradientBrush Center="0.5,0.5">
                                        <GradientStop Color="#FFFF0000" Offset="0"/>
                                        <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                                        <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                        <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                                        <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                        <GradientStop Color="#FFFF0000" Offset="1"/>
                                    </ConicGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Value dimming: a black disc whose Opacity the control sets to (1 - Value). -->
                            <Ellipse x:Name="PART_ValueOverlay" Fill="Black" Opacity="0"/>
                            <!-- The marker, positioned by the control via Margin. Two hairlines, not one: white alone
                                 vanishes on a pale hue and black alone on a dark one. -->
                            <Border x:Name="PART_Thumb"
                                    Width="{ResourceReference ColorThumbSize}"
                                    Height="{ResourceReference ColorThumbSize}"
                                    CornerRadius="0"
                                    BorderThickness="{ResourceReference StrokeThin}"
                                    BorderBrush="Black"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <Border BorderThickness="{ResourceReference StrokeThin}" BorderBrush="White"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
