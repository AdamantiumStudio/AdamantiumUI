<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Plain text at this theme's body size (12). A type-only selector is a type default below inheritance, so it does
         not mask what controls set for their content. -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <!-- Said once here rather than at every label - see Fluent's copy for why the property's own Bottom default
             cannot be the thing that changes. -->
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>

    <!-- A link stands out in the accent color, on top of its underline. -->
    <Style Selector="Hyperlink">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
    </Style>

</StyleSet>
