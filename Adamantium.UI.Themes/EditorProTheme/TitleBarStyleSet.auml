<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The custom caption (part names and triggers kept): a band closed by a bottom hairline, a secondary-weight title,
         and a hairline gutter before the window buttons. -->

    <Style Selector="TitleBar">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- A standalone TitleBar's own height. Inside a Window the template binds it to Window.TitleBarHeight, which
             wins over this - the window is the one that has to know how tall its caption is. -->
        <Setter Property="Height" Value="{ResourceReference TitleBarHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeChrome}"/>
    </Style>

    <Style Selector="TitleBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TitleBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{ResourceReference TitleBarUnderline}">
                        <!-- Column 0 is EMPTY until the buttons move into it (CaptionButtonPlacement=Left, the macOS
                             and Ubuntu convention). An Auto column costs nothing while nothing is in it, and this is
                             cheaper than carrying a second copy of the button panel: the parts are found by NAME, so
                             two panels would mean two PART_CloseButton and the control would wire up only one. -->
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                            <!-- A neutral slot before everything else: a quick-access bar, a search box, whatever the
                                 application puts there. -->
                            <ContentPresenter x:Name="PART_LeadingContent" Grid.Column="1"
                                    Content="{TemplateBinding LeadingContent}"
                                    VerticalAlignment="Center"/>

                            <!-- LEFT commands: interactive, sit before the drag area (so they stay clickable). -->
                            <ItemsControl Grid.Column="2" ItemsSource="{TemplateBinding LeftWindowCommands}"
                                    VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="CaptionButton" VerticalAlignment="Stretch"
                                                ToolTip="{Binding ToolTip}"
                                                Command="{Binding Command}"
                                                CommandParameter="{Binding CommandParameter}"
                                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <!-- {Ancestor} walks up to the hosting TitleBar and binds its LIVE
                                                 Foreground, so a command icon follows the same active/inactive color
                                                 as the window buttons (and re-resolves if the tree rebuilds). -->
                                            <Path Data="{Binding Icon}"
                                                    Stroke="{Ancestor TitleBar, Foreground}"
                                                    StrokeThickness="{ResourceReference StrokeThinValue}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- THE draggable zone: icon + title, fills the middle `*` column. Transparent = invisible
                                 but fully hit-testable (hit-testing is decoupled from Background here), so the whole
                                 strip drags. Clips so a long title doesn't spill onto the commands. The command columns
                                 sit outside this element, so their buttons stay clickable. -->
                            <Grid x:Name="PART_DragArea" Grid.Column="3" Background="Transparent" ClipToBounds="True">
                                <!-- Centered, the row stands in the middle of the whole bar: TitleCentering adds the
                                     difference between the sides to the narrower one. -->
                                <Border Margin="{TemplateBinding TitleCentering}">
                                    <StackPanel x:Name="PART_TitleRow"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="{TemplateBinding TitleAlignment}"
                                            Margin="{ResourceReference TitleBarTitleInset}">
                                        <!-- The gap AFTER the icon, which is not the strip's inset before it - two
                                             different jobs, so two metrics. -->
                                        <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}"
                                                VerticalAlignment="Center" Margin="{ResourceReference TitleBarIconGap}"/>
                                        <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}"
                                                Foreground="{ObservableResource TextFillColorSecondary}"
                                                FontSize="{TemplateBinding FontSize}"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- RIGHT zone (interactive): right commands + "..." overflow menu + the window buttons. -->
                            <StackPanel x:Name="PART_RightCluster" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch">
                                <ItemsControl ItemsSource="{TemplateBinding RightWindowCommands}" VerticalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="CaptionButton" VerticalAlignment="Stretch"
                                                    ToolTip="{Binding ToolTip}"
                                                    Command="{Binding Command}"
                                                    CommandParameter="{Binding CommandParameter}"
                                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                                    AutomationProperties.Name="{Binding Label}">
                                                <Path Data="{Binding Icon}"
                                                        Stroke="{Ancestor TitleBar, Foreground}"
                                                        StrokeThickness="{ResourceReference StrokeThinValue}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Drops a list, so the second press has to put it away - but a Button, not a
                                     ToggleButton: Button.CaptionButton would not name a ToggleButton (they are siblings
                                     under ButtonBase) and it would fall back to the default toggle look. -->
                                <Button x:Name="PART_RightOverflowButton" Classes="CaptionButton" VerticalAlignment="Stretch">
                                    <Path Data="M0,4 L2,4 L2,6 L0,6 Z M4,4 L6,4 L6,6 L4,6 Z M8,4 L10,4 L10,6 L8,6 Z"
                                            Fill="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <ContextMenu x:Name="PART_RightOverflowMenu"
                                        ItemsSource="{TemplateBinding RightWindowCommands}">
                                    <ContextMenu.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OverflowLabel}"/>
                                        </DataTemplate>
                                    </ContextMenu.ItemTemplate>
                                    <ContextMenu.ItemContainerStyle>
                                        <Style Selector="MenuItem">
                                            <Setter Property="Command" Value="{Binding Command}"/>
                                            <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                                            <Setter Property="Icon">
                                                <Setter.Value>
                                                    <!-- The ROW's foreground: a popup is a detached subtree, so
                                                         {Ancestor} cannot reach the TitleBar from here. -->
                                                    <Path x:Shared="False"
                                                            Data="{Binding Icon}"
                                                            Stroke="{Ancestor MenuItem, Foreground}"
                                                            StrokeThickness="{ResourceReference StrokeThinValue}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>

                                <!-- The gutter: where the application's buttons end and the window's begin. -->
                                <Border x:Name="PART_CaptionGutter"
                                        Width="{ResourceReference StrokeThinValue}"
                                        Margin="{ResourceReference TitleBarGutterMargin}"
                                        Background="{ResourceReference ControlStrokeColorDefault}"/>
                            </StackPanel>

                            <!-- Window buttons with vector Path icons, Focusable="False" on the parts; a Grid so triggers
                                 can reorder them by column. -->
                            <Grid x:Name="PART_ButtonsPanel" Grid.Column="5" ColumnDefinitions="Auto,Auto,Auto"
                                    VerticalAlignment="Stretch">
                                    <Button x:Name="PART_MinButton" Grid.Column="0" Classes="CaptionButton" Focusable="False" Height="{TemplateBinding Height}">
                                        <Path Data="M0,5 L10,5"
                                                Stroke="{TemplateBinding Foreground}"
                                                StrokeThickness="{ResourceReference StrokeThinValue}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <!-- Maximize <-> restore: two overlaid glyphs, only one shown; the
                                         IsWindowMaximized trigger swaps their Opacity. -->
                                    <Button x:Name="PART_MaxButton" Grid.Column="1" Classes="CaptionButton" Focusable="False" Height="{TemplateBinding Height}">
                                        <Grid>
                                            <Path x:Name="MaximizeGlyph" Data="M0,0 L10,0 L10,10 L0,10 Z"
                                                    Stroke="{TemplateBinding Foreground}"
                                                    StrokeThickness="{ResourceReference StrokeThinValue}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path x:Name="RestoreGlyph" Data="M0,3 L7,3 L7,10 L0,10 Z M3,3 L3,0 L10,0 L10,7 L7,7"
                                                    Stroke="{TemplateBinding Foreground}"
                                                    StrokeThickness="{ResourceReference StrokeThinValue}" Opacity="0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="PART_CloseButton" Grid.Column="2" Classes="CaptionButton CloseButton" Focusable="False" Height="{TemplateBinding Height}">
                                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                                                Stroke="{TemplateBinding Foreground}"
                                                StrokeThickness="{ResourceReference StrokeThinValue}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TitleBar">
        <!-- Buttons on the LEFT (macOS, and Ubuntu since Unity). Three things move together, and all three matter:
             the panel goes to the far-left column; the ORDER reverses, because closing stays OUTERMOST on either side
             (right: min, max, close - left: close, min, max); and the gutter that separates the application's buttons
             from the window's is no longer between them, so it goes away. -->
        <PropertyTrigger Property="CaptionButtonPlacement" Value="Left">
            <Setter TargetName="PART_ButtonsPanel" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_CloseButton" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_MinButton" Property="Grid.Column" Value="1"/>
            <Setter TargetName="PART_MaxButton" Property="Grid.Column" Value="2"/>
            <Setter TargetName="PART_CaptionGutter" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>

        <PropertyTrigger Property="ShowMinButton" Value="false">
            <Setter TargetName="PART_MinButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowMaxRestoreButton" Value="false">
            <Setter TargetName="PART_MaxButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowCloseButton" Value="false">
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowTitle" Value="false">
            <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowIcon" Value="false">
            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- No right commands -> hide the "..." overflow button so an empty caption doesn't show an orphaned button. -->
        <PropertyTrigger Property="HasRightWindowCommands" Value="false">
            <Setter TargetName="PART_RightOverflowButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Maximized: hide the single-square glyph, show the overlapping-squares one. A trigger overrides the local
             Opacity defaults, so the swap applies both ways. -->
        <PropertyTrigger Property="IsWindowMaximized" Value="true">
            <Setter TargetName="MaximizeGlyph" Property="Opacity" Value="0"/>
            <Setter TargetName="RestoreGlyph" Property="Opacity" Value="1"/>
        </PropertyTrigger>
    </Style>

    <!-- Caption buttons: the base Button template, flattened. Click-only, so not focus targets. -->
    <Style Selector="Button.CaptionButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="{ResourceReference TitleBarButtonWidth}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- The one place in the chrome that shouts, and it comes from the palette rather than a literal: a theme that
         hard-codes a color cannot answer for its own light variant. -->
    <Style Selector="Button.CloseButton">
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference CloseButtonFillPointerOver}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference CloseButtonFillPressed}"/>
    </Style>

</StyleSet>
