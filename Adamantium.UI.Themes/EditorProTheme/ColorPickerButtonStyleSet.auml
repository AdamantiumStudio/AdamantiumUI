<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A square swatch chip with a hairline frame for property rows. The popup content binds two-way via a logical
         {Ancestor}, since popups have no visual path. -->

    <Style Selector="ColorPickerButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorPickerButton">
                    <Grid>
                        <Border x:Name="PART_Header"
                                CornerRadius="0"
                                Background="{ResourceReference ControlFillColorDefault}"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                BorderThickness="{ResourceReference StrokeThin}"
                                Padding="{ResourceReference ColorSwatchPadding}">
                            <Grid>
                                <Border x:Name="PART_Swatch" Background="{TemplateBinding SelectedBrush}" CornerRadius="0"/>
                                <!-- NO ONE COLOR TO SHOW - see Fluent's set. -->
                                <TextBlock x:Name="PART_Mixed" Text="—" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                                Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <ColorPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay}"/>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ColorPickerButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_Header" Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsIndeterminate" Value="true">
            <Setter TargetName="PART_Swatch" Property="Background" Value="Transparent"/>
            <Setter TargetName="PART_Mixed" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
