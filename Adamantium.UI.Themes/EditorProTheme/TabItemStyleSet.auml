<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Editor Pro's tab: no fill or corners, the current tab marked by the strip's accent rule. Part names match
         Fluent's. Properties, then the template, then the triggers. -->

    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="{ResourceReference TabStripHeight}"/>
        <!-- A tab's own padding, not a row's: the two differ in the vertical pair, and on a folded strip that pair is
             what keeps one turned label off the next. -->
        <Setter Property="Padding" Value="{ResourceReference PaddingTab}"/>
        <!-- A CEILING on the width, which the strip had none of: a tab sizes to its content, so one long title made one
             enormous tab and pushed the rest out of reach. Past this the header trims with an ellipsis. Set
             TabPanel.ItemWidth to make every tab the same width instead. -->
        <Setter Property="MaxWidth" Value="240"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <!-- A line tab has no card behind it. Fluent's IsSelected trigger still runs and still writes this brush onto
             the border - it just has nothing to paint. -->
        <Setter Property="BackgroundSelected" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorTertiary}"/>
        <Setter Property="ForegroundSelected" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- No rule per item: the tab control's sliding PART_SelectionIndicator is the one mark
                         (SelectionIndicatorThickness from this theme's metrics). -->
                    <Grid>
                        <Border x:Name="TabBorder"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <!-- Same shape as Fluent's inner grid, and for the same reason: the starred middle track
                                 keeps the close button against the right edge when a lone tab is stretched. -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                <ContentPresenter x:Name="PART_Icon" Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Margin="0 0 4 0"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"/>
                                <ContentPresenter
                                        x:Name="PART_ContentPresenter" Grid.Column="1"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        TextTrimming="CharEllipses"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"/>
                                <Ellipse x:Name="DirtyMark" Grid.Column="2"
                                        Width="6" Height="6"
                                        Margin="4 0 0 0"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding Foreground}"
                                        Visibility="Collapsed"/>
                                <ToggleButton x:Name="PART_PinButton" Grid.Column="3"
                                        AutomationProperties.AutomationId="PinTab"
                                        AutomationProperties.Name="{Localize TabStrings.PinTab}"
                                        Template="{TemplateBinding PinButtonTemplate}"
                                        Margin="4 0 0 0"
                                        MinWidth="0" MinHeight="0" Padding="0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                                <Button x:Name="PART_CloseButton" Grid.Column="4"
                                        AutomationProperties.AutomationId="CloseTab"
                                        AutomationProperties.Name="{Localize TabStrings.CloseTab}"
                                        Template="{TemplateBinding CloseButtonTemplate}"
                                        Margin="4 0 0 0"
                                        MinWidth="0" MinHeight="0" Padding="0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- The tab's states (hover, close button, icon slot, current), owned here with the template. -->
    <Style Selector="TabItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="TabBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <!-- The icon slot exists only when there is an icon to put in it: an always-reserved gutter would inset every
             label in a strip where most tabs have no icon at all. -->
        <PropertyTrigger Property="HasIcon" Value="true">
            <Setter TargetName="PART_Icon" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="TabBorder" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </PropertyTrigger>
        <!-- Close button: Collapsed when off, Hidden (space reserved) when idle, Visible on hover or selection; later
             triggers override the Hidden. -->
        <PropertyTrigger Property="ShowCloseButton" Value="true">
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowCloseButton" Value="true"/>
                <Condition Property="IsMouseOver" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowCloseButton" Value="true"/>
                <Condition Property="IsSelected" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <!-- The pin button follows the same rule, with one addition: on a PINNED tab it is always visible, because it
             is the only way back and a button you have to hunt for is not one. -->
        <PropertyTrigger Property="ShowPinButton" Value="true">
            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Hidden"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowPinButton" Value="true"/>
                <Condition Property="IsMouseOver" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowPinButton" Value="true"/>
                <Condition Property="IsSelected" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowPinButton" Value="true"/>
                <Condition Property="IsPinned" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
    </Style>

    <!-- A lone stretched tab stays an ordinary tab (no accent fill), stated explicitly for this theme. -->
    <Style Selector="TabItem[IsStretched=true]">
        <Setter Property="BackgroundSelected" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

</StyleSet>
