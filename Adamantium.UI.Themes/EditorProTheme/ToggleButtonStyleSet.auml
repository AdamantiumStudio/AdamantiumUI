<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Editor Pro's toggle: a hairline outline at rest like the button; checked keeps its text color and adds a subtle
         fill plus a bottom accent rule, like the tab strip. -->

    <Style Selector="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>

        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference SubtleFillColorTertiary}"/>
        <Setter Property="BackgroundDisabled" Value="Transparent"/>
        <Setter Property="ForegroundPressed" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="ForegroundDisabled" Value="{ObservableResource TextFillColorDisabled}"/>
        <!-- The CHECKED fill as a brush rather than a value written into the trigger - see the Fluent set. -->
        <Setter Property="BackgroundChecked" Value="{ResourceReference SubtleFillColorSecondary}"/>

        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- Two rows, as the tab: the mark lives under the content and never moves it. -->
                    <Grid RowDefinitions="*,Auto">
                        <Border x:Name="InnerBorder" Grid.Row="0"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                    x:Name="PART_ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Border>

                        <Border x:Name="CheckedRule" Grid.Row="1"
                                Height="{ResourceReference StrokeAccentValue}"
                                Background="{ThemeResource AccentFillColorDefault}"
                                Visibility="Hidden"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
            <!-- The outline BRIGHTENS rather than appearing: it is already there at rest. -->
            <Setter TargetName="InnerBorder" Property="BorderBrush"
                    Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundPressed}"/>
        </PropertyTrigger>
        <!-- Held down: the fill stays and the rule appears. The label keeps its own colour - nothing accent-coloured is
             behind it. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundChecked}"/>
            <Setter TargetName="CheckedRule" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundDisabled}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
            <!-- The outline dims with the label: on this theme the outline IS the button. -->
            <Setter TargetName="InnerBorder" Property="BorderBrush"
                    Value="{ResourceReference ControlFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
