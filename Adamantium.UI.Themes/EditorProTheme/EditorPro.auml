<?xml version="1.0" encoding="utf-8" ?>
<Theme xmlns="http://adamantium/ui"
       xmlns:x="http://adamantium/ui/xaml/extensions"
       xmlns:editor="clr-namespace:Adamantium.UI.Themes.EditorProTheme"
       xmlns:fluent="clr-namespace:Adamantium.UI.Themes.FluentTheme"
       xmlns:shared="clr-namespace:Adamantium.UI.Themes.Shared"
       Name="EditorPro"
       SystemLightVariant="Light"
       SystemDarkVariant="Dark"
       ResourceContext.Scope="Theme">

  <!-- The editor skin: dense rows, small type, tight radii, hairlines, muted blue-grey. All sizes live in its Metrics and
       all colors come from the palette by key, so its dark and light variants share every template. -->

  <!-- Dark first: it is what an editor is usually set to, and order is what says which one it opens on. -->

  <ResourceContext.Resources>
    <!-- Its own numbers, and - for now - Fluent's SHAPES. An icon is geometry; its colour comes from the palette by
         key, and this theme answers the same key names. Editor Pro will want sharper, smaller icons of its own, and
         that is a separate piece of work from the skin. -->
    <ResourceLink Source="{x:Type editor:Metrics}"/>
    <!-- FIRST - see Fluent's. The canvas's pictures belong to no theme. -->
    <ResourceLink Source="{x:Type shared:CanvasIcons}"/>
    <!-- ...and what its inspector SHOWS - see the note in Fluent's: content, shared by all three. -->
    <ResourceLink Source="{x:Type shared:CanvasInspectorContent}"/>
    <ResourceLink Source="{x:Type fluent:Icons}"/>
  </ResourceContext.Resources>

  <Theme.Variants>
    <editor:EditorProDark/>
    <editor:EditorProLight/>
  </Theme.Variants>

  <!-- A theme answers for EVERY control in the application: styles come only from the current theme, and a control
       with no styled ancestor gets no template and draws nothing. Every one of those answers is now THIS theme's own -
       not one style is borrowed from Fluent any more. -->
  <Theme.StyleIncludes>
    <!-- These sets define this theme's shapes; density comes from Metrics. Busy indicators and the ribbon keep Fluent's
         forms and change only tempo and grounds. -->
    <StyleInclude Source="{x:Type editor:ButtonStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ToggleButtonStyleSet}"/>
    <StyleInclude Source="{x:Type editor:RepeatButtonStyleSet}"/>
    <StyleInclude Source="{x:Type editor:TextBoxStyleSet}"/>
    <StyleInclude Source="{x:Type editor:CheckBoxStyleSet}"/>
    <StyleInclude Source="{x:Type editor:RadioButtonStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ToggleSwitchStyleSet}"/>
    <StyleInclude Source="{x:Type editor:DropDownStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ExpanderStyleSet}"/>
    <StyleInclude Source="{x:Type editor:PropertyGridStyleSet}"/>
    <StyleInclude Source="{x:Type editor:NumericUpDownStyleSet}"/>
    <StyleInclude Source="{x:Type editor:DataPagerStyleSet}"/>
    <StyleInclude Source="{x:Type editor:DataGridStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ProgressBarStyleSet}"/>
    <StyleInclude Source="{x:Type editor:SliderStyleSet}"/>
    <StyleInclude Source="{x:Type editor:RangeSliderStyleSet}"/>
    <StyleInclude Source="{x:Type editor:GridSplitterStyleSet}"/>
    <StyleInclude Source="{x:Type editor:SelectionAdornerStyleSet}"/>
    <StyleInclude Source="{x:Type editor:HoverAdornerStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ListBoxStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ListBoxItemStyleSet}"/>
    <StyleInclude Source="{x:Type editor:DropDownItemStyleSet}"/>
    <StyleInclude Source="{x:Type editor:TabControlStyleSet}"/>
    <StyleInclude Source="{x:Type editor:TabItemStyleSet}"/>
    <StyleInclude Source="{x:Type editor:BusyIndicatorStyleSet}"/>
    <StyleInclude Source="{x:Type editor:RibbonStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ThumbStyleSet}"/>
    <StyleInclude Source="{x:Type editor:TextBlockStyleSet}"/>
    <StyleInclude Source="{x:Type editor:BorderStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ContentControlStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ItemsControlStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ScrollViewerStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ZoomBoxStyleSet}"/>
    <!-- The canvas AND everything that only exists inside one - see Fluent's list. -->
    <StyleInclude Source="{x:Type editor:InfiniteCanvasStyleSet}"/>
    <StyleInclude Source="{x:Type editor:RingProgressBarStyleSet}"/>
    <StyleInclude Source="{x:Type editor:KeyTipAdornerStyleSet}"/>
    <StyleInclude Source="{x:Type editor:SlidePanelStyleSet}"/>
    <StyleInclude Source="{x:Type editor:OverlayWindowStyleSet}"/>
    <StyleInclude Source="{x:Type editor:TilesHostStyleSet}"/>
    <StyleInclude Source="{x:Type editor:FlipTileStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ColorPickerStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ColorPickerButtonStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ColorWheelStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ToolTipStyleSet}"/>
    <StyleInclude Source="{x:Type editor:FocusAdornerStyleSet}"/>
    <StyleInclude Source="{x:Type editor:DropInsertionIndicatorStyleSet}"/>
    <StyleInclude Source="{x:Type editor:DragHandleStyleSet}"/>
    <StyleInclude Source="{x:Type editor:TitleBarStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ResizeGripperStyleSet}"/>
    <StyleInclude Source="{x:Type editor:WindowStyleSet}"/>
    <StyleInclude Source="{x:Type editor:DockingStyleSet}"/>
    <StyleInclude Source="{x:Type editor:ScrollBarStyleSet}"/>
    <StyleInclude Source="{x:Type editor:TreeViewStyleSet}"/>
    <StyleInclude Source="{x:Type editor:MenuStyleSet}"/>
  </Theme.StyleIncludes>
</Theme>
