<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Editor Pro's field: a rule under the text (its own element, so it thickens without moving the text) that takes
         the accent on focus, when the ground lifts a step. -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <!-- Carries the two vertical pixels that keep the descenders and the caret off the rule below. -->
        <Setter Property="Padding" Value="{ResourceReference PaddingFieldFlat}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <!-- Caret and placeholder brushes the control draws itself; every theme must set them or the gray/white defaults
             apply. The floating label turns accent on focus. -->
        <Setter Property="PlaceholderForeground" Value="{ResourceReference TextFillColorTertiary}"/>
        <Setter Property="FloatingPlaceholderForeground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="CaretBrush" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- Two rows: the text, and the rule under it. The rule is a row rather than a border so it can
                         thicken on focus without the text shifting - a border that grows eats its own padding. -->
                    <Grid RowDefinitions="*,Auto">
                        <Border x:Name="PART_Border" Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                <TextPresenter x:Name="PART_TextPresenter"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="Rule" Grid.Row="1"
                                Height="{ResourceReference StrokeThinValue}"
                                Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <!-- Focus last, so it wins the rule over hover. -->
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Rule" Property="Height" Value="{ResourceReference StrokeAccentValue}"/>
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_TextPresenter" Property="Foreground"
                    Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
