<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <Description>Themes of Adamantium UI - Fluent, Graphite and macOS - with a style for every control, in light and dark variants.</Description>
        <PackageTags>adamantium;ui;themes;styles;fluent</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.UI.Controls\Adamantium.UI.Controls.csproj" />
        <ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
        <ProjectReference Include="..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Adamantium.UI.Core\Adamantium.UI.Core.csproj" OutputItemType="Analyzer" />
    </ItemGroup>

    <ItemGroup>
        <AdamantiumEngineReference Include="Adamantium.Core" />
        <AdamantiumEngineReference Include="Adamantium.Core.Shared" GeneratePathProperty="true" />
        <AdamantiumEngineReference Include="Adamantium.Mathematics" />
        <!-- What the source generator above loads: Core.Shared, analyzer-only - the assembly itself comes above. -->
        <AdamantiumEngineReference Include="Adamantium.Core.Shared" Role="NetStandardAnalyzer" />
    </ItemGroup>

    <!-- The same analyzer dep, taken from the package. -->
    <ItemGroup Condition="'$(UseEngineSource)' != 'true'">
        <Analyzer Include="$(PkgAdamantium_Core_Shared)\lib\netstandard2.0\Adamantium.Core.Shared.dll" Condition="'$(PkgAdamantium_Core_Shared)' != ''" />
    </ItemGroup>

    <!-- The themes' strings: language tables (Localization\*.alang) the themes name in {Localize}. -->
    <ItemGroup>
        <AdditionalFiles Include="$(ProjectDir)**\*.auml" />
        <AdditionalFiles Include="$(ProjectDir)**\*.alang" />
        <CompilerVisibleProperty Include="RootNamespace" />
        <CompilerVisibleProperty Include="NeutralLanguage" />
        <CompilerVisibleProperty Include="OutputType" />
    </ItemGroup>

</Project>
