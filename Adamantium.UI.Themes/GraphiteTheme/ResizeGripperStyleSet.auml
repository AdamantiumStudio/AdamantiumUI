<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The corner resize grip: the whole transparent box is the hit region (ResizeGripRect). Three tertiary diagonal
         hairlines instead of Fluent's dots. -->

    <Style Selector="ResizeGripper">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ResizeGripper">
                    <Border Background="Transparent">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="{ResourceReference ResizeGripInset}"
                              Stroke="{ResourceReference TextFillColorTertiary}"
                              StrokeThickness="{ResourceReference StrokeThinValue}"
                              Data="M14,4 L4,14 M14,9 L9,14 M14,14 L13,15"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
