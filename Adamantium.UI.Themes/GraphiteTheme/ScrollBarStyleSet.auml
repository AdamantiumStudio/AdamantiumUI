<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Graphite's scrollbar: thin, square, in a recessed channel that shows the extent the thumb is read against.
         Thickness is set via ScrollBar.BarThickness, not Width. -->

    <Style Selector="ScrollBar">
        <Setter Property="BarThickness" Value="{ResourceReference ScrollBarThickness}"/>
        <!-- This theme's own rule, stated in its palette: the fill sits nearly on the ground and the STROKE is what
             says where the control is. A 4%-white channel alone would not read on a #14181D panel. -->
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <Track x:Name="PART_Track"
                                Orientation="{TemplateBinding Orientation}"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value}"
                                ViewportSize="{TemplateBinding ViewportSize}">
                            <!-- The paging areas stay: they are invisible but hit-testable, and clicking the empty
                                 channel to page is expected even when the channel is not drawn. -->
                            <Track.DecreaseRepeatButton>
                                <ScrollBarPageButton Focusable="false"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <ScrollBarPageButton Focusable="false"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
