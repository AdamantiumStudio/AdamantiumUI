<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The shared scroll Thumb, square like its trough. Sliders supply their own Thumb.Template inline. -->

    <Style Selector="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="0" Background="{ResourceReference TextFillColorTertiary}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
