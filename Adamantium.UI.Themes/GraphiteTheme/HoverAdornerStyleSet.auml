<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The hover frame: a square hairline, distinct in kind from the selection frame, which adds corner handles. -->

    <Style Selector="HoverAdorner">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HoverAdorner">
                    <Border BorderThickness="{ResourceReference AdornerHoverThickness}"
                            CornerRadius="0"
                            BorderBrush="{ResourceReference ControlStrokeColorSecondary}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
