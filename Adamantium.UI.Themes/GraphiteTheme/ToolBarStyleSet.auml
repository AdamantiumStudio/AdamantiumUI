<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The editor's tray: dense rows with a hairline under them. Its menu holds the bars by name - the tray adds them
         when it opens - and the switch that locks them. -->
    <Style Selector="ToolBarTray">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="BarsHeader" Value="{Localize ToolBarStrings.Bars}"/>
        <Setter Property="ContextualBarsHeader" Value="{Localize ToolBarStrings.ContextualBars}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <ToolBarTrayPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu x:Shared="False">
                    <MenuItem Header="{Localize ToolBarStrings.LockToolBars}"
                              Command="{x:Static ToolBarTray.LockCommand}"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBarTray">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A bar's grip: two hairline rules, the editor's grip - tertiary at rest, primary under the pointer, as a row's drag
         handle is. -->
    <Style Selector="Thumb.ToolBarGrip">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorTertiary}"/>
        <!-- Room between the grip and the first command; under it on a bar down the side. -->
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              Data="M0,0 L1,0 L1,12 L0,12 Z M3,0 L4,0 L4,12 L3,12 Z"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Thumb.ToolBarGrip">
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        </PropertyTrigger>
    </Style>

    <!-- A bar: no card of its own - the bars are told apart by a hairline after each, as the editor's panes are. -->
    <Style Selector="ToolBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Accent" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="1,1,3,1"/>
        <Setter Property="Margin" Value="0,0,3,1"/>
        <Setter Property="OverflowButtonLength" Value="{ResourceReference ToolBarOverflowButtonLength}"/>
        <Setter Property="Spacing" Value="{ResourceReference ToolBarSpacing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- A contextual bar's wash: its context's accent, faint, behind the whole bar. -->
                            <Border x:Name="ContextualWash" Background="{TemplateBinding Accent}"
                                    Opacity="{ResourceReference ToolBarContextualWashOpacity}" Visibility="Collapsed"/>
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <!-- The grip: drawn by Thumb.ToolBarGrip below. -->
                                <Thumb x:Name="PART_Grip"
                                       Classes="ToolBarGrip"
                                       DockPanel.Dock="Left"
                                       Width="{ResourceReference ToolBarGripLength}"
                                       Cursor="SizeAll"
                                       AutomationProperties.Name="{Localize ToolBarStrings.Grip}"/>
                                <ToggleButton x:Name="PART_OverflowButton"
                                              DockPanel.Dock="Right"
                                              Width="{TemplateBinding OverflowButtonLength}"
                                              MinWidth="0"
                                              Padding="0"
                                              Visibility="Collapsed"
                                              IsChecked="{TemplateBinding IsOverflowOpen, Mode=TwoWay}"
                                              ToolTip="{Localize ToolBarStrings.MoreCommands}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              AutomationProperties.Name="{Localize ToolBarStrings.MoreCommands}">
                                    <Grid>
                                        <!-- A section a shown context comes from is in the menu: framed in its color,
                                             in the content, so the button's own states draw under it. -->
                                        <Border x:Name="OverflowContextFrame"
                                                BorderBrush="{TemplateBinding OverflowContextAccent}"
                                                BorderThickness="{ResourceReference ToolBarContextFrameThickness}"
                                                CornerRadius="{ResourceReference CornerRadiusDefault}"
                                                Visibility="Collapsed"/>
                                        <Path Data="M0,0 L3,3 L6,0"
                                              Stroke="{ResourceReference TextFillColorSecondary}" StrokeThickness="1"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                                <!-- A contextual bar's context, named as the ribbon names it: the same label. -->
                                <RibbonContextualLabel x:Name="ContextualHeaderLabel"
                                                       DockPanel.Dock="Left"
                                                       Margin="0,0,3,0"
                                                       Visibility="Collapsed"
                                                       Accent="{TemplateBinding Accent}"
                                                       Content="{TemplateBinding ContextualHeader}"
                                                       ContentTemplate="{TemplateBinding ContextualHeaderTemplate}"/>
                                <ToolBarPanel x:Name="PART_Items" Spacing="{TemplateBinding Spacing}"
                                            Orientation="{TemplateBinding Orientation}"
                                            VerticalAlignment="Center"/>
                                <Popup x:Name="PART_OverflowPopup"
                                       Placement="Bottom"
                                       PlacementAlignment="End"
                                       KeepOpen="False"
                                       IgnoreTargetPress="True"
                                       IsOpen="{TemplateBinding IsOverflowOpen, Mode=TwoWay}">
                                    <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1"
                                            Padding="2">
                                        <StackPanel x:Name="PART_OverflowItems" Spacing="{TemplateBinding Spacing}"
                                                    Orientation="{TemplateBinding Orientation}"/>
                                    </Border>
                                </Popup>
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToolBar">
        <PropertyTrigger Property="HasOverflowItems" Value="true">
            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ToolBarTray.IsLocked" Value="true">
            <Setter TargetName="PART_Grip" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Orientation" Value="Vertical">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter TargetName="PART_Grip" Property="DockPanel.Dock" Value="Top"/>
            <Setter TargetName="PART_Grip" Property="Width" Value="NaN"/>
            <Setter TargetName="PART_Grip" Property="Height" Value="{ResourceReference ToolBarGripLength}"/>
            <Setter TargetName="PART_Grip" Property="Margin" Value="0,0,0,3"/>
            <Setter TargetName="PART_OverflowButton" Property="DockPanel.Dock" Value="Bottom"/>
            <Setter TargetName="PART_OverflowButton" Property="Width" Value="NaN"/>
            <Setter TargetName="PART_OverflowButton" Property="Height" Value="{TemplateBinding OverflowButtonLength}"/>
            <Setter TargetName="PART_Items" Property="VerticalAlignment" Value="Stretch"/>
            <Setter TargetName="PART_Items" Property="HorizontalAlignment" Value="Center"/>
            <Setter TargetName="PART_OverflowPopup" Property="Placement" Value="Right"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsMoving" Value="true">
            <Setter Property="Opacity" Value="0.8"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsContextual" Value="true">
            <Setter TargetName="ContextualWash" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- A section a shown context comes from is in the menu: the chevron framed in that context's color. -->
        <PropertyTrigger Property="HasContextInOverflow" Value="true">
            <Setter TargetName="OverflowContextFrame" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- Named along a bar; down the side only its color says it, until bars there get a form of their own. -->
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="HasContextualHeader" Value="true"/>
                <Condition Property="Orientation" Value="Horizontal"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="ContextualHeaderLabel" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
    </Style>

    <!-- A section of a bar: a rule before it where a command stands before it, then its commands along the bar. -->
    <Style Selector="ToolBarGroup">
        <Setter Property="Accent" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- Not virtualized: commands of different widths, each its own, not a cell sized by the first. -->
                    <StackPanel Orientation="{TemplateBinding Orientation}" Spacing="{ResourceReference ToolBarSpacing}"
                                IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBarGroup">
                    <StackPanel Orientation="{TemplateBinding Orientation}">
                        <Separator x:Name="PART_Separator" Orientation="Vertical" Visibility="Collapsed"/>
                        <!-- Where a shown context comes from: washed and framed in its color, just past the commands,
                             so turning it on moves nothing. -->
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="ContextWash" Margin="-2" Background="{TemplateBinding Accent}"
                                    CornerRadius="{ResourceReference ToolBarContextFrameRadius}"
                                    Opacity="{ResourceReference ToolBarContextualWashOpacity}" Visibility="Collapsed"/>
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                            <Border x:Name="ContextFrame" Margin="-2" BorderBrush="{TemplateBinding Accent}"
                                    BorderThickness="{ResourceReference ToolBarContextFrameThickness}"
                                    CornerRadius="{ResourceReference ToolBarContextFrameRadius}"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToolBarGroup">
        <PropertyTrigger Property="ShowsSeparator" Value="true">
            <Setter TargetName="PART_Separator" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- Beginning a line of a bar that wraps: the rule hidden, its room kept, so the lines break as they did. -->
        <PropertyTrigger Property="BeginsLine" Value="true">
            <Setter TargetName="PART_Separator" Property="Visibility" Value="Hidden"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Orientation" Value="Vertical">
            <Setter TargetName="PART_Separator" Property="Orientation" Value="Horizontal"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsInContext" Value="true">
            <Setter TargetName="ContextWash" Property="Visibility" Value="Visible"/>
            <Setter TargetName="ContextFrame" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
