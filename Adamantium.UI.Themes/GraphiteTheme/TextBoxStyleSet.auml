<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Graphite's field: a rule under the text (its own element, so it thickens without moving the text) that takes
         the accent on focus, when the ground lifts a step. -->

    <Style Selector="TextBox, PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <!-- Carries the two vertical pixels that keep the descenders and the caret off the rule below. -->
        <Setter Property="Padding" Value="{ResourceReference PaddingFieldFlat}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <!-- Caret and placeholder brushes the control draws itself; every theme must set them or the gray/white defaults
             apply. The floating label turns accent on focus. -->
        <Setter Property="PlaceholderForeground" Value="{ResourceReference TextFillColorTertiary}"/>
        <Setter Property="FloatingPlaceholderForeground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="CaretBrush" Value="{ResourceReference TextFillColorPrimary}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="ClearButtonToolTip" Value="{Localize TextBoxStrings.Clear}"/>
    </Style>

    <!-- The editing menu, one per box (x:Shared): a menu points at the box it opens on. Spelling rows come above these
         while the spelling is checked. -->
    <Style Selector="TextBox">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu x:Shared="False">
                    <MenuItem Header="{Localize TextBoxStrings.Cut}"
                              Command="{x:Static ApplicationCommands.Cut}"/>
                    <MenuItem Header="{Localize TextBoxStrings.Copy}"
                              Command="{x:Static ApplicationCommands.Copy}"/>
                    <MenuItem Header="{Localize TextBoxStrings.Paste}"
                              Command="{x:Static ApplicationCommands.Paste}"/>
                    <Separator/>
                    <MenuItem Header="{Localize TextBoxStrings.SelectAll}"
                              Command="{x:Static ApplicationCommands.SelectAll}"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- Two rows: the text, and the rule under it. The rule is a row rather than a border so it can
                         thicken on focus without the text shifting - a border that grows eats its own padding. -->
                    <Grid RowDefinitions="*,Auto">
                        <Border x:Name="PART_Border" Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <!-- The clear button takes a column of its own, so the text never runs under it. -->
                            <Grid ColumnDefinitions="*,Auto">
                                <ScrollViewer x:Name="PART_ContentHost"
                                        HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                    <TextPresenter x:Name="PART_TextPresenter"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                                </ScrollViewer>
                                <!-- Not a focus stop: the press leaves the caret in the box. -->
                                <Button x:Name="PART_ClearButton"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        Focusable="False"
                                        Width="16"
                                        Height="16"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        Margin="4 0 0 0"
                                        VerticalAlignment="Center"
                                        ToolTip="{TemplateBinding ClearButtonToolTip}">
                                    <Image Source="{ResourceReference CloseIcon}"
                                           Width="7"
                                           Height="7"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="Rule" Grid.Row="1"
                                Height="{ResourceReference StrokeThinValue}"
                                Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Only while there is something to clear, and the box may be cleared. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowsClearButton" Value="true"/>
                                <Condition Property="HasText" Value="true"/>
                                <Condition Property="IsReadOnly" Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox: the same field, with a reveal button where the text box has its clear button. -->
    <Style Selector="PasswordBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid RowDefinitions="*,Auto">
                        <Border x:Name="PART_Border" Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="*,Auto">
                                <ScrollViewer x:Name="PART_ContentHost"
                                        HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                    <TextPresenter x:Name="PART_TextPresenter"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                                </ScrollViewer>
                                <!-- Not a focus stop: the press leaves the caret in the box. -->
                                <Button x:Name="PART_RevealButton"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        Focusable="False"
                                        Width="16"
                                        Height="16"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        Margin="4 0 0 0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Localize TextBoxStrings.ShowPassword}">
                                    <Image Source="{ResourceReference RevealIcon}"
                                           Width="9"
                                           Height="9"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="Rule" Grid.Row="1"
                                Height="{ResourceReference StrokeThinValue}"
                                Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- While there is something to show, unless the box asks for no button. -->
                        <PropertyTrigger Property="HasPassword" Value="true">
                            <Setter TargetName="PART_RevealButton" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="PasswordRevealMode" Value="Hidden">
                            <Setter TargetName="PART_RevealButton" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox, PasswordBox">
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <!-- Focus last, so it wins the rule over hover. -->
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Rule" Property="Height" Value="{ResourceReference StrokeAccentValue}"/>
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_TextPresenter" Property="Foreground"
                    Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- DateTimeField and DurationField: the same flat field over its rule, its parts side by side where the text box
         has its text. -->
    <Style Selector="DateTimeField, DurationField">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingFieldFlat}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid RowDefinitions="*,Auto">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel x:Name="PART_Segments"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Rule" Grid.Row="1"
                                Height="{ResourceReference StrokeThinValue}"
                                Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DateTimeField, DurationField">
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Rule" Property="Height" Value="{ResourceReference StrokeAccentValue}"/>
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- The pickers: the same flat field over its rule, its button at the end and the card the button opens under it. -->
    <Style Selector="DatePicker, TimePicker, DateTimePicker">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingFieldFlat}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DateTimePickerBase">
                    <Grid RowDefinitions="*,Auto">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel x:Name="PART_Segments"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Classes="DateTimePickerButton"
                                        Focusable="False"
                                        AutomationProperties.Name="{Localize DateTimeFieldStrings.Choose}">
                                    <Image Source="{TemplateBinding ButtonIcon}"
                                           Width="12"
                                           Height="12"/>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       PlacementAlignment="Start"
                                       FlipToFit="True"
                                       VerticalOffset="4"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Rule" Grid.Row="1"
                                Height="{ResourceReference StrokeThinValue}"
                                Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DatePicker, TimePicker, DateTimePicker">
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsDropDownOpen" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="Rule" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Rule" Property="Height" Value="{ResourceReference StrokeAccentValue}"/>
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
