<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A border around a scroll viewer that hosts the items. CanContentScroll delegates scrolling to the virtualizing
         panel (item scrolling, not pixel translation), which is behavior rather than looks and is kept as it is. -->
    <Style Selector="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Where a dragged item will land, inside a list. The same statement this theme's drop caret makes between rows,
         made around a whole slot: a HAIRLINE outline, square, no wash. Fluent uses a two-unit dashed frame; at this
         theme's row height a dashed two-unit frame is thicker than the gap between rows and reads as a filled band. -->
    <Style Selector="ItemsControl">
        <Setter Property="DropPlaceholderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- A Shape, not a Border: the dashes live on Shape.StrokeDashArray. -->
                    <Rectangle IsHitTestVisible="False" Fill="Transparent"
                            StrokeThickness="{ResourceReference StrokeThinValue}"
                            StrokeDashArray="3,2"
                            Stroke="{ThemeResource AccentFillColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The loading skeleton card: filled and breathing (unlike the dashed drop outline). The panel draws this one card at
         every pending slot as a copy, and each copy breathes a little after the one before it (RenderCloneStagger), so
         the breath runs along the cards like a garland. Gentler than Fluent's. -->
    <Style Selector="ItemsControl">
        <Setter Property="ItemSkeletonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- No margin: the PANEL insets the card by the real item's margin, read from a realized row, so the
                         cards line up with the real ones for any list. The fill breathes; the outline over it stays. -->
                    <Grid IsHitTestVisible="False"
                          RenderCloneStagger="0:0:0.08">
                        <Border x:Name="SkeletonFill"
                                CornerRadius="0"
                                Opacity="0.04"
                                Background="{ObservableResource SkeletonPulseFill}"/>
                        <Border CornerRadius="0"
                                BorderThickness="{ResourceReference StrokeThin}"
                                BorderBrush="{ObservableResource ControlStrokeColorDefault}"/>
                    </Grid>
                    <!-- Shown while the list loads, collapsed once it is done: the breath runs exactly as long. -->
                    <DataTemplate.Triggers>
                        <PropertyTrigger Property="Visibility"
                                         Value="Visible">
                            <PropertyTrigger.EnterActions>
                                <RunAnimationAction TargetName="SkeletonFill">
                                    <PulseAnimation Property="Opacity"
                                                    Min="0.04"
                                                    Max="0.11"
                                                    Duration="0:0:1.4"
                                                    Easing="CubicInOut"/>
                                </RunAnimationAction>
                            </PropertyTrigger.EnterActions>
                            <PropertyTrigger.ExitActions>
                                <StopAnimationAction TargetName="SkeletonFill"/>
                            </PropertyTrigger.ExitActions>
                        </PropertyTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
