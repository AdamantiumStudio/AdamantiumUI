<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Graphite's table: flat, no frame, rows at RowHeight; a header bar with sort chevron and funnel; selection is a
         wash (see ListBoxItemStyleSet). -->

    <Style Selector="TreeDataGrid">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusSmall}"/>
        <Setter Property="RowHeight" Value="{ResourceReference RowHeight}"/>
        <Setter Property="NewRowHint" Value="{Localize DataGridStrings.AddRecord}"/>
        <!-- Where a dragged column would land - see Fluent's set. -->
        <Setter Property="DropIndicatorBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeDataGrid">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnDefinitions="*,Auto">
                            <!-- The search strip, at the very top - see the macOS set. -->
                            <DataGridSearchPanel x:Name="PART_SearchPanel" Grid.Row="0" Grid.ColumnSpan="2"
                                                 Visibility="Collapsed"/>

                            <!-- The grouping strip, above the headers - see the macOS set. -->
                            <DataGridGroupPanel x:Name="PART_GroupPanel" Grid.Row="1" Grid.ColumnSpan="2"
                                                Visibility="Collapsed"/>

                            <!-- The sorting strip, between the grouping and the headers - see the macOS set. -->
                            <DataGridSortPanel x:Name="PART_SortPanel" Grid.Row="2" Grid.ColumnSpan="2"
                                               Visibility="Collapsed"/>

                            <!-- The header band is OUTSIDE the scroller: it must not scroll away vertically. Sideways
                                 it follows by hand, from the same offset the rows use. -->
                            <Border Grid.Row="3" Grid.Column="0"
                                    Background="{ObservableResource SolidBackgroundFillColorTertiary}"
                                    BorderBrush="{ObservableResource DataGridLineColor}"
                                    BorderThickness="0 0 0 1">
                                <DataGridHeadersPresenter x:Name="PART_Headers" Height="22"/>
                            </Border>

                            <!-- The rail the chooser's handle stands in - see the Fluent set for why it is a column
                                 rather than something laid over the band. -->
                            <Border Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" x:Name="PART_ChooserRail"
                                    Visibility="Collapsed" Width="20"
                                    Background="{ObservableResource SolidBackgroundFillColorTertiary}"
                                    BorderBrush="{ObservableResource DataGridLineColor}"
                                    BorderThickness="1 0 0 0">
                                <Border x:Name="PART_ChooserButton" Height="22" VerticalAlignment="Top"
                                        Background="Transparent" Cursor="Hand"
                                        ToolTipService.ToolTip="{Localize DataGridStrings.ChooseColumns}">
                                    <Image Source="{ResourceReference ColumnsIcon}" Width="11" Height="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>

                            <!-- Light dismiss - see the Fluent set: this flyout has no buttons, so clicking away is
                                 the only way out. -->
                            <Popup x:Name="PART_ChooserPopup" Grid.Row="3" Grid.Column="1"
                                   KeepOpen="False" IgnoreTargetPress="True"
                                   Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="4" Padding="10">
                                            <DataGridColumnChooser x:Name="PART_ColumnChooser"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>

                            <ScrollViewer Grid.Row="4" Grid.Column="0" x:Name="PART_ScrollHost"
                                          CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                            </ScrollViewer>

                            <!-- The totals, outside the vertical scroller - see the macOS set. -->
                            <!-- The strip a new record is typed into, ABOVE the totals and outside the vertical
                                 scroller: it is not one of the rows, and nobody should have to scroll ten thousand of
                                 them to add one. -->
                            <Border x:Name="PART_NewRowBand" Grid.Row="5" Grid.ColumnSpan="2" Visibility="Collapsed"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{ObservableResource DataGridLineColor}"
                                    BorderThickness="0 1 0 0">
                                <DataGridNewRowPresenter x:Name="PART_NewRow" Height="{TemplateBinding RowHeight}"/>
                            </Border>

                            <Border x:Name="PART_FooterBand" Grid.Row="6" Grid.ColumnSpan="2" Visibility="Collapsed"
                                    Background="{ObservableResource SolidBackgroundFillColorTertiary}"
                                    BorderBrush="{ObservableResource DataGridLineColor}"
                                    BorderThickness="0 1 0 0">
                                <DataGridFooterPresenter x:Name="PART_Footer" Height="20"/>
                            </Border>

                            <!-- Where a dragged column would land - see Fluent's set. -->
                            <Border x:Name="PART_DropIndicator" Grid.Row="3" Grid.RowSpan="2" Grid.Column="0"
                                    Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="{TemplateBinding DropIndicatorBrush}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowSearchPanel" Value="true">
                            <Setter TargetName="PART_SearchPanel" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowGroupPanel" Value="true">
                            <Setter TargetName="PART_GroupPanel" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowSortPanel" Value="true">
                            <Setter TargetName="PART_SortPanel" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanUserChooseColumns" Value="true">
                            <Setter TargetName="PART_ChooserRail" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="HasTotals" Value="true">
                            <Setter TargetName="PART_FooterBand" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowNewItemRow" Value="true">
                            <Setter TargetName="PART_NewRowBand" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- Reports the COLUMNS' width to the scroller, which a row cannot: its desired size is clamped to
                         the viewport it was measured in. -->
                    <DataGridRowsPresenter Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="GridLineBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <!-- The strip's rule is the grid's own setting, on the header's OWN border - see Fluent's set. -->
                    <Border x:Name="HeaderBg" Background="Transparent"
                            BorderBrush="{TemplateBinding GridLineBrush}"
                            BorderThickness="{TemplateBinding GridLineThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <ContentPresenter Grid.Column="0"
                                    x:Name="PART_ContentPresenter"
                                    TextTrimming="CharEllipses"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <!-- The arrow and, from the second key on, which key this column is - see the Fluent set. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="SortGlyph"
                                       Source="{ResourceReference ChevronUpIcon}"
                                       Width="9" Height="9" Margin="6 0 0 0"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="SortLevelText" VerticalAlignment="Center" Margin="2 0 0 0"
                                           Text="{TemplateBinding SortLevelText}"
                                           FontSize="{ResourceReference FontSizeCaption}"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                            </StackPanel>

                            <!-- The funnel answers for its own press (DataGridColumnHeader hooks it), so what reacts is
                                 what is drawn. -->
                            <Border Grid.Column="2" x:Name="PART_FilterButton"
                                    Width="16" Margin="4 0 0 0" Background="Transparent"
                                    CornerRadius="{ResourceReference CornerRadiusSmall}"
                                    Cursor="Hand" Visibility="Collapsed" ToolTipService.ToolTip="{Localize DataGridStrings.Filter}">
                                <Image x:Name="FilterGlyph"
                                       Source="{ResourceReference FilterIcon}"
                                       Width="8" Height="8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Popup Grid.Column="2" x:Name="PART_FilterPopup"
                                   Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                                <Popup.ChildTemplate>
                                    <ControlTemplate TargetType="Popup">
                                        <Border Background="{ResourceReference CardBackgroundFillColorDefault}"
                                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                                BorderThickness="{ResourceReference StrokeThin}"
                                                CornerRadius="{ResourceReference CornerRadiusSmall}"
                                                Padding="8">
                                            <DataGridFilterView x:Name="PART_FilterView"/>
                                        </Border>
                                    </ControlTemplate>
                                </Popup.ChildTemplate>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- PINNED: the strip scrolls under it - see Fluent's set. -->
                        <PropertyTrigger Property="IsFrozen" Value="true">
                            <Setter TargetName="HeaderBg" Property="Background"
                                    Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
                        </PropertyTrigger>
                        <!-- Picked up - see Fluent's set. -->
                        <PropertyTrigger Property="IsDragging" Value="true">
                            <Setter TargetName="HeaderBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                            <Setter TargetName="HeaderBg" Property="Opacity" Value="0.6"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortGlyph" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="CanFilter" Value="true">
                            <Setter TargetName="PART_FilterButton" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <!-- A filtered column says so in the strip - the accent is a theme property, readable here but
                             not from inside an icon's dictionary, so the BUTTON lights up rather than the glyph. -->
                        <PropertyTrigger Property="IsFiltered" Value="true">
                            <Setter TargetName="PART_FilterButton" Property="Background"
                                    Value="{ThemeResource AccentFillColorDefault}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ValidationErrorBrush" Value="{ObservableResource DataGridValidationErrorColor}"/>
    </Style>

    <!-- The zebra: band 1 is tinted, band 0 shows the table's own surface, so an unset AlternationCount changes nothing. -->
    <Style Selector="DataGridRow[AlternationIndex=1]">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
    </Style>

    <!-- A group row takes the band's color, not a stripe of the zebra - see the macOS set. -->
    <Style Selector="DataGridRow[IsGroup=true]">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
    </Style>

    <!-- The keyboard standing ON a caption. A caption holds no cells, so no cell can carry the active look and the ROW
         has to - the same wash the cells take, over the whole of it. -->
    <Style Selector="DataGridRow[IsGroup=true][IsSelected=true]">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorSelection}"/>
    </Style>

    <!-- A fault in the RECORD, not in any one of its cells - a "from" later than a "to". It washes the whole row for
         exactly that reason: marking one of the cells involved would name the wrong culprit. Through the row's own
         brush, so a page that names its color is obeyed here as it is on the cells. -->
    <Style Selector="DataGridRow[HasValidationError=true]">
        <Setter Property="Background" Value="{Self ValidationErrorBrush}"/>
    </Style>

    <!-- The number strip and its corner - see Fluent's set for why it is opaque. -->
    <Style Selector="DataGridRowHeader">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowHeader">
                    <Border x:Name="StripBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ObservableResource DataGridLineColor}"
                            BorderThickness="0 0 1 1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                TextTrimming="CharEllipses"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsSelected" Value="true">
                            <Setter TargetName="StripBg" Property="Background"
                                    Value="{ThemeResource AccentFillColorDefault}"/>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ThemeResource AccentForegroundColor}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="StripBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The handle that opens a record's long form - see the Fluent set for why the sign is a PART. -->
    <Style Selector="DataGridRowDetailsToggle">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowDetailsToggle">
                    <Border x:Name="ToggleBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ObservableResource DataGridLineColor}"
                            BorderThickness="0 0 1 1">
                        <TextBlock x:Name="Sign" Text="+"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsOpen" Value="true">
                            <Setter TargetName="Sign" Property="Text" Value="−"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsBlank" Value="true">
                            <Setter TargetName="Sign" Property="Text" Value=""/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ToggleBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An editor INSIDE A CELL, and only there - see Fluent's set for why. -->
    <Style Selector="TextBox.DataGridEditor">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- The list keeps its own padding - see Fluent's set. -->
    <Style Selector="DropDown.DataGridEditor">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- The theme's own rules - see Fluent's set. -->
        <Setter Property="GridLineBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="SearchMatchBrush" Value="{ObservableResource DataGridSearchMatchColor}"/>
        <Setter Property="ValidationErrorBrush" Value="{ObservableResource DataGridValidationErrorColor}"/>
        <Setter Property="SearchCurrentBrush" Value="{ObservableResource DataGridSearchCurrentColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <!-- The rules ride on the cell's OWN border - see the macOS set for what two extra elements per
                         cell cost. -->
                    <Border x:Name="CellBorder"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding GridLineBrush}"
                            BorderThickness="{TemplateBinding GridLineThickness}"
                            Padding="{TemplateBinding Padding}">
                        <!-- PART_Indent: depth pushes the CONTENT right, never the border above it - that one paints
                             the grid lines and the selection, and shifting it left a hole at the start of the cell. -->
                        <Grid x:Name="PART_Indent" ColumnDefinitions="Auto,*">
                            <!-- The expander's STRIP, on the carrier column only: reserved even where there is nothing
                                 to open, so the rows of one level line up. -->
                            <Border Grid.Column="0" x:Name="PART_Expander"
                                    Width="14" Background="Transparent" Visibility="Collapsed">
                                <Image x:Name="Expander"
                                       Source="{ResourceReference ChevronRightIcon}"
                                       Width="8" Height="8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                    x:Name="PART_ContentPresenter"
                                    TextTrimming="CharEllipses"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Read-only: a faint wash and disabled-weight text. Declared FIRST, so a selection, an error
                             or an edit still wins over it. -->
                        <PropertyTrigger Property="IsReadOnly" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ObservableResource TextFillColorDisabled}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsExpander" Value="true">
                            <Setter TargetName="PART_Expander" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowsExpander" Value="true"/>
                                <Condition Property="HasChildren" Value="true"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <PropertyTrigger Property="IsExpanded" Value="true">
                            <Setter TargetName="Expander" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                        <!-- A WASH, and the content keeps its own colors: a cell holds controls and meanings, and a
                             plate of accent swallows both. -->
                        <!-- FOUND by the search - see the macOS set. -->
                        <PropertyTrigger Property="IsSearchMatch" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{TemplateBinding SearchMatchBrush}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsSelected" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{ThemeResource AccentFillColorSelection}"/>
                        </PropertyTrigger>

                        <!-- ...and the one the search is ON wins even over that - see the macOS set. -->
                        <PropertyTrigger Property="IsCurrentSearchMatch" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{TemplateBinding SearchCurrentBrush}"/>
                        </PropertyTrigger>

                        <!-- A value the column will not accept wins over all of them - see the Fluent set. -->
                        <PropertyTrigger Property="HasValidationError" Value="true">
                            <Setter TargetName="CellBorder" Property="Background"
                                    Value="{TemplateBinding ValidationErrorBrush}"/>
                        </PropertyTrigger>
                        <!-- The ACTIVE cell is outlined, not filled: it sits inside the selection and has to be told
                             apart from it. -->
                        <PropertyTrigger Property="IsActive" Value="true">
                            <Setter TargetName="CellBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="CellBorder" Property="BorderBrush"
                                    Value="{ThemeResource AccentFillColorDefault}"/>
                        </PropertyTrigger>
                        <!-- An editor takes the WHOLE cell: the padding that keeps text off the edge would squeeze it. -->
                        <PropertyTrigger Property="IsEditing" Value="true">
                            <Setter TargetName="CellBorder" Property="Padding" Value="0"/>
                            <!-- ...the whole of it, top to bottom - see Fluent's set. -->
                            <Setter TargetName="PART_ContentPresenter" Property="VerticalAlignment" Value="Stretch"/>
                        </PropertyTrigger>
                        <!-- What the view-model called an error. A MEANING from the model, a color from here. -->
                        <!-- The three meanings a table normally distinguishes. A column states them through
                             StateBinding or works them out with a StateRule; what they LOOK like is decided here, which
                             is the whole reason a rule returns a meaning and not a color. -->
                        <PropertyTrigger Property="State" Value="Error">
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ObservableResource SystemFillColorCritical}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="State" Value="Warning">
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ObservableResource SystemFillColorCaution}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="State" Value="Success">
                            <Setter TargetName="PART_ContentPresenter" Property="Foreground"
                                    Value="{ObservableResource SystemFillColorSuccess}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The filter flyout: the values to tick, then two conditions joined by And/Or, then the buttons that actually
         change the table. Nothing applies while it is being filled in. -->
    <Style Selector="DataGridFilterView">
        <Setter Property="Width" Value="236"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridFilterView">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="PART_SelectAll" Content="{Localize DataGridStrings.SelectAll}" Margin="0 0 0 6"/>

                        <!-- The list CLIPS: a virtualized list arranges a row or two beyond its viewport, and in a
                             flyout there is nothing behind them. -->
                        <Border BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                                BorderThickness="{ResourceReference StrokeThin}"
                                CornerRadius="{ResourceReference CornerRadiusSmall}"
                                Padding="2" ClipToBounds="True">
                            <ListBox x:Name="PART_Values" MaxHeight="170" ClipToBounds="True"
                                     BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="{Localize DataGridStrings.FilterValues}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Content="{Binding Text}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="{Localize DataGridStrings.ShowRowsWhere}" Margin="0 8 0 4"
                                   Foreground="{ObservableResource TextFillColorSecondary}"/>

                        <!-- One item per DataGridFilterOperator, in its order - see the Fluent set. -->
                        <DropDown x:Name="PART_FirstOperator" Margin="0 0 0 4"
                                  AutomationProperties.Name="{Localize DataGridStrings.FirstCondition}">
                            <DropDownItem Content="{Localize DataGridStrings.IsEqualTo}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsNotEqualTo}"/>
                            <DropDownItem Content="{Localize DataGridStrings.Contains}"/>
                            <DropDownItem Content="{Localize DataGridStrings.DoesNotContain}"/>
                            <DropDownItem Content="{Localize DataGridStrings.StartsWith}"/>
                            <DropDownItem Content="{Localize DataGridStrings.EndsWith}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsGreaterThan}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsLessThan}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsEmpty}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsNotEmpty}"/>
                        </DropDown>
                        <!-- aA = match case, beside the field it applies to. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 4">
                            <TextBox Grid.Column="0" x:Name="PART_FirstValue"
                                     AutomationProperties.Name="{Localize DataGridStrings.FirstValue}"/>
                            <ToggleButton Grid.Column="1" x:Name="PART_FirstMatchCase" Content="aA"
                                          AutomationProperties.Name="{Localize DataGridStrings.FirstMatchCase}"
                                          Margin="4 0 0 0" MinWidth="30" ToolTipService.ToolTip="{Localize DataGridStrings.MatchCase}"/>
                        </Grid>
                        <DropDown x:Name="PART_Logic" Margin="0 0 0 4"
                                  AutomationProperties.Name="{Localize DataGridStrings.ConditionLogic}">
                            <DropDownItem Content="{Localize DataGridStrings.And}"/>
                            <DropDownItem Content="{Localize DataGridStrings.Or}"/>
                        </DropDown>
                        <DropDown x:Name="PART_SecondOperator" Margin="0 0 0 4"
                                  AutomationProperties.Name="{Localize DataGridStrings.SecondCondition}">
                            <DropDownItem Content="{Localize DataGridStrings.IsEqualTo}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsNotEqualTo}"/>
                            <DropDownItem Content="{Localize DataGridStrings.Contains}"/>
                            <DropDownItem Content="{Localize DataGridStrings.DoesNotContain}"/>
                            <DropDownItem Content="{Localize DataGridStrings.StartsWith}"/>
                            <DropDownItem Content="{Localize DataGridStrings.EndsWith}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsGreaterThan}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsLessThan}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsEmpty}"/>
                            <DropDownItem Content="{Localize DataGridStrings.IsNotEmpty}"/>
                        </DropDown>
                        <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                            <TextBox Grid.Column="0" x:Name="PART_SecondValue"
                                     AutomationProperties.Name="{Localize DataGridStrings.SecondValue}"/>
                            <ToggleButton Grid.Column="1" x:Name="PART_SecondMatchCase" Content="aA"
                                          AutomationProperties.Name="{Localize DataGridStrings.SecondMatchCase}"
                                          Margin="4 0 0 0" MinWidth="30" ToolTipService.ToolTip="{Localize DataGridStrings.MatchCase}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0" x:Name="PART_Apply" Content="{Localize DataGridStrings.ApplyFilter}" Margin="0 0 4 0"/>
                            <Button Grid.Column="1" x:Name="PART_Clear" Content="{Localize DataGridStrings.ClearFilter}" Margin="4 0 0 0"/>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The strip that searches the table - see the macOS set for what each part is for. -->
    <Style Selector="DataGridSearchPanel">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Padding" Value="6 4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridSearchPanel">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                            <TextBox Grid.Column="0"
                                     x:Name="PART_Text"
                                     MinWidth="140"
                                     AutomationProperties.Name="{Localize DataGridStrings.SearchText}"/>
                            <!-- Where the search stands - see the Fluent set. -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8 0">
                                <TextBlock x:Name="SearchingLabel" Visibility="Collapsed"
                                           Text="{Localize DataGridStrings.Searching}"
                                           FontSize="{ResourceReference FontSizeCaption}"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                                <TextBlock x:Name="NoMatchesLabel" Visibility="Collapsed"
                                           Text="{Localize DataGridStrings.NoMatches}"
                                           FontSize="{ResourceReference FontSizeCaption}"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                                <TextBlock x:Name="MatchesLabel" Visibility="Collapsed"
                                           Text="{Localize DataGridStrings.MatchOf, current={TemplateBinding CurrentMatch}, total={TemplateBinding MatchCount}}"
                                           FontSize="{ResourceReference FontSizeCaption}"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                                <TextBlock x:Name="MatchesSoFarLabel" Visibility="Collapsed"
                                           Text="{Localize DataGridStrings.MatchOfSoFar, current={TemplateBinding CurrentMatch}, total={TemplateBinding MatchCount}}"
                                           FontSize="{ResourceReference FontSizeCaption}"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                            </Grid>
                            <Button Grid.Column="2" x:Name="PART_Previous" Content="↑" MinWidth="26"
                                    ToolTipService.ToolTip="{Localize DataGridStrings.PreviousMatch}"/>
                            <Button Grid.Column="3" x:Name="PART_Next" Content="↓" MinWidth="26" Margin="4 0 0 0"
                                    ToolTipService.ToolTip="{Localize DataGridStrings.NextMatch}"/>
                            <Button Grid.Column="4" x:Name="PART_Find" Content="{Localize DataGridStrings.Find}" Margin="6 0 0 0"/>
                            <!-- Closed from inside the strip - see the macOS set. -->
                            <Button Grid.Column="5" x:Name="PART_Close" Content="×" MinWidth="24" Margin="6 0 0 0"
                                    ToolTipService.ToolTip="{Localize DataGridStrings.CloseSearch}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <PropertyTrigger Property="State" Value="Searching">
            <Setter TargetName="SearchingLabel" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="State" Value="NoMatches">
            <Setter TargetName="NoMatchesLabel" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="State" Value="Matches">
            <Setter TargetName="MatchesLabel" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="State" Value="MatchesSoFar">
            <Setter TargetName="MatchesSoFarLabel" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- Which columns are shown - see the Fluent set for why it is a list in a flyout and not a strip. -->
    <Style Selector="DataGridColumnChooser">
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnChooser">
                    <!-- Capped and scrolled - see the Fluent set. -->
                    <ScrollViewer MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PART_Items" Orientation="Vertical"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The grouping strip and the tokens in it - see the macOS set for what each part is for. -->
    <Style Selector="DataGridGroupPanel">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Padding" Value="6 4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridGroupPanel">
                    <Border x:Name="PanelBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" x:Name="PART_Hint"
                                       Text="{Localize DataGridStrings.GroupByHint}"
                                       VerticalAlignment="Center"
                                       FontSize="{ResourceReference FontSizeCaption}"
                                       Foreground="{ObservableResource TextFillColorTertiary}"/>
                            <StackPanel Grid.Column="0" x:Name="PART_Chips"
                                        Orientation="Horizontal" VerticalAlignment="Center"/>

                            <!-- Folding the whole table - see the macOS set. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PART_ExpandAll" Content="{Localize DataGridStrings.ExpandAll}" Visibility="Collapsed"
                                        FontSize="{ResourceReference FontSizeCaption}" Padding="8 0" Margin="4 0 0 0"/>
                                <Button x:Name="PART_CollapseAll" Content="{Localize DataGridStrings.CollapseAll}" Visibility="Collapsed"
                                        FontSize="{ResourceReference FontSizeCaption}" Padding="8 0" Margin="4 0 0 0"/>
                            </StackPanel>

                            <!-- Where a carried chip would land - see the macOS set. -->
                            <Border Grid.Column="0" x:Name="PART_DropMark"
                                    Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="{ThemeResource AccentFillColorDefault}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsDropTarget" Value="true">
                            <Setter TargetName="PanelBg" Property="Background"
                                    Value="{ThemeResource AccentFillColorSelection}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridGroupChip">
        <Setter Property="Background" Value="{ObservableResource CardBackgroundFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <Setter Property="Margin" Value="0 0 4 0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridGroupChip">
                    <Border x:Name="ChipBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                            BorderThickness="{ResourceReference StrokeThin}"
                            CornerRadius="{ResourceReference CornerRadiusSmall}" Padding="6 1"
                            ToolTipService.ToolTip="{Localize DataGridStrings.ChangeNesting}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"/>
                            <!-- The × is a PART - see the macOS set. -->
                            <Border x:Name="PART_Remove" Margin="4 0 0 0" Padding="3 0"
                                    CornerRadius="{ResourceReference CornerRadiusSmall}"
                                    Background="Transparent" ToolTipService.ToolTip="{Localize DataGridStrings.RemoveFromGrouping}">
                                <TextBlock x:Name="RemoveGlyph" Text="×" VerticalAlignment="Center"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ChipBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                        <!-- Picked up - see the macOS set. -->
                        <PropertyTrigger Property="IsDragging" Value="true">
                            <Setter TargetName="ChipBg" Property="Opacity" Value="0.6"/>
                        </PropertyTrigger>
                        <PropertyTrigger SourceName="PART_Remove" Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_Remove" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                            <Setter TargetName="RemoveGlyph" Property="Foreground"
                                    Value="{ObservableResource TextFillColorPrimary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The group row and a total. NOT tinted - see the macOS set. -->
    <!-- The sorting strip and its chips - the same act as grouping, see the Fluent set for why they look alike. -->
    <Style Selector="DataGridSortPanel">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource DataGridLineColor}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Padding" Value="6 4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridSortPanel">
                    <Border x:Name="PanelBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" x:Name="PART_Hint"
                                       Text="{Localize DataGridStrings.SortByHint}"
                                       VerticalAlignment="Center"
                                       FontSize="{ResourceReference FontSizeCaption}"
                                       Foreground="{ObservableResource TextFillColorTertiary}"/>
                            <StackPanel Grid.Column="0" x:Name="PART_Chips"
                                        Orientation="Horizontal" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" x:Name="PART_Clear" Content="{Localize DataGridStrings.ClearSorting}" Visibility="Collapsed"
                                    FontSize="{ResourceReference FontSizeCaption}" Padding="8 0" Margin="4 0 0 0"/>

                            <Border Grid.Column="0" x:Name="PART_DropMark"
                                    Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="{ThemeResource AccentFillColorDefault}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsDropTarget" Value="true">
                            <Setter TargetName="PanelBg" Property="Background"
                                    Value="{ThemeResource AccentFillColorSelection}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridSortChip">
        <Setter Property="Background" Value="{ObservableResource CardBackgroundFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <Setter Property="Margin" Value="0 0 4 0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridSortChip">
                    <Border x:Name="ChipBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                            BorderThickness="1" CornerRadius="2" Padding="6 1"
                            ToolTipService.ToolTip="{Localize DataGridStrings.SortKeyHint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LevelText" VerticalAlignment="Center" Margin="0 0 4 0"
                                       Text="{TemplateBinding Level}"
                                       Foreground="{ObservableResource TextFillColorTertiary}"/>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"/>
                            <TextBlock x:Name="DirectionGlyph" Text="↑" VerticalAlignment="Center" Margin="4 0 0 0"
                                       Foreground="{ObservableResource TextFillColorSecondary}"/>
                            <Border x:Name="PART_Remove" Margin="3 0 0 0" Padding="2 0" CornerRadius="2"
                                    Background="Transparent" ToolTipService.ToolTip="{Localize DataGridStrings.RemoveFromSorting}">
                                <TextBlock x:Name="RemoveGlyph" Text="×" VerticalAlignment="Center"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsDescending" Value="true">
                            <Setter TargetName="DirectionGlyph" Property="Text" Value="↓"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ChipBg" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsDragging" Value="true">
                            <Setter TargetName="ChipBg" Property="Opacity" Value="0.6"/>
                        </PropertyTrigger>
                        <PropertyTrigger SourceName="PART_Remove" Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_Remove" Property="Background"
                                    Value="{ObservableResource SubtleFillColorSecondary}"/>
                            <Setter TargetName="RemoveGlyph" Property="Foreground"
                                    Value="{ObservableResource TextFillColorPrimary}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DataGridGroupHeader">
        <Setter Property="Phrases" Value="{x:Static DataGridStrings.Current}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridGroupHeader">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <!-- A GRID, not a StackPanel, so the caption has an edge to trim against - see the macOS set. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Grid.Column="0" x:Name="Expander"
                                   Source="{ResourceReference ChevronRightIcon}"
                                   Width="9" Height="9" Margin="0 0 5 0"
                                   VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"
                                    x:Name="PART_ContentPresenter"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharEllipses"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Content="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsExpanded" Value="true">
                            <Setter TargetName="Expander" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A total is set apart by COLOR - see the macOS set. -->
    <Style Selector="DataGridFooterCell">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeCaption}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridFooterCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                TextTrimming="CharEllipses"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
