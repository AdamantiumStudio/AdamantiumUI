<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The selection frame: a square hairline with corner handles set inside the corners, light enough to show
         constantly and distinct from a real border. -->

    <Style Selector="SelectionAdorner">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SelectionAdorner">
                    <Grid>
                        <Border BorderThickness="{ResourceReference AdornerSelectionThickness}"
                                CornerRadius="0"
                                BorderBrush="{ThemeResource AccentFillColorDefault}"/>
                        <Border Width="{ResourceReference AdornerHandleSize}"
                                Height="{ResourceReference AdornerHandleSize}"
                                Background="{ThemeResource AccentFillColorDefault}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Width="{ResourceReference AdornerHandleSize}"
                                Height="{ResourceReference AdornerHandleSize}"
                                Background="{ThemeResource AccentFillColorDefault}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Border Width="{ResourceReference AdornerHandleSize}"
                                Height="{ResourceReference AdornerHandleSize}"
                                Background="{ThemeResource AccentFillColorDefault}"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Border Width="{ResourceReference AdornerHandleSize}"
                                Height="{ResourceReference AdornerHandleSize}"
                                Background="{ThemeResource AccentFillColorDefault}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
