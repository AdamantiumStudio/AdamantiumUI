<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The key-tip badge: deliberately loud, square, opaque and one fixed size, with dedicated palette tokens so it reads
         over anything. -->

    <Style Selector="KeyTipAdorner">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="KeyTipAdorner">
                    <Border Background="{ResourceReference KeyTipPlateFill}"
                            BorderBrush="{ResourceReference KeyTipPlateStroke}"
                            BorderThickness="{ResourceReference StrokeThin}"
                            CornerRadius="0"
                            MinWidth="{ResourceReference KeyTipSize}"
                            MinHeight="{ResourceReference KeyTipSize}"
                            Padding="{ResourceReference KeyTipPadding}">
                        <!-- Both text alignments stated: the vertical one defaults to Bottom, which sits the letter on
                             the floor of the plate instead of in the middle of it. -->
                        <TextBlock Text="{TemplateBinding Keys}"
                                FontSize="{ResourceReference FontSizeMicro}"
                                Foreground="{ObservableResource KeyTipForeground}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
