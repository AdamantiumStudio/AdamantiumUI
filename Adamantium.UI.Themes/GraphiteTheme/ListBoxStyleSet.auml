<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A square outlined list with no fill (BorderThickness="0" for an edgeless one). The theme owns the full template;
         see ItGivesATemplateToEveryControlFluentTemplates. -->

    <Style Selector="ListBox" BasedOn="ItemsControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Scrollbar policy comes from ScrollViewer attached properties set on the list (owner-qualified
                             paths). CanContentScroll lets the virtualizing panel scroll by item. -->
                        <ScrollViewer x:Name="PART_ScrollHost" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
