<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS menu: rows, separator, scroll host and context-menu card on FlyoutSurfaceFill. The hovered row is an
         inset accent plate with label and shortcut on-accent; rows are 22 high. -->

    <Style Selector="MenuItem" BasedOn="ItemsControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- Mixed row heights and few of them: not virtualized, so a separator takes its own height rather
                         than a full row's cell. -->
                    <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="5 0" Padding="10 3" MinHeight="22">
                            <Grid ColumnDefinitions="22,*,Auto,Auto">
                                <ContentPresenter x:Name="IconPresenter" Grid.Column="0" Content="{TemplateBinding Icon}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="CheckGlyph" Grid.Column="0"
                                        Data="M0,5 L4,9 L12,1"
                                        Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                                <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                        Foreground="{ObservableResource TextFillColorSecondary}"
                                        FontSize="{ResourceReference FontSizeCaption}"
                                        VerticalAlignment="Center" Margin="24 0 0 0"/>
                                <Image x:Name="Chevron" Grid.Column="3"
                                        Source="{ResourceReference ChevronRightIcon}"
                                        Width="{ResourceReference DropDownIconSize}"
                                        Height="{ResourceReference DropDownIconSize}"
                                        VerticalAlignment="Center" Margin="8 0 0 0"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- The submenu lives in the ROW's template - a row is what opens one - so it belongs to any
                             template that restates the row. No PlacementTarget: the popup falls back to this Grid, which
                             overlaps the row, so Placement=Right opens just past its right edge, its top raised by the
                             card's border and padding so the first row sits level with this one. The card is built on
                             FIRST OPEN, so a leaf row never pays to build one. -->
                        <Popup x:Name="PART_SubmenuPopup" Placement="Right" PlacementAlignment="Start" FlipToFit="True"
                                VerticalOffset="-5"
                                IsOpen="{TemplateBinding IsSubmenuOpen}">
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="160">
                                        <MenuScrollViewer x:Name="PART_MenuScroll">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </MenuScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="MenuItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="Gesture" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
            <Setter TargetName="CheckGlyph" Property="Stroke" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
        <!-- A checked row shows the check mark in the icon gutter, in place of its icon. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="HasItems" Value="true">
            <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <!-- The rule takes its LENGTH from the way it runs - see Fluent's set. -->
                <ControlTemplate TargetType="Separator">
                    <Border x:Name="PART_Rule" Background="{ResourceReference ControlStrokeColorDefault}"/>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Rule" Property="Height" Value="1"/>
                            <Setter TargetName="PART_Rule" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_Rule" Property="Margin" Value="8 4 8 4"/>
                        </PropertyTrigger>

                        <PropertyTrigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_Rule" Property="Width" Value="1"/>
                            <Setter TargetName="PART_Rule" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_Rule" Property="Margin" Value="4 2 4 2"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The scroll host a menu uses: NO scrollbar. Arrows are RepeatButtons in their own rows, 0-tall while collapsed;
         a hold repeats the step. The * row bounds the presenter (the card carries a MaxHeight) so there is something to
         scroll at all. -->
    <!-- Arrow strips are transparent (a second glass layer would paint over the glyph); the glyph carries a halo in the
         card's tint for contrast over whatever the glass shows. Brushes are {ObservableResource} to follow variants. -->
    <Style Selector="MenuScrollViewer" BasedOn="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuScrollViewer">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <RepeatButton x:Name="PART_ScrollUp" Grid.Row="0" Height="18" Visibility="Collapsed"
                                Delay="300" Interval="40">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent">
                                        <Path Data="M0,5 L5,0 L10,5 Z" Fill="{ObservableResource TextFillColorPrimary}"
                                                Width="10" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Shadow>
                                                <Shadow BlurRadius="3" Spread="1" Opacity="1"
                                                        Color="{ObservableResource AcrylicFillColorDefault}"/>
                                            </Path.Shadow>
                                        </Path>
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                Content="{TemplateBinding Content}"/>
                        <RepeatButton x:Name="PART_ScrollDown" Grid.Row="2" Height="18" Visibility="Collapsed"
                                Delay="300" Interval="40">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent">
                                        <Path Data="M0,0 L10,0 L5,5 Z" Fill="{ObservableResource TextFillColorPrimary}"
                                                Width="10" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Shadow>
                                                <Shadow BlurRadius="3" Spread="1" Opacity="1"
                                                        Color="{ObservableResource AcrylicFillColorDefault}"/>
                                            </Path.Shadow>
                                        </Path>
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="MenuScrollViewer">
        <PropertyTrigger Property="CanScrollUp" Value="true">
            <Setter TargetName="PART_ScrollUp" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanScrollDown" Value="true">
            <Setter TargetName="PART_ScrollDown" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ContextMenu" BasedOn="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                            <!-- Built on FIRST OPEN: any element may carry a context menu, and most never show one. Its
                                 parts are taken from the built content in code (Popup.ContentBuilt). -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border x:Name="PART_MenuRoot"
                                            Background="{ResourceReference FlyoutSurfaceFill}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="160">
                                        <MenuScrollViewer x:Name="PART_MenuScroll">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </MenuScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
