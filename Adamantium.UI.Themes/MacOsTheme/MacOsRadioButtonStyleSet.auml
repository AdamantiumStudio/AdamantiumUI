<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS radio button, the checkbox's twin: 16px (AppKit's 14 smudges at 1x), hairline, no hover, darkening
         press; selected is a white dot on an accent fill. -->

    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- Same material as the unset CheckBox, and for the same reason - see MacOsCheckBoxStyleSet. The two are one
             family and must not drift apart. -->
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="OuterRing"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"/>
                            <!-- A third of the diameter. Bigger and it stops being a dot on a filled disc and starts
                                 being a ring, which is the Windows marker; smaller and it disappears at 1x. -->
                            <Ellipse x:Name="Dot"
                                     Width="6" Height="6"
                                     Fill="{ThemeResource AccentForegroundColor}"
                                     Opacity="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="RadioButton">
        <!-- No IsMouseOver trigger, deliberately - see MacOsButtonStyleSet. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="OuterRing" Property="Fill" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="OuterRing" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
            <!-- Un-inherit the ToggleButton accent-label - see the note in MacOsCheckBoxStyleSet. -->
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="OuterRing" Property="Fill" Value="{ResourceReference ControlFillColorTertiary}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="true"/>
                <Condition Property="IsPressed" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="OuterRing" Property="Fill" Value="{ThemeResource AccentFillColorTertiary}"/>
            <Setter TargetName="OuterRing" Property="Stroke" Value="{ThemeResource AccentFillColorTertiary}"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="OuterRing" Property="Fill" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- `<RadioButton Classes="Toggle"/>`: an exclusive row with the toggle look. Last in the file, since document order
         decides at equal specificity. -->
    <Style Selector="RadioButton.Toggle" BasedOn="ToggleButton"/>

    <!-- A pager page number: the toggle look plus hover, as a MultiTrigger so the current page keeps its accent. -->
    <Style Selector="RadioButton.PagerPage" BasedOn="ToggleButton"/>

    <!-- No padding and a minimum width, so button widths do not change with the label. -->
    <Style Selector="RadioButton.PagerPage">
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="Padding" Value="0"/>

        <!-- The same two keys the arrows take, so the row lines up by construction rather than by two numbers that
             happen to be equal today. Height FIXED, width a floor - a height that followed its content would step up
             and down as the digits changed. -->
        <Setter Property="MinWidth" Value="{ResourceReference PagerButtonMinWidth}"/>
        <Setter Property="Height" Value="{ResourceReference PagerButtonHeight}"/>

        <!-- Centered explicitly: a plain RadioButton left-aligns its content. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The hover is gated on NOT being the current page. A trigger setter carries the BAND of the style that declared
         it and a class style outranks a type style, so an unguarded IsMouseOver here would sit above the inherited
         IsChecked trigger and the page you are on would go gray the moment you pointed at it. Pressed is left to the
         toggle's own triggers, which this does not contradict. -->
    <Style Selector="RadioButton.PagerPage">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="true"/>
                <Condition Property="IsChecked" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </MultiTrigger>
    </Style>

</StyleSet>
