<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ColorPickerButton: a color well opening the picker in a floating panel. Hover sharpens the frame, never tints the
         swatch. -->

    <Style Selector="ColorPickerButton">
        <!-- The inset the swatch sits in, read by the template below - see Fluent's set. -->
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ColorPickerButton">
                    <Grid>
                        <Border x:Name="PART_Header"
                                CornerRadius="{ResourceReference CornerRadiusDefault}"
                                Background="{ResourceReference ControlFillColorDefault}"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                BorderThickness="{ResourceReference StrokeControl}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="PART_Swatch" Background="{TemplateBinding SelectedBrush}"
                                        CornerRadius="4"/>
                                <!-- NO ONE COLOR TO SHOW - see Fluent's set. -->
                                <TextBlock x:Name="PART_Mixed" Text="—" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ResourceReference TextFillColorSecondary}"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                                Placement="Bottom" FlipToFit="True" VerticalOffset="4">
                            <!-- The picker builds on first open; its DataContext is the button, so {Binding} reaches
                                 SelectedColor. A transient panel, so it takes FlyoutSurfaceFill. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <ColorPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                                            Background="{ResourceReference FlyoutSurfaceFill}"/>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ColorPickerButton">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_Header" Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsIndeterminate" Value="true">
            <Setter TargetName="PART_Swatch" Property="Background" Value="Transparent"/>
            <Setter TargetName="PART_Mixed" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
