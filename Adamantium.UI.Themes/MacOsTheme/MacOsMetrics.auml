<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns="http://adamantium/ui">

    <!-- The macOS theme's own numbers. It takes the rest from the Fluent metrics for now (see MacOs.auml); what is here
         is what actually differs, and every one of these is a platform convention rather than a taste.

         OVERRIDING BY NAME is how this works: both dictionaries are linked, and the one linked later answers first, so
         a key restated here replaces Fluent's while every key not restated still resolves. -->

    <!-- A Mac caption is SHORTER than a Windows one - 28 against 36 - and the difference is felt rather than measured:
         it is what makes the window read as content with a strip on top instead of a frame around content. -->
    <sys:Double x:Key="TitleBarHeight">28</sys:Double>

    <!-- NOT HERE: the Mac title is semi-bold, and the engine has no font weight to say so with - neither TextBlock nor
         the themes carry one. Left undone rather than faked; it belongs with whatever adds weights. -->

    <!-- The lights: 12 across, 8 apart, 20 in from the edge. Fixed, not derived from the caption's height - they are a
         constant of the platform the way a scrollbar's width is, and a caption made taller does not grow them. -->
    <sys:Double x:Key="TrafficLightSize">12</sys:Double>
    <sys:Double x:Key="TrafficLightGap">8</sys:Double>
    <sys:Double x:Key="TrafficLightsInset">20</sys:Double>
    <CornerRadius x:Key="TrafficLightRadius">6</CornerRadius>

    <!-- The symbol inside a light: near-black and TRANSLUCENT, so it reads on all three colors without a per-light
         glyph color. Not a palette key - the lights it sits on are platform constants, so this is one too. -->
    <SolidColorBrush x:Key="TrafficLightGlyph" Color="#99000000"/>

    <!-- WINDOW CORNERS. The single most recognizable number in the whole theme: a Mac window is generously rounded
         where a Windows one is barely. -->
    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>

    <!-- ── Controls ───────────────────────────────────────────────────────────────────────────────────────────────
         Shorter and rounder than Fluent (28 high, radius 6); borrowed Fluent sets read these keys too. -->
    <sys:Double x:Key="ControlHeight">28</sys:Double>
    <sys:Double x:Key="ControlHeightCompact">22</sys:Double>
    <CornerRadius x:Key="CornerRadiusDefault">6</CornerRadius>
    <CornerRadius x:Key="SplitButtonLeadingRadius">6 0 0 6</CornerRadius>
    <CornerRadius x:Key="SplitButtonTrailingRadius">0 6 6 0</CornerRadius>
    <!-- ...and down the side of a bar, the arrow's half under the body: the seam across. -->
    <CornerRadius x:Key="SplitButtonTopRadius">6 6 0 0</CornerRadius>
    <CornerRadius x:Key="SplitButtonBottomRadius">0 0 6 6</CornerRadius>
    <Thickness x:Key="SplitButtonArrowPaddingDown">0 3</Thickness>
    <!-- A drop-down button's arrow under its content, down the side of a bar. -->
    <Thickness x:Key="DropDownChevronInsetDown">0 3 0 0</Thickness>
    <Thickness x:Key="PaddingControl">12 4 12 5</Thickness>
    <Thickness x:Key="PaddingControlCompact">9 3 9 4</Thickness>

    <!-- The pager's cell, stated HERE and not left to Fluent's: this theme's controls are 28 where Windows uses 32, and
         a row of page buttons that kept Fluent's height would be the one strip in the theme that did not get shorter.
         Height is fixed and width is a floor - see the Fluent metrics for why that asymmetry is the point. -->
    <sys:Double x:Key="PagerButtonMinWidth">30</sys:Double>
    <sys:Double x:Key="PagerButtonHeight">28</sys:Double>
    <!-- A Mac toolbar's buttons stand apart, not shoulder to shoulder. -->
    <sys:Double x:Key="ToolBarSpacing">6</sys:Double>
    <sys:Double x:Key="ToolBarGripLength">14</sys:Double>
    <!-- A contextual bar's wash: how much of its context's accent shows behind it. -->
    <sys:Double x:Key="ToolBarContextualWashOpacity">0.25</sys:Double>
    <!-- The frame round a section a shown context comes from, and round the chevron when it is in the menu. -->
    <Thickness x:Key="ToolBarContextFrameThickness">1.5</Thickness>
    <!-- Its rounding: the commands' (CornerRadiusDefault) plus the 2 it stands past them, so the two curves run alike. -->
    <CornerRadius x:Key="ToolBarContextFrameRadius">8</CornerRadius>
    <!-- Down the side: the widest a command stands on the bar's column - an icon's button (42) and a number's narrow form
         fit, a list is folded. -->
    <sys:Double x:Key="ToolBarColumnWidth">44</sys:Double>
    <!-- The card a folded command opens beside the column. -->
    <Thickness x:Key="ToolBarCardPadding">10</Thickness>
    <sys:Double x:Key="ToolBarCardSpacing">6</sys:Double>
    <!-- A number's unit, after it along the box. -->
    <Thickness x:Key="NumericUnitInset">4,0,0,0</Thickness>
    <!-- Round a number standing vertically: as narrow as the number, so it fits the column of a bar down the side. -->
    <Thickness x:Key="NumericNarrowPadding">2,0</Thickness>

    <!-- A HAIRLINE, not a stroke. Fluent draws control borders 2 wide; a Mac's are one device pixel and are there to
         seat the control on its surface rather than to outline it. -->
    <Thickness x:Key="StrokeControl">1</Thickness>

    <!-- How far a row's selection plate stands in. Spent out of the row's CONTENT, so a grid of small tiles feels it. -->
    <Thickness x:Key="ListRowPlateInset">4 1</Thickness>

</ResourceDictionary>
