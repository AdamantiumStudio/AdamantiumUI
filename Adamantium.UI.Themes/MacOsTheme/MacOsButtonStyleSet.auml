<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS push button: no hover reaction (AppKit answers the press), a hairline border, and pressing darkens the
         fill. -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>

        <!-- Hover leaves it exactly as it was - see above. Stated rather than left out, so that the next person can see
             it was a decision and not a forgotten setter. -->
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference ControlFillColorTertiary}"/>
        <Setter Property="BackgroundDisabled" Value="{ResourceReference ControlFillColorDisabled}"/>
        <Setter Property="ForegroundPressed" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="ForegroundDisabled" Value="{ResourceReference TextFillColorDisabled}"/>

        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingControl}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="InnerBorder"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                                x:Name="PART_ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                    <!-- No focus ring here either: the application draws ONE, on the adorner layer. See Fluent's note -
                         a ring restated in a template is a second answer to the same question. -->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button">
        <!-- No IsMouseOver trigger at all. The brush above already says hover changes nothing; a trigger that assigns
             the same value would only invite someone to "fix" it later by giving it a different one. -->
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundDisabled}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
            <!-- AND THE CONTENT AS A WHOLE GOES QUIET - see Fluent's set: a picture carries its own brush and does not
                 hear the disabled foreground, so a glyph button sat there looking live with nothing to do. -->
            <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value="0.4"/>
        </PropertyTrigger>
    </Style>

    <!-- THE DEFAULT BUTTON. On a Mac this is not "a button someone styled blue" - it is the one the Return key presses,
         and it is filled with the accent precisely so that it can be found without reading. Same template, only the
         brushes change; pressed goes DARKER, as everything here does. -->
    <Style Selector="Button.Accent">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        <Setter Property="BackgroundPointerOver" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BackgroundPressed" Value="{ThemeResource AccentFillColorTertiary}"/>
        <Setter Property="BackgroundDisabled" Value="{ThemeResource AccentFillColorDisabled}"/>
        <Setter Property="ForegroundPressed" Value="{ThemeResource AccentForegroundColor}"/>
    </Style>

    <!-- The borderless icon button does light on hover (as AppKit does), with a subtle plate that pressing darkens. -->
    <Style Selector="Button.Icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference ControlFillColorTertiary}"/>
        <Setter Property="BackgroundDisabled" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- ...and the hover TRIGGER it needs, which the plain button deliberately does without. Its own style, because the
         plain button's trigger block states its absence as a decision - adding one there would contradict the sentence
         written beside it. -->
    <Style Selector="Button.Icon">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="InnerBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

    <!-- A pager arrow, worn alongside Icon (BasedOn resolves only pure-type styles): fixed height, minimum width, and
         Opacity dims the drawn glyph when disabled. -->
    <Style Selector="Button.PagerArrow">
        <Setter Property="MinWidth" Value="{ResourceReference PagerButtonMinWidth}"/>
        <Setter Property="Height" Value="{ResourceReference PagerButtonHeight}"/>

        <!-- Centered in the row and centered in itself, both said outright: the height is fixed, so an arrow left to
             stretch or to sit at the top would stand at a different level from the numbers beside it. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.PagerArrow">
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value="0.35"/>
        </PropertyTrigger>
    </Style>
</StyleSet>
