<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- CanContentScroll=true so the ScrollViewer delegates to the virtualizing panel (item scrolling). -->
    <Style Selector="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The hole a drag opens: an outline, never a filled card - a filled plate is what "still loading" looks like. -->
    <Style Selector="ItemsControl">
        <Setter Property="DropPlaceholderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- A Shape, not a Border: the dashes live on Shape.StrokeDashArray. -->
                    <Rectangle IsHitTestVisible="False" Fill="Transparent" StrokeThickness="2"
                            StrokeDashArray="4,3"
                            Stroke="{ThemeResource AccentFillColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ItemsControl">
        <Setter Property="ItemSkeletonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- No margin: the panel insets the card by the real item's. The panel draws this one card at every
                         pending slot as a copy (a screenful can be 4000+), so the breathe below is still ONE animation:
                         each copy plays it a little after the one before (RenderCloneStagger), like a garland. -->
                    <Grid IsHitTestVisible="False"
                          RenderCloneStagger="0:0:0.08">
                        <Border x:Name="SkeletonFill"
                                CornerRadius="{ResourceReference CornerRadiusDefault}"
                                Opacity="0.05"
                                Background="{ObservableResource SkeletonPulseFill}"/>
                        <Border CornerRadius="{ResourceReference CornerRadiusDefault}"
                                BorderThickness="1"
                                BorderBrush="{ObservableResource ControlStrokeColorDefault}"/>
                    </Grid>
                    <!-- Shown while the list loads, collapsed once it is done: the breathe runs exactly as long. -->
                    <DataTemplate.Triggers>
                        <PropertyTrigger Property="Visibility"
                                         Value="Visible">
                            <PropertyTrigger.EnterActions>
                                <RunAnimationAction TargetName="SkeletonFill">
                                    <PulseAnimation Property="Opacity"
                                                    Min="0.05"
                                                    Max="0.15"
                                                    Duration="0:0:1.2"
                                                    Easing="CubicInOut"/>
                                </RunAnimationAction>
                            </PropertyTrigger.EnterActions>
                            <PropertyTrigger.ExitActions>
                                <StopAnimationAction TargetName="SkeletonFill"/>
                            </PropertyTrigger.ExitActions>
                        </PropertyTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
