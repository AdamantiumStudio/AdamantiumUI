<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The viewer for the overlay scrollers: no corner piece; each bar gives up a bar's width at its far end only while
         the other bar is shown. Fades as in Fluent. -->

    <Style Selector="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The corner, such as it is: each bar steps back by the other's width, and only while the other is showing. -->
    <Style Selector="ScrollViewer">
        <PropertyTrigger Property="IsScrollBarCornerOccupied" Value="true">
            <Setter TargetName="PART_VerticalScrollBar" Property="MarginBottom" Value="11"/>
            <Setter TargetName="PART_HorizontalScrollBar" Property="MarginRight" Value="11"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ScrollViewer">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True"/>
            <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True"/>
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="PART_VerticalScrollBar">
                    <Animation Duration="0:0:0.15" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="PART_HorizontalScrollBar">
                    <Animation Duration="0:0:0.15" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <!-- Held for ~0.7s after the pointer leaves, then faded over ~0.3s. -->
                <RunAnimationAction TargetName="PART_VerticalScrollBar">
                    <Animation Duration="0:0:1.0" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="70%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
                <RunAnimationAction TargetName="PART_HorizontalScrollBar">
                    <Animation Duration="0:0:1.0" Easing="CubicOut">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="70%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

</StyleSet>
