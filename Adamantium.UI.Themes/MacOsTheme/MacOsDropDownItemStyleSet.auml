<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A pop-up menu row: the accent plate follows the pointer or keyboard, the current value gets a tick in a margin
         reserved on every row. -->


    <Style Selector="DropDownItem" BasedOn="ListBoxItem">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BackgroundPressed" Value="{ThemeResource AccentFillColorTertiary}"/>
        <!-- The chosen row keeps the menu's own colors - it is marked by the TICK, not by a fill. Stated as
             transparent rather than left out, so that the trigger below has something to bind and nobody wonders
             whether the omission was an oversight. -->
        <Setter Property="BackgroundSelected" Value="Transparent"/>
        <Setter Property="ForegroundSelected" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <!-- A ROW IS A ROW whatever is in it - see Fluent's set. An empty entry left to its content shrinks to its
             padding, and a virtualizing list gives every row the height of the one it probed. -->
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeightCompact}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="DropDownItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DropDownItem">
                    <!-- Held off the card's edge, like a list row - the menu card already carries its own padding, so
                         this is the small extra that keeps the plate clear of the rounded corner. -->
                    <Border x:Name="ItemBorder"
                            Margin="0 1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- The tick's margin, held open on EVERY row: reserved only where it is drawn, the rows
                                 would shift sideways as the selection moved. The glyph starts at (0,0) because a Path's
                                 box is its geometry bounds - leading empty space would push it off center. -->
                            <Path x:Name="CheckGlyph" Grid.Column="0"
                                  Data="M0,3.6 L3,6.6 L8.6,0"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  Opacity="0"
                                  Width="9" Height="7"
                                  Margin="0 0 8 0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"
                                x:Name="PART_ContentPresenter"
                                TextTrimming="CharEllipses"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDownItem">
        <!-- THE TICK, and nothing else: no plate, no color change. What the control holds now. -->
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="CheckGlyph" Property="Opacity" Value="1"/>
        </PropertyTrigger>

        <!-- THE PLATE, and it belongs to the pointer and the arrows alone - the two ways of saying "a release lands
             here". The row the arrows are on and the row under the pointer are the same statement made by different
             hands, so they look the same; the chosen row is a different statement and looks different.
             The tick is repainted with them: on an accent plate the text color it borrows would be unreadable. -->
        <!-- ONE trigger, not two. IsHighlighted is now driven by the pointer as well as by the arrows (the row hands
             the highlight to its owner on mouse-enter), so there is a single mark and a single place that draws it.
             A second trigger on IsMouseOver would put the plate back on a row the highlight has already left - which is
             the two-plates-at-once the tick was introduced to end. -->
        <PropertyTrigger Property="IsHighlighted" Value="true">
            <Setter TargetName="ItemBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
            <Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="ItemBorder" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
