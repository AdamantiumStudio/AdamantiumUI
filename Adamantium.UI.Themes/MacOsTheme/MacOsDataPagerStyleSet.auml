<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The pager, one line: plain Buttons (auto-repeat flickers the list), with step back/forward always shown. "Last" is
         bound to CanGoForward; with an unknown total the control refuses the jump. -->

    <Style Selector="DataPager">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>

        <!-- The pager takes the width it is given and puts its buttons at the LEADING edge, under the first column of
             the list it belongs to - that is where the eye returns to, and it is where the row stays put as the page
             number grows a digit. Alignment is a SETTER rather than a constant in the template, so an author who wants
             the row centered or trailing says so on the control. -->
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="DataPager">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataPager">
                    <!-- CLIPPED, and that is the floor rather than the plan. The control gives up parts until the line
                         fits (see DataPager.MeasureOverride); below the width of what is left there is nothing sensible
                         to give up, and a row that spills would draw its arrows over the numbers - which is how this
                         template was first shipped. Clipped is wrong-looking; overlapping is wrong AND unreadable. -->
                    <Border x:Name="Chrome" HorizontalAlignment="Stretch" Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <!-- TWO COLUMNS, because the row does two different jobs: stepping to a NEARBY page, which is
                             what the buttons are for, and going to a page too far away to be worth listing, which is
                             what the box is for. They are separated so neither has to grow to cover the other's job. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Button x:Name="PART_FirstPage" Classes="Icon PagerArrow" MarginRight="4"
                                        IsEnabled="{TemplateBinding CanGoBack}">
                                    <Image Source="{ResourceReference FirstPageIcon}"
                                           Width="{ResourceReference PagerGlyphSize}"
                                           Height="{ResourceReference PagerGlyphSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="PART_PreviousPage" Classes="Icon PagerArrow" MarginRight="8"
                                        IsEnabled="{TemplateBinding CanGoBack}">
                                    <Image Source="{ResourceReference ChevronLeftIcon}"
                                           Width="{ResourceReference PagerGlyphSize}"
                                           Height="{ResourceReference PagerGlyphSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- The pages as a toggle-look radio group of a fixed PageButtonCount entries; the ellipsis
                                     is a live entry (see PagerPageItem). -->
                                <ItemsControl x:Name="NumbersGroup" ItemsSource="{TemplateBinding PageItems}"
                                              MarginRight="8" VerticalAlignment="Center">
                                    <!-- Not virtualized: the virtualizing host uses a uniform pitch, but page buttons vary
                                         in width. -->
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        IsVirtualizing="False"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Classes="PagerPage"
                                                         Content="{Binding Text}"
                                                         IsChecked="{Binding IsCurrent}"
                                                         IsEnabled="{Binding IsEnabled}"
                                                         Command="{Binding Command}"
                                                         MarginRight="4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="PART_NextPage" Classes="Icon PagerArrow" MarginRight="4"
                                        IsEnabled="{TemplateBinding CanGoForward}">
                                    <Image Source="{ResourceReference ChevronRightIcon}"
                                           Width="{ResourceReference PagerGlyphSize}"
                                           Height="{ResourceReference PagerGlyphSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="PART_LastPage" Classes="Icon PagerArrow"
                                        IsEnabled="{TemplateBinding CanGoForward}">
                                    <Image Source="{ResourceReference LastPageIcon}"
                                           Width="{ResourceReference PagerGlyphSize}"
                                           Height="{ResourceReference PagerGlyphSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Page size and "Page [n] of N"; the box commits on Enter or focus loss and restores the
                                 real page on invalid input. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" MarginLeft="16"
                                        VerticalAlignment="Center">
                                <StackPanel x:Name="PageSizeGroup" Orientation="Horizontal" MarginRight="16"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Localize DataPagerStrings.Rows}"
                                               VerticalAlignment="Center"
                                               MarginRight="6"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"/>
                                    <!-- The SAME height as everything else on the line, said outright. Left to their own
                                         devices the two fields settle a point or two apart - they are different controls
                                         with different chrome - and the line then changed height as parts came and went,
                                         which is the one thing a row of controls must never do. -->
                                    <DropDown x:Name="PART_PageSizeSelector" VerticalAlignment="Center"
                                              Width="{ResourceReference PagerSizePickerWidth}"
                                              MinWidth="{ResourceReference PagerSizePickerWidth}"
                                              Height="{ResourceReference PagerButtonHeight}"
                                              ItemsSource="{TemplateBinding PageSizes}"/>
                                </StackPanel>

                                <StackPanel x:Name="PageInputGroup" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Localize DataPagerStrings.Page}"
                                               VerticalAlignment="Center"
                                               MarginRight="6"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"/>
                                    <!-- A NUMBER box with no buttons: a page is a whole number in a known range, and
                                         NumericUpDown already refuses a decimal separator at the keystroke and clamps
                                         to Minimum/Maximum. The steppers are off because the arrows beside it are the
                                         steppers - two ways to go one page on the same line would be one too many. -->
                                    <NumericUpDown x:Name="PART_PageBox" VerticalAlignment="Center"
                                                   AreButtonsVisible="False"
                                                   InputMode="Integers"
                                                   Width="{ResourceReference PagerPageBoxWidth}"
                                                   MinWidth="{ResourceReference PagerPageBoxWidth}"
                                                   Height="{ResourceReference PagerButtonHeight}"/>
                                    <TextBlock x:Name="PageCountLabel"
                                               Text="{Localize DataPagerStrings.OfCount, count={TemplateBinding PageCount}}"
                                               VerticalAlignment="Center"
                                               MarginLeft="6"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"/>
                                    <!-- "of ?" while the end has not been found - see Fluent's set. -->
                                    <TextBlock x:Name="UnknownCountLabel"
                                               Text="{Localize DataPagerStrings.OfUnknown}"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"
                                               MarginLeft="6"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DisplayMode: parts are visible by default and triggers hide them, one boolean per flag (markup cannot test a
         flags enum). -->
    <Style Selector="DataPager">
        <!-- DISABLED, said ONCE for the whole row. IsEnabled is not an inheriting property here, so the buttons and
             fields inside never learn they are off and go on looking live - while input is dead, because hit-testing
             prunes the whole subtree of a disabled element. Opacity is the statement that reaches all of it, drawn
             glyphs included, and it is the only one a composite control can make about itself. -->
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsFirstLast" Value="false">
            <Setter TargetName="PART_FirstPage" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_LastPage" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsPreviousNext" Value="false">
            <Setter TargetName="PART_PreviousPage" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_NextPage" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsNumbers" Value="false">
            <Setter TargetName="NumbersGroup" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsPageSizeSelector" Value="false">
            <Setter TargetName="PageSizeGroup" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsPageInput" Value="false">
            <Setter TargetName="PageInputGroup" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEndKnown" Value="false">
            <Setter TargetName="PageCountLabel" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="UnknownCountLabel" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="PageCount" Value="0">
            <Setter TargetName="PageCountLabel" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
