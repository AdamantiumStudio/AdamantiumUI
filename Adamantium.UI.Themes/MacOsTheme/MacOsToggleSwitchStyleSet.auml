<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS switch: a white thumb nearly filling the track in both states and variants; on is the accent. -->

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- Its own key, not a ControlFill: with no outline round the groove, its colour is the only thing that says
             where the track ends - see the note in MacOsDark. -->
        <Setter Property="Background" Value="{ResourceReference SelectionControlFillColorOff}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <!-- No border: the 38x22 inner box fits an 18 thumb with 2 all round; a 1px border would not. -->
                        <Border x:Name="SwitchTrack"
                                Width="38" Height="22" CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <!-- One margin for both ends; only the alignment moves. Fluent's ToggleSwitch set must
                                     not be included too, its trigger targets this same part name. -->
                                <Ellipse x:Name="SwitchThumb"
                                         Width="18" Height="18"
                                         Fill="#FFFFFF"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="2"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="ToggleSwitch">
        <!-- No hover on the track, for the reason the button gives: a Mac control answers the press, not the pointer. -->
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="SwitchTrack" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
            <!-- The thumb is NOT repainted here - see the header. It stays the knob it was. -->
            <!-- Un-inherit the ToggleButton accent-label: a switch's label sits on the window, not on the switch. -->
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="SwitchTrack" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="SwitchThumb" Property="Fill" Value="{ResourceReference ControlFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
