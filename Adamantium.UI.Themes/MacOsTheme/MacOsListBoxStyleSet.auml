<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS list: Fluent's parts on the same well surface as text fields, with the theme's corner radius. -->

    <Style Selector="ListBox" BasedOn="ItemsControl">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{ResourceReference ControlStrokeColorSecondary}"
                            BorderThickness="{ResourceReference StrokeControl}"
                            CornerRadius="{ResourceReference CornerRadiusDefault}">
                        <!-- OWNER-QUALIFIED, so it reaches ScrollViewer's ATTACHED properties: a bare
                             {TemplateBinding HorizontalScrollBarVisibility} is looked up as a property of the LIST,
                             which has none - it resolves to null and throws while the template is being BUILT, which
                             leaves every list with no template at all. -->
                        <ScrollViewer x:Name="PART_ScrollHost" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
