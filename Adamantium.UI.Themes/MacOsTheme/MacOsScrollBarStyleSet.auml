<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS overlay scroller: no trough, a translucent capsule thumb inset from the edges. Widening on hover is not
         implemented. -->

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <!-- 11 across with a 7 thumb inside it: the 2 either side is the gap that lifts the capsule off the edge. -->
        <Setter Property="BarThickness" Value="11"/>
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <!-- MinThumbLength is this theme's own: the thumb is a ROUNDED bar, so it stops reading as a
                             thumb long before a square one does. At the shared floor of 12 a list of ten thousand rows
                             left a dot that was hard to even aim at. -->
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               MinThumbLength="32">
                            <Track.DecreaseRepeatButton>
                                <ScrollBarPageButton Focusable="false"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <!-- The template is inline rather than a Thumb style, so that the global Thumb set -
                                     which the splitter and anything else without its own thumb still use - is left
                                     alone. An inline Template is a Local value and outranks that set either way. -->
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- Margin 2 on all four sides: across the bar it makes the 11 into a 7
                                                 capsule, and along it, it keeps the rounded ends off the very top and
                                                 bottom of the travel. CornerRadius half the width - a capsule, not a
                                                 rounded rectangle. -->
                                            <Border Margin="2"
                                                    CornerRadius="3.5"
                                                    Background="{ResourceReference ScrollThumbFillColor}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <ScrollBarPageButton Focusable="false"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
