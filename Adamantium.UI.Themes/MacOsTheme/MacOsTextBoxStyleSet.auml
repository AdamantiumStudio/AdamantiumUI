<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS text field: the engine's template on the well surface (SolidBackgroundFillColorSecondary). No hover;
         focus changes only the border, the halo is the adorner's focus ring. -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- Dimmer than the text, so the watermark reads as a hint rather than as something already typed. -->
        <Setter Property="PlaceholderForeground" Value="{ResourceReference TextFillColorTertiary}"/>
        <Setter Property="FloatingPlaceholderForeground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="CaretBrush" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingField}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox">
        <!-- No IsMouseOver trigger, deliberately - see the header. -->
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_TextPresenter" Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
