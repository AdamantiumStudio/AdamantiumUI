<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS text field: the engine's template on the well surface (SolidBackgroundFillColorSecondary). No hover;
         focus changes only the border, the halo is the adorner's focus ring. -->

    <Style Selector="TextBox, PasswordBox">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- Dimmer than the text, so the watermark reads as a hint rather than as something already typed. -->
        <Setter Property="PlaceholderForeground" Value="{ResourceReference TextFillColorTertiary}"/>
        <Setter Property="FloatingPlaceholderForeground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="CaretBrush" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingField}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="ClearButtonToolTip" Value="{Localize TextBoxStrings.Clear}"/>
    </Style>

    <!-- The editing menu, one per box (x:Shared): a menu points at the box it opens on. Spelling rows come above these
         while the spelling is checked. -->
    <Style Selector="TextBox">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu x:Shared="False">
                    <MenuItem Header="{Localize TextBoxStrings.Cut}"
                              InputGestureText="⌘X"
                              Command="{x:Static ApplicationCommands.Cut}"/>
                    <MenuItem Header="{Localize TextBoxStrings.Copy}"
                              InputGestureText="⌘C"
                              Command="{x:Static ApplicationCommands.Copy}"/>
                    <MenuItem Header="{Localize TextBoxStrings.Paste}"
                              InputGestureText="⌘V"
                              Command="{x:Static ApplicationCommands.Paste}"/>
                    <Separator/>
                    <MenuItem Header="{Localize TextBoxStrings.SelectAll}"
                              InputGestureText="⌘A"
                              Command="{x:Static ApplicationCommands.SelectAll}"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <!-- The clear button takes a column of its own, so the text never runs under it. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                <TextPresenter x:Name="PART_TextPresenter"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"/>
                            </ScrollViewer>
                            <!-- Not a focus stop: the press leaves the caret in the box. -->
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    Focusable="False"
                                    Width="17"
                                    Height="17"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    Margin="4 0 0 0"
                                    VerticalAlignment="Center"
                                    ToolTip="{TemplateBinding ClearButtonToolTip}">
                                <Image Source="{ResourceReference CloseIcon}"
                                       Width="8"
                                       Height="8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Only while there is something to clear, and the box may be cleared. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowsClearButton" Value="true"/>
                                <Condition Property="HasText" Value="true"/>
                                <Condition Property="IsReadOnly" Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox: the same field, with a reveal button where the text box has its clear button. -->
    <Style Selector="PasswordBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <Grid ColumnDefinitions="*,Auto">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                <TextPresenter x:Name="PART_TextPresenter"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"/>
                            </ScrollViewer>
                            <!-- Not a focus stop: the press leaves the caret in the box. -->
                            <Button x:Name="PART_RevealButton"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    Focusable="False"
                                    Width="17"
                                    Height="17"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    Margin="4 0 0 0"
                                    VerticalAlignment="Center"
                                    ToolTip="{Localize TextBoxStrings.ShowPassword}">
                                <Image Source="{ResourceReference RevealIcon}"
                                       Width="10"
                                       Height="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- While there is something to show, unless the box asks for no button. -->
                        <PropertyTrigger Property="HasPassword" Value="true">
                            <Setter TargetName="PART_RevealButton" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="PasswordRevealMode" Value="Hidden">
                            <Setter TargetName="PART_RevealButton" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox, PasswordBox">
        <!-- No IsPointerOver trigger, deliberately - see the header. -->
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_TextPresenter" Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- DateTimeField: the same well, its parts side by side where the text box has its text. -->
    <Style Selector="DateTimeField">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingField}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DateTimeField">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel x:Name="PART_Segments"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DateTimeField">
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

    <!-- The pickers: the same well, its button at the end and the card the button opens under it. -->
    <Style Selector="DatePicker, TimePicker, DateTimePicker">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorSecondary}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingField}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DateTimePickerBase">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel x:Name="PART_Segments"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Classes="DateTimePickerButton"
                                    Focusable="False"
                                    AutomationProperties.Name="{Localize DateTimeFieldStrings.Choose}">
                                <Image Source="{TemplateBinding ButtonIcon}"
                                       Width="12"
                                       Height="12"/>
                            </Button>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementAlignment="Start"
                                   FlipToFit="True"
                                   VerticalOffset="4"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DatePicker, TimePicker, DateTimePicker">
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsDropDownOpen" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter Property="Foreground" Value="{ObservableResource TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
