<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- A macOS list row: selection is a solid accent capsule inset from the edges (the hit area stays full width) with an
         on-accent label; no hover. -->

    <Style Selector="ListBoxItem">
        <!-- No rest Background on purpose: a transparent fill still builds a fill unit and an anti-aliased fringe per
             row, which in a long list is paid for nothing. The triggers paint one when there is something to say. -->
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference ControlFillColorTertiary}"/>
        <!-- A WASH, not a plate of accent, and the row keeps its own colors - the same selection language Fluent uses
             and the same one the table now uses. A solid accent swallows whatever the row draws itself: a check box in
             the accent, an icon, a color that MEANS something. -->
        <Setter Property="BackgroundSelected" Value="{ThemeResource AccentFillColorSelection}"/>
        <Setter Property="ForegroundSelected" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <!-- The selection plate stands in from the list's edge. On the ITEM, so a view can override it the ordinary
             way; it costs the item that much of its content, which a grid of small tiles feels. -->
        <Setter Property="Margin" Value="{ResourceReference ListRowPlateInset}"/>
        <!-- Stretch on both axes, as Fluent's does and for its reason: content that wants to be centered can say so
             about itself, while content that wants the whole slot cannot get back height never handed to it. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                                x:Name="PART_ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover FIRST, then pressed, then selected: the trigger value stack is ordered by ACTIVATION, so the plate
         declared last is the one that stands once the others are gone. -->
    <Style Selector="ListBoxItem">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="ItemBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="ItemBorder" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="ItemBorder" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </PropertyTrigger>
        <!-- Selected AND pressed: darken the plate rather than lighten it, as everything in this theme does under a
             press. Declared last so it lands on top of the stack while both hold. -->
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="true"/>
                <Condition Property="IsPressed" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="ItemBorder" Property="Background" Value="{ThemeResource AccentFillColorSelectionStrong}"/>
        </MultiTrigger>
    </Style>

</StyleSet>
