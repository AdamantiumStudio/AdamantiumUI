<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS window: generously rounded corners and a caption drawn on the window's surface instead of the
         accent. -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- The caption sits one layer above the body, with a hairline below; inactive falls back to the body color. -->
        <Setter Property="TitleBarBackground" Value="{ObservableResource LayerFillColorDefault}"/>
        <Setter Property="InactiveTitleBarBackground" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <!-- The title dims when the window loses focus, which on a Mac is the main way an inactive window says so. -->
        <Setter Property="TitleBarForeground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="InactiveTitleBarForeground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="LoadingIndicatorText" Value="Switching theme…"/>
    </Style>

    <Style Selector="Window">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="PART_WindowBorder" Background="{TemplateBinding Background}"
                            CornerRadius="{ResourceReference WindowCornerRadius}"
                            BorderThickness="1" BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                            <TitleBar x:Name="PART_TitleBar" Grid.Row="0"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="{TemplateBinding InactiveTitleBarBackground}"
                                    Foreground="{TemplateBinding InactiveTitleBarForeground}"
                                    Title="{TemplateBinding Title}"
                                    LeadingContent="{TemplateBinding TitleBarLeadingContent}"
                                    LeftWindowCommands="{TemplateBinding LeftWindowCommands}"
                                    RightWindowCommands="{TemplateBinding RightWindowCommands}"
                                    CaptionButtonPlacement="{TemplateBinding CaptionButtonPlacement}"/>

                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>

                            <ResizeGripper x:Name="PART_ResizeGripper" Grid.Row="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Width="26" Height="26" Visibility="Collapsed"/>

                            <!-- The theme-swap scrim, kept as the Fluent window has it: the ENGINE owns the state
                                 (Window.IsThemeChanging) and a theme that dropped this would silently lose the only
                                 feedback a swap gives. The spinner's template is set INLINE on purpose - a re-templated
                                 spinner gets a new owner the compositor cannot drive, and it freezes mid-swap. -->
                            <Border x:Name="PART_ThemeOverlay" Grid.Row="1"
                                    Background="{ObservableResource SmokeFillColorDefault}"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <BusyIndicator x:Name="PART_ThemeSpinner" IsActive="False"
                                            Width="48" Height="48" HorizontalAlignment="Center">
                                        <BusyIndicator.Template>
                                            <ControlTemplate TargetType="BusyIndicator">
                                                <Grid>
                                                    <Ellipse Stroke="{ObservableResource ControlFillColorTertiary}"
                                                             StrokeThickness="4" Fill="Transparent" EllipseType="EdgeToEdge"/>
                                                    <Ellipse Stroke="{ThemeResource AccentFillColorDefault}"
                                                             StrokeThickness="4" Fill="Transparent" EllipseType="EdgeToEdge"
                                                             StartAngle="0" StopAngle="90" RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <Transform x:Name="RingSpin"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </BusyIndicator.Template>
                                    </BusyIndicator>
                                    <TextBlock Text="{TemplateBinding LoadingIndicatorText}" HorizontalAlignment="Center"
                                            Margin="0,18,0,0" Foreground="{ObservableResource TextFillColorSecondary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Window">
        <PropertyTrigger Property="UseCustomChrome" Value="false">
            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ResizeMode" Value="CanResizeWithGrip">
            <Setter TargetName="PART_ResizeGripper" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsThemeChanging" Value="true">
            <Setter TargetName="PART_ThemeOverlay" Property="Visibility" Value="Visible"/>
            <Setter TargetName="PART_ThemeSpinner" Property="IsActive" Value="True"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
