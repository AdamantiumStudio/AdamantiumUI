<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- DropDownButton, SplitButton, ToggleSplitButton and the rows of their lists: the macOS push button - no hover,
         pressing darkens - over the pop-up menu sheet, whose accent plate follows the pointer and the arrows. -->

    <Style Selector="DropDownButton" BasedOn="ItemsControl">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BackgroundPressed" Value="{ResourceReference ControlFillColorTertiary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingControl}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDownButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DropDownButton">
                    <Grid>
                        <!-- Plate, not Chrome: a split button takes these styles too, and its halves are lit apart. -->
                        <Border x:Name="Plate"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <Path x:Name="Chevron" Grid.Column="1"
                                        Data="M0,0 L8,0 L4,4 Z"
                                        Fill="{TemplateBinding Foreground}"
                                        Margin="8 0 0 0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            MinWidth="{Binding ActualWidth}">
                                        <ScrollViewer MaxHeight="{Binding MaxDropDownHeight}"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDownButton">
        <PropertyTrigger Property="IsDropDownOpen" Value="true">
            <Setter TargetName="Plate" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="Plate" Property="Opacity" Value="0.4"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="SplitButton" BasedOn="DropDownButton"/>

    <Style Selector="SplitButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SplitButton">
                    <Grid>
                        <Border x:Name="Chrome"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Border x:Name="Body"
                                        CornerRadius="{ResourceReference SplitButtonLeadingRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="PART_ContentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Border>
                                <Border x:Name="SplitRule" Grid.Column="1"
                                        Width="{ResourceReference StrokeThinValue}" Margin="0 5"
                                        Background="{TemplateBinding BorderBrush}"/>
                                <!-- A real element with a size: the control asks it where the pointer is. -->
                                <Border x:Name="PART_DropDownArea" Grid.Column="2"
                                        CornerRadius="{ResourceReference SplitButtonTrailingRadius}"
                                        Padding="{ResourceReference SplitButtonArrowPadding}">
                                    <Path x:Name="Chevron"
                                            Data="M0,0 L8,0 L4,4 Z"
                                            Fill="{TemplateBinding Foreground}"
                                            VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            MinWidth="{Binding ActualWidth}">
                                        <ScrollViewer MaxHeight="{Binding MaxDropDownHeight}"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="SplitButton">
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="Body" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsDropDownOpen" Value="true">
            <Setter TargetName="PART_DropDownArea" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsBodyEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value="0.4"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="ToggleSplitButton" BasedOn="SplitButton"/>

    <!-- Down: the body takes the accent, as a checked toggle button does. -->
    <Style Selector="ToggleSplitButton">
        <PropertyTrigger Property="IsChecked" Value="true">
            <Setter TargetName="Body" Property="Background" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="true"/>
                <Condition Property="IsPressed" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="Body" Property="Background" Value="{ThemeResource AccentFillColorTertiary}"/>
        </MultiTrigger>
    </Style>

    <Style Selector="DropDownButtonItem">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundPointerOver" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BackgroundPressed" Value="{ThemeResource AccentFillColorTertiary}"/>
        <Setter Property="ForegroundDisabled" Value="{ResourceReference TextFillColorDisabled}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingRow}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeightCompact}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="DropDownButtonItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DropDownButtonItem">
                    <Border x:Name="ItemBorder"
                            Margin="0 1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                TextTrimming="CharEllipses"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDownButtonItem">
        <!-- One plate, for the pointer and the arrows alike: the row hands the highlight to its owner on mouse-enter. -->
        <PropertyTrigger Property="IsHighlighted" Value="true">
            <Setter TargetName="ItemBorder" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPressed" Value="true">
            <Setter TargetName="ItemBorder" Property="Background" Value="{TemplateBinding BackgroundPressed}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsAvailable" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
