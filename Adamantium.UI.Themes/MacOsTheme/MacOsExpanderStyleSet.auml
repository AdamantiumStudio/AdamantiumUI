<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The macOS disclosure group: no box, a triangle before a bold caption that turns down when open, content
         indented. -->

    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="0 4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ExpandDuration" Value="0:0:0.2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- A header's text does not select - see Fluent's Expander. -->
                        <Border Grid.Row="0" x:Name="PART_Header"
                                TextBlock.IsTextSelectionEnabled="False"
                                Background="Transparent"
                                CornerRadius="{ResourceReference CornerRadiusDefault}"
                                Padding="{TemplateBinding Padding}"
                                Cursor="Hand">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Grid.Column="0" x:Name="Glyph"
                                       Source="{ResourceReference ChevronRightIcon}"
                                       Width="9" Height="9" Margin="0 0 6 0"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <Transform x:Name="PART_GlyphTurn"/>
                                    </Image.RenderTransform>
                                </Image>
                                <ContentPresenter Grid.Column="1"
                                        x:Name="PART_HeaderPresenter"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharEllipses"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                            </Grid>
                        </Border>

                        <!-- Indented under the triangle, not boxed: the indent is what says "this belongs to that". -->
                        <RevealDecorator Grid.Row="1" x:Name="PART_Reveal" Visibility="Collapsed">
                            <Border x:Name="PART_Content" Margin="15 2 0 6">
                                <ContentPresenter
                                        x:Name="PART_ContentPresenter"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                        </RevealDecorator>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsPointerOver" Value="true">
                            <Setter TargetName="PART_Header" Property="Background"
                                    Value="{ResourceReference SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsEnabled" Value="false">
                            <Setter TargetName="PART_HeaderPresenter" Property="Foreground"
                                    Value="{ObservableResource TextFillColorDisabled}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
