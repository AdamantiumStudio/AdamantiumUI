<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns="http://adamantium/ui">

    <!-- The macOS transient surfaces answer the shared role keys with liquid glass, which refracts toward the rim.
         BlurAmount is a logical-pixel radius blurring the flat middle; the pass halves tint alpha, so 1.0 is the max. -->

    <!-- The flyout surface. The tint is {ObservableResource} so it follows variant switches. A light tint and a narrow
         lens: the full tint and the material's default refraction read as a thick pale frame round every menu. -->
    <MaterialBrush x:Key="FlyoutSurfaceFill"
                   Material="LiquidGlass"
                   TintColor="{ObservableResource AcrylicFillColorDefault}"
                   TintOpacity="0.7"
                   BlurAmount="5"
                   Refraction="5"
                   NoiseAmount="0.02"/>

    <!-- A tooltip is small, and the lens is measured in device pixels from the edge - at the flyout's strength the
         bending would reach the middle of it and there would be no flat part left to read text on. -->
    <MaterialBrush x:Key="TooltipSurfaceFill"
                   Material="LiquidGlass"
                   TintColor="{ObservableResource AcrylicFillColorDefault}"
                   TintOpacity="0.7"
                   BlurAmount="4"
                   Refraction="4"
                   NoiseAmount="0.02"/>

</ResourceDictionary>
