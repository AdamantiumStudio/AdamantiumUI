<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The circular gauge: the shared unset groove as track, and a thin (3) ring. -->

    <Style Selector="RingProgressBar">
        <Setter Property="MinWidth" Value="{ResourceReference RingSize}"/>
        <Setter Property="MinHeight" Value="{ResourceReference RingSize}"/>
        <Setter Property="RingThickness" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
    </Style>

    <Style Selector="RingProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RingProgressBar">
                    <Grid>
                        <!-- The ring is a SHAPE, not a stroke: RingThickness leaves a band that thick inward from the
                             outline, and a swept band is an annular sector - which is what a gauge is. Sector, because a
                             band's ends are radial whichever closing is asked for. -->
                        <Ellipse Fill="{ResourceReference SelectionControlFillColorOff}"
                                 RingThickness="{TemplateBinding RingThickness}"
                                 EllipseType="Sector"/>
                        <Ellipse x:Name="PART_Indicator"
                                 Fill="{ThemeResource AccentFillColorDefault}"
                                 RingThickness="{TemplateBinding RingThickness}"
                                 EllipseType="Sector"
                                 StartAngle="0"
                                 StopAngle="0"
                                 RenderTransformOrigin="0.5,0.5"/>
                        <TextBlock x:Name="PART_ValueText"
                                   Text="{TemplateBinding ValueText}"
                                   Visibility="Collapsed"
                                   FontSize="{ResourceReference FontSizeSubtitle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Center percentage label, opt-in via ShowValueText. -->
    <Style Selector="RingProgressBar">
        <PropertyTrigger Property="ShowValueText" Value="true">
            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
