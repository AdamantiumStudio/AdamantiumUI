<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The application-wide focus ring: one translucent accent band (3px at 60%) instead of Fluent's two lines. The
         outset stays Fluent's, since a standing-off ring is clipped and arranged off-center. -->

    <Style Selector="FocusAdorner">
        <Setter Property="Outset" Value="{ResourceReference FocusRingOutset}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="FocusAdorner">
                    <Grid IsHitTestVisible="False">
                        <Border BorderThickness="3"
                                Opacity="0.6"
                                BorderBrush="{ThemeResource AccentFillColorDefault}"
                                CornerRadius="{TemplateBinding AdornedCornerRadius}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
