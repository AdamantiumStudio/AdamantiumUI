<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The print dialog: the preview on the left, the options on the right, the buttons along the bottom. Rows of the
         printer's options are collapsed until the dialog says the printer offers them (Shows*). Shown inside a window
         (IsInline), "Print" and the copies head the options and there is no bottom bar. -->

    <Style Selector="PrintDialog">
        <Setter Property="Background" Value="{ResourceReference SolidBackgroundFillColorBase}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="MinWidth" Value="860"/>
        <Setter Property="MinHeight" Value="600"/>
    </Style>

    <Style Selector="PrintDialog TextBlock.Label">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="PrintDialog">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PrintDialog">
                    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,400" Background="{TemplateBinding Background}">

                        <!-- The sheet as it will be printed, and the way through the sheets. -->
                        <Grid RowDefinitions="*,Auto" Background="{ResourceReference SolidBackgroundFillColorTertiary}">
                            <PrintPreview x:Name="PART_Preview"
                                          Sheets="{TemplateBinding Sheets}"
                                          Sheet="{TemplateBinding Sheet}"
                                          PaperBrush="#FFFFFFFF"
                                          ShadowBrush="#33000000"
                                          ShowsMargins="{TemplateBinding ShowsCustomMargins}"
                                          MarginsBrush="{ThemeResource AccentFillColorDefault}"
                                          Margin="12"
                                          AutomationProperties.Name="{Localize PrintStrings.Preview}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" MarginBottom="12">
                                <Button Command="{TemplateBinding PreviousSheetCommand}"
                                        Content="‹" Width="32" Height="32" Padding="0"
                                        AutomationProperties.Name="{Localize PrintStrings.PreviousSheet}"/>
                                <TextBlock x:Name="PART_SheetNumber"
                                           Text="{Localize PrintStrings.SheetOfCount, sheet={TemplateBinding SheetNumber}, count={TemplateBinding SheetCount}}"
                                           VerticalAlignment="Center" MarginLeft="12" MarginRight="12"/>
                                <Button Command="{TemplateBinding NextSheetCommand}"
                                        Content="›" Width="32" Height="32" Padding="0"
                                        AutomationProperties.Name="{Localize PrintStrings.NextSheet}"/>
                            </StackPanel>
                        </Grid>

                        <!-- The options: the printer, then the platform's own, then the printer's. -->
                        <ScrollViewer x:Name="Options" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Vertical" Margin="18 16 18 16">
                                <StackPanel x:Name="InlinePrintRow"
                                            Orientation="Horizontal"
                                            MarginBottom="16"
                                            Visibility="Collapsed">
                                    <Button x:Name="PART_InlinePrint"
                                            Classes="Accent"
                                            Content="{Localize PrintStrings.Print}"
                                            Command="{TemplateBinding PrintCommand}"
                                            MinWidth="100"
                                            Height="40"/>
                                    <StackPanel x:Name="InlineCopies"
                                                Orientation="Horizontal"
                                                MarginLeft="16"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="InlineCopiesLabel"
                                                   Classes="Label"
                                                   Text="{Localize PrintStrings.Copies}"
                                                   MarginRight="8"/>
                                        <NumericUpDown x:Name="PART_InlineCopies"
                                                       Width="100"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=InlineCopiesLabel}"
                                                       Minimum="1"
                                                       Maximum="{TemplateBinding MaxCopies}"
                                                       Value="{TemplateBinding Copies, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="140,*" MarginBottom="4">
                                    <TextBlock x:Name="PrinterLabel" Classes="Label" Text="{Localize PrintStrings.Printer}"/>
                                    <DropDown x:Name="PART_Printer" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=PrinterLabel}"
                                              ItemsSource="{Ancestor PrintDialog, Printers}"
                                              SelectedItem="{TemplateBinding Printer, Mode=TwoWay}">
                                        <DropDown.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               Visibility="{Binding IsFile, Converter={InverseBooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Localize PrintStrings.SaveAsPdf}"
                                                               Visibility="{Binding IsFile, Converter={BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DropDown.ItemTemplate>
                                    </DropDown>
                                </Grid>
                                <Grid ColumnDefinitions="140,*" MarginBottom="8">
                                    <TextBlock x:Name="PART_PrinterState" Grid.Column="1" Visibility="Collapsed"
                                               Foreground="{ObservableResource SystemFillColorCaution}"
                                               TextWrapping="WrapByWords"
                                               Text="{Localize PrintStrings, Key={TemplateBinding PrinterState}}"/>
                                    <TextBlock x:Name="PART_Asking" Grid.Column="1" Visibility="Collapsed"
                                               Foreground="{ObservableResource TextFillColorSecondary}"
                                               Text="{Localize PrintStrings.LookingForPrinters}"/>
                                </Grid>

                                <Grid x:Name="CopiesRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock x:Name="CopiesLabel" Classes="Label" Text="{Localize PrintStrings.Copies}"/>
                                    <NumericUpDown x:Name="PART_Copies" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=CopiesLabel}"
                                                   Minimum="1" Maximum="{TemplateBinding MaxCopies}"
                                                   Value="{TemplateBinding Copies, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="CollateRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <CheckBox x:Name="PART_Collate" Grid.Column="1" Content="{Localize PrintStrings.Collate}"
                                              IsChecked="{TemplateBinding Collate, Mode=TwoWay}"/>
                                </Grid>

                                <Grid ColumnDefinitions="140,*" MarginBottom="4">
                                    <TextBlock x:Name="PagesLabel" Classes="Label" Text="{Localize PrintStrings.Pages}"/>
                                    <SegmentedControl x:Name="PART_Range" Grid.Column="1"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=PagesLabel}"
                                                      EnumType="{x:Type PageRangeKind}"
                                                      SelectedItem="{TemplateBinding RangeKind, Mode=TwoWay}">
                                        <SegmentedControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize PrintStrings, Key={Binding}}"/>
                                            </DataTemplate>
                                        </SegmentedControl.ItemTemplate>
                                    </SegmentedControl>
                                </Grid>
                                <Grid ColumnDefinitions="140,*" MarginBottom="8">
                                    <TextBox x:Name="PART_RangeText" Grid.Column="1"
                                             AutomationProperties.Name="{Localize PrintStrings.ChosenPages}"
                                             Placeholder="{Localize PrintStrings.ChosenPagesHint}"
                                             ShowsClearButton="True"
                                             Text="{TemplateBinding RangeText, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="RangeErrorRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock Grid.Column="1" TextWrapping="WrapByWords"
                                               Foreground="{ObservableResource SystemFillColorCaution}"
                                               Text="{Localize PrintStrings.NoSuchPages}"/>
                                </Grid>

                                <Grid ColumnDefinitions="140,*" MarginBottom="8">
                                    <TextBlock x:Name="OrientationLabel" Classes="Label" Text="{Localize PrintStrings.Orientation}"/>
                                    <SegmentedControl x:Name="PART_Orientation" Grid.Column="1"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=OrientationLabel}"
                                                      EnumType="{x:Type PageOrientation}"
                                                      SelectedItem="{TemplateBinding Orientation, Mode=TwoWay}">
                                        <SegmentedControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize PrintStrings, Key={Binding}}"/>
                                            </DataTemplate>
                                        </SegmentedControl.ItemTemplate>
                                    </SegmentedControl>
                                </Grid>

                                <Grid ColumnDefinitions="140,*" MarginBottom="8">
                                    <TextBlock x:Name="PaperLabel" Classes="Label" Text="{Localize PrintStrings.Paper}"/>
                                    <DropDown x:Name="PART_Paper" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=PaperLabel}"
                                              ItemsSource="{TemplateBinding Papers}"
                                              SelectedItem="{TemplateBinding Paper, Mode=TwoWay}">
                                        <DropDown.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </DropDown.ItemTemplate>
                                    </DropDown>
                                </Grid>

                                <Grid ColumnDefinitions="140,*" MarginBottom="8">
                                    <TextBlock x:Name="MarginsLabel" Classes="Label" Text="{Localize PrintStrings.Margins}"/>
                                    <DropDown x:Name="PART_Margins"
                                              Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=MarginsLabel}"
                                              ItemsSource="{TemplateBinding MarginsChoices}"
                                              SelectedValuePath="Margins"
                                              SelectedValue="{TemplateBinding Margins, Mode=TwoWay}">
                                        <DropDown.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize PrintMarginsStrings, Key={Binding Key}}"/>
                                            </DataTemplate>
                                        </DropDown.ItemTemplate>
                                    </DropDown>
                                </Grid>
                                <Grid x:Name="CustomMarginsRow"
                                      ColumnDefinitions="Auto,*,Auto,*"
                                      RowDefinitions="Auto,Auto"
                                      MarginBottom="8"
                                      Visibility="Collapsed">
                                    <TextBlock x:Name="MarginTopLabel"
                                               Classes="Label"
                                               Text="{Localize PrintStrings.MarginTop}"
                                               MarginRight="8"/>
                                    <NumericUpDown x:Name="PART_MarginTop"
                                                   Grid.Column="1"
                                                   MarginRight="12"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=MarginTopLabel}"
                                                   Minimum="{TemplateBinding PaperMarginTopMinimum}"
                                                   Maximum="{TemplateBinding PaperMarginTopMaximum}"
                                                   SmallChange="{TemplateBinding MarginsStep}"
                                                   Unit="{Localize PrintStrings, Key={TemplateBinding MarginsUnit}}"
                                                   Value="{TemplateBinding PaperMarginTop, Mode=TwoWay}"/>
                                    <TextBlock x:Name="MarginBottomLabel"
                                               Grid.Column="2"
                                               Classes="Label"
                                               Text="{Localize PrintStrings.MarginBottom}"
                                               MarginRight="8"/>
                                    <NumericUpDown x:Name="PART_MarginBottom"
                                                   Grid.Column="3"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=MarginBottomLabel}"
                                                   Minimum="{TemplateBinding PaperMarginBottomMinimum}"
                                                   Maximum="{TemplateBinding PaperMarginBottomMaximum}"
                                                   SmallChange="{TemplateBinding MarginsStep}"
                                                   Unit="{Localize PrintStrings, Key={TemplateBinding MarginsUnit}}"
                                                   Value="{TemplateBinding PaperMarginBottom, Mode=TwoWay}"/>
                                    <TextBlock x:Name="MarginLeftLabel"
                                               Grid.Row="1"
                                               Classes="Label"
                                               Text="{Localize PrintStrings.MarginLeft}"
                                               MarginRight="8"
                                               MarginTop="6"/>
                                    <NumericUpDown x:Name="PART_MarginLeft"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   MarginRight="12"
                                                   MarginTop="6"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=MarginLeftLabel}"
                                                   Minimum="{TemplateBinding PaperMarginLeftMinimum}"
                                                   Maximum="{TemplateBinding PaperMarginLeftMaximum}"
                                                   SmallChange="{TemplateBinding MarginsStep}"
                                                   Unit="{Localize PrintStrings, Key={TemplateBinding MarginsUnit}}"
                                                   Value="{TemplateBinding PaperMarginLeft, Mode=TwoWay}"/>
                                    <TextBlock x:Name="MarginRightLabel"
                                               Grid.Row="1"
                                               Grid.Column="2"
                                               Classes="Label"
                                               Text="{Localize PrintStrings.MarginRight}"
                                               MarginRight="8"
                                               MarginTop="6"/>
                                    <NumericUpDown x:Name="PART_MarginRight"
                                                   Grid.Row="1"
                                                   Grid.Column="3"
                                                   MarginTop="6"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=MarginRightLabel}"
                                                   Minimum="{TemplateBinding PaperMarginRightMinimum}"
                                                   Maximum="{TemplateBinding PaperMarginRightMaximum}"
                                                   SmallChange="{TemplateBinding MarginsStep}"
                                                   Unit="{Localize PrintStrings, Key={TemplateBinding MarginsUnit}}"
                                                   Value="{TemplateBinding PaperMarginRight, Mode=TwoWay}"/>
                                </Grid>

                                <Grid ColumnDefinitions="140,*" MarginBottom="8">
                                    <TextBlock x:Name="ScaleLabel" Classes="Label" Text="{Localize PrintStrings.Scale}"/>
                                    <DropDown x:Name="PART_Scaling" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=ScaleLabel}"
                                              EnumType="{x:Type PrintScaling}"
                                              SelectedItem="{TemplateBinding Scaling, Mode=TwoWay}">
                                        <DropDown.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize PrintStrings, Key={Binding}}"/>
                                            </DataTemplate>
                                        </DropDown.ItemTemplate>
                                    </DropDown>
                                </Grid>
                                <Grid x:Name="ScaleRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <NumericUpDown x:Name="PART_ScalePercent" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                   AutomationProperties.Name="{Localize PrintStrings.ScalePercent}"
                                                   Minimum="10" Maximum="400" Unit="%"
                                                   Value="{TemplateBinding ScalePercent, Mode=TwoWay}"/>
                                </Grid>

                                <Grid ColumnDefinitions="140,*" MarginBottom="8">
                                    <TextBlock x:Name="PerSheetLabel" Classes="Label" Text="{Localize PrintStrings.PagesPerSheet}"/>
                                    <DropDown x:Name="PART_PagesPerSheet" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=PerSheetLabel}"
                                              ItemsSource="{Ancestor PrintDialog, PagesPerSheetChoices}"
                                              SelectedItem="{TemplateBinding PagesPerSheet, Mode=TwoWay}"/>
                                </Grid>

                                <Grid x:Name="DuplexRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock x:Name="DuplexLabel" Classes="Label" Text="{Localize PrintStrings.TwoSided}"/>
                                    <DropDown x:Name="PART_Duplex" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=DuplexLabel}"
                                              ItemsSource="{TemplateBinding Duplexes}"
                                              SelectedItem="{TemplateBinding Duplex, Mode=TwoWay}">
                                        <DropDown.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize PrintStrings, Key={Binding}}"/>
                                            </DataTemplate>
                                        </DropDown.ItemTemplate>
                                    </DropDown>
                                </Grid>
                                <Grid x:Name="ColorRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock x:Name="ColorLabel" Classes="Label" Text="{Localize PrintStrings.ColorMode}"/>
                                    <SegmentedControl x:Name="PART_Color" Grid.Column="1"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=ColorLabel}"
                                                      ItemsSource="{TemplateBinding Colors}"
                                                      SelectedItem="{TemplateBinding Color, Mode=TwoWay}">
                                        <SegmentedControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Localize PrintStrings, Key={Binding}}"/>
                                            </DataTemplate>
                                        </SegmentedControl.ItemTemplate>
                                    </SegmentedControl>
                                </Grid>
                                <Grid x:Name="QualityRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock x:Name="QualityLabel" Classes="Label" Text="{Localize PrintStrings.Quality}"/>
                                    <DropDown x:Name="PART_Quality" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=QualityLabel}"
                                              ItemsSource="{TemplateBinding Qualities}"
                                              SelectedItem="{TemplateBinding Quality, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="TrayRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock x:Name="TrayLabel" Classes="Label" Text="{Localize PrintStrings.Tray}"/>
                                    <DropDown x:Name="PART_Tray" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=TrayLabel}"
                                              ItemsSource="{TemplateBinding Trays}"
                                              SelectedItem="{TemplateBinding Tray, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="MediaTypeRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock x:Name="MediaTypeLabel" Classes="Label" Text="{Localize PrintStrings.MediaType}"/>
                                    <DropDown x:Name="PART_MediaType" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=MediaTypeLabel}"
                                              ItemsSource="{TemplateBinding MediaTypes}"
                                              SelectedItem="{TemplateBinding MediaType, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="RasterRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <TextBlock x:Name="RasterLabel" Classes="Label" Text="{Localize PrintStrings.RasterResolution}"/>
                                    <DropDown x:Name="PART_Raster" Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=RasterLabel}"
                                              ItemsSource="{Ancestor PrintDialog, RasterChoices}"
                                              SelectedItem="{TemplateBinding RasterResolution, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="DriverSettingsRow" ColumnDefinitions="140,*" MarginBottom="8" Visibility="Collapsed">
                                    <Button x:Name="PART_DriverSettings" Grid.Column="1" HorizontalAlignment="Left"
                                            Content="{Localize PrintStrings.PrinterSettings}"
                                            Command="{TemplateBinding DriverSettingsCommand}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Along the bottom: leave, or print. -->
                        <Border x:Name="ButtonBar" Grid.Row="1" Grid.ColumnSpan="2"
                                Background="{ResourceReference SolidBackgroundFillColorSecondary}"
                                BorderBrush="{ResourceReference ControlStrokeColorDefault}" BorderThickness="0 1 0 0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18 12">
                                <Button x:Name="PART_Cancel" Content="{Localize PrintStrings.Cancel}" IsCancel="True"
                                        Command="{TemplateBinding CancelCommand}" MinWidth="100" MarginRight="8"/>
                                <Button x:Name="PART_Print" Classes="Accent" Content="{Localize PrintStrings.Print}" IsDefault="True"
                                        Command="{TemplateBinding PrintCommand}" MinWidth="100"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="PrintDialog">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowsCopies" Value="true"/>
                <Condition Property="IsInline" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="CopiesRow" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ShowsCopies" Value="true"/>
                <Condition Property="IsInline" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="InlineCopies" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <PropertyTrigger Property="IsInline" Value="true">
            <Setter TargetName="InlinePrintRow" Property="Visibility" Value="Visible"/>
            <Setter TargetName="ButtonBar" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPrinting" Value="true">
            <Setter TargetName="Options" Property="IsEnabled" Value="False"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsCustomMargins" Value="true">
            <Setter TargetName="CustomMarginsRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsCollate" Value="true">
            <Setter TargetName="CollateRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsScale" Value="true">
            <Setter TargetName="ScaleRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsDuplex" Value="true">
            <Setter TargetName="DuplexRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsColor" Value="true">
            <Setter TargetName="ColorRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsQuality" Value="true">
            <Setter TargetName="QualityRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsTray" Value="true">
            <Setter TargetName="TrayRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsMediaType" Value="true">
            <Setter TargetName="MediaTypeRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="PrintsToFile" Value="true">
            <Setter TargetName="PART_Print" Property="Content" Value="{Localize PrintStrings.Save}"/>
            <Setter TargetName="PART_InlinePrint" Property="Content" Value="{Localize PrintStrings.Save}"/>
            <Setter TargetName="RasterRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsDriverSettings" Value="true">
            <Setter TargetName="DriverSettingsRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowsPrinterState" Value="true">
            <Setter TargetName="PART_PrinterState" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsAsking" Value="true">
            <Setter TargetName="PART_Asking" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="RangeIsValid" Value="false">
            <Setter TargetName="RangeErrorRow" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
