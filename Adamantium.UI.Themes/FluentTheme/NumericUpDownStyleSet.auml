<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- NumericUpDown: one framed row with a chromeless editor in the starred middle column and four Auto seats for the
         buttons. Properties, template, placement, states. -->

    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingFieldFlat}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NumericUpDown">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,Auto,*,*,Auto,Auto">
                            <!-- Rows: a pair over the number, the number, a pair under it. Columns: seats 0 and 1 are
                                 the left pair, 4 and 5 the right pair; the two starred halve the width, so a pair over
                                 or under the number spans 0-2 and 3-5. The default is Split along: the two outermost. -->
                            <RepeatButton x:Name="PART_Decrease" Grid.Row="1" Grid.Column="0"
                                    Width="{TemplateBinding ButtonsWidth}"
                                    Content="{TemplateBinding DecreaseButtonContent}"
                                    Delay="{TemplateBinding Delay}"
                                    Interval="{TemplateBinding RepeatInterval}"
                                    Focusable="{TemplateBinding AreButtonsFocusable}"
                                    FontSize="{TemplateBinding FontSize}"
                                    BorderThickness="0" CornerRadius="0" Padding="0"
                                    MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Stretch"/>
                            <!-- The number, and what it counts beside it - under it, down the side. -->
                            <DockPanel x:Name="ValueArea" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                       Margin="{TemplateBinding Padding}">
                                <TextBlock x:Name="UnitText" DockPanel.Dock="Right"
                                           Text="{TemplateBinding Unit}"
                                           Foreground="{ObservableResource TextFillColorSecondary}"
                                           FontSize="{ResourceReference FontSizeCaption}"
                                           Margin="{ResourceReference NumericUnitInset}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <TextBox x:Name="PART_TextBox"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Center">
                                    <!-- The embedded editor gets a bare template, so the TextBox theme's state triggers
                                         find no PART_Border to restyle. -->
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                                <TextPresenter x:Name="PART_TextPresenter"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </DockPanel>
                            <RepeatButton x:Name="PART_Increase" Grid.Row="1" Grid.Column="5"
                                    Width="{TemplateBinding ButtonsWidth}"
                                    Content="{TemplateBinding IncreaseButtonContent}"
                                    Delay="{TemplateBinding Delay}"
                                    Interval="{TemplateBinding RepeatInterval}"
                                    Focusable="{TemplateBinding AreButtonsFocusable}"
                                    FontSize="{TemplateBinding FontSize}"
                                    BorderThickness="0" CornerRadius="0" Padding="0"
                                    MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Placement: which seat each button takes. Split-unswapped is the template's own arrangement, so only the other
         five combinations are stated. Swapping is a separate condition rather than five more placements, which is what
         keeps this to one row per case instead of one per product. -->
    <Style Selector="NumericUpDown">
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Split"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="5"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Left"/>
                <Condition Property="AreButtonsSwapped" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="1"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Left"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="1"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Right"/>
                <Condition Property="AreButtonsSwapped" Value="false"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="4"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="5"/>
        </MultiTrigger>

        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Right"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="4"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="5"/>
        </MultiTrigger>

        <!-- A pair over the number, each button half its width. -->
        <PropertyTrigger Property="ButtonsPlacement" Value="Top">
            <Setter TargetName="PART_Decrease" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.ColumnSpan" Value="3"/>
            <Setter TargetName="PART_Decrease" Property="Width" Value="Auto"/>
            <Setter TargetName="PART_Increase" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="3"/>
            <Setter TargetName="PART_Increase" Property="Grid.ColumnSpan" Value="3"/>
            <Setter TargetName="PART_Increase" Property="Width" Value="Auto"/>
            <Setter TargetName="ValueArea" Property="Grid.Column" Value="0"/>
            <Setter TargetName="ValueArea" Property="Grid.ColumnSpan" Value="6"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Top"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="3"/>
        </MultiTrigger>

        <!-- ...or under it. -->
        <PropertyTrigger Property="ButtonsPlacement" Value="Bottom">
            <Setter TargetName="PART_Decrease" Property="Grid.Row" Value="2"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.ColumnSpan" Value="3"/>
            <Setter TargetName="PART_Decrease" Property="Width" Value="Auto"/>
            <Setter TargetName="PART_Increase" Property="Grid.Row" Value="2"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="3"/>
            <Setter TargetName="PART_Increase" Property="Grid.ColumnSpan" Value="3"/>
            <Setter TargetName="PART_Increase" Property="Width" Value="Auto"/>
            <Setter TargetName="ValueArea" Property="Grid.Column" Value="0"/>
            <Setter TargetName="ValueArea" Property="Grid.ColumnSpan" Value="6"/>
        </PropertyTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="ButtonsPlacement" Value="Bottom"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="3"/>
        </MultiTrigger>

        <!-- Vertical, Split stands one over the number, one under it; stated last, so it wins over Split along. -->
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="Orientation" Value="Vertical"/>
                <Condition Property="ButtonsPlacement" Value="Split"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Decrease" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.ColumnSpan" Value="6"/>
            <Setter TargetName="PART_Decrease" Property="Width" Value="Auto"/>
            <Setter TargetName="PART_Increase" Property="Grid.Row" Value="2"/>
            <Setter TargetName="PART_Increase" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_Increase" Property="Grid.ColumnSpan" Value="6"/>
            <Setter TargetName="PART_Increase" Property="Width" Value="Auto"/>
            <Setter TargetName="ValueArea" Property="Grid.Column" Value="0"/>
            <Setter TargetName="ValueArea" Property="Grid.ColumnSpan" Value="6"/>
        </MultiTrigger>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="Orientation" Value="Vertical"/>
                <Condition Property="ButtonsPlacement" Value="Split"/>
                <Condition Property="AreButtonsSwapped" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="PART_Increase" Property="Grid.Row" Value="0"/>
            <Setter TargetName="PART_Decrease" Property="Grid.Row" Value="2"/>
        </MultiTrigger>
    </Style>

    <!-- Vertical: as narrow as its number - the box's own minimum along goes - the number centered, its unit under it. A
         box on the column of a bar down the side stands so unless it is set otherwise. -->
    <Style Selector="NumericUpDown">
        <PropertyTrigger Property="ToolBar.CommandOrientation" Value="Vertical">
            <Setter Property="Orientation" Value="Vertical"/>
        </PropertyTrigger>
        <PropertyTrigger Property="HasUnit" Value="true">
            <Setter TargetName="UnitText" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="Orientation" Value="Vertical">
            <Setter Property="MinWidth" Value="0"/>
            <!-- The entry as wide as its number, in the middle. -->
            <Setter TargetName="PART_TextBox" Property="HorizontalAlignment" Value="Center"/>
            <Setter TargetName="UnitText" Property="DockPanel.Dock" Value="Bottom"/>
            <Setter TargetName="UnitText" Property="HorizontalAlignment" Value="Center"/>
            <Setter TargetName="UnitText" Property="Margin" Value="0"/>
            <Setter TargetName="ValueArea" Property="Margin" Value="{ResourceReference NumericNarrowPadding}"/>
        </PropertyTrigger>
    </Style>

    <!-- States. Read-only and "no typing allowed" both mean the same thing to the editor - it must not accept a
         keystroke - so both project onto its IsReadOnly rather than the control policing every input path itself. -->
    <Style Selector="NumericUpDown">
        <PropertyTrigger Property="AreButtonsVisible" Value="false">
            <Setter TargetName="PART_Decrease" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_Increase" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsReadOnly" Value="true">
            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="true"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsManualEntryEnabled" Value="false">
            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="true"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorDisabled}"/>
            <Setter TargetName="PART_TextBox" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
