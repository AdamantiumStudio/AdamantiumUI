<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The classless indicator: a sweeping arc over a dim ring. Named variants live in Shared/BusyEffectsStyleSet. -->

    <Style Selector="BusyIndicator">
        <Setter Property="Width" Value="{ResourceReference BusySize}"/>
        <Setter Property="Height" Value="{ResourceReference BusySize}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="BusyIndicator">
                    <Grid>
                        <!-- The dim full ring the arc travels over. -->
                        <Ellipse Stroke="{ResourceReference ControlFillColorTertiary}"
                                          StrokeThickness="{ResourceReference BusyArcThickness}"
                                          Fill="Transparent"
                                          EllipseType="EdgeToEdge"/>
                        <!-- The accent arc; it is the ARC that spins. RenderTransformOrigin is a FRACTION of the element's
                             own size, so the arc turns about its center at ANY size the control is given - an absolute
                             pixel center would be correct only at the one size this template happened to be written for. -->
                        <Ellipse Stroke="{ThemeResource AccentFillColorDefault}"
                                          StrokeThickness="{ResourceReference BusyArcThickness}"
                                          Fill="Transparent"
                                          EllipseType="EdgeToEdge"
                                          StartAngle="0"
                                          StopAngle="90"
                                          RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <Transform x:Name="RingSpin"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The loop never ends by itself (IterationCount="Infinity"), so it is STOPPED on the way out: a looping animation
         on a detached element is a leak. -->
    <Style Selector="BusyIndicator">
        <PropertyTrigger Property="IsActive" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="RingSpin">
                    <Animation Duration="0:0:1.1" IterationCount="Infinity">
                        <KeyFrame Cue="0"><Setter Property="RotationAngle" Value="0"/></KeyFrame>
                        <KeyFrame Cue="1"><Setter Property="RotationAngle" Value="360"/></KeyFrame>
                    </Animation>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="RingSpin"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

</StyleSet>
