<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- One frame round all the segments, which stand side by side inside it with a hairline between; the chosen one is
         filled with the accent. The frame clips them, so the first and last take its rounded corners. -->

    <Style Selector="SegmentedControl">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" IsVirtualizing="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="SegmentedControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SegmentedControl">
                    <!-- No focus ring here - the application has ONE, drawn by the FocusAdorner. -->
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A disabled control fades whole: its segments do not inherit its state. -->
    <Style Selector="SegmentedControl">
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="Frame" Property="Opacity" Value="0.4"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="SegmentedControlItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1 0 0 0"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference SubtleFillColorSecondary}"/>
        <Setter Property="BackgroundSelected" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="ForegroundSelected" Value="{ThemeResource AccentForegroundColor}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="10 0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="SegmentedControlItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SegmentedControlItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="SegmentedControlItem">
        <PropertyTrigger Property="IsFirst" Value="true">
            <Setter TargetName="Chrome" Property="BorderThickness" Value="0"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
        <!-- After the hover, so the chosen one keeps its accent under the pointer. -->
        <PropertyTrigger Property="IsSelected" Value="true">
            <Setter TargetName="Chrome" Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{TemplateBinding ForegroundSelected}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsEnabled" Value="false">
            <Setter TargetName="PART_ContentPresenter" Property="Foreground" Value="{ResourceReference TextFillColorDisabled}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
