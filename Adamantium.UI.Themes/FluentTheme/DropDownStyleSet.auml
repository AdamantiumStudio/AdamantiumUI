<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- DropDown: a header (PART_Header, shows DisplayContent = selected item or placeholder, plus a chevron) over a
         Popup list (PART_Popup -> Border -> ScrollViewer -> PART_ItemsPresenter). The control opens/closes and positions
         the popup in code; the popup is edge-aware (FlipToFit) and its width tracks the header. Per the small-styles
         convention: properties, then template, then triggers. -->

    <Style Selector="DropDown" BasedOn="ItemsControl">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="BackgroundPointerOver" Value="{ResourceReference ControlFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingDropDown}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDown">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DropDown">
                    <Grid>
                        <Border x:Name="PART_Header"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter
                                        x:Name="PART_ContentPresenter"
                                        TextTrimming="CharEllipses"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Content="{TemplateBinding DisplayContent}"
                                        ContentTemplate="{TemplateBinding ItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <!-- An editable one's value is typed here; a bare editor, as the spin box's. -->
                                <TextBox x:Name="PART_EditableTextBox"
                                        Visibility="Collapsed"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Center">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                                <TextPresenter x:Name="PART_TextPresenter"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <Image x:Name="Chevron" Grid.Column="1"
                                        Source="{ResourceReference ChevronDownIcon}"
                                        Width="{ResourceReference DropDownIconSize}"
                                        Height="{ResourceReference DropDownIconSize}"
                                        Margin="8 0 0 0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                                Placement="Bottom" FlipToFit="True" VerticalOffset="2">
                            <!-- The list builds lazily on first open (ChildTemplate). The popup's DataContext is the
                                 DropDown, so plain {Binding}s reach it where {TemplateBinding} cannot. -->
                            <Popup.ChildTemplate>
                                <ControlTemplate TargetType="Popup">
                                    <Border Background="{ResourceReference FlyoutSurfaceFill}"
                                            BorderBrush="{ResourceReference ControlStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="2"
                                            MinWidth="{Binding ActualWidth}">
                                        <ScrollViewer MaxHeight="{Binding MaxDropDownHeight}"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Popup.ChildTemplate>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="DropDown">
        <PropertyTrigger Property="IsPointerOver" Value="true">
            <Setter TargetName="PART_Header" Property="Background" Value="{TemplateBinding BackgroundPointerOver}"/>
        </PropertyTrigger>
    </Style>

    <Style Selector="DropDown">
        <PropertyTrigger Property="IsEditable" Value="true">
            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
