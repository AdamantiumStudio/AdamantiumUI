<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Circular progress gauge: a dim full ring under an accent arc RingProgressBar sweeps to Percentage. The control is
         always square (MeasureOverride), so Center alignment lets arrange settle onto that square. Per the small-styles
         convention each concern is its own <Style>. -->

    <Style Selector="RingProgressBar">
        <Setter Property="MinWidth" Value="{ResourceReference RingSize}"/>
        <Setter Property="MinHeight" Value="{ResourceReference RingSize}"/>
        <Setter Property="RingThickness" Value="{ResourceReference RingThickness}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
    </Style>

    <Style Selector="RingProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RingProgressBar">
                    <Grid>
                        <!-- The ring is a shape: Ellipse.RingThickness makes an inward band, swept as an annular sector
                             with radial ends, leaving the stroke free. -->
                        <Ellipse Fill="{ResourceReference ControlFillColorTertiary}"
                                RingThickness="{TemplateBinding RingThickness}"
                                EllipseType="Sector"/>
                        <Ellipse x:Name="PART_Indicator"
                                Fill="{ThemeResource AccentFillColorDefault}"
                                RingThickness="{TemplateBinding RingThickness}"
                                EllipseType="Sector"
                                StartAngle="0"
                                StopAngle="0"
                                RenderTransformOrigin="0.5,0.5"/>
                        <TextBlock x:Name="PART_ValueText"
                                Text="{TemplateBinding ValueText}"
                                Visibility="Collapsed"
                                FontSize="{ResourceReference FontSizeSubtitle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalTextAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Center percentage label, opt-in via ShowValueText. -->
    <Style Selector="RingProgressBar">
        <PropertyTrigger Property="ShowValueText" Value="true">
            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
