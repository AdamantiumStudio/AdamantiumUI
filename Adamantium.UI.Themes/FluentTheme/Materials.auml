<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns="http://adamantium/ui">

    <!-- The theme's materials. Keys name roles (FlyoutSurfaceFill), so other themes can answer with another material.
         Acrylic only for transient surfaces, since it captures every frame; solid palette keys remain as fallback.
         Tints come from the palette via {ObservableResource}, so variant switches reach these brushes. -->

    <!-- The flyout surface (menus, drop-downs, ribbon flyout, color picker popup): tint 0.78 keeps text legible over
         anything; blur is the outer Gaussian tap reach over a 4x-downscaled copy. -->
    <MaterialBrush x:Key="FlyoutSurfaceFill"
                   Material="Acrylic"
                   TintColor="{ObservableResource AcrylicFillColorDefault}"
                   TintOpacity="0.78"
                   BlurAmount="28"
                   NoiseAmount="0.03"/>

    <!-- The same material, thinner, for surfaces that sit CLOSE to what they cover and want to be felt through:
         a tooltip, which is small enough that a heavy tint reads as a black box. -->
    <MaterialBrush x:Key="TooltipSurfaceFill"
                   Material="Acrylic"
                   TintColor="{ObservableResource AcrylicFillColorDefault}"
                   TintOpacity="0.70"
                   BlurAmount="20"
                   NoiseAmount="0.03"/>

</ResourceDictionary>
