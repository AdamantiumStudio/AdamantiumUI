<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- THE WHOLE CANVAS FAMILY, in one file: the plane itself, the panes of its chrome, the bars that ride in them and
         the nodes that stand on it. None of these is a control anybody uses on its own - a pane outside a canvas is
         nothing - so their styles are never something to go hunting for elsewhere in a theme. -->

    <!-- InfiniteCanvas draws its own ground, grid and axes; this sets the look. An opaque ground keeps the plane
         pressable for panning. -->
    <Style Selector="InfiniteCanvas">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="DeleteTitle" Value="{Localize CanvasStrings.DeleteTitle}"/>
        <Setter Property="ClearTitle" Value="{Localize CanvasStrings.ClearCanvas}"/>
        <!-- The words the canvas names its tools and new things with. -->
        <Setter Property="Phrases" Value="{x:Static CanvasStrings.Current}"/>
        <!-- Its own palette entry, not a control's hairline: the grid is a ruler the user reads while working, and the
             strokes that separate controls are meant to go unnoticed. Borrowing one left the grid invisible. -->
        <Setter Property="GridBrush" Value="{ObservableResource CanvasGridColor}"/>
        <!-- The world's own axes stand out from the grid, or there is nothing on an edgeless plane saying where the
             origin went. -->
        <Setter Property="AxisBrush" Value="{ObservableResource CanvasAxisColor}"/>
        <Setter Property="GridThickness" Value="1"/>
        <Setter Property="GridDotSize" Value="2"/>
        <Setter Property="SnapMarkBrush" Value="{ThemeResource AccentFillColorDefault}"/>

        <!-- The manipulation frame and its grips: the accent, because what is selected is what the next action applies
             to, and the band, which is translucent so it does not hide what it is being dragged round. -->
        <Setter Property="SelectionBrush" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="HandleBrush" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="RubberBandBrush" Value="{ObservableResource CanvasBandColor}"/>
        <Setter Property="HandleSize" Value="9"/>

        <Setter Property="MinInspectorWidth" Value="200"/>
        <Setter Property="InspectorWidth" Value="340"/>

        <!-- The inspector's panel: open, the inspector with the button that folds it beside its faces, by the plane's edge;
             folded, a strip that opens it again. -->
        <Setter Property="InspectorPanelTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Background="{ObservableResource SolidBackgroundFillColorSecondary}">
                        <Grid>
                            <Grid x:Name="Open" Margin="10">
                                <CanvasInspector ShowsDrawingActions="{Ancestor InfiniteCanvas, ShowsDrawingActions}"/>
                                <Button x:Name="FoldButton" Width="24" Height="22" MinWidth="0" MinHeight="0" Padding="0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="2"
                                        ToolTip="{Localize CanvasStrings.FoldInspector}"
                                        Command="{Ancestor InfiniteCanvas, FoldInspectorCommand}">
                                    <Image Source="{ObservableResource CanvasFoldInspectorIcon}" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="Folded" Orientation="Vertical" Width="36" MinWidth="0" Margin="0 10"
                                        Visibility="Collapsed">
                                <Button x:Name="UnfoldButton" Width="24" Height="22" MinWidth="0" MinHeight="0" Padding="0"
                                        HorizontalAlignment="Center" MarginTop="2"
                                        ToolTip="{Localize CanvasStrings.UnfoldInspector}"
                                        Command="{Ancestor InfiniteCanvas, FoldInspectorCommand}">
                                    <Image Source="{ObservableResource CanvasUnfoldInspectorIcon}" Width="12" Height="12"/>
                                </Button>
                                <TextBlock Text="{Localize CanvasStrings.Inspector}" HorizontalAlignment="Center"
                                           MarginTop="12" Foreground="{ObservableResource TextFillColorSecondary}">
                                    <TextBlock.LayoutTransform>
                                        <Transform RotationAngle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Ancestor InfiniteCanvas, IsInspectorOpen}" Value="false">
                            <Setter TargetName="Open" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Folded" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- The overlay on the glass, fixed against the camera; the control places content and corner. Never stretched, or
             it would swallow drawing presses. The grip travels with its panel. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="InfiniteCanvas">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                    <!-- What the plane is looked at through, all that stands over it inside. -->
                    <Grid x:Name="PART_Viewport">
                        <!-- The plane's layers, filled by the canvas in scene order: runs of controls and runs of drawn
                             items each become a layer. -->
                        <Grid x:Name="PART_Layers"/>

                        <!-- THE GLASS: what a gesture is making and has not put down yet, over everything. It takes no
                             part in hit-testing. -->
                        <CanvasFrontLayer x:Name="PART_Front"/>

                        <StackPanel x:Name="PART_OverlayRoot" Orientation="Vertical" Margin="12">
                            <Button x:Name="PART_OverlayGrip" Classes="CanvasChrome" Width="30" Height="24"
                                    MinWidth="0" MinHeight="0" Padding="0"
                                    HorizontalAlignment="Left" MarginBottom="6"
                                    ToolTip="{Localize CanvasStrings.MovePanel}">
                                <Image Source="{ObservableResource CanvasGripIcon}" Width="12" Height="12"/>
                            </Button>
                            <ContentPresenter x:Name="PART_Overlay"/>
                        </StackPanel>

                        <!-- The plane's scroll bars: the canvas shows them only when the plane has edges and there is
                             somewhere to go along them, and places them inside what docked panes leave. -->
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" VerticalAlignment="Bottom"
                                   Visibility="Collapsed"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right"
                                   Visibility="Collapsed"/>

                        <!-- The panes above everything, placed by CanvasChromeLayer. The canvas's own chrome parts are
                             declared here (each can be switched off); the app's Chrome goes over them. -->
                        <CanvasChromeLayer x:Name="PART_Chrome" PaneInset="12" PaneGap="8">
                            <!-- The selection bar, first in paint order so edge panes draw over it; placed on the selection
                                 and shown only while something is selected. -->
                            <CanvasPane x:Name="PART_SelectionBar" Placement="Selection" Kind="Bar">
                                <CanvasSelectionBar/>
                            </CanvasPane>

                            <!-- The tool rail, built from the canvas's Tools; anchored top-left and given only the height
                                 above the map in the bottom corner, scrolling what does not fit; never shorter than
                                 its grip, so it can always be taken hold of. -->
                            <CanvasPane x:Name="PART_ToolRail" Placement="TopLeft" Kind="Rail" CanDrag="True" MinHeight="34"/>

                            <!-- The MAP, in the corner nothing else wants: the rail is up the left side, the view bar along
                                 the bottom middle. -->
                            <CanvasPane x:Name="PART_MiniMap" Placement="BottomLeft" Kind="Sheet" Header="{Localize CanvasStrings.Map}"
                                        CanDrag="True">
                                <CanvasMiniMap Width="190" Height="120" MinWidth="0" MinHeight="0"
                                               AutomationProperties.Name="{Localize CanvasStrings.WholePlane}"/>
                            </CanvasPane>

                            <!-- The VIEW BAR, docked so the plane's usable middle stops above it: "fit" and "home"
                                 center on what can actually be seen, and a bar lying over the bottom of the drawing
                                 would make them center on something else. -->
                            <CanvasPane x:Name="PART_ViewBar" Placement="BottomCenter" Kind="Bar"
                                        IsDocked="True" MinWidth="248">
                                <CanvasViewBar/>
                            </CanvasPane>
                        </CanvasChromeLayer>
                    </Grid>

                    <!-- The inspector's panel beside the plane, and the edge it is pulled by; folded, it is as wide as its
                         strip. -->
                    <GridSplitter x:Name="PART_InspectorSplitter" Grid.Column="1" Width="5"
                                  ResizeBehavior="PreviousAndNext"
                                  ToolTip="{Localize CanvasStrings.ResizePanel}"
                                  Background="{ObservableResource ControlStrokeColorDefault}"/>
                    <ContentPresenter x:Name="PART_Inspector" Grid.Column="2" Content="{TemplateBinding InspectorPanelData}"
                                      ContentTemplate="{TemplateBinding InspectorPanelTemplate}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- IsWanted and not Visibility: whether a pane is on screen has two answers - whether anybody
                             wants it and, for one that follows the selection, whether there is one to follow - and
                             written to the same property the later answer simply erases the earlier. See
                             CanvasPane.Settle. -->
                        <PropertyTrigger Property="ShowsToolRail" Value="false">
                            <Setter TargetName="PART_ToolRail" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsMiniMap" Value="false">
                            <Setter TargetName="PART_MiniMap" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsInspector" Value="false">
                            <Setter TargetName="PART_Inspector" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsInspectorUnfolded" Value="false">
                            <Setter TargetName="PART_InspectorSplitter" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsSelectionBar" Value="false">
                            <Setter TargetName="PART_SelectionBar" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsViewBar" Value="false">
                            <Setter TargetName="PART_ViewBar" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A DRAWING: the plane, and the words the dialogs that write and read its SVG use. -->
    <Style Selector="DrawingBoard" BasedOn="InfiniteCanvas">
        <Setter Property="ExportTitle" Value="{Localize CanvasStrings.ExportTitle}"/>
        <Setter Property="OpenTitle" Value="{Localize CanvasStrings.OpenTitle}"/>
        <Setter Property="DrawingsName" Value="{Localize CanvasStrings.Drawings}"/>
        <Setter Property="AllFilesName" Value="{Localize CanvasStrings.AllFiles}"/>
    </Style>

    <!-- A GRAPH: the plane's template with the node palette among its panes. -->
    <Style Selector="NodeGraph" BasedOn="InfiniteCanvas">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NodeGraph">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                    <Grid x:Name="PART_Viewport">
                        <Grid x:Name="PART_Layers"/>

                        <CanvasFrontLayer x:Name="PART_Front"/>

                        <StackPanel x:Name="PART_OverlayRoot" Orientation="Vertical" Margin="12">
                            <Button x:Name="PART_OverlayGrip" Classes="CanvasChrome" Width="30" Height="24"
                                    MinWidth="0" MinHeight="0" Padding="0"
                                    HorizontalAlignment="Left" MarginBottom="6"
                                    ToolTip="{Localize CanvasStrings.MovePanel}">
                                <Image Source="{ObservableResource CanvasGripIcon}" Width="12" Height="12"/>
                            </Button>
                            <ContentPresenter x:Name="PART_Overlay"/>
                        </StackPanel>

                        <CanvasChromeLayer x:Name="PART_Chrome" PaneInset="12" PaneGap="8">
                            <CanvasPane x:Name="PART_SelectionBar" Placement="Selection" Kind="Bar">
                                <CanvasSelectionBar/>
                            </CanvasPane>

                            <CanvasPane x:Name="PART_ToolRail" Placement="TopLeft" Kind="Rail" CanDrag="True" MinHeight="34"/>

                            <CanvasPane x:Name="PART_MiniMap" Placement="BottomLeft" Kind="Sheet" Header="{Localize CanvasStrings.Map}"
                                        CanDrag="True">
                                <CanvasMiniMap Width="190" Height="120" MinWidth="0" MinHeight="0"
                                               AutomationProperties.Name="{Localize CanvasStrings.WholePlane}"/>
                            </CanvasPane>

                            <!-- The NODE PALETTE, at the point where the wire was let go. A FREE pane rather than a
                                 popup: a pane already knows how to sit on the glass at a given offset and to stay
                                 inside the viewport, and a second machinery for the same job would be a second
                                 machinery. -->
                            <CanvasPane x:Name="PART_NodePalette" Placement="Free" Kind="Sheet" Header="{Localize CanvasStrings.AddNode}"
                                        CanDrag="True" Width="200"
                                        IsNeeded="{TemplateBinding IsPaletteOpen}">
                                <CanvasNodePalette/>
                            </CanvasPane>

                            <CanvasPane x:Name="PART_ViewBar" Placement="BottomCenter" Kind="Bar"
                                        IsDocked="True" MinWidth="248">
                                <CanvasViewBar/>
                            </CanvasPane>
                        </CanvasChromeLayer>
                    </Grid>

                    <!-- The inspector's panel beside the plane, and the edge it is pulled by; folded, it is as wide as its
                         strip. -->
                    <GridSplitter x:Name="PART_InspectorSplitter" Grid.Column="1" Width="5"
                                  ResizeBehavior="PreviousAndNext"
                                  ToolTip="{Localize CanvasStrings.ResizePanel}"
                                  Background="{ObservableResource ControlStrokeColorDefault}"/>
                    <ContentPresenter x:Name="PART_Inspector" Grid.Column="2" Content="{TemplateBinding InspectorPanelData}"
                                      ContentTemplate="{TemplateBinding InspectorPanelTemplate}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowsToolRail" Value="false">
                            <Setter TargetName="PART_ToolRail" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsMiniMap" Value="false">
                            <Setter TargetName="PART_MiniMap" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsInspector" Value="false">
                            <Setter TargetName="PART_Inspector" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsInspectorUnfolded" Value="false">
                            <Setter TargetName="PART_InspectorSplitter" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsNodePalette" Value="false">
                            <Setter TargetName="PART_NodePalette" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsSelectionBar" Value="false">
                            <Setter TargetName="PART_SelectionBar" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ShowsViewBar" Value="false">
                            <Setter TargetName="PART_ViewBar" Property="IsWanted" Value="false"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- A lone button of the canvas's chrome standing on the plane itself - the overlay's grip, which has no pane under
         it: on a solid plate of its own, as the map's buttons are, so it is seen over whatever is drawn under it, a
         white page included. The control fills are translucent and vanish there. -->
    <Style Selector="Button.CanvasChrome">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BackgroundPointerOver" Value="{ObservableResource SolidBackgroundFillColorTertiary}"/>
        <Setter Property="BackgroundPressed" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BackgroundDisabled" Value="{ObservableResource SolidBackgroundFillColorBase}"/>
    </Style>


    <!-- CanvasPane: a chrome panel on the glass with its own ground and border. Its grip drags and folds it, so a folded
         pane is just its grip. -->
    <Style Selector="CanvasPane">
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasPane">
                    <!-- DOCK and not a stack, both here and inside the body. A vertical stack measures its children
                         with INFINITE height, and a rail that is never told how much room there is can never know it
                         has to scroll - it just runs off the bottom of the canvas, or over the map, taking its last
                         tools with it. A dock hands the fill child what is actually left. -->
                    <!-- ONE PLATE for the whole pane, handles and all, solid and lifted by a shadow as the map's plates
                         are: a pane stands on whatever is drawn under it, a white page included, and buttons left
                         standing on the glass beside it vanish there. -->
                    <Grid>
                    <Border x:Name="PART_Plate"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Shadow>
                            <Shadow OffsetY="2" BlurRadius="8" Opacity="1" Color="#50000000"/>
                        </Border.Shadow>
                    <DockPanel LastChildFill="True">
                        <!-- The grip carries and folds; the turn button is beside it and does the one other thing a
                             panel can be asked about itself. Both above the body, so a folded pane is its handles. -->
                        <!-- The handles ride in a row of their OWN, named so it can be collapsed whole. Hiding only the
                             buttons left the row's own bottom margin behind, which made the plate taller than what is
                             in it - a bar looked lifted off its neighbors by a few pixels for no reason. -->
                        <StackPanel x:Name="PART_Handles" Orientation="Horizontal" DockPanel.Dock="Top"
                                    HorizontalAlignment="Left" MarginBottom="6">
                            <Button x:Name="PART_Grip" Width="30" Height="24"
                                    MinWidth="0" MinHeight="0" Padding="0" Focusable="False"
                                    ToolTip="{Localize CanvasStrings.MovePanel}">
                                <Image Source="{ObservableResource CanvasGripIcon}" Width="12" Height="12"/>
                            </Button>
                            <ToggleButton x:Name="PART_Snap" Width="30" Height="24" MarginLeft="4"
                                          MinWidth="0" MinHeight="0" Padding="0" Focusable="False"
                                          ToolTip="{Localize CanvasStrings.StickToEdge}">
                                <Image Source="{ObservableResource CanvasPaneSnapIcon}" Width="12" Height="12"/>
                            </ToggleButton>
                            <Button x:Name="PART_Turn" Width="30" Height="24" MarginLeft="4"
                                    MinWidth="0" MinHeight="0" Padding="0" Visibility="Collapsed" Focusable="False"
                                    ToolTip="{Localize CanvasStrings.ToolsLayout}">
                                <Image Source="{ObservableResource CanvasPaneTurnIcon}" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>

                        <Grid VerticalAlignment="Top">
                            <Border x:Name="PART_Body">
                                <DockPanel LastChildFill="True">
                                    <!-- The caption names what the panel is about. Quieter than the rows and colored
                                         OUTRIGHT: a presenter handed a bare string does not carry the pane's foreground
                                         down to the text it makes, so the caption came out drawn in nothing. -->
                                    <ContentPresenter x:Name="PART_Header" DockPanel.Dock="Top"
                                                      Content="{TemplateBinding Header}"
                                                      FontSize="12"
                                                      Foreground="{ObservableResource TextFillColorSecondary}"
                                                      MarginBottom="6"/>
                                    <ContentPresenter x:Name="PART_ContentPresenter" DockPanel.Dock="Top"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                    <!-- A rail pane's buttons come from the tools themselves; custom content needs
                                         another pane kind. One line of them, scrolled along its own direction when the
                                         room the canvas leaves is short - by the wheel or a finger, with no bar: a bar
                                         beside thirty-pixel buttons would be wider than the gap it scrolls past. -->
                                    <ScrollViewer x:Name="PART_RailScroll" Visibility="Collapsed"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <CanvasToolRail x:Name="PART_Rail"
                                                        Canvas="{TemplateBinding Canvas}"
                                                        Orientation="{TemplateBinding Orientation}"
                                                        ButtonWidth="30" ButtonHeight="28" IconSize="13" ButtonGap="4"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                    </Border>

                    <!-- Resize strips, one per side facing into the canvas (see CanvasPane.SyncSizer), over the plate's
                         OUTER edge - its border and padding, wider than a strip in every theme, so a strip never lies
                         over the content and never takes a press meant for the grip. Invisible: beside the plate they
                         were a strip of nothing catching the mouse. Three dots mark each: an edge nobody can see is an
                         edge nobody finds. -->
                    <Border x:Name="PART_SizerLeft" HorizontalAlignment="Left" Width="8" Visibility="Collapsed"
                            Background="Transparent" Cursor="SizeWE"
                            ToolTip="{Localize CanvasStrings.ResizePanel}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Cursor="SizeWE">
                            <Ellipse Width="3" Height="3" Fill="{ObservableResource TextFillColorSecondary}"/>
                            <Ellipse Width="3" Height="3" MarginTop="3" Fill="{ObservableResource TextFillColorSecondary}"/>
                            <Ellipse Width="3" Height="3" MarginTop="3" Fill="{ObservableResource TextFillColorSecondary}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PART_SizerRight" HorizontalAlignment="Right" Width="8" Visibility="Collapsed"
                            Background="Transparent" Cursor="SizeWE"
                            ToolTip="{Localize CanvasStrings.ResizePanel}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Cursor="SizeWE">
                            <Ellipse Width="3" Height="3" Fill="{ObservableResource TextFillColorSecondary}"/>
                            <Ellipse Width="3" Height="3" MarginTop="3" Fill="{ObservableResource TextFillColorSecondary}"/>
                            <Ellipse Width="3" Height="3" MarginTop="3" Fill="{ObservableResource TextFillColorSecondary}"/>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Collapsed and not merely hidden: hidden it would still take its place, and the grip would
                             sit exactly where it sat when the pane was open, having got nothing out of the way. -->
                        <PropertyTrigger Property="IsOpen" Value="false">
                            <Setter TargetName="PART_Body" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Handles" Property="MarginBottom" Value="0"/>
                        </PropertyTrigger>

                        <!-- A BAR is all content and no chrome: it is read at a glance beside the thing it acts on, and
                             a grip over it would be bigger than the bar. It is moved by its own background instead. -->
                        <PropertyTrigger Property="Kind" Value="Bar">
                            <Setter TargetName="PART_Handles" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Plate" Property="Padding" Value="4"/>
                        </PropertyTrigger>

                        <!-- ...unless it asks for its grip: then the handles stand at its start, beside the content. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Kind" Value="Bar"/>
                                <Condition Property="ShowsGrip" Value="true"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Handles" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Handles" Property="DockPanel.Dock" Value="Left"/>
                            <Setter TargetName="PART_Handles" Property="VerticalAlignment" Value="Center"/>
                            <Setter TargetName="PART_Handles" Property="MarginBottom" Value="0"/>
                            <Setter TargetName="PART_Handles" Property="MarginRight" Value="6"/>
                            <Setter TargetName="PART_Snap" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>

                        <!-- Folded, the grip is all there is: no gap after it. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Kind" Value="Bar"/>
                                <Condition Property="ShowsGrip" Value="true"/>
                                <Condition Property="IsOpen" Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Handles" Property="MarginRight" Value="0"/>
                        </MultiTrigger>

                        <!-- Only a RAIL offers the turn button: it is the one kind whose contents have a direction of
                             their own to argue about. Its plate is a narrow one: a pane catches the mouse across its
                             whole box, so a wide margin is canvas that cannot be drawn on. -->
                        <PropertyTrigger Property="Kind" Value="Rail">
                            <Setter TargetName="PART_Plate" Property="Padding" Value="4"/>
                            <Setter TargetName="PART_RailScroll" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Turn" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>

                        <!-- A rail turned across scrolls across. -->
                        <PropertyTrigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_RailScroll" Property="VerticalScrollBarVisibility" Value="Disabled"/>
                            <Setter TargetName="PART_RailScroll" Property="HorizontalScrollBarVisibility" Value="Hidden"/>
                        </PropertyTrigger>

                        <!-- ...and its handles run the way the tools do. Three buttons in a row are wider than one
                             column of tools, and it is the handles that were making the pane wide. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Kind" Value="Rail"/>
                                <Condition Property="Orientation" Value="Vertical"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Handles" Property="Orientation" Value="Vertical"/>
                            <!-- The gap moves with them: stacked, it belongs above each button and not beside it.
                                 Said side by side, because MarginLeft is its own property that OVERRIDES Margin.Left -
                                 setting Margin here left the template's MarginLeft standing, and the two lower handles
                                 sat four pixels right of the grip. -->
                            <Setter TargetName="PART_Snap" Property="MarginLeft" Value="0"/>
                            <Setter TargetName="PART_Snap" Property="MarginTop" Value="4"/>
                            <Setter TargetName="PART_Turn" Property="MarginLeft" Value="0"/>
                            <Setter TargetName="PART_Turn" Property="MarginTop" Value="4"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- The MAP. Its things are drawn in the quiet text color and the box round what is being looked at takes the
         accent: a map is read at a glance to find where you are, and where you are is the one thing on it that answers
         that. -->
    <Style Selector="CanvasMiniMap">
        <Setter Property="ItemBrush" Value="{ObservableResource TextFillColorSecondary}"/>
        <Setter Property="ViewBrush" Value="{ThemeResource AccentFillColorDefault}"/>
    </Style>

    <!-- The inspector: property grids for the tool (nothing selected) and the selection (a section per kind, shared
         values or "different"), plus a structure face listing the plane. -->
    <Style Selector="CanvasInspector">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasInspector">
                    <DockPanel LastChildFill="True">
                        <!-- The faces, at the far end of their row: the panel's fold button stands at the near one. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" MarginBottom="8">
                            <RadioButton Classes="Toggle" GroupName="CanvasInspectorFace"
                                         Height="26" MinWidth="0" MinHeight="0" Padding="10 0"
                                         Content="{Localize CanvasStrings.PropertiesFace}"
                                         ToolTip="{Localize CanvasStrings.Properties}"
                                         IsChecked="{TemplateBinding ShowsProperties, Mode=TwoWay}"/>
                            <RadioButton Classes="Toggle" GroupName="CanvasInspectorFace" MarginLeft="4"
                                         Height="26" MinWidth="0" MinHeight="0" Padding="10 0"
                                         Content="{Localize CanvasStrings.LayersFace}"
                                         ToolTip="{Localize CanvasStrings.Layers}"
                                         IsChecked="{TemplateBinding ShowsStructure, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                   FontSize="12" MarginBottom="6"
                                   Foreground="{ObservableResource TextFillColorSecondary}"/>

                        <!-- Whole-work actions, all canvas commands, as wrapping pictogram buttons with trailing gaps so
                             wrapped lines do not indent. -->
                        <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" MarginTop="8">
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.CommentFrame}"
                                    Command="{Ancestor CanvasInspector, FrameCommand}">
                                <Image Source="{ObservableResource CanvasFrameIcon}" Width="13" Height="13"/>
                            </Button>

                            <!-- PUTTING THE WORK IN ORDER. A plane has no grid to snap a row against, so lining up and
                                 spreading out are the only way a graph ever looks tidy. -->
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.AlignLeft}"
                                    Command="{Ancestor CanvasInspector, Canvas.AlignCommand}" CommandParameter="Left">
                                <Image Source="{ObservableResource CanvasAlignLeftIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.AlignCenter}"
                                    Command="{Ancestor CanvasInspector, Canvas.AlignCommand}"
                                    CommandParameter="HorizontalCenter">
                                <Image Source="{ObservableResource CanvasAlignMiddleIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.AlignRight}"
                                    Command="{Ancestor CanvasInspector, Canvas.AlignCommand}" CommandParameter="Right">
                                <Image Source="{ObservableResource CanvasAlignRightIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.AlignTop}"
                                    Command="{Ancestor CanvasInspector, Canvas.AlignCommand}" CommandParameter="Top">
                                <Image Source="{ObservableResource CanvasAlignTopIcon}" Width="13" Height="13"/>
                            </Button>

                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.DistributeVertically}"
                                    Command="{Ancestor CanvasInspector, Canvas.SpreadCommand}"
                                    CommandParameter="Vertical">
                                <Image Source="{ObservableResource CanvasSpreadRowsIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.DistributeHorizontally}"
                                    Command="{Ancestor CanvasInspector, Canvas.SpreadCommand}"
                                    CommandParameter="Horizontal">
                                <Image Source="{ObservableResource CanvasSpreadColumnsIcon}" Width="13" Height="13"/>
                            </Button>

                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                    Visibility="{TemplateBinding GraphActions}"
                                    ToolTip="{Localize CanvasStrings.FitToView}"
                                    Command="{Ancestor CanvasInspector, Canvas.FitViewCommand}">
                                <Image Source="{ObservableResource CanvasFitIcon}" Width="13" Height="13"/>
                            </Button>

                            <!-- Drawing import/export as SVG (graphs use JSON); importing adds to the plane. -->
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="2"
                                    Visibility="{TemplateBinding DrawingActions}"
                                    ToolTip="{Localize CanvasStrings.ExportSvg}"
                                    Command="{Ancestor CanvasInspector, ExportSvgCommand}">
                                <Image Source="{ObservableResource CanvasSaveIcon}" Width="13" Height="13"/>
                            </Button>
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" MarginRight="6"
                                    Visibility="{TemplateBinding DrawingActions}"
                                    ToolTip="{Localize CanvasStrings.OpenSvg}"
                                    Command="{Ancestor CanvasInspector, ImportSvgCommand}">
                                <Image Source="{ObservableResource CanvasOpenIcon}" Width="13" Height="13"/>
                            </Button>

                            <!-- THE BIN, last and on its own: it is the one button here that takes something away, and
                                 it is about the whole canvas rather than the graph, so it stays in a drawing too. It
                                 asks before it does anything - see ConfirmsDelete. -->
                            <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                    ToolTip="{Localize CanvasStrings.ClearCanvas}"
                                    Visibility="{TemplateBinding ClearAction}"
                                    Command="{Ancestor CanvasInspector, Canvas.ClearCommand}">
                                <Image Source="{ObservableResource CanvasBinIcon}" Width="13" Height="13"/>
                            </Button>
                        </WrapPanel>

                        <Grid>
                            <!-- The FIRST face: the tool in hand and the surface under it. It SCROLLS rather than being
                                 trimmed: a panel that runs off the bottom is one whose last row cannot be reached. -->
                            <ScrollViewer Visibility="{TemplateBinding ToolFace}"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                                <!-- NO LINES WRITTEN HERE. What a tool is set by is CONTENT, and it comes from a
                                     resource the panel looks up - see Shared/CanvasInspectorContent. A theme that
                                     carried the list would be a theme that has to be edited whenever the canvas gains
                                     a tool, three times over, and an application could never add a line to it. -->
                                <PropertyGrid x:Name="PART_Tool"
                                              SelectedObject="{TemplateBinding Canvas}"
                                              NameColumnWidth="92" ShowSearch="False"
                                              ResetButton="{Ancestor CanvasInspector, Canvas.ResetButton}"/>
                            </ScrollViewer>

                            <!-- The selection face, lines from Shared/CanvasInspectorContent by item type; each edit becomes
                                 a canvas history step, which redraws the plane. -->
                            <PropertyGrid x:Name="PART_Selected"
                                          Visibility="{TemplateBinding SelectionFace}"
                                          SelectedObjects="{TemplateBinding Selection}"
                                          NameColumnWidth="92" ShowSearch="False"
                                          ResetButton="{Ancestor CanvasInspector, Canvas.ResetButton}"/>

                            <!-- The THIRD face: what is on the plane, topmost first - the same order the drawing is
                                 stacked in, so "bring to front" needs no explaining. Clicking a row selects it on the
                                 plane, because there is one selection and not two; a DOUBLE click takes the camera to
                                 it, which is the only way to find something left far outside the viewport. -->
                            <!-- The item count over a tree of the plane (groups expand, topmost first); double click opens a
                                 group or moves the camera to an item. -->
                            <DockPanel Visibility="{TemplateBinding StructureFace}" LastChildFill="True">
                                <!-- How much is on the plane: a count, or that there is nothing - shown by the trigger
                                     below. -->
                                <TextBlock x:Name="ItemCountLabel" DockPanel.Dock="Top" MarginBottom="6"
                                           Text="{Localize CanvasStrings.Items, count={TemplateBinding FoundCount}}"
                                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                                <TextBlock x:Name="NothingDrawnLabel" DockPanel.Dock="Top" MarginBottom="6"
                                           Visibility="Collapsed"
                                           Text="{Localize CanvasStrings.NothingDrawn}"
                                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                                <!-- The plane searched by name: the list keeps what is called so. Ctrl+F on the plane
                                     comes here; Escape clears it. -->
                                <TextBox x:Name="PART_Find" DockPanel.Dock="Top" MarginBottom="6" Height="26"
                                         Padding="6 0 5 0" ShowsClearButton="True"
                                         ClearButtonToolTip="{Localize CanvasStrings.ClearFind}"
                                         Placeholder="{Localize CanvasStrings.FindOnPlane}"
                                         AutomationProperties.Name="{Localize CanvasStrings.FindOnPlane}"/>
                                <TreeView MinWidth="0"
                                          AutomationProperties.Name="{Localize CanvasStrings.Layers}"
                                          ItemsSource="{TemplateBinding Structure}"
                                          SelectedItem="{TemplateBinding Listed, Mode=TwoWay}"
                                          ItemActivatedCommand="{Ancestor CanvasInspector, Canvas.ZoomToCommand}">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Inside}">
                                            <!-- What it is, in the application's language; how many parts it has;
                                                 what it was called. -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Localize CanvasStrings, Key={Binding Sort}}"/>
                                                <TextBlock Text="{Binding Parts}" MarginLeft="6"
                                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                                                <TextBlock Text="{Binding Title}" MarginLeft="6" TextTrimming="CharEllipses"
                                                           Foreground="{ObservableResource TextFillColorSecondary}"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ItemCount" Value="0">
                            <Setter TargetName="ItemCountLabel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NothingDrawnLabel" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The node palette: the canvas's catalog in sections, filtered by typing; one template for sections and kinds, and
         only picking a kind places a node. -->
    <Style Selector="CanvasNodePalette">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasNodePalette">
                    <StackPanel Orientation="Vertical">
                        <!-- The field clears by its own button, inside it - beside it, the field would end short of the
                             pane and read as two controls. -->
                        <TextBox MarginBottom="6"
                                 Text="{TemplateBinding Search, Mode=TwoWay}"
                                 Padding="6 0 5 0"
                                 ShowsClearButton="True"
                                 ClearButtonToolTip="{Localize CanvasStrings.ClearSearch}"
                                 ToolTip="{Localize CanvasStrings.NarrowList}"/>

                        <TreeView MaxHeight="180" MinWidth="0" ItemsSource="{TemplateBinding Groups}"
                                  SelectedItem="{Ancestor CanvasNodePalette, PickedKind, Mode=TwoWay}"
                                  AutomationProperties.Name="{Localize CanvasStrings.AddNode}">
                            <TreeView.ItemContainerStyle>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Kinds}">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <StackPanel Orientation="Horizontal" MarginTop="6" HorizontalAlignment="Right">
                            <Button Content="{Localize CanvasStrings.Cancel}" Height="26" MinWidth="0" Padding="10,0"
                                    Command="{Ancestor CanvasNodePalette, CloseCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- What the canvas asks before it takes something away, in an overlay window that is its frame: one line per
         question and the two answers, the right ones shown by the triggers below. "Remove it?" is said for ONE thing
         and not by the plural form, which in some languages also takes 21. -->
    <Style Selector="CanvasQuestion">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasQuestion">
                    <StackPanel Orientation="Vertical" Width="360" Margin="16">
                        <TextBlock x:Name="RemoveSomeLabel" TextWrapping="WrapByWords" MarginBottom="20"
                                   Text="{Localize CanvasStrings.RemoveObjects, count={TemplateBinding Count}}"/>
                        <TextBlock x:Name="RemoveOneLabel" Visibility="Collapsed" TextWrapping="WrapByWords" MarginBottom="20"
                                   Text="{Localize CanvasStrings.RemoveIt}"/>
                        <TextBlock x:Name="ClearLabel" Visibility="Collapsed" TextWrapping="WrapByWords" MarginBottom="20"
                                   Text="{Localize CanvasStrings.RemoveAll, count={TemplateBinding Count}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PART_Yes" MinWidth="96" MarginRight="8">
                                <Grid>
                                    <TextBlock x:Name="DeleteText" Text="{Localize CanvasStrings.DeleteAnswer}"/>
                                    <TextBlock x:Name="ClearText" Visibility="Collapsed" Text="{Localize CanvasStrings.ClearAnswer}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="PART_No" MinWidth="96" Content="{Localize CanvasStrings.Cancel}"/>
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <MultiTrigger>
            <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="DeleteSelection"/>
                <Condition Property="Count" Value="1"/>
            </MultiTrigger.Conditions>
            <Setter TargetName="RemoveSomeLabel" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="RemoveOneLabel" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <PropertyTrigger Property="Kind" Value="Clear">
            <Setter TargetName="RemoveSomeLabel" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="ClearLabel" Property="Visibility" Value="Visible"/>
            <Setter TargetName="DeleteText" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="ClearText" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
    </Style>

    <!-- The selection bar over the selection frame: pictogram buttons with tooltips and trailing gaps, so collapsed
         buttons take their gap with them. -->
    <Style Selector="CanvasSelectionBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasSelectionBar">
                    <StackPanel Orientation="Horizontal">
                        <!-- NO COLOR HERE. A color is set in the panel, where it is said as the three things it
                             actually is - fill, outline, text - and beside the rest of what the object holds. One
                             swatch on a bar could only ever be one of them, and read as all of them. -->
                        <Button x:Name="PART_Front" Width="26" Height="24" MinWidth="0" MinHeight="0"
                                MarginRight="4" Padding="0"
                                ToolTip="{Localize CanvasStrings.BringToFront}"
                                Command="{Ancestor CanvasSelectionBar, Canvas.BringToFrontCommand}">
                            <Image Source="{ObservableResource CanvasBringToFrontIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button x:Name="PART_Back" Width="26" Height="24" MinWidth="0" MinHeight="0"
                                MarginRight="4" Padding="0"
                                ToolTip="{Localize CanvasStrings.SendToBack}"
                                Command="{Ancestor CanvasSelectionBar, Canvas.SendToBackCommand}">
                            <Image Source="{ObservableResource CanvasSendToBackIcon}" Width="13" Height="13"/>
                        </Button>

                        <!-- ONE PLACE AT A TIME, beside the two that go all the way. The ends are not where arranging
                             happens: a shape that belongs BETWEEN two others cannot be put there by a button that can
                             only put it on top of both. These gray out at the end they have reached. -->
                        <Button x:Name="PART_Forward" Width="26" Height="24" MinWidth="0" MinHeight="0"
                                MarginRight="4" Padding="0"
                                ToolTip="{Localize CanvasStrings.BringForward}"
                                Command="{Ancestor CanvasSelectionBar, Canvas.BringForwardCommand}">
                            <Image Source="{ObservableResource CanvasBringForwardIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button x:Name="PART_Backward" Width="26" Height="24" MinWidth="0" MinHeight="0"
                                MarginRight="4" Padding="0"
                                ToolTip="{Localize CanvasStrings.SendBackward}"
                                Command="{Ancestor CanvasSelectionBar, Canvas.SendBackwardCommand}">
                            <Image Source="{ObservableResource CanvasSendBackwardIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button x:Name="PART_Group" Width="26" Height="24" MinWidth="0" MinHeight="0"
                                MarginRight="4" Padding="0"
                                ToolTip="{Localize CanvasStrings.Group}"
                                Command="{Ancestor CanvasSelectionBar, Canvas.GroupCommand}">
                            <Image Source="{ObservableResource CanvasGroupIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button x:Name="PART_Ungroup" Width="26" Height="24" MinWidth="0" MinHeight="0"
                                MarginRight="4" Padding="0"
                                ToolTip="{Localize CanvasStrings.Ungroup}"
                                Command="{Ancestor CanvasSelectionBar, Canvas.UngroupCommand}">
                            <Image Source="{ObservableResource CanvasUngroupIcon}" Width="13" Height="13"/>
                        </Button>

                        <!-- The canvas's OWN delete, which is also what the Delete key goes through - so the button
                             meets the same question the key does. -->
                        <Button Width="26" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                ToolTip="{Localize CanvasStrings.Delete}"
                                Command="{Ancestor CanvasSelectionBar, Canvas.DeleteCommand}">
                            <Image Source="{ObservableResource CanvasBinIcon}" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="IsDrawing" Value="false">
                            <Setter TargetName="PART_Front" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Back" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Group" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Ungroup" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CanvasViewBar: undo/redo, zoom and Home along the bottom, all canvas commands that enable themselves; pictograms
         except "Home". -->
    <Style Selector="CanvasViewBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasViewBar">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Width="28" Height="26" MinWidth="0" Padding="0" MarginRight="6"
                                Command="{Ancestor CanvasViewBar, Canvas.UndoCommand}"
                                ToolTip="{Localize CanvasStrings.Undo}">
                            <Image Source="{ObservableResource CanvasUndoIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button Width="28" Height="26" MinWidth="0" Padding="0" MarginRight="10"
                                Command="{Ancestor CanvasViewBar, Canvas.RedoCommand}"
                                ToolTip="{Localize CanvasStrings.Redo}">
                            <Image Source="{ObservableResource CanvasRedoIcon}" Width="13" Height="13"/>
                        </Button>

                        <Button Content="-" Width="28" Height="26" MinWidth="0" Padding="0"
                                Command="{Ancestor CanvasViewBar, Canvas.ZoomOutCommand}"
                                ToolTip="{Localize CanvasStrings.ZoomOut}"/>
                        <!-- Centered BOTH ways: a text block draws on its baseline by default, which in a one-line
                             plate looks like the text has sunk. A stated width, so the bar does not breathe as the
                             digits change. -->
                        <TextBlock Text="{TemplateBinding ZoomText}" MinWidth="54" MarginLeft="6" MarginRight="6"
                                   VerticalAlignment="Center"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        <Button Content="+" Width="28" Height="26" MinWidth="0" Padding="0"
                                Command="{Ancestor CanvasViewBar, Canvas.ZoomInCommand}"
                                ToolTip="{Localize CanvasStrings.ZoomIn}"/>
                        <Button Width="28" Height="26" MinWidth="0" Padding="0" MarginLeft="8"
                                Command="{Ancestor CanvasViewBar, Canvas.HomeCommand}"
                                ToolTip="{Localize CanvasStrings.GoHome}">
                            <Image Source="{ObservableResource CanvasHomeIcon}" Width="12" Height="12"/>
                        </Button>
                        <!-- Which view Home means: this takes it, that one goes back to it. -->
                        <Button Width="28" Height="26" MinWidth="0" Padding="0" MarginLeft="4"
                                Command="{Ancestor CanvasViewBar, Canvas.RememberViewCommand}"
                                ToolTip="{Localize CanvasStrings.KeepHome}">
                            <Image Source="{ObservableResource CanvasKeepViewIcon}" Width="12" Height="12"/>
                        </Button>
                        <!-- Offered only where it does something: with nothing kept, Home already means the origin. -->
                        <Button Width="28" Height="26" MinWidth="0" Padding="0" MarginLeft="4"
                                Visibility="{Ancestor CanvasViewBar, Canvas.KeepsHomeFace}"
                                Command="{Ancestor CanvasViewBar, Canvas.ForgetViewCommand}"
                                ToolTip="{Localize CanvasStrings.ForgetHome}">
                            <Image Source="{ObservableResource CanvasForgetViewIcon}" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- A graph node in the usual shape (colored title strip, body, sockets down the sides), using the theme's panel
         surface, control stroke and accent strip. -->
    <Style Selector="CanvasNode">
        <!-- What a socket is called until it is given a name. -->
        <Setter Property="Phrases" Value="{x:Static CanvasStrings.Current}"/>
        <Setter Property="Background" Value="{ObservableResource SolidBackgroundFillColorSecondary}"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="Accent" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="PinColor" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CanvasNode">
                    <!-- The sockets sit ON the edge, half outside, so the node needs room round the body to draw them
                         in. A margin on the body rather than padding on the sockets: the body is what a person reads as
                         "the node", and it should be exactly as wide as it looks. -->
                    <Border x:Name="PART_Body" Margin="6,0,6,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <StackPanel Orientation="Vertical">
                                <!-- The strip, and the two stubs a FOLDED node's wires come to, laid OVER it rather
                                     than in it: nothing may take width from this row, or the switch that opens the
                                     node again slides out from under the click that closed it. -->
                                <Grid>
                                    <Border x:Name="PART_Header"
                                            Background="{TemplateBinding Accent}"
                                            CornerRadius="5,5,0,0"
                                            Padding="10,5">
                                        <!-- The FOLD sits in the strip, because the strip is all that is left when the
                                             node is folded - a switch anywhere else would be one you cannot reach to
                                             undo. A toggle and not a button: it shows the state as well as changing it. -->
                                        <DockPanel LastChildFill="True">
                                            <ToggleButton x:Name="PART_Fold" DockPanel.Dock="Right"
                                                          Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0"
                                                          MarginLeft="8" VerticalAlignment="Center"
                                                          Background="Transparent" BorderThickness="0"
                                                          ToolTip="{Localize CanvasStrings.FoldNode}"
                                                          IsChecked="{TemplateBinding IsCollapsed, Mode=TwoWay}"
                                                          BackgroundChecked="Transparent"
                                                          BorderBrushChecked="Transparent"
                                                          BackgroundCheckedPointerOver="Transparent"
                                                          BackgroundCheckedPressed="Transparent"
                                                          ForegroundChecked="{ThemeResource AccentForegroundColor}">
                                                <!-- Drawn HERE and not taken from the icon set: it sits on the accent
                                                     strip and so must wear the accent's own foreground, which is a
                                                     ThemeResource - and a DrawingImage cannot carry one. -->
                                                <Path Data="M0,0 L3.5,3.5 L7,0"
                                                      Stroke="{ThemeResource AccentForegroundColor}"
                                                      StrokeThickness="1.4" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>

                                            <ContentPresenter Content="{TemplateBinding Title}"
                                                              FontSize="{TemplateBinding FontSize}"
                                                              Foreground="{ThemeResource AccentForegroundColor}"
                                                              VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- A folded node shows one stub per side for all its wires; the node toggles them, since
                                         a trigger cannot ask whether a side has sockets. -->
                                    <CanvasNodeSocket x:Name="PART_FoldedIn" Width="12" Height="12" CornerRadius="6"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      MarginLeft="-6" Visibility="Collapsed"
                                                      Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                      BorderBrush="{TemplateBinding PinColor}"
                                                      BorderThickness="2"/>

                                    <CanvasNodeSocket x:Name="PART_FoldedOut" Width="12" Height="12" CornerRadius="6"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      MarginRight="-6" Visibility="Collapsed"
                                                      Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                      BorderBrush="{TemplateBinding PinColor}"
                                                      BorderThickness="2"/>
                                </Grid>

                                <!-- Inputs down the left and outputs down the right, each column as wide as it needs to
                                     be. A Grid of two star columns would center two short lists in the middle of a wide
                                     node, which reads as one list of six rather than two of three. -->
                                <Grid x:Name="PART_Rows" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,10" MinWidth="120">
                                    <!-- The node's body between the socket columns; empty by default at no cost. -->
                                    <ContentPresenter Grid.Column="1" x:Name="PART_ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      Margin="10,0,10,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                    <ItemsControl Grid.Column="0" ItemsSource="{TemplateBinding InputPins}">
                                        <!-- Its OWN template: the stock one wraps the items in a ScrollViewer, and a scroller takes every pixel it is
                                             offered - which made a node as tall as whatever it was measured against instead of as tall as its pins. -->
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" MarginBottom="4">
                                                    <!-- Half outside the body: an outer ring in the pin color and an inner
                                                         fill that a connection paints (null when loose); the hole shows the
                                                         body color. -->
                                                    <CanvasNodeSocket Width="12" Height="12" CornerRadius="6" MarginLeft="-6"
                                                            VerticalAlignment="Center"
                                                            Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                            BorderBrush="{Binding Color}"
                                                            BorderThickness="2">
                                                        <!-- Tucked half a pixel under the ring, so no seam shows between
                                                             them. -->
                                                        <Border CornerRadius="4.5" Margin="-0.5"
                                                                Background="{Binding Fill}"/>
                                                    </CanvasNodeSocket>
                                                    <TextBlock Text="{Binding Name}" MarginLeft="7"
                                                               VerticalAlignment="Center"
                                                               VerticalTextAlignment="Center"
                                                               Foreground="{ObservableResource TextFillColorSecondary}"/>

                                                    <!-- The socket's move grip after its name (the pin itself pulls wires):
                                                         a marked element whose transparent box makes the gaps pressable. -->
                                                    <Border CanvasNode.IsSocketGrip="True" Background="Transparent"
                                                            Width="12" Height="14" MinWidth="0" MinHeight="0"
                                                            MarginLeft="6" VerticalAlignment="Center" Cursor="SizeAll"
                                                            ToolTipService.ToolTip="{Localize CanvasStrings.MoveSocket}">
                                                        <Path Fill="{ObservableResource TextFillColorTertiary}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M0,0 L2,0 L2,2 L0,2 Z M4,0 L6,0 L6,2 L4,2 Z M0,4 L2,4 L2,6 L0,6 Z M4,4 L6,4 L6,6 L4,6 Z M0,8 L2,8 L2,10 L0,10 Z M4,8 L6,8 L6,10 L4,10 Z"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="2" ItemsSource="{TemplateBinding OutputPins}">
                                        <!-- Its OWN template: the stock one wraps the items in a ScrollViewer, and a scroller takes every pixel it is
                                             offered - which made a node as tall as whatever it was measured against instead of as tall as its pins. -->
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" IsVirtualizing="False"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" MarginBottom="4"
                                                            HorizontalAlignment="Right">
                                                    <!-- On THIS side the grip stands first, for the same reason the pin
                                                         stands last: each is nearest the edge it belongs to. -->
                                                    <Border CanvasNode.IsSocketGrip="True" Background="Transparent"
                                                            Width="12" Height="14" MinWidth="0" MinHeight="0"
                                                            MarginRight="6" VerticalAlignment="Center" Cursor="SizeAll"
                                                            ToolTipService.ToolTip="{Localize CanvasStrings.MoveSocket}">
                                                        <Path Fill="{ObservableResource TextFillColorTertiary}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M0,0 L2,0 L2,2 L0,2 Z M4,0 L6,0 L6,2 L4,2 Z M0,4 L2,4 L2,6 L0,6 Z M4,4 L6,4 L6,6 L4,6 Z M0,8 L2,8 L2,10 L0,10 Z M4,8 L6,8 L6,10 L4,10 Z"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" MarginRight="7"
                                                               VerticalAlignment="Center"
                                                               VerticalTextAlignment="Center"
                                                               Foreground="{ObservableResource TextFillColorSecondary}"/>
                                                    <CanvasNodeSocket Width="12" Height="12" CornerRadius="6" MarginRight="-6"
                                                            VerticalAlignment="Center"
                                                            Background="{ObservableResource SolidBackgroundFillColorSecondary}"
                                                            BorderBrush="{Binding Color}"
                                                            BorderThickness="2">
                                                        <!-- Tucked half a pixel under the ring, so no seam shows between
                                                             them. -->
                                                        <Border CornerRadius="4.5" Margin="-0.5"
                                                                Background="{Binding Fill}"/>
                                                    </CanvasNodeSocket>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>

                    <ControlTemplate.Triggers>
                        <!-- Folded: rows are Collapsed so the strip is the whole node, rounded on all corners; socket
                             placement is CanvasNode.Fold's. -->
                        <PropertyTrigger Property="IsCollapsed" Value="true">
                            <Setter TargetName="PART_Rows" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Header" Property="CornerRadius" Value="5"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
