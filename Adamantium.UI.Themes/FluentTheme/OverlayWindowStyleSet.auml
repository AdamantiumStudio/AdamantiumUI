<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- OverlayWindow chrome: PART_Window card with an accent title bar (PART_TitleThumb drags, PART_CollapseButton,
         PART_PinButton, PART_CloseButton), content and PART_ResizeGrip. Properties, template, triggers. -->

    <Style Selector="OverlayWindow">
        <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusSurface}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingSurface}"/>
        <Setter Property="OverlayBrush" Value="{ResourceReference SmokeFillColorDefault}"/>
        <Setter Property="TitleBarBackground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="TitleForeground" Value="{ThemeResource AccentForegroundColor}"/>
        <!-- Sized to content and centered on the overlay; the manager then offsets/drags it via the popup. -->
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- The collapse button's glyph: a chevron up, turned down while collapsed - the way back to the content. -->
        <Setter Property="MinimizeTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="M0,5 L5,0 L10,5" Stroke="{Ancestor OverlayWindow, TitleForeground}" StrokeThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="MaximizeTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="M0,0 L5,5 L10,0" Stroke="{Ancestor OverlayWindow, TitleForeground}" StrokeThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="OverlayWindow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="OverlayWindow">
                    <Border x:Name="PART_Window"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">

                            <!-- Title bar: PART_TitleThumb (transparent, hit-testable) drags the whole strip; pin + close sit
                                 in their own columns so they stay clickable. -->
                            <Grid x:Name="PART_TitleBar" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
                                    Background="{TemplateBinding TitleBarBackground}"
                                    Height="{ResourceReference OverlayTitleBarHeight}">
                                <Grid x:Name="PART_TitleThumb" Grid.Column="3" Background="Transparent">
                                    <!-- A Grid, not a StackPanel: the title gets the room left beside the buttons and ends
                                         in an ellipsis, rather than running on under them. -->
                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}"
                                                Foreground="{TemplateBinding TitleForeground}"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ContentPresenter x:Name="PART_Title" Grid.Column="1" Content="{TemplateBinding Title}"
                                                TextBlock.IsTextSelectionEnabled="False" TextTrimming="CharEllipses"
                                                Foreground="{TemplateBinding TitleForeground}" FontSize="{ResourceReference FontSizeSubtitle}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <!-- Collapse: the window's MinimizeTemplate, its MaximizeTemplate while collapsed. -->
                                <Button x:Name="PART_CollapseButton" Grid.Column="4" Visibility="Collapsed"
                                        AutomationProperties.AutomationId="Collapse"
                                        AutomationProperties.Name="{Localize WindowStrings.Collapse}"
                                        ContentTemplate="{TemplateBinding MinimizeTemplate}"
                                        Classes="CaptionButton"
                                        Width="{ResourceReference DockHeaderButtonSize}"
                                        MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Stretch"/>

                                <Button x:Name="PART_PinButton" Grid.Column="5" Visibility="Collapsed"
                                        AutomationProperties.AutomationId="Pin"
                                        AutomationProperties.Name="{Localize WindowStrings.Pin}"
                                        Classes="CaptionButton"
                                        Width="{ResourceReference DockHeaderButtonSize}"
                                        MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Stretch">
                                    <!-- Thumbtack, symmetric about x=7: cap (5..9), flared shoulders (3..11), tapering neck
                                         (6..8), point at (7,12) - the classic push-pin silhouette. -->
                                    <Path x:Name="PinGlyph"
                                            Data="M5,2 L9,2 L9,4 L11,6 L11,7 L8,7 L8,10 L7,12 L6,10 L6,7 L3,7 L3,6 L5,4 Z"
                                            Stroke="{TemplateBinding TitleForeground}" StrokeThickness="1" Fill="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Button x:Name="PART_CloseButton" Grid.Column="6"
                                        AutomationProperties.AutomationId="Close"
                                        AutomationProperties.Name="{Localize WindowStrings.Close}"
                                        Classes="CaptionButton CloseButton"
                                        Width="{ResourceReference DockHeaderButtonSize}"
                                        MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Stretch">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                                            Stroke="{TemplateBinding TitleForeground}" StrokeThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    Margin="{TemplateBinding Padding}"/>

                            <!-- Resize grip: the shared ResizeGripper control (dotted-triangle visual + hit box, dots in the
                                 corner so the cursor sits right on them). PublishToWindow=False: this is an in-window card,
                                 not the OS window, so it must NOT drive the native window resize - OverlayWindow resizes
                                 itself with a managed drag. -->
                            <ResizeGripper x:Name="PART_ResizeGrip" Grid.Row="1" Visibility="Collapsed"
                                    PublishToWindow="False" Width="18" Height="18"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="OverlayWindow">
        <!-- Buttons on the left: the order reverses, so closing stays outermost. -->
        <PropertyTrigger Property="CaptionButtonPlacement" Value="Left">
            <Setter TargetName="PART_CloseButton" Property="Grid.Column" Value="0"/>
            <Setter TargetName="PART_PinButton" Property="Grid.Column" Value="1"/>
            <Setter TargetName="PART_CollapseButton" Property="Grid.Column" Value="2"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanClose" Value="false">
            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanPin" Value="true">
            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanResize" Value="true">
            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <PropertyTrigger Property="CanCollapse" Value="true">
            <Setter TargetName="PART_CollapseButton" Property="Visibility" Value="Visible"/>
        </PropertyTrigger>
        <!-- Collapsed: the caption alone; after CanResize, so the grip goes with the content. -->
        <PropertyTrigger Property="IsCollapsed" Value="true">
            <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="PART_CollapseButton" Property="ContentTemplate" Value="{TemplateBinding MaximizeTemplate}"/>
        </PropertyTrigger>
        <!-- Pinned = filled pin glyph. -->
        <PropertyTrigger Property="IsPinned" Value="true">
            <Setter TargetName="PinGlyph" Property="Fill" Value="{ThemeResource AccentForegroundColor}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="ShowTitleBar" Value="false">
            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
        </PropertyTrigger>
        <!-- Active: the outline takes the caption's color, as the main window's does. -->
        <PropertyTrigger Property="IsActive" Value="true">
            <Setter TargetName="PART_Window" Property="BorderBrush" Value="{TemplateBinding TitleBarBackground}"/>
        </PropertyTrigger>
        <!-- Inactive (not the front-most window): dim the title bar like an inactive OS window. Overrides the window's own
             TitleBarBackground/TitleForeground, which the bar, title, icon and pin/close glyphs all bind to. -->
        <PropertyTrigger Property="IsActive" Value="false">
            <Setter Property="TitleBarBackground" Value="{ResourceReference ControlFillColorSecondary}"/>
            <Setter Property="TitleForeground" Value="{ResourceReference TextFillColorSecondary}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
