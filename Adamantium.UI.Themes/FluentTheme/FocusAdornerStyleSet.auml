<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- THE FOCUS RING for the whole application: what the keyboard leaves around the control it reached. The adorner
         stage sizes it to the focused control's bounds (pushed out by Outset) and draws it above the content, so this
         one style is the focus visual of every control - restyle it here and the whole app follows.
         A single control wanting a different ring sets its own FocusVisualStyle; that is applied after this and wins. -->
    <Style Selector="FocusAdorner">
        <!-- The ring sits on the control's outline (zero outset): an offset ring gets clipped by the control's clip and is
             positioned without the outset. -->
        <Setter Property="Outset" Value="{ResourceReference FocusRingOutset}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="FocusAdorner">
                    <!-- Two tones like UWP: a thick accent line and a thin inner focus stroke that keeps it legible on
                         accent fills; sibling borders following AdornedCornerRadius. -->
                    <Grid IsHitTestVisible="False">
                        <Border BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefault}"
                                CornerRadius="{TemplateBinding AdornedCornerRadius}"/>
                        <Border Margin="2"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource FocusStrokeColorInner}"
                                CornerRadius="{TemplateBinding AdornedCornerRadius}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
