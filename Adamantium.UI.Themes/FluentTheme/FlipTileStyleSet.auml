<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- FlipTile draws itself, so the theme only seeds properties. FrontBrush uses TileFillColorDefault, defined against
         the card surface; a bound FrontBrush overrides it. -->
    <Style Selector="FlipTile">
        <Setter Property="FrontBrush" Value="{ResourceReference TileFillColorDefault}"/>
    </Style>

</StyleSet>
