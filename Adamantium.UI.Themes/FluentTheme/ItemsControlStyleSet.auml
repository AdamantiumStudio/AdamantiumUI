<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ItemsControl: a Border around a ScrollViewer that hosts the items. CanContentScroll=true so the ScrollViewer
         delegates scrolling to the virtualizing items panel (item scrolling, not pixel translation). PART_ItemsPresenter
         is the items host; its panel comes from ItemsPanel (default = a vertical virtualizing StackPanel). Per the
         small-styles convention this is just the template. -->
    <Style Selector="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                               HorizontalScrollBarVisibility="Disabled"
                                               VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drop gap placeholder: a dashed accent outline, distinct from the filled, pulsing loading skeleton. -->
    <Style Selector="ItemsControl">
        <Setter Property="DropPlaceholderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- A Shape, not a Border: the dashes live on Shape.StrokeDashArray. -->
                    <Rectangle IsHitTestVisible="False" Fill="Transparent" StrokeThickness="2"
                                        StrokeDashArray="4,3"
                                        Stroke="{ThemeResource AccentFillColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The loading skeleton card for budget-deferred slots: muted, rounded, hit-transparent, painted with the shared
         SkeletonPulseFill via {ObservableResource}, so one animation serves every card. -->
    <Style Selector="ItemsControl">
        <Setter Property="ItemSkeletonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- No margin here: the PANEL insets the card by the REAL item's margin (read from a realized tile) so
                         cards line up exactly with the real tiles and keep the same inter-tile gaps for any list. A faint
                         static border outlines the card even at the pulse's low point. -->
                    <!-- The outline comes from the PALETTE, like every other hairline. It used to be a literal white at
                         a tenth opacity, which is a dark-theme assumption written into a shared file: on the light theme
                         it is white on near-white, so the card had no outline at all at the pulse's low point - exactly
                         the moment the outline exists for. {ObservableResource}, so a palette swap re-points it. -->
                    <Border CornerRadius="4" BorderThickness="1" IsHitTestVisible="False"
                                     Background="{ObservableResource SkeletonPulseFill}"
                                     BorderBrush="{ObservableResource ControlStrokeColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The list pulses the shared skeleton brush's Opacity while IsLoadingItems (TargetName resolves the keyed resource);
         AnimationManager holds keep one list from stopping another's pulse. -->
    <Style Selector="ItemsControl">
        <PropertyTrigger Property="IsLoadingItems" Value="True">
            <PropertyTrigger.EnterActions>
                <RunAnimationAction TargetName="SkeletonPulseFill">
                    <PulseAnimation Property="Opacity" Min="0.05" Max="0.15" Duration="0:0:1.2" Easing="CubicInOut"/>
                </RunAnimationAction>
            </PropertyTrigger.EnterActions>
            <PropertyTrigger.ExitActions>
                <StopAnimationAction TargetName="SkeletonPulseFill"/>
            </PropertyTrigger.ExitActions>
        </PropertyTrigger>
    </Style>

</StyleSet>
