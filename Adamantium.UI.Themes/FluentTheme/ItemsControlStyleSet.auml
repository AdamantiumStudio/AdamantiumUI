<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- ItemsControl: a Border around a ScrollViewer that hosts the items. CanContentScroll=true so the ScrollViewer
         delegates scrolling to the virtualizing items panel (item scrolling, not pixel translation). PART_ItemsPresenter
         is the items host; its panel comes from ItemsPanel (default = a vertical virtualizing StackPanel). Per the
         small-styles convention this is just the template. -->
    <Style Selector="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                               HorizontalScrollBarVisibility="Disabled"
                                               VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drop gap placeholder: a dashed accent outline, distinct from the filled, pulsing loading skeleton. -->
    <Style Selector="ItemsControl">
        <Setter Property="DropPlaceholderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- A Shape, not a Border: the dashes live on Shape.StrokeDashArray. -->
                    <Rectangle IsHitTestVisible="False" Fill="Transparent" StrokeThickness="2"
                                        StrokeDashArray="4,3"
                                        Stroke="{ThemeResource AccentFillColorDefault}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The loading skeleton card for budget-deferred slots: muted, rounded, hit-transparent. The panel draws this one
         card at every pending slot as a copy, and each copy pulses a little after the one before it (RenderCloneStagger),
         so the pulse runs along the cards like a garland. -->
    <Style Selector="ItemsControl">
        <Setter Property="ItemSkeletonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- No margin here: the PANEL insets the card by the REAL item's margin (read from a realized tile) so
                         cards line up exactly with the real tiles and keep the same inter-tile gaps for any list. The
                         fill pulses; the outline over it stays, so the card is outlined even at the pulse's low point. -->
                    <Grid IsHitTestVisible="False"
                          RenderCloneStagger="0:0:0.08">
                        <Border x:Name="SkeletonFill"
                                CornerRadius="4"
                                Opacity="0.05"
                                Background="{ObservableResource SkeletonPulseFill}"/>
                        <Border CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{ObservableResource ControlStrokeColorDefault}"/>
                    </Grid>
                    <!-- The card is shown while the list is loading and collapsed once it is done: the pulse runs exactly
                         as long, played by the render thread. -->
                    <DataTemplate.Triggers>
                        <PropertyTrigger Property="Visibility"
                                         Value="Visible">
                            <PropertyTrigger.EnterActions>
                                <RunAnimationAction TargetName="SkeletonFill">
                                    <PulseAnimation Property="Opacity"
                                                    Min="0.05"
                                                    Max="0.15"
                                                    Duration="0:0:1.2"
                                                    Easing="CubicInOut"/>
                                </RunAnimationAction>
                            </PropertyTrigger.EnterActions>
                            <PropertyTrigger.ExitActions>
                                <StopAnimationAction TargetName="SkeletonFill"/>
                            </PropertyTrigger.ExitActions>
                        </PropertyTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
