<ResourceDictionary xmlns:x="http://adamantium/ui/xaml/extensions"
        xmlns="http://adamantium/ui">

    <!-- Close: two crossing strokes. Stroked, not filled - it IS a stroke, and saying so keeps it honest at any size. -->
    <DrawingImage x:Key="CloseIcon">
        <GeometryDrawing Geometry="M0,0 L10,10 M10,0 L0,10"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Locked: a padlock - a text or a value that cannot be changed. -->
    <DrawingImage x:Key="LockIcon">
        <GeometryDrawing Geometry="M1.5,4.5 L8.5,4.5 L8.5,9.5 L1.5,9.5 Z M3,4.5 L3,2.75 C3,0.25 7,0.25 7,2.75 L7,4.5"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Match case: a capital and a small letter drawn side by side - search telling the two apart. -->
    <DrawingImage x:Key="MatchCaseIcon">
        <GeometryDrawing Geometry="M0.5,9 L2.75,1.5 L5,9 M1.3,6.5 L4.2,6.5 M9.2,4.8 L9.2,9 M9.2,6.8 C9.2,5.4 8.4,4.8 7.6,4.8 C6.6,4.8 6,5.7 6,6.9 C6,8.1 6.6,9 7.6,9 C8.4,9 9.2,8.4 9.2,7"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Whole word: a word over a bracket that closes on both its ends. -->
    <DrawingImage x:Key="WholeWordIcon">
        <GeometryDrawing Geometry="M4,2.5 L4,6.5 M4,4.4 C4,3.1 3.3,2.5 2.5,2.5 C1.6,2.5 1,3.3 1,4.5 C1,5.7 1.6,6.5 2.5,6.5 C3.3,6.5 4,5.9 4,4.6 M5.5,0.5 L5.5,6.5 M5.5,4.5 C5.5,3.1 6.3,2.5 7.1,2.5 C8.1,2.5 8.8,3.3 8.8,4.5 C8.8,5.7 8.1,6.5 7.1,6.5 C6.3,6.5 5.5,5.9 5.5,4.6 M0.5,8 L0.5,9.5 L9.5,9.5 L9.5,8"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Regular expression: any character and a repeat - a dot and a star. -->
    <DrawingImage x:Key="RegularExpressionIcon">
        <GeometryDrawing Geometry="M1,7.5 L2.5,7.5 L2.5,9 L1,9 Z M7,1 L7,6 M4.8,2.2 L9.2,4.8 M4.8,4.8 L9.2,2.2"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- In selection: lines of text, the last one short - look only within what is selected. -->
    <DrawingImage x:Key="FindInSelectionIcon">
        <GeometryDrawing Geometry="M0,1.5 L10,1.5 M0,5 L10,5 M0,8.5 L6,8.5"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Breakpoint: a filled disc in the critical color. -->
    <DrawingImage x:Key="BreakpointIcon">
        <GeometryDrawing Geometry="M0,5 A5,5 0 1,1 10,5 A5,5 0 1,1 0,5 Z"
                         Brush="{ResourceReference SystemFillColorCritical}"/>
    </DrawingImage>

    <!-- Bookmark: a ribbon with a notch at its foot, in the caution color. -->
    <DrawingImage x:Key="BookmarkIcon">
        <GeometryDrawing Geometry="M2,0 L8,0 L8,10 L5,7.5 L2,10 Z"
                         Brush="{ResourceReference SystemFillColorCaution}"/>
    </DrawingImage>

    <!-- Code: angle brackets around a slash - the source of something. -->
    <DrawingImage x:Key="CodeIcon">
        <GeometryDrawing Geometry="M3,2 L0.5,5 L3,8 M7,2 L9.5,5 L7,8 M6,1 L4,9"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Chevrons: a filled triangle, one shape rotated by where it points. Kept as geometry rather than the SDF
         RegularPolygon they used to be, so the whole set is one kind of thing. -->
    <DrawingImage x:Key="ChevronDownIcon">
        <GeometryDrawing Geometry="M0,3 L10,3 L5,9 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ChevronUpIcon">
        <GeometryDrawing Geometry="M0,7 L5,1 L10,7 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ChevronRightIcon">
        <GeometryDrawing Geometry="M3,0 L9,5 L3,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="ChevronLeftIcon">
        <GeometryDrawing Geometry="M7,0 L1,5 L7,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <!-- The chevron ending against a WALL: "as far as this goes", which is a different statement from "one more step"
         and has to look different at a glance, or a pager's four arrows read as two pairs of the same button. Both
         shapes in one geometry rather than a bar drawn beside an icon - the pair is one glyph, and splitting it would
         let the two halves drift apart in every template that used them. -->
    <DrawingImage x:Key="FirstPageIcon">
        <GeometryDrawing Geometry="M0,0 L1.5,0 L1.5,10 L0,10 Z M9.5,0 L3.5,5 L9.5,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <DrawingImage x:Key="LastPageIcon">
        <GeometryDrawing Geometry="M8.5,0 L10,0 L10,10 L8.5,10 Z M0.5,0 L6.5,5 L0.5,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <!-- The filter funnel, filled like the chevrons. One icon only; an active filter is marked by its button in the style
         set, since the accent is not a keyed resource. -->
    <DrawingImage x:Key="FilterIcon">
        <GeometryDrawing Geometry="M0,0 L10,0 L6,4.5 L6,10 L4,8.5 L4,4.5 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

    <!-- Put it back: an arrow going BACK around, not a return key. Segments rather than an arc - the path parser reads
         lines - and the head at the left end, pointing the way it travels. Stroked, like the close glyph. -->
    <DrawingImage x:Key="RevertIcon">
        <GeometryDrawing Geometry="M8.6,6.4 L8.4,4.4 L7.3,2.8 L5.4,2 L3.5,2.4 L2.2,3.7 L1.7,5.4 M0.2,4.4 L1.7,6.3 L3.4,4.7"
                         Stroke="{ResourceReference TextFillColorSecondary}"
                         StrokeThickness="1"/>
    </DrawingImage>

    <!-- Which columns are shown: three bars of a table, the middle one dropped out - the whole of what the chooser
         does, said in the shape rather than in a word that would need translating. -->
    <DrawingImage x:Key="ColumnsIcon">
        <GeometryDrawing Geometry="M0,0 L2.5,0 L2.5,10 L0,10 Z M7.5,0 L10,0 L10,10 L7.5,10 Z"
                         Brush="{ResourceReference TextFillColorSecondary}"/>
    </DrawingImage>

</ResourceDictionary>
