<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Plain text. A type-only selector files at ValuePriority.TypeDefault, below inherited values, so this dresses loose
         text and yields to state colors a control pushes down (TypeDefaultSlotTests). -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <!-- Center for labels; the property default stays Bottom because text controls lay out their runs with it. -->
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>

    <!-- A link stands out in the accent color, on top of its underline. -->
    <Style Selector="Hyperlink">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefault}"/>
    </Style>

</StyleSet>
