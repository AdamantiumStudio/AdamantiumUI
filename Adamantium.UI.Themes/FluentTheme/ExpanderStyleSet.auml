<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Expander: the whole PART_Header toggles; folded content is Collapsed so it is not measured; the header docks to
         the side ExpandDirection names and the content opens on the other. -->

    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="12 8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- The header docks to the side ExpandDirection names it for; the content fills the rest. -->
                        <DockPanel LastChildFill="True">
                            <!-- The header folds and opens the expander, so its text does not select; the content
                                 does. -->
                            <Border DockPanel.Dock="Top" x:Name="PART_Header"
                                    TextBlock.IsTextSelectionEnabled="False"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Image Grid.Column="0" x:Name="Glyph"
                                           Source="{ResourceReference ChevronRightIcon}"
                                           Width="10" Height="10" Margin="0 0 8 0"
                                           VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                            x:Name="PART_HeaderPresenter"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharEllipses"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                </Grid>
                            </Border>

                            <Border x:Name="PART_Content"
                                    Visibility="Collapsed"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0 1 0 0">
                                <ContentPresenter
                                        x:Name="PART_ContentPresenter"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Where the header sits, and the hairline on the content's side towards it. -->
                        <PropertyTrigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="PART_Header" Property="DockPanel.Dock" Value="Bottom"/>
                            <Setter TargetName="PART_Content" Property="BorderThickness" Value="0 0 0 1"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="PART_Header" Property="DockPanel.Dock" Value="Right"/>
                            <Setter TargetName="PART_Content" Property="BorderThickness" Value="0 0 1 0"/>
                            <Setter TargetName="Glyph" Property="Source" Value="{ResourceReference ChevronLeftIcon}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="PART_Header" Property="DockPanel.Dock" Value="Left"/>
                            <Setter TargetName="PART_Content" Property="BorderThickness" Value="1 0 0 0"/>
                        </PropertyTrigger>
                        <!-- Up or down, the chevron points right while folded and into the content while open; to a
                             side, it points where the content opens while folded and back to the header while open. -->
                        <PropertyTrigger Property="IsExpanded" Value="true">
                            <Setter TargetName="PART_Content" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glyph" Property="Source" Value="{ResourceReference ChevronDownIcon}"/>
                        </PropertyTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="true"/>
                                <Condition Property="ExpandDirection" Value="Up"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Source" Value="{ResourceReference ChevronUpIcon}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="true"/>
                                <Condition Property="ExpandDirection" Value="Left"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Source" Value="{ResourceReference ChevronRightIcon}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="true"/>
                                <Condition Property="ExpandDirection" Value="Right"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Source" Value="{ResourceReference ChevronLeftIcon}"/>
                        </MultiTrigger>
                        <PropertyTrigger Property="IsPointerOver" Value="true">
                            <Setter TargetName="PART_Header" Property="Background"
                                    Value="{ResourceReference SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsEnabled" Value="false">
                            <Setter TargetName="PART_HeaderPresenter" Property="Foreground"
                                    Value="{ObservableResource TextFillColorDisabled}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
