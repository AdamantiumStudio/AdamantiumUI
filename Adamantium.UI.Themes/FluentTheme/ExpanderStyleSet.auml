<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- Expander: the whole PART_Header toggles; the content unfolds in PART_Reveal and is Collapsed once folded, so it
         is not measured; the header docks to the side ExpandDirection names and the content opens on the other; the
         chevron turns with it. -->

    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ObservableResource ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeControl}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="Padding" Value="12 8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ExpandDuration" Value="0:0:0.2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- The header docks to the side ExpandDirection names it for; the content fills the rest. -->
                        <DockPanel LastChildFill="True">
                            <!-- The header folds and opens the expander, so its text does not select; the content
                                 does. -->
                            <Border DockPanel.Dock="Top" x:Name="PART_Header"
                                    TextBlock.IsTextSelectionEnabled="False"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Image Grid.Column="0" x:Name="Glyph"
                                           Source="{ResourceReference ChevronRightIcon}"
                                           Width="10" Height="10" Margin="0 0 8 0"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <Transform x:Name="PART_GlyphTurn"/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <ContentPresenter Grid.Column="1"
                                            x:Name="PART_HeaderPresenter"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharEllipses"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                </Grid>
                            </Border>

                            <RevealDecorator x:Name="PART_Reveal"
                                             Visibility="Collapsed"
                                             Direction="{TemplateBinding ExpandDirection}">
                                <Border x:Name="PART_Content"
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0 1 0 0">
                                    <ContentPresenter
                                            x:Name="PART_ContentPresenter"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Border>
                            </RevealDecorator>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Where the header sits, and the hairline on the content's side towards it. -->
                        <PropertyTrigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="PART_Header" Property="DockPanel.Dock" Value="Bottom"/>
                            <Setter TargetName="PART_Content" Property="BorderThickness" Value="0 0 0 1"/>
                            <Setter TargetName="PART_Reveal" Property="VerticalAlignment" Value="Bottom"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="PART_Header" Property="DockPanel.Dock" Value="Right"/>
                            <Setter TargetName="PART_Content" Property="BorderThickness" Value="0 0 1 0"/>
                            <Setter TargetName="PART_Reveal" Property="HorizontalAlignment" Value="Right"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="PART_Header" Property="DockPanel.Dock" Value="Left"/>
                            <Setter TargetName="PART_Content" Property="BorderThickness" Value="1 0 0 0"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsPointerOver" Value="true">
                            <Setter TargetName="PART_Header" Property="Background"
                                    Value="{ResourceReference SubtleFillColorSecondary}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsEnabled" Value="false">
                            <Setter TargetName="PART_HeaderPresenter" Property="Foreground"
                                    Value="{ObservableResource TextFillColorDisabled}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
