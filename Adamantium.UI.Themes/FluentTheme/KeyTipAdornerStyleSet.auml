<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- The badge that says which key reaches a command while the ribbon is in key-tip mode. Deliberately loud - it has
         to be legible over an icon, a label, or the accent of an active tab - and small enough not to hide what it
         marks. The adorner stage measures it to its content and puts it where the command asked (see
         KeyTipService.Placement). -->
    <Style Selector="KeyTipAdorner">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="KeyTipAdorner">
                    <!-- Opaque badge in dedicated KeyTip* palette tokens that contrast with any surface; a minimum square
                         so single letters share one size. -->
                    <Border Background="{ResourceReference KeyTipPlateFill}"
                            BorderBrush="{ResourceReference KeyTipPlateStroke}"
                            BorderThickness="1"
                            CornerRadius="2"
                            MinWidth="18"
                            MinHeight="18"
                            Padding="3 0 3 0">
                        <!-- Both text alignments stated: VerticalTextAlignment defaults to Bottom, which is what sat
                             the letter on the floor of the plate instead of in the middle of it. -->
                        <TextBlock Text="{TemplateBinding Keys}"
                                   FontSize="{ResourceReference FontSizeCaption}"
                                   Foreground="{ObservableResource KeyTipForeground}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
