<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions">

    <!-- TextBox: a templated single-line editor. The template is a themed Border (chrome) wrapping PART_TextPresenter -
         the surface that renders text/caret/selection and hosts the caret-following horizontal scroll (the Border clips,
         so long text scrolls under it). Focus shows an accent border; hover a subtler stroke. Per the small-styles
         convention: properties, template, triggers. -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{ResourceReference ControlFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <!-- Dimmer than the text (Tertiary, not Secondary) so the watermark reads as a hint, not real entered text. -->
        <Setter Property="PlaceholderForeground" Value="{ResourceReference TextFillColorTertiary}"/>
        <Setter Property="FloatingPlaceholderForeground" Value="{ThemeResource AccentFillColorDefault}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="CaretBrush" Value="{ResourceReference TextFillColorPrimary}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusDefault}"/>
        <Setter Property="Padding" Value="{ResourceReference PaddingField}"/>
        <Setter Property="MinWidth" Value="{ResourceReference ControlMinWidth}"/>
        <Setter Property="MinHeight" Value="{ResourceReference ControlHeight}"/>
        <Setter Property="FontSize" Value="{ResourceReference FontSizeBody}"/>
        <Setter Property="ClearButtonToolTip" Value="{Localize TextBoxStrings.Clear}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <!-- The clear button takes a column of its own, so the text never runs under it. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <ScrollViewer x:Name="PART_ContentHost"
                                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                <TextPresenter x:Name="PART_TextPresenter"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                            </ScrollViewer>
                            <!-- Not a focus stop: the press leaves the caret in the box. -->
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    Focusable="False"
                                    Width="18"
                                    Height="18"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    Margin="4 0 0 0"
                                    VerticalAlignment="Center"
                                    ToolTip="{TemplateBinding ClearButtonToolTip}">
                                <Image Source="{ResourceReference CloseIcon}"
                                       Width="8"
                                       Height="8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Only while there is something to clear, and the box may be cleared. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowsClearButton" Value="true"/>
                                <Condition Property="HasText" Value="true"/>
                                <Condition Property="IsReadOnly" Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="TextBox">
        <PropertyTrigger Property="IsMouseOver" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ResourceReference ControlStrokeColorSecondary}"/>
        </PropertyTrigger>
        <PropertyTrigger Property="IsFocused" Value="true">
            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{ThemeResource AccentFillColorDefault}"/>
            <Setter TargetName="PART_Border" Property="Background" Value="{ResourceReference ControlFillColorSecondary}"/>
        </PropertyTrigger>
    </Style>

</StyleSet>
