<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <Description>PDF pages as Adamantium UI drawings: paths, text, images, shadings, patterns, groups and soft masks of a page, drawn at any zoom.</Description>
        <PackageTags>adamantium;ui;pdf;viewer;drawing</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.Pdf.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.UI.Core\Adamantium.UI.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AdamantiumEngineReference Include="Adamantium.Pdf" />
        <AdamantiumEngineReference Include="Adamantium.Fonts" />
        <AdamantiumEngineReference Include="Adamantium.Mathematics" />
    </ItemGroup>

</Project>
