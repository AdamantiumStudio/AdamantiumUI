<Project>

  <!-- The source generators read .auml/.fx through AdditionalFiles, which MSBuild's CoreCompile and Visual Studio's fast
       up-to-date check do not count as inputs: editing a view left the build "up to date" and the app ran the previously
       generated code. Added inside targets, not as project items, so an IDE does not list every such file again under
       each extra item type. -->
  <Target Name="AdditionalFilesAreCompileInputs" BeforeTargets="CoreCompile">
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="@(AdditionalFiles)" />
    </ItemGroup>
  </Target>

  <Target Name="AdditionalFilesAreUpToDateInputs" BeforeTargets="CollectUpToDateCheckInputDesignTime">
    <ItemGroup>
      <UpToDateCheckInput Include="@(AdditionalFiles)" />
    </ItemGroup>
  </Target>

  <!-- Packages are made against the published engine packages. Packed from the engine's source, the analyzer-only
       references to its projects would turn into package dependencies. -->
  <Target Name="PackAgainstEnginePackages" BeforeTargets="GenerateNuspec" Condition="'$(UseEngineSource)' == 'true' And '$(IsPackable)' == 'true'">
    <Error Text="Pack the UI against the engine packages: dotnet pack -p:UseEngineSource=false" />
  </Target>

</Project>
