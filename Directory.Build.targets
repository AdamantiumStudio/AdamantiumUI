<Project>

  <!-- The source generators read .auml/.fx through AdditionalFiles, which MSBuild's CoreCompile and Visual Studio's fast
       up-to-date check do not count as inputs: editing a view left the build "up to date" and the app ran the previously
       generated code; and a removed file left the code generated from it in. Added inside targets, not as project items,
       so an IDE does not list every such file again under each extra item type. -->
  <Target Name="AdditionalFilesAreCompileInputs" BeforeTargets="_GenerateCompileDependencyCache">
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="@(AdditionalFiles)" />
      <CoreCompileCache Include="@(AdditionalFiles)" />
    </ItemGroup>
  </Target>

  <Target Name="AdditionalFilesAreUpToDateInputs" BeforeTargets="CollectUpToDateCheckInputDesignTime">
    <ItemGroup>
      <UpToDateCheckInput Include="@(AdditionalFiles)" />
    </ItemGroup>
  </Target>

  <!-- The repository's own markup projects reference the generator directly, not through the package's buildTransitive
       targets, so they get the markup hot reload switch here: on in a Debug build. -->
  <PropertyGroup>
    <AdamantiumAumlHotReload Condition="'$(AdamantiumAumlHotReload)' == '' And '$(Configuration)' == 'Debug'">true</AdamantiumAumlHotReload>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="AdamantiumAumlHotReload" />
  </ItemGroup>

  <!-- A project names each engine assembly it needs once, as an AdamantiumEngineReference, and here it becomes a
       reference to the engine's project when the engine's source is beside this repository, or to its package of
       AdamantiumEngineVersion when it is not - one list, so the two can no longer differ. Its Role says what kind of
       reference it is:
         (none)              an assembly the code uses;
         Generator           a source generator - from source an analyzer whose assembly the project does not take;
         EffectsCompiler     the effect compiler - from source an analyzer whose assembly the project takes too;
         NetStandardAnalyzer the netstandard2.0 build a generator from source loads, as an analyzer only; a generator's
                             package carries it, so packages need none.
       PrivateAssets and GeneratePathProperty go with the item; a generator's package keeps its assets private unless the
       item says otherwise. -->
  <ItemGroup Condition="'$(UseEngineSource)' == 'true'">
    <ProjectReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', '')->'$(AdamantiumEngineDir)%(Identity)\%(Identity).csproj')" />
    <ProjectReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', 'Generator')->'$(AdamantiumEngineDir)%(Identity)\%(Identity).csproj')"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', 'EffectsCompiler')->'$(AdamantiumEngineDir)%(Identity)\%(Identity).csproj')"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', 'NetStandardAnalyzer')->'$(AdamantiumEngineDir)%(Identity)\%(Identity).csproj')"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEngineSource)' != 'true'">
    <PackageReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', '')->'%(Identity)')" Version="$(AdamantiumEngineVersion)" />
    <PackageReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', 'Generator')->WithMetadataValue('PrivateAssets', '')->'%(Identity)')"
                      Version="$(AdamantiumEngineVersion)" PrivateAssets="all" />
    <PackageReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', 'Generator')->HasMetadata('PrivateAssets')->'%(Identity)')"
                      Version="$(AdamantiumEngineVersion)" />
    <PackageReference Include="@(AdamantiumEngineReference->WithMetadataValue('Role', 'EffectsCompiler')->'%(Identity)')" Version="$(AdamantiumEngineVersion)" />
  </ItemGroup>

  <!-- An AdamantiumVulkan assembly, named once as an AdamantiumVulkanReference: its project when the source is beside,
       its package of AdamantiumVulkanVersion when it is not (see Directory.Build.props). -->
  <ItemGroup Condition="'$(UseVulkanSource)' == 'true'">
    <ProjectReference Include="@(AdamantiumVulkanReference->'$(AdamantiumVulkanDir)%(Identity)\%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseVulkanSource)' != 'true'">
    <PackageReference Include="@(AdamantiumVulkanReference)" Version="$(AdamantiumVulkanVersion)" />
  </ItemGroup>

  <!-- The repository's applications carry their icon as the package's do; a project that imports the package's targets
       itself has it from them. -->
  <Import Project="$(MSBuildThisFileDirectory)Adamantium.UI\buildTransitive\Adamantium.UI.ApplicationIcon.targets"
          Condition="'$(_AdamantiumApplicationIconImported)' != 'true'" />

  <!-- Packages are made against the published engine packages. Packed from the engine's source, the analyzer-only
       references to its projects would turn into package dependencies. -->
  <Target Name="PackAgainstEnginePackages" BeforeTargets="GenerateNuspec" Condition="'$(UseEngineSource)' == 'true' And '$(IsPackable)' == 'true'">
    <Error Text="Pack the UI against the engine packages: dotnet pack -p:UseEngineSource=false" />
  </Target>

  <!-- The README links its images by relative paths, which GitHub shows in a private repository too. nuget.org shows only
       absolute ones, so the packed copy points them at raw.githubusercontent.com. -->
  <Target Name="PackReadmeWithAbsoluteImageUrls" BeforeTargets="_GetPackageFiles" Condition="'$(PackageReadmeFile)' != ''">
    <PropertyGroup>
      <PackedReadme>$(BaseIntermediateOutputPath)README.md</PackedReadme>
      <ReadmeImageUrl>$(RepositoryUrl.Replace('https://github.com/', 'https://raw.githubusercontent.com/'))/main/.github/images/</ReadmeImageUrl>
      <ReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)README.md').Replace('](.github/images/', ']($(ReadmeImageUrl)'))</ReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape('$(ReadmeText)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
