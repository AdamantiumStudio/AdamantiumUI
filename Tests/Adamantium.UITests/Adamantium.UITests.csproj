<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <IsPackable>false</IsPackable>

        <Platforms>AnyCPU</Platforms>

        <Configurations>Debug;Release</Configurations>

        <LangVersion>latest</LangVersion>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Adamantium.UI\Adamantium.UI.csproj" />
      <!-- The themes themselves, so a style set can be measured as SHIPPED rather than as a hand-copied lookalike. -->
      <ProjectReference Include="..\..\Adamantium.UI.Themes\Adamantium.UI.Themes.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Fonts\*.ttf;Fonts\*.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <!-- Graphics is needed by the [Category("Gpu")] integration tests to spin up a headless render device. -->
    <ItemGroup Condition="'$(UseEngineSource)' == 'true'">
      <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
      <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Graphics\Adamantium.Graphics.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseEngineSource)' != 'true'">
      <PackageReference Include="Adamantium.Mathematics" Version="$(AdamantiumEngineVersion)" />
      <PackageReference Include="Adamantium.Graphics" Version="$(AdamantiumEngineVersion)" />
    </ItemGroup>

</Project>
