<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Adamantium.UI.Remote\Adamantium.UI.Remote.csproj" />
    </ItemGroup>

    <!-- The engine's universe host, built beside the tests and started from there by the [Category("Gpu")] ones. -->
    <ItemGroup>
        <AdamantiumEngineReference Include="Adamantium.Graphics" />
        <AdamantiumEngineReference Include="Adamantium.UniverseHost" />
    </ItemGroup>

</Project>
