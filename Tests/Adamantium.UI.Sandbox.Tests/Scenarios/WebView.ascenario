<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The Web page: an address is gone to on Enter; leaving the page parks it with its browser hidden and coming back shows it again - with no error left behind, CEF staged beside the sandbox or not.">
  <Select Target="id=GalleryTabs/id=Web" />
  <Wait Target="id=WebPage" />
  <Set Target="id=WebAddress" Value="about:blank" />
  <Key Keys="Enter" Into="id=WebAddress" />
  <WaitIdle />
  <Select Target="id=GalleryTabs/id=Text" />
  <WaitIdle />
  <Select Target="id=GalleryTabs/id=Web" />
  <Wait Target="id=WebPage" />
  <WaitIdle />
  <!-- The status bar under the page: the zoom a step up and back to 100%, the DevTools shown and put away. -->
  <Invoke Target="id=WebZoomIn" />
  <Expect Target="id=WebPage" ZoomPercent="110" />
  <Invoke Target="id=WebZoomReset" />
  <Expect Target="id=WebPage" ZoomPercent="100" />
  <Toggle Target="id=WebStatusDevTools" />
  <Wait Target="id=WebDevTools" />
  <Toggle Target="id=WebStatusDevTools" />
  <WaitIdle />
  <!-- The DevTools open beside the page, under it, and close again - with no error left behind. -->
  <Toggle Target="id=WebDevToolsOpen" />
  <Wait Target="id=WebDevTools" />
  <WaitIdle />
  <Select Target="id=WebDevToolsDock/name=Bottom" />
  <WaitIdle />
  <Toggle Target="id=WebDevToolsOpen" />
  <WaitIdle />
  <!-- Back as the page opens. -->
  <Set Target="id=WebAddress" Value="https://example.org" />
  <Key Keys="Enter" Into="id=WebAddress" />
  <WaitIdle />
</Scenario>
