<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Platforms="MacOS" Description="VariantSwitch from the MacOs theme, which the stand opens with on macOS: dark and light take the tabs along in it, in a theme swapped to and after swapping back.">
  <Select Target="id=Buttons" />
  <Invoke Target="id=ToggleSettings" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:0 G:0 B:0 A:140, Opacity: 1" />
  <Expect Target="id=Navigation" Foreground="Color: R:0 G:0 B:0 A:140, Opacity: 1" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:255 G:255 B:255 A:140, Opacity: 1" />
  <Expect Target="id=Navigation" Foreground="Color: R:255 G:255 B:255 A:140, Opacity: 1" />
  <Select Target="id=ThemeChooser/name=Graphite" />
  <Invoke Target="id=SwitchTheme" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:139 G:151 B:163 A:255, Opacity: 1" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:107 G:118 B:131 A:255, Opacity: 1" />
  <Expect Target="id=Navigation" Foreground="Color: R:107 G:118 B:131 A:255, Opacity: 1" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:139 G:151 B:163 A:255, Opacity: 1" />
  <Select Target="id=ThemeChooser/name=macOS" />
  <Invoke Target="id=SwitchTheme" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:255 G:255 B:255 A:140, Opacity: 1" />
</Scenario>
