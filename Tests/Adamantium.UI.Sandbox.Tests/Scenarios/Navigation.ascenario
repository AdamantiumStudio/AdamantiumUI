<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The Navigation page: pages navigated to in the region and back and forward through its journal, cards added to a list region, and an overlay window opened, moved, resized and closed.">
  <Select Target="id=GalleryTabs/id=Navigation" />
  <Wait Target="id=Region/id=HomePageView" />
  <Invoke Target="id=NavigationDemoView/name=Details (id=42)" />
  <Wait Target="id=Region/id=DetailsPageView" />
  <Invoke Target="id=NavigationDemoView/name=Settings" />
  <Wait Target="id=Region/id=SettingsPageView" />
  <Invoke Target="id=NavigationDemoView/name=Back" />
  <Wait Target="id=Region/id=DetailsPageView" />
  <Invoke Target="id=NavigationDemoView/name=Forward" />
  <Wait Target="id=Region/id=SettingsPageView" />
  <Invoke Target="id=NavigationDemoView/name=Home" />
  <Wait Target="id=Region/id=HomePageView" />
  <Invoke Target="id=NavigationDemoView/name=Add card" />
  <!-- The third card, by place: its number goes on from the count, which a previous pass has moved on. -->
  <Wait Target="id=Cards/type=ListItem[2]" />
  <Invoke Target="id=NavigationDemoView/name=Clear" />
  <Absent Target="id=Cards/type=ListItem" />
  <!-- Two cards again, as the page opens with; their numbers go on from where the count stands. -->
  <Invoke Target="id=NavigationDemoView/name=Add card" />
  <Invoke Target="id=NavigationDemoView/name=Add card" />
  <Invoke Target="id=NavigationDemoView/name=Show overlay window" />
  <Wait Target="id=OverlayWindow/id=OverlayDemoView" />
  <Move Target="id=OverlayWindow" By="-20,10" />
  <Resize Target="id=OverlayWindow" Size="480,300" />
  <Window Target="id=OverlayWindow" Action="Close" />
  <Absent Target="id=OverlayWindow" />
  <!-- The click-through window, closed by automation: a click cannot reach it. -->
  <Invoke Target="id=OpenClickThroughWindow" />
  <Wait Target="id=ClickThroughWindow/id=ClickThroughStatus" Name="Clicks stop here" />
  <Invoke Target="id=ClickThroughWindowView/type=Button" />
  <Wait Target="id=ClickThroughStatus" Name="Clicks pass through - 10 s left" />
  <Window Target="id=ClickThroughWindow" Action="Close" />
  <Absent Target="id=ClickThroughWindow" />
  <!-- The splash window again, on its own thread; its close button closes it and nothing else. -->
  <Invoke Target="id=ShowSplash" />
  <Wait Target="id=SandboxSplashWindow/id=Close" />
  <Invoke Target="id=SandboxSplashWindow/id=Close" />
  <Absent Target="id=SandboxSplashWindow" />
  <Wait Target="id=ShowSplash" />
</Scenario>
