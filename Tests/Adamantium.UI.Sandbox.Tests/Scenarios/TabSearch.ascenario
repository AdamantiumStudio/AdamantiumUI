<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The field over the gallery's tabs: the tabs whose title has what is typed drop below it, the strip and the open tab as they were; one picked there, or the first by Enter, opens and the search is over.">
  <Select Target="id=GalleryTabs/id=Buttons" />
  <Wait Target="id=ButtonsView/id=ClickCount" Timeout="20s" />
  <Set Target="id=TabSearch" Value="LIST" />
  <Wait Target="id=FoundTabs/name=Lists" />
  <Absent Target="id=FoundTabs/name=Trees" />
  <Expect Target="id=GalleryTabs/id=Buttons" Selected="True" />
  <Expect Target="id=GalleryTabs/id=Trees" Name="Trees" />
  <Click Target="id=FoundTabs/name=Lists" />
  <Expect Target="id=GalleryTabs/id=Lists" Selected="True" />
  <Absent Target="id=FoundTabs" />
  <Expect Target="id=TabSearch" Value="" />
  <!-- Typed again right after, the one just opened among the found. -->
  <Set Target="id=TabSearch" Value="l" />
  <Expect Target="id=TabSearch" Value="l" />
  <Set Target="id=TabSearch" Value="ti" />
  <Wait Target="id=FoundTabs/type=ListItem,name=Navigation" />
  <Key Keys="Escape" Into="id=TabSearch" />
  <Absent Target="id=FoundTabs" />
  <!-- Closed, Enter opens nothing. -->
  <Key Keys="Enter" Into="id=TabSearch" />
  <Expect Target="id=GalleryTabs/id=Lists" Selected="True" />
  <!-- The first arrow drops the list again, the next goes down it. -->
  <Key Keys="Down" Into="id=TabSearch" />
  <Wait Target="id=FoundTabs/type=ListItem,name=Navigation" />
  <Key Keys="Down" Into="id=TabSearch" />
  <Key Keys="Enter" Into="id=TabSearch" />
  <Expect Target="id=GalleryTabs/id=DateTime" Selected="True" />
  <!-- The one chosen stays in view. -->
  <Set Target="id=TabSearch" Value="a" />
  <Wait Target="id=FoundTabs/type=ListItem,name=Navigation" />
  <Key Keys="Down Down Down Down Down Down Down Down Down Down Down Down Down Down" Into="id=TabSearch" />
  <Expect Target="id=FoundTabs/type=ListItem,name=Animations" Offscreen="False" />
  <!-- Nothing found, nothing drops. -->
  <Set Target="id=TabSearch" Value="zzzz" />
  <Absent Target="id=FoundTabs" />
  <Set Target="id=TabSearch" Value="butt" />
  <Wait Target="id=FoundTabs/name=Buttons" />
  <Key Keys="Enter" Into="id=TabSearch" />
  <Expect Target="id=GalleryTabs/id=Buttons" Selected="True" />
  <Expect Target="id=TabSearch" Value="" />
  <!-- The same one can be found again. -->
  <Set Target="id=TabSearch" Value="list" />
  <Click Target="id=FoundTabs/name=Lists" />
  <Expect Target="id=GalleryTabs/id=Lists" Selected="True" />
</Scenario>
