<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The ribbon shell, opened by the gallery's caption command: its clipboard commands say in the status line what they did, and work on the notes field while it has the keyboard.">
  <Invoke Target="id=OpenRibbon" />
  <!-- The window comes first and its page after it, by navigation: wait for what the next steps read. -->
  <Wait Target="id=RibbonWindow/id=StatusLine" Timeout="30s" />
  <Expect Target="id=StatusLine" Name="Ready." />
  <Invoke Target="id=Cut" />
  <Expect Target="id=StatusLine" Name="Cut the selection." />
  <Click Target="id=Band/name=Copy" />
  <Expect Target="id=StatusLine" Name="Copied the selection." />
  <!-- The clipboard commands are routed: with the keyboard in the notes they are the field's - off while it has nothing
       to give, its text when it has - and the scene hears none of it. A click on the scene gives them back to it. -->
  <Type Text="note" Into="id=Notes" />
  <Expect Target="id=Band/name=Copy" Enabled="False" />
  <Invoke Target="id=SelectAll" />
  <Expect Target="id=Band/name=Copy" Enabled="True" />
  <Click Target="id=Band/name=Copy" />
  <Key Keys="End" Into="id=Notes" />
  <Invoke Target="id=Band/name=Paste" />
  <Expect Target="id=Notes" Value="notenote" />
  <Expect Target="id=StatusLine" Name="Copied the selection." />
  <Click Target="id=RibbonWindow/id=SceneSurface" />
  <Invoke Target="id=Cut" />
  <Expect Target="id=StatusLine" Name="Cut the selection." />
  <!-- Key tips: Alt, then F, opens the File menu; Escape puts it away. -->
  <Key Keys="Alt F" Into="id=RibbonWindow" />
  <Wait Target="id=RibbonWindow/id=PART_BackButton" />
  <Key Keys="Escape" Into="id=RibbonWindow" />
  <Absent Target="id=RibbonWindow/id=PART_BackButton" />
  <!-- Tabs are chosen by name; the open tab's groups follow. -->
  <Expect Target="id=Band/name=Home" Key="H" Selected="True" />
  <Select Target="id=Band/name=Modeling" />
  <Expect Target="id=Band/type=Pane" Name="Modeling" />
  <!-- The Transform tools are one choice: picking one clears the others, and the status line says what it does. -->
  <Expect Target="id=Band/id=SelectGizmo" Selected="True" />
  <Select Target="id=Band/id=MoveGizmo" />
  <Expect Target="id=Band/id=MoveGizmo" Selected="True" />
  <Expect Target="id=Band/id=SelectGizmo" Selected="False" />
  <Expect Target="id=StatusLine" Name="Drag to move the selection." />
  <Select Target="id=Band/id=SelectGizmo" />
  <Expect Target="id=Band/id=MoveGizmo" Selected="False" />
  <!-- The menu key opens a command's own menu with the keyboard on its first row; Escape puts it away. -->
  <Key Keys="Apps" Into="id=Band/name=Snap" />
  <Expect Target="type=MenuItem,name=Snap settings..." Focus="True" />
  <Key Keys="Escape" />
  <Absent Target="type=MenuItem,name=Snap settings..." />
  <Expect Target="id=Band/name=Snap" Focus="True" />
  <Select Target="id=Band/name=Home" />
  <!-- The gallery is a list picked from by name. -->
  <Select Target="id=Band/name=Materials/name=Gold" />
  <Expect Target="id=Band/name=Materials/name=Gold" Selected="True" />
  <!-- File opens a page by its row. -->
  <Expand Target="id=Band/name=File" />
  <Select Target="id=Band/name=File/name=Customize" />
  <Expect Target="id=CommandChoices" Name="Choose commands from" />
  <Collapse Target="id=Band/name=File" />
  <!-- The ribbon folds down to its tabs and opens again. -->
  <Collapse Target="id=Band" />
  <Expect Target="id=Band" Expanded="Collapsed" />
  <Expand Target="id=Band" />
  <Expect Target="id=Band" Expanded="Expanded" />
  <!-- The module catalog still opens after the window was minimized and restored. -->
  <Window Target="id=RibbonWindow" Action="Minimize" />
  <Window Target="id=RibbonWindow" Action="Restore" />
  <Expand Target="id=Band/name=Modules" />
  <Invoke Target="id=Band/name=Modules/name=Module catalog..." />
  <Wait Target="id=CatalogModules" />
  <Expect Target="id=CatalogSearch" Name="Find a module" />
  <!-- The search box is inside the ribbon, and its editing menu is still its own: Cut takes the search away and
       nothing from the scene. -->
  <Type Text="find" Into="id=CatalogSearch" />
  <ContextMenu Target="id=CatalogSearch" />
  <Invoke Target="type=MenuItem,name=Select all" />
  <ContextMenu Target="id=CatalogSearch" />
  <Invoke Target="type=MenuItem,name=Cut" />
  <Expect Target="id=CatalogSearch" Value="" />
  <Invoke Target="id=CloseCatalog" />
  <Absent Target="id=CatalogModules" />
  <!-- Opened again from the gallery while minimized, it comes back as it was. It used to come back on screen still
       reading Minimized: it took no sizes and no input, a picture of itself. -->
  <Window Target="id=RibbonWindow" Action="Minimize" />
  <Invoke Target="id=OpenRibbon" />
  <Expect Target="id=RibbonWindow" Window="Normal" />
  <Click Target="id=Band/name=Duplicate" />
  <Expect Target="id=StatusLine" Name="Duplicated the selection." />
  <!-- Closed again, so the next run starts from a fresh shell. -->
  <Window Target="id=RibbonWindow" Action="Close" />
  <Absent Target="id=RibbonWindow" />
</Scenario>
