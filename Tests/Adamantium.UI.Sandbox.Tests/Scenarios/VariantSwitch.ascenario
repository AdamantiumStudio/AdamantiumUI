<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="Dark and light take the tabs along with the rest, the selected one and one not selected, in the theme the stand opens with and in one swapped to: a variant recolors the palette in place, and a tab still holding a brush from before kept its dark color while everything around it went light.">
  <Select Target="id=Buttons" />
  <Invoke Target="id=ToggleDiagnostics" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:0 G:0 B:0 A:158, Opacity: 1" />
  <Expect Target="id=Navigation" Foreground="Color: R:0 G:0 B:0 A:158, Opacity: 1" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:255 G:255 B:255 A:197, Opacity: 1" />
  <Expect Target="id=Navigation" Foreground="Color: R:255 G:255 B:255 A:197, Opacity: 1" />
  <Select Target="id=ThemeChooser/name=Graphite" />
  <Invoke Target="id=SwitchTheme" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:139 G:151 B:163 A:255, Opacity: 1" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:107 G:118 B:131 A:255, Opacity: 1" />
  <Expect Target="id=Navigation" Foreground="Color: R:107 G:118 B:131 A:255, Opacity: 1" />
  <Invoke Target="id=ToggleVariant" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:139 G:151 B:163 A:255, Opacity: 1" />
  <Select Target="id=ThemeChooser/name=Fluent" />
  <Invoke Target="id=SwitchTheme" />
  <WaitIdle />
  <Expect Target="id=Buttons" Foreground="Color: R:255 G:255 B:255 A:197, Opacity: 1" />
</Scenario>
