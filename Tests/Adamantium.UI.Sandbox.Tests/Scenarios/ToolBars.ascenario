<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The Toolbars page: a command pressed on a bar says so below; a bar dragged by its grip into the first row and another into the lower tray; the upper tray narrowed, so a bar's last commands go to its menu, and one run from there; the lower tray locked from its menu, its grips gone; the bar of sections narrowed - its last section to the menu, then set to wrap onto a new line of the bar - and a table's contextual bar, its source section in its context while it shows.">
  <Select Target="id=GalleryTabs/id=ToolBars" />
  <Wait Target="id=ToolBarsView/id=UpperTray" Timeout="20s" />
  <Invoke Target="id=CutCommand" />
  <Expect Target="id=ToolBarsReport" Name="Pressed: Cut" />
  <!-- The View bar from the second row to the end of the first; the Paragraph bar into the lower tray, after Extra. -->
  <Drag Target="id=ViewBar/id=PART_Grip" From="5,15" To="320,-25" />
  <Wait Target="id=UpperTray/id=ViewBar" />
  <Drag Target="id=ParagraphBar/id=PART_Grip" From="5,15" To="120,105" />
  <Wait Target="id=LowerTray/id=ParagraphBar" />
  <Absent Target="id=UpperTray/id=ParagraphBar" />
  <!-- Narrowed, the Text bar keeps Bold and sends the rest under its chevron; Italic is pressed from there and the menu
       goes away. -->
  <Set Target="id=TrayWidth" Value="330" />
  <Wait Target="id=TextBar/id=PART_OverflowButton" Offscreen="False" />
  <Click Target="id=TextBar/id=PART_OverflowButton" />
  <Click Target="id=ItalicCommand" />
  <Expect Target="id=ToolBarsReport" Name="Pressed: Italic" />
  <Set Target="id=TrayWidth" Value="900" />
  <Wait Target="id=TextBar/id=PART_OverflowButton" Offscreen="True" Timeout="5s" />
  <Expect Target="id=TextBar/id=UnderlineCommand" Offscreen="False" />
  <!-- Locked from the tray's own menu: the grips go, so nothing moves the bars. -->
  <RightClick Target="id=LowerTray" />
  <Click Target="name=Lock the toolbars" />
  <Wait Target="id=LowerTray/id=ExtraBar/id=PART_Grip" Offscreen="True" Timeout="5s" />
  <!-- The tray of sections narrowed: its last sections, Alignment among them, go to the bar's menu whole, and Center is
       pressed there. -->
  <Expect Target="id=FontGroup" Type="Group" Name="Font" />
  <Set Target="id=SectionsWidth" Value="330" />
  <Wait Target="id=FormatBar/id=PART_OverflowButton" Offscreen="False" />
  <Click Target="id=FormatBar/id=PART_OverflowButton" />
  <Click Target="id=SectionCenterCommand" />
  <Expect Target="id=ToolBarsReport" Name="Pressed: Center" />
  <Set Target="id=SectionsWidth" Value="900" />
  <Wait Target="id=FormatBar/id=PART_OverflowButton" Offscreen="True" Timeout="5s" />
  <!-- Set to wrap and narrowed again: no menu - the Alignment section stands on a new line, and Center is pressed there. -->
  <Expand Target="id=SectionsWrapping" />
  <Select Target="id=SectionsWrapping/name=Wrap" />
  <Set Target="id=SectionsWidth" Value="330" />
  <Wait Target="id=SectionCenterCommand" Offscreen="False" Timeout="5s" />
  <Expect Target="id=FormatBar/id=PART_OverflowButton" Offscreen="True" />
  <Click Target="id=SectionCenterCommand" />
  <Expect Target="id=ToolBarsReport" Name="Pressed: Center" />
  <Set Target="id=SectionsWidth" Value="900" />
  <Expand Target="id=SectionsWrapping" />
  <Select Target="id=SectionsWrapping/name=NoWrap" />
  <!-- In a table its bar shows, and the Tables section it comes from is in its context; the tray's menu lists the bar
       apart, under its header, and does not switch it. Out of the table, the bar goes and the section is out of it. -->
  <Expect Target="id=TablesGroup" IsInContext="False" />
  <Toggle Target="id=InTable" />
  <Wait Target="id=TableBar" Offscreen="False" Timeout="5s" />
  <Expect Target="id=TablesGroup" IsInContext="True" />
  <RightClick Target="id=SectionsTray" />
  <Wait Target="name=Contextual - shown where you are" />
  <Expect Target="type=MenuItem,name=Table" Enabled="False" Toggle="On" />
  <Key Keys="Escape" Into="id=MainWindow" />
  <Toggle Target="id=InTable" />
  <Wait Target="id=TableBar" Offscreen="True" Timeout="5s" />
  <Expect Target="id=TablesGroup" IsInContext="False" />
  <!-- Down the side: the narrow number boxes stand on the column; the author field is folded into a button named for
       it, which opens the field itself beside the column, where it is typed into. Turned along, the field stands on the
       bar again, holding what was typed. -->
  <Expect Target="id=PictureWidth" Offscreen="False" Value="5.08" />
  <Expect Target="id=PictureHeight" Offscreen="False" />
  <Expect Target="id=Author" Offscreen="True" />
  <Click Target="id=PictureBar/type=Button,name=Author" />
  <Wait Target="id=Author" Offscreen="False" Timeout="5s" />
  <Set Target="id=Author" Value="Margo" />
  <Click Target="id=PictureBar/type=Button,name=Author" />
  <Wait Target="id=Author" Offscreen="True" Timeout="5s" />
  <Expand Target="id=SideOrientation" />
  <Select Target="id=SideOrientation/name=Horizontal" />
  <Wait Target="id=Author" Offscreen="False" Timeout="5s" />
  <Expect Target="id=Author" Value="Margo" />
  <Absent Target="id=PictureBar/type=Button,name=Author" />
  <Expand Target="id=SideOrientation" />
  <Select Target="id=SideOrientation/name=Vertical" />
</Scenario>
