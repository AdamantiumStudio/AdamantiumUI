<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The Tabs page: a tab of a thousand that the virtualizing strip has not built is found and selected all the same, the capped strip closes its oldest tab to make room once the cap is lowered, and a document dragged away across its strip gets a window of its own.">
  <Select Target="id=GalleryTabs/id=Tabs" />
  <Wait Target="id=TabsView/id=ManyTabs" Timeout="20s" />
  <Select Target="id=ManyTabs/name=Document 500 - a rather long tab title" />
  <Expect Target="id=ManyTabs/name=Document 500 - a rather long tab title" Selected="True" />
  <Select Target="id=ManyTabs/name=Document 1 - a rather long tab title" />
  <Expect Target="id=ManyTabs/name=Document 1 - a rather long tab title" Selected="True" />
  <Set Target="id=MaxOpened" Value="3" />
  <Expect Target="id=MaxOpened" Value="3" />
  <Invoke Target="id=TabsView/name=Open a tab" />
  <Absent Target="id=CappedTabs/name=Report 9" />
  <Absent Target="id=CappedTabs/name=Report 10" />
  <!-- Back as the page opens, as far as it goes: the ceiling and the report being read. What the ceiling closed stays closed. -->
  <Set Target="id=MaxOpened" Value="5" />
  <Select Target="id=CappedTabs/name=Report 2" />
  <!-- A document dragged away across the strip gets a window of its own, named as its tab, and leaves the strip. -->
  <Drag Target="id=ManyTabs/name=Document 1 - a rather long tab title" From="40,15" To="40,400" />
  <Wait Target="name=Document 1 - a rather long tab title,type=Window" />
  <Absent Target="id=ManyTabs/name=Document 1 - a rather long tab title" />
  <Window Target="name=Document 1 - a rather long tab title,type=Window" Action="Close" />
</Scenario>
