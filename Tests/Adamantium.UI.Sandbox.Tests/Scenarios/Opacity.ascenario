<?xml version="1.0" encoding="utf-8"?>
<Scenario xmlns="http://adamantium/automation/scenario" Description="The Opacity page: the container's opacity and one element's own, each a slider.">
  <Select Target="id=GalleryTabs/id=Opacity" />
  <Wait Target="id=ContainerOpacity" />
  <Set Target="id=ContainerOpacity" Value="0.8" />
  <Expect Target="id=ContainerOpacity" Value="0.8" />
  <Set Target="id=ElementOpacity" Value="0.25" />
  <Expect Target="id=ElementOpacity" Value="0.25" />
  <!-- Back as the page opens: the container half through, the element whole. -->
  <Set Target="id=ContainerOpacity" Value="0.5" />
  <Set Target="id=ElementOpacity" Value="1" />
  <!-- The overlapping circles, faded as is and as a layer, by one slider. -->
  <Set Target="id=GroupOpacity" Value="0.3" />
  <Expect Target="id=LayeredGroup" Opacity="0.3" />
  <Expect Target="id=PlainGroup" Opacity="0.3" />
  <Set Target="id=GroupOpacity" Value="0.5" />
  <!-- The list under a melting mask scrolls end to end, and back. -->
  <Scroll Target="id=MaskedList" Vertical="100" />
  <Scroll Target="id=MaskedList" Vertical="0" />
</Scenario>
