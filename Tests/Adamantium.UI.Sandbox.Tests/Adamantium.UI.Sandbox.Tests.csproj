<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <IsPackable>false</IsPackable>

        <Platforms>AnyCPU</Platforms>

        <Configurations>Debug;Release</Configurations>

        <LangVersion>latest</LangVersion>

        <AdamantiumScenarioApplication>Adamantium.UI.Sandbox</AdamantiumScenarioApplication>
        <!-- One font on every system, so what a scenario expects of a layout does not hang on the system's own. -->
        <AdamantiumScenarioFont>Content/SandboxContent/Fonts/RobotoFlex-Variable.ttf</AdamantiumScenarioFont>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <!-- The application under test: the views it ships are built under every theme. Kept out of the library's own test
         projects, which would otherwise reach the engine and the game through it. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Adamantium.UI.Sandbox\Adamantium.UI.Sandbox.csproj" />
        <ProjectReference Include="..\..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="ScenarioGeneratorFromSource" BeforeTargets="CoreCompile">
        <MSBuild Projects="..\..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj"
                 Targets="GetAumlAnalyzerAssemblies"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework;RuntimeIdentifier">
            <Output TaskParameter="TargetOutputs" ItemName="Analyzer" />
        </MSBuild>
    </Target>

    <Import Project="..\..\Adamantium.UI\buildTransitive\Adamantium.UI.targets" />

</Project>
