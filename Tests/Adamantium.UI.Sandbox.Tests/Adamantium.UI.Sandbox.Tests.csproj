<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <IsPackable>false</IsPackable>

        <Platforms>AnyCPU</Platforms>

        <Configurations>Debug;Release</Configurations>

        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <!-- The application under test: the views it ships are built under every theme. Kept out of the library's own test
         projects, which would otherwise reach the engine and the game through it. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Adamantium.UI.Sandbox\Adamantium.UI.Sandbox.csproj" />
    </ItemGroup>

    <!-- The inert application the markup tests run under, shared as source rather than copied. -->
    <ItemGroup>
        <Compile Include="..\Adamantium.XamlTests\Fakes\*.cs" Link="Fakes\%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
