<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AssemblyName>adam-auto</AssemblyName>
        <RootNamespace>Adamantium.UI.Automation.Cli</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>adam-auto</ToolCommandName>
        <PackageId>Adamantium.UI.Automation.Cli</PackageId>
        <Description>adam-auto: drives an Adamantium UI application from the command line through its automation agent - starts it, finds elements by id, name or type, acts on them, checks what they show and runs scenario files. dotnet tool install -g Adamantium.UI.Automation.Cli</Description>
        <PackageTags>adamantium;ui;automation;testing;cli;dotnet-tool</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.UI.Automation\Adamantium.UI.Automation.csproj" />
    </ItemGroup>

</Project>
