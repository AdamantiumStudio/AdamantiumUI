<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <Configurations>Release;Debug</Configurations>
        <Platforms>AnyCPU</Platforms>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>
        <Description>AUML, the markup of Adamantium UI: the parser, the document model and the type resolution shared by its code generator and its runtime loader.</Description>
        <PackageTags>adamantium;ui;auml;markup;xaml</PackageTags>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseEngineSource)' == 'true'">
      <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Core\Adamantium.Core.csproj" />
      <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Fonts\Adamantium.Fonts.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseEngineSource)' != 'true'">
      <PackageReference Include="Adamantium.Core" Version="$(AdamantiumEngineVersion)" />
      <PackageReference Include="Adamantium.Fonts" Version="$(AdamantiumEngineVersion)" />
    </ItemGroup>

</Project>
