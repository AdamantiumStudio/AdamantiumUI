<idea-plugin>
    <id>com.adamantium.auml</id>
    <name>Adamantium AUML</name>
    <vendor email="adamantiumdev@gmail.com" url="https://github.com/AdamantiumStudio">Adamantium Studio</vendor>

    <description><![CDATA[
        <p>Editing support for AUML, the markup of Adamantium UI (<code>.auml</code> files), with a live preview drawn
        by the framework itself.</p>
        <ul>
            <li><b>Live preview</b> beside or below the markup, rendered from the application's own build in its own
            theme. It follows edits as you type and plays animations; a click on an element selects it and moves the
            caret to its line, and Go to Source opens the file a nested view was declared in.</li>
            <li><b>Completion, diagnostics and go to definition</b> from the AUML language server, which knows the
            types of the project and its packages.</li>
            <li>Syntax highlighting, folding, and <b>New | AUML File</b> for windows, views, themes, style sets and
            resource dictionaries.</li>
            <li>The <b>project templates</b> for File | New Solution: offered at startup when missing, and installed or
            updated any time with <b>Tools | Install Adamantium UI Templates</b>.</li>
        </ul>
        <p><b>Requirements:</b> the .NET 10 SDK and a project that references the <code>Adamantium.UI</code> NuGet
        package. The preview runs the designer that package carries on the project's own build, so build the project
        once before previewing. LSP4IJ is installed with this plugin.</p>
    ]]></description>

    <change-notes><![CDATA[
        <p>Completion for the x: directives: x:Null, x:Static and x:Type after an opening brace; inside {x:Static} a
        type and then its static fields and properties; the values of x:Load, x:Shared, x:CreateInDesignTime and
        x:KeepAlive.</p>
    ]]></change-notes>

    <!-- Declaration order matters: platform + xml, then lsp4ij, then the extensions below. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <!-- Register .auml as its own file type backed by the XML language => XML highlighting & structure. -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="AUML"
                  implementationClass="com.adamantium.auml.AumlFileType"
                  fieldName="INSTANCE"
                  language="XML"
                  extensions="auml"/>
        <!-- Mark the static AUML xmlns URIs as known so XML support doesn't flag "URI is not registered". -->
        <standardResourceProvider implementation="com.adamantium.auml.AumlResourceProvider"/>
        <!-- Dynamic clr-namespace: xmlns URIs can't be pre-registered. Two complementary nets:
             the registrar resolves them upstream (mark ignored on open); the filter is an instant fallback. -->
        <daemon.highlightInfoFilter implementation="com.adamantium.auml.AumlNamespaceHighlightFilter"/>

        <!-- WPF-style split editor for .auml: XML text on the left, live engine-rendered preview on the right. -->
        <fileEditorProvider implementation="com.adamantium.auml.AumlPreviewFileEditorProvider"/>

        <!-- Bundled "New AUML File" templates (resources/fileTemplates/internal/*.auml.ft). Each name maps to one
             root entity type; the New/Add action below offers them as kinds. Also editable in
             Settings | Editor | File and Code Templates. -->
        <internalFileTemplate name="Adamantium Window"/>
        <internalFileTemplate name="Adamantium View"/>
        <internalFileTemplate name="Adamantium Theme"/>
        <internalFileTemplate name="Adamantium StyleSet"/>
        <internalFileTemplate name="Adamantium ResourceDictionary"/>
        <notificationGroup id="Adamantium AUML" displayType="BALLOON"/>
        <notificationGroup id="Adamantium AUML templates offer" displayType="STICKY_BALLOON"/>
    </extensions>
    <!-- At startup, offer to install the project templates when dotnet new has none. -->
    <applicationListeners>
        <listener class="com.adamantium.auml.AumlTemplatesOffer"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <!-- "AUML File" entry in the project view's New/Add context menu (kind picker -> bundled template). -->
    <actions>
        <action id="Adamantium.CreateAumlFile"
                class="com.adamantium.auml.CreateAumlFileAction"
                text="AUML File"
                description="Creates a new Adamantium UI markup file">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
        <action id="Adamantium.InstallTemplates"
                class="com.adamantium.auml.InstallAumlTemplatesAction"
                text="Install Adamantium UI Templates"
                description="Installs or updates the Adamantium UI project templates for File | New Solution">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <!-- Mark each .auml file's clr-namespace: URIs as ignored XML resources when it opens. -->
    <projectListeners>
        <listener class="com.adamantium.auml.AumlClrNamespaceRegistrar"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <!-- Register the AUML language server and bind it to *.auml files. -->
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="adamantium-auml"
                name="Adamantium AUML"
                factoryClass="com.adamantium.auml.AumlLanguageServerFactory">
            <description><![CDATA[Adamantium UI markup language server]]></description>
        </server>
        <fileNamePatternMapping patterns="*.auml" serverId="adamantium-auml"/>
        <!-- Paint the server's 'unknown' token (unresolved element) red; the rest get sensible colors.
             serverId MUST match the <server id> above — the provider is bound per server definition. -->
        <semanticTokensColorsProvider serverId="adamantium-auml"
                                      class="com.adamantium.auml.AumlSemanticTokensColorsProvider"/>
    </extensions>
</idea-plugin>
