<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <Description>View-model navigation for Adamantium UI: navigation by key with parameters, regions and their journal, dialogs and overlays with results - with no view known to the view model.</Description>
        <PackageTags>adamantium;ui;navigation;mvvm;dialogs;regions</PackageTags>
    </PropertyGroup>

    <!-- UI-free: the whole navigation engine + contracts a ViewModel sees. Only PropertyChangedBase + the DI resolver. -->
    <ItemGroup Condition="'$(UseEngineSource)' == 'true'">
        <ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Core\Adamantium.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseEngineSource)' != 'true'">
        <PackageReference Include="Adamantium.Core" Version="$(AdamantiumEngineVersion)" />
    </ItemGroup>

</Project>
