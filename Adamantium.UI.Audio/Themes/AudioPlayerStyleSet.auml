<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:local="clr-namespace:Adamantium.UI.Audio">

    <!-- The player in four looks, by its View. Each look is a template of the player's parts, and each part one of its
         template properties - DisplayTemplate, PositionTemplate, TransportTemplate, TrackTemplate - set here per look,
         so an application replaces one part and keeps the rest. The parts read the player by {Ancestor}; the accent is
         the theme's, the digits in its code font. -->

    <!-- Full: the display (title, format, time, spectrum), the position, the buttons and the volume, the list. -->
    <Style Selector="AudioPlayer">
        <Setter Property="Background" Value="{ResourceReference CardBackgroundFillColorDefault}"/>
        <Setter Property="Foreground" Value="{ObservableResource TextFillColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="{ResourceReference StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{ResourceReference CornerRadiusSurface}"/>
        <Setter Property="AutomationProperties.Name" Value="{Localize AudioPlayerStrings.Player}"/>

        <Setter Property="DisplayTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- The title, the format's marks, the time large - pressed, what is left - and under it the length
                         and what is left; the spectrum beside them, as high as they are. -->
                    <Border Background="{ObservableResource SolidBackgroundFillColorBase}"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}" BorderThickness="1"
                            CornerRadius="7" Padding="14 9">
                        <Grid ColumnDefinitions="*,190" ColumnSpacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="Title" Text="{Ancestor local:AudioPlayer, TrackTitle}"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharEllipses"
                                           AutomationProperties.AutomationId="AudioTitle"/>
                                <TextBlock x:Name="Nothing" Text="{Localize AudioPlayerStrings.NothingOpen}"
                                           FontSize="14" Visibility="Collapsed"
                                           Foreground="{ObservableResource TextFillColorTertiary}"/>
                                <local:AudioFormatBadges Info="{Ancestor local:AudioPlayer, Info}"
                                                         AutomationProperties.AutomationId="AudioFormat"/>
                                <ToggleButton IsChecked="{Ancestor local:AudioPlayer, ShowsRemaining, Mode=TwoWay}"
                                              HorizontalAlignment="Left" MarginTop="1"
                                              ToolTipService.ToolTip="{Localize AudioPlayerStrings.TimeLeft}"
                                              AutomationProperties.AutomationId="AudioTime"
                                              AutomationProperties.Name="{Localize AudioPlayerStrings.TimeLeft}">
                                    <!-- The digits are the button: a display's, not a button's look. -->
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <ContentPresenter Content="{TemplateBinding Content}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <Grid>
                                        <TextBlock x:Name="Played" FontSize="34" LineHeight="32"
                                                   FontFamily="{ThemeResource CodeFontFamily}"
                                                   Foreground="{ThemeResource AccentFillColorDefault}"
                                                   Text="{Ancestor local:AudioPlayer, Position, Converter={TimeSpanToClockTextConverter}}"/>
                                        <TextBlock x:Name="Left" FontSize="34" LineHeight="32" Visibility="Collapsed"
                                                   FontFamily="{ThemeResource CodeFontFamily}"
                                                   Foreground="{ThemeResource AccentFillColorDefault}"
                                                   Text="{Ancestor local:AudioPlayer, Remaining, Converter={TimeSpanToClockTextConverter}, ConverterParameter=Remaining}"/>
                                    </Grid>
                                </ToggleButton>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}"
                                               Text="{Localize AudioPlayerStrings.Of}"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}"
                                               Text="{Ancestor local:AudioPlayer, Duration, Converter={TimeSpanToClockTextConverter}}"
                                               AutomationProperties.AutomationId="AudioDuration"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}" Text="·"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}"
                                               Text="{Localize AudioPlayerStrings.Left}"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}"
                                               Text="{Ancestor local:AudioPlayer, Remaining, Converter={TimeSpanToClockTextConverter}, ConverterParameter=Remaining}"/>
                                </StackPanel>
                            </StackPanel>
                            <local:Spectrum Grid.Column="1" Bands="24" VerticalAlignment="Stretch" MinHeight="60"
                                            Playback="{Ancestor local:AudioPlayer, Playback}"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, ShowsRemaining}" Value="true">
                            <Setter TargetName="Played" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Left" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, CurrentTrack}" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Nothing" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- The position: the track's waveform, which is pressed and dragged as a slider is, where the player shows it;
             a slider where it does not. Never one over the other. -->
        <Setter Property="PositionTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <local:Waveform Height="{Ancestor local:AudioPlayer, WaveformHeight}" Minimum="0"
                                        Peaks="{Ancestor local:AudioPlayer, Peaks}"
                                        Maximum="{Ancestor local:AudioPlayer, Duration, Converter={TimeSpanToSecondsConverter}}"
                                        Value="{Ancestor local:AudioPlayer, Position, Mode=TwoWay, Converter={TimeSpanToSecondsConverter}}"
                                        Visibility="{Ancestor local:AudioPlayer, ShowsWaveform, Converter={BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="AudioWaveform"
                                        AutomationProperties.Name="{Localize AudioPlayerStrings.Position}"/>
                        <Slider VerticalAlignment="Center" Minimum="0" MinWidth="0"
                                Maximum="{Ancestor local:AudioPlayer, Duration, Converter={TimeSpanToSecondsConverter}}"
                                Value="{Ancestor local:AudioPlayer, Position, Mode=TwoWay, Converter={TimeSpanToSecondsConverter}}"
                                Visibility="{Ancestor local:AudioPlayer, ShowsWaveform, Converter={InverseBooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AudioPosition"
                                AutomationProperties.Name="{Localize AudioPlayerStrings.Position}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- Previous, play, stop, next; repeat and shuffle a little apart; the volume at the end. -->
        <Setter Property="TransportTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Command="{Ancestor local:AudioPlayer, PreviousCommand}" Width="34" Height="30" Padding="0"
                                    ToolTipService.ToolTip="{Localize AudioPlayerStrings.Previous}"
                                    AutomationProperties.AutomationId="AudioPrevious"
                                    AutomationProperties.Name="{Localize AudioPlayerStrings.Previous}">
                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{Ancestor Button, Foreground}"
                                      Data="M3,3 L5,3 L5,13 L3,13 Z M13,3 L13,13 L6,8 Z"/>
                            </Button>
                            <Button x:Name="PlayButton" Classes="Accent" Command="{Ancestor local:AudioPlayer, PlayPauseCommand}"
                                    Width="44" Height="36" Padding="0"
                                    AutomationProperties.AutomationId="AudioPlayPause"
                                    AutomationProperties.Name="{Localize AudioPlayerStrings.Play}">
                                <Grid>
                                    <Path x:Name="PlayGlyph" Width="14" Height="14" Stretch="Uniform"
                                          Fill="{Ancestor Button, Foreground}" Data="M4,2.5 L13,8 L4,13.5 Z"/>
                                    <Path x:Name="PauseGlyph" Width="14" Height="14" Stretch="Uniform" Visibility="Collapsed"
                                          Fill="{Ancestor Button, Foreground}"
                                          Data="M4,2.5 L7,2.5 L7,13.5 L4,13.5 Z M9,2.5 L12,2.5 L12,13.5 L9,13.5 Z"/>
                                </Grid>
                            </Button>
                            <Button Command="{Ancestor local:AudioPlayer, StopCommand}" Width="34" Height="30" Padding="0"
                                    ToolTipService.ToolTip="{Localize AudioPlayerStrings.Stop}"
                                    AutomationProperties.AutomationId="AudioStop"
                                    AutomationProperties.Name="{Localize AudioPlayerStrings.Stop}">
                                <Path Width="10" Height="10" Stretch="Uniform" Fill="{Ancestor Button, Foreground}"
                                      Data="M3,3 L13,3 L13,13 L3,13 Z"/>
                            </Button>
                            <Button Command="{Ancestor local:AudioPlayer, NextCommand}" Width="34" Height="30" Padding="0"
                                    ToolTipService.ToolTip="{Localize AudioPlayerStrings.Next}"
                                    AutomationProperties.AutomationId="AudioNext"
                                    AutomationProperties.Name="{Localize AudioPlayerStrings.Next}">
                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{Ancestor Button, Foreground}"
                                      Data="M11,3 L13,3 L13,13 L11,13 Z M3,3 L3,13 L10,8 Z"/>
                            </Button>
                            <Button x:Name="RepeatButton" Command="{Ancestor local:AudioPlayer, RepeatCommand}"
                                    Width="34" Height="30" Padding="0" MarginLeft="8"
                                    ToolTipService.ToolTip="{Localize AudioPlayerStrings.RepeatOff}"
                                    AutomationProperties.AutomationId="AudioRepeat"
                                    AutomationProperties.Name="{Localize AudioPlayerStrings.Repeat}">
                                <Grid>
                                    <Path x:Name="RepeatGlyph" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                                          Stroke="{Ancestor Button, Foreground}"
                                          Data="M3,9 L3,5 L14,5 M12,3 L14,5 L12,7 M15,9 L15,13 L4,13 M6,11 L4,13 L6,15"/>
                                    <TextBlock x:Name="RepeatOne" Text="1" FontSize="8" FontWeight="Bold" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentFillColorDefault}"/>
                                </Grid>
                            </Button>
                            <ToggleButton IsChecked="{Ancestor local:AudioPlayer, IsShuffled, Mode=TwoWay}"
                                          Width="34" Height="30" Padding="0"
                                          ToolTipService.ToolTip="{Localize AudioPlayerStrings.Shuffle}"
                                          AutomationProperties.AutomationId="AudioShuffle"
                                          AutomationProperties.Name="{Localize AudioPlayerStrings.Shuffle}">
                                <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                                      Stroke="{Ancestor ToggleButton, Foreground}"
                                      Data="M2,5 L5,5 L12,13 L16,13 M2,13 L5,13 L7,10.7 M11,6.3 L12,5 L16,5 M14,3 L16,5 L14,7 M14,11 L16,13 L14,15"/>
                            </ToggleButton>
                        </StackPanel>
                        <Path Grid.Column="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{ObservableResource TextFillColorSecondary}" Data="M3,7 L6,7 L10,4 L10,14 L6,11 L3,11 Z"/>
                        <Slider Grid.Column="3" Width="110" MinWidth="0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                Value="{Ancestor local:AudioPlayer, Volume, Mode=TwoWay}"
                                AutomationProperties.AutomationId="AudioVolume"
                                AutomationProperties.Name="{Localize AudioPlayerStrings.Volume}"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, IsPlaying}" Value="true">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PauseGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PlayButton" Property="AutomationProperties.Name" Value="{Localize AudioPlayerStrings.Pause}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, Repeat}" Value="List">
                            <Setter TargetName="RepeatGlyph" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
                            <Setter TargetName="RepeatButton" Property="ToolTipService.ToolTip" Value="{Localize AudioPlayerStrings.RepeatList}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, Repeat}" Value="Track">
                            <Setter TargetName="RepeatGlyph" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
                            <Setter TargetName="RepeatOne" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="RepeatButton" Property="ToolTipService.ToolTip" Value="{Localize AudioPlayerStrings.RepeatTrack}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- A row of the list: the track's row, which the player tells what it read; its look is AudioTrackRow's. -->
        <Setter Property="TrackTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:AudioTrackRow Track="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AudioPlayer">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                            <InfoBar Severity="Error" Margin="12 12 12 0" Title="{Localize AudioPlayerStrings.CannotPlay}"
                                     Message="{Ancestor local:AudioPlayer, FailedTrackTitle}"
                                     IsOpen="{TemplateBinding HasFailed, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="AudioFailed"/>
                            <ContentPresenter Grid.Row="1" Margin="12 12 12 0" ContentTemplate="{TemplateBinding DisplayTemplate}"/>
                            <ContentPresenter Grid.Row="2" Margin="12 8 12 2" ContentTemplate="{TemplateBinding PositionTemplate}"/>
                            <ContentPresenter Grid.Row="3" Margin="12 4 12 12" ContentTemplate="{TemplateBinding TransportTemplate}"/>
                            <!-- The list under a line: how many, how long all; then the rows. -->
                            <Border Grid.Row="4" BorderBrush="{ObservableResource ControlStrokeColorDefault}"
                                    BorderThickness="0 1 0 0" Padding="12 8 12 4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}"
                                               Text="{Localize AudioPlayerStrings.Tracks}"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}" Text="·"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}"
                                               Text="{Ancestor local:AudioPlayer, TrackCount}"
                                               AutomationProperties.AutomationId="AudioTrackCount"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}" Text="·"/>
                                    <TextBlock FontSize="11" Foreground="{ObservableResource TextFillColorTertiary}"
                                               Text="{Ancestor local:AudioPlayer, TotalDuration, Converter={TimeSpanToClockTextConverter}}"
                                               AutomationProperties.AutomationId="AudioTotal"/>
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="5" MinHeight="56" BorderThickness="0" Background="Transparent"
                                     ItemsSource="{TemplateBinding Tracks}"
                                     SelectedItem="{TemplateBinding CurrentTrack, Mode=TwoWay}"
                                     ItemTemplate="{TemplateBinding TrackTemplate}"
                                     AutomationProperties.AutomationId="AudioTracks"
                                     AutomationProperties.Name="{Localize AudioPlayerStrings.Tracks}">
                                <!-- Rows as dense as a player's list. -->
                                <ListBox.ItemContainerStyle>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="12 5"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bar: one row - play and stop, a small display (time, codec and channels, a few bars of spectrum), the position,
         the length, repeat, the volume. -->
    <Style Selector="AudioPlayer[View=Bar]">
        <Setter Property="Padding" Value="10 6"/>
        <Setter Property="WaveformHeight" Value="26"/>
        <Setter Property="DisplayTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Background="{ObservableResource SolidBackgroundFillColorBase}"
                            BorderBrush="{ObservableResource ControlStrokeColorDefault}" BorderThickness="1"
                            CornerRadius="6" Padding="10 0" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ToggleButton IsChecked="{Ancestor local:AudioPlayer, ShowsRemaining, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="{Localize AudioPlayerStrings.TimeLeft}"
                                          AutomationProperties.AutomationId="AudioTime"
                                          AutomationProperties.Name="{Localize AudioPlayerStrings.TimeLeft}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter Content="{TemplateBinding Content}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <TextBlock x:Name="Played" FontSize="20" FontFamily="{ThemeResource CodeFontFamily}"
                                               Foreground="{ThemeResource AccentFillColorDefault}"
                                               Text="{Ancestor local:AudioPlayer, Position, Converter={TimeSpanToClockTextConverter}}"/>
                                    <TextBlock x:Name="Left" FontSize="20" Visibility="Collapsed"
                                               FontFamily="{ThemeResource CodeFontFamily}"
                                               Foreground="{ThemeResource AccentFillColorDefault}"
                                               Text="{Ancestor local:AudioPlayer, Remaining, Converter={TimeSpanToClockTextConverter}, ConverterParameter=Remaining}"/>
                                </Grid>
                            </ToggleButton>
                            <local:AudioFormatBadges VerticalAlignment="Center" Orientation="Vertical" FontSize="9"
                                                     Marks="Codec, Channels" Info="{Ancestor local:AudioPlayer, Info}"
                                                     AutomationProperties.AutomationId="AudioFormat"/>
                            <local:Spectrum Width="52" Height="26" Bands="13" BarSpacing="1" VerticalAlignment="Center"
                                            Playback="{Ancestor local:AudioPlayer, Playback}"/>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, ShowsRemaining}" Value="true">
                            <Setter TargetName="Played" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Left" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TransportTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Classes="Accent" Command="{Ancestor local:AudioPlayer, PlayPauseCommand}"
                                Width="36" Height="32" Padding="0"
                                AutomationProperties.AutomationId="AudioPlayPause"
                                AutomationProperties.Name="{Localize AudioPlayerStrings.Play}">
                            <Grid>
                                <Path x:Name="PlayGlyph" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Ancestor Button, Foreground}" Data="M4,2.5 L13,8 L4,13.5 Z"/>
                                <Path x:Name="PauseGlyph" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"
                                      Fill="{Ancestor Button, Foreground}"
                                      Data="M4,2.5 L7,2.5 L7,13.5 L4,13.5 Z M9,2.5 L12,2.5 L12,13.5 L9,13.5 Z"/>
                            </Grid>
                        </Button>
                        <Button Command="{Ancestor local:AudioPlayer, StopCommand}" Width="30" Height="28" Padding="0"
                                ToolTipService.ToolTip="{Localize AudioPlayerStrings.Stop}"
                                AutomationProperties.AutomationId="AudioStop"
                                AutomationProperties.Name="{Localize AudioPlayerStrings.Stop}">
                            <Path Width="9" Height="9" Stretch="Uniform" Fill="{Ancestor Button, Foreground}"
                                  Data="M3,3 L13,3 L13,13 L3,13 Z"/>
                        </Button>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, IsPlaying}" Value="true">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PauseGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PlayButton" Property="AutomationProperties.Name" Value="{Localize AudioPlayerStrings.Pause}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AudioPlayer">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid RowDefinitions="Auto,Auto">
                            <InfoBar Severity="Error" MarginBottom="6" Title="{Localize AudioPlayerStrings.CannotPlay}"
                                     Message="{Ancestor local:AudioPlayer, FailedTrackTitle}"
                                     IsOpen="{TemplateBinding HasFailed, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="AudioFailed"/>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <ContentPresenter ContentTemplate="{TemplateBinding TransportTemplate}"/>
                                <ContentPresenter Grid.Column="1" ContentTemplate="{TemplateBinding DisplayTemplate}"/>
                                <!-- The position keeps a length of its own however tight the row: it is what the row is for. -->
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" MinWidth="80"
                                                  ContentTemplate="{TemplateBinding PositionTemplate}"/>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{ObservableResource TextFillColorSecondary}"
                                           Text="{Ancestor local:AudioPlayer, Duration, Converter={TimeSpanToClockTextConverter}}"
                                           AutomationProperties.AutomationId="AudioDuration"/>
                                <Button x:Name="RepeatButton" Grid.Column="4" Command="{TemplateBinding RepeatCommand}"
                                        Width="30" Height="28" Padding="0" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{Localize AudioPlayerStrings.RepeatOff}"
                                        AutomationProperties.AutomationId="AudioRepeat"
                                        AutomationProperties.Name="{Localize AudioPlayerStrings.Repeat}">
                                    <Grid>
                                        <Path x:Name="RepeatGlyph" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                                              Stroke="{Ancestor Button, Foreground}"
                                              Data="M3,9 L3,5 L14,5 M12,3 L14,5 L12,7 M15,9 L15,13 L4,13 M6,11 L4,13 L6,15"/>
                                        <TextBlock x:Name="RepeatOne" Text="1" FontSize="8" FontWeight="Bold" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentFillColorDefault}"/>
                                    </Grid>
                                </Button>
                                <Path Grid.Column="5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{ObservableResource TextFillColorSecondary}" Data="M3,7 L6,7 L10,4 L10,14 L6,11 L3,11 Z"/>
                                <Slider Grid.Column="6" Width="72" MinWidth="0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                        Value="{Ancestor local:AudioPlayer, Volume, Mode=TwoWay}"
                                        AutomationProperties.AutomationId="AudioVolume"
                                        AutomationProperties.Name="{Localize AudioPlayerStrings.Volume}"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="Repeat" Value="List">
                            <Setter TargetName="RepeatGlyph" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
                            <Setter TargetName="RepeatButton" Property="ToolTipService.ToolTip" Value="{Localize AudioPlayerStrings.RepeatList}"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="Repeat" Value="Track">
                            <Setter TargetName="RepeatGlyph" Property="Stroke" Value="{ThemeResource AccentFillColorDefault}"/>
                            <Setter TargetName="RepeatOne" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="RepeatButton" Property="ToolTipService.ToolTip" Value="{Localize AudioPlayerStrings.RepeatTrack}"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Line: play; the title, the codec, the time and the length; a thin position under them - for lists of sounds,
         cards of assets. -->
    <Style Selector="AudioPlayer[View=Line]">
        <Setter Property="Padding" Value="10 8"/>
        <Setter Property="WaveformHeight" Value="26"/>
        <Setter Property="DisplayTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharEllipses"
                                   Text="{Ancestor local:AudioPlayer, TrackTitle}"
                                   AutomationProperties.AutomationId="AudioTitle"/>
                        <local:AudioFormatBadges Grid.Column="1" VerticalAlignment="Center" FontSize="9" Marks="Codec"
                                                 Info="{Ancestor local:AudioPlayer, Info}"
                                                 AutomationProperties.AutomationId="AudioFormat"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontFamily="{ThemeResource CodeFontFamily}"
                                       Foreground="{ThemeResource AccentFillColorDefault}"
                                       Text="{Ancestor local:AudioPlayer, Position, Converter={TimeSpanToClockTextConverter}}"
                                       AutomationProperties.AutomationId="AudioTime"/>
                            <!-- In the same font and size as the time, so the digits stand on one line. -->
                            <TextBlock FontSize="12" FontFamily="{ThemeResource CodeFontFamily}"
                                       Foreground="{ObservableResource TextFillColorTertiary}" Text="/"/>
                            <TextBlock FontSize="12" FontFamily="{ThemeResource CodeFontFamily}"
                                       Foreground="{ObservableResource TextFillColorTertiary}"
                                       Text="{Ancestor local:AudioPlayer, Duration, Converter={TimeSpanToClockTextConverter}}"
                                       AutomationProperties.AutomationId="AudioDuration"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TransportTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Button x:Name="PlayButton" Classes="Accent" Command="{Ancestor local:AudioPlayer, PlayPauseCommand}"
                            Width="30" Height="28" Padding="0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AudioPlayPause"
                            AutomationProperties.Name="{Localize AudioPlayerStrings.Play}">
                        <Grid>
                            <Path x:Name="PlayGlyph" Width="11" Height="11" Stretch="Uniform"
                                  Fill="{Ancestor Button, Foreground}" Data="M4,2.5 L13,8 L4,13.5 Z"/>
                            <Path x:Name="PauseGlyph" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"
                                  Fill="{Ancestor Button, Foreground}"
                                  Data="M4,2.5 L7,2.5 L7,13.5 L4,13.5 Z M9,2.5 L12,2.5 L12,13.5 L9,13.5 Z"/>
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, IsPlaying}" Value="true">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PauseGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PlayButton" Property="AutomationProperties.Name" Value="{Localize AudioPlayerStrings.Pause}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AudioPlayer">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid RowDefinitions="Auto,Auto">
                            <InfoBar Severity="Error" MarginBottom="6" Title="{Localize AudioPlayerStrings.CannotPlay}"
                                     Message="{Ancestor local:AudioPlayer, FailedTrackTitle}"
                                     IsOpen="{TemplateBinding HasFailed, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="AudioFailed"/>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <ContentPresenter VerticalAlignment="Center" ContentTemplate="{TemplateBinding TransportTemplate}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <ContentPresenter ContentTemplate="{TemplateBinding DisplayTemplate}"/>
                                    <ContentPresenter ContentTemplate="{TemplateBinding PositionTemplate}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mini: play, the time, a short position - for tight places. -->
    <Style Selector="AudioPlayer[View=Mini]">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="WaveformHeight" Value="26"/>
        <Setter Property="DisplayTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontFamily="{ThemeResource CodeFontFamily}"
                               Foreground="{ThemeResource AccentFillColorDefault}"
                               Text="{Ancestor local:AudioPlayer, Position, Converter={TimeSpanToClockTextConverter}}"
                               AutomationProperties.AutomationId="AudioTime"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TransportTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Button x:Name="PlayButton" Classes="Accent" Command="{Ancestor local:AudioPlayer, PlayPauseCommand}"
                            Width="30" Height="28" Padding="0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AudioPlayPause"
                            AutomationProperties.Name="{Localize AudioPlayerStrings.Play}">
                        <Grid>
                            <Path x:Name="PlayGlyph" Width="11" Height="11" Stretch="Uniform"
                                  Fill="{Ancestor Button, Foreground}" Data="M4,2.5 L13,8 L4,13.5 Z"/>
                            <Path x:Name="PauseGlyph" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"
                                  Fill="{Ancestor Button, Foreground}"
                                  Data="M4,2.5 L7,2.5 L7,13.5 L4,13.5 Z M9,2.5 L12,2.5 L12,13.5 L9,13.5 Z"/>
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Ancestor local:AudioPlayer, IsPlaying}" Value="true">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PauseGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PlayButton" Property="AutomationProperties.Name" Value="{Localize AudioPlayerStrings.Pause}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AudioPlayer">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <InfoBar Severity="Error" Title="{Localize AudioPlayerStrings.CannotPlay}"
                                     Message="{Ancestor local:AudioPlayer, FailedTrackTitle}"
                                     IsOpen="{TemplateBinding HasFailed, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="AudioFailed"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ContentPresenter ContentTemplate="{TemplateBinding TransportTemplate}"/>
                                <ContentPresenter VerticalAlignment="Center" ContentTemplate="{TemplateBinding DisplayTemplate}"/>
                                <ContentPresenter Width="90" VerticalAlignment="Center"
                                                  ContentTemplate="{TemplateBinding PositionTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
