<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:local="clr-namespace:Adamantium.UI.Audio">

    <!-- Small marks in a row or a column, lit as a display's: the codec, the sample rate, the bitrate, the channels -
         those asked for; a mark of nothing known takes no room. -->
    <Style Selector="AudioFormatBadges">
        <Setter Property="Background" Value="{ObservableResource SystemFillColorSuccessBackground}"/>
        <Setter Property="Foreground" Value="{ObservableResource SystemFillColorSuccess}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AudioFormatBadges">
                    <StackPanel Orientation="{TemplateBinding Orientation}" Spacing="3">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4 1"
                                Visibility="{Ancestor local:AudioFormatBadges, ShowsCodec, Converter={BooleanToVisibilityConverter}}">
                            <TextBlock Text="{TemplateBinding Codec}" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4 1"
                                Visibility="{Ancestor local:AudioFormatBadges, ShowsKilohertz, Converter={BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="{TemplateBinding Kilohertz}" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                                <TextBlock Text="{Localize AudioPlayerStrings.Kilohertz}" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4 1"
                                Visibility="{Ancestor local:AudioFormatBadges, ShowsKilobits, Converter={BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="{TemplateBinding Kilobits}" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                                <TextBlock Text="{Localize AudioPlayerStrings.Kilobits}" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4 1"
                                Visibility="{Ancestor local:AudioFormatBadges, ShowsMono, Converter={BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Localize AudioPlayerStrings.Mono}" TextTransform="Uppercase" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4 1"
                                Visibility="{Ancestor local:AudioFormatBadges, ShowsStereo, Converter={BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Localize AudioPlayerStrings.Stereo}" TextTransform="Uppercase" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="4 1"
                                Visibility="{Ancestor local:AudioFormatBadges, ShowsSurround, Converter={BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Localize AudioPlayerStrings.Surround}" TextTransform="Uppercase" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
