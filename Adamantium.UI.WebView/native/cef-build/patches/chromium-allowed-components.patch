 #include "components/component_updater/component_updater_switches.h"
 
+#include <algorithm>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+
 namespace switches {
 
+// Comma-separated ids of the only components that are registered, wherever
+// they are registered from; present and empty, no component is. An embedder
+// that must not fetch anything it was not asked for passes it. Only valid for
+// the browser process.
+constexpr char kAllowedComponents[] = "allowed-components";
+
 // Comma-separated options to troubleshoot the component updater. Only valid
 // for the browser process.
 constexpr char kComponentUpdater[] = "component-updater";
@@ -29,3 +41,25 @@ constexpr char kDemoModeTestTag[] = "demo-app-test-tag";
 constexpr char kEnableComponentUninstall[] = "enable-component-uninstall";
 
 }  // namespace switches
+
+namespace component_updater {
+
+bool IsComponentListed(std::string_view id) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  return command_line->HasSwitch(switches::kAllowedComponents) &&
+         std::ranges::contains(
+             base::SplitString(command_line->GetSwitchValueASCII(
+                                   switches::kAllowedComponents),
+                               ",", base::TRIM_WHITESPACE,
+                               base::SPLIT_WANT_NONEMPTY),
+             id);
+}
+
+bool IsComponentAllowed(std::string_view id) {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch(
+             switches::kAllowedComponents) ||
+         IsComponentListed(id);
+}
+
+}  // namespace component_updater
