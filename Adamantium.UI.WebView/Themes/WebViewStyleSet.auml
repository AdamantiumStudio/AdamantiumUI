<?xml version="1.0" encoding="utf-8"?>
<StyleSet xmlns="http://adamantium/ui"
          xmlns:x="http://adamantium/ui/xaml/extensions"
          xmlns:local="clr-namespace:Adamantium.UI.WebView">

    <!-- The page is drawn into the panel, laid out at the frame's size in pixels - up to a pixel past the page's part,
         which clips it. Beside the page, when they are open, its DevTools: a view of their own, to the right or under
         it, with a splitter between that the mouse drags. -->
    <!-- What a drag the page starts carries under the pointer: its text on a small plate, not a picture of the view. -->
    <Style Selector="WebView">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="DragDrop.DragTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Border HorizontalAlignment="Left" MaxWidth="360" CornerRadius="6" Padding="10 6"
                                Background="{ThemeResource AccentFillColorDefault}">
                            <TextBlock Text="{Binding}" TextTrimming="CharEllipses" MaxLines="2"
                                       Foreground="{ThemeResource AccentForegroundColor}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:WebView">
                    <Grid RowDefinitions="*,Auto">
                        <local:WebViewDevToolsLayout IsDevToolsOpen="{TemplateBinding IsDevToolsOpen}"
                                                     Dock="{TemplateBinding DevToolsDock}">
                            <Border x:Name="PART_PageHost" ClipToBounds="True">
                                <!-- The page, and over it the list it drops - a select's - where the page places it, the
                                     search bar at its top right while the page is searched, and the dialog its script
                                     asks, over the page only. -->
                                <Grid>
                                    <Canvas>
                                        <RenderTargetPanel x:Name="PART_Surface" AcceptsTab="False"/>
                                        <RenderTargetPanel x:Name="PART_PopupSurface" AcceptsTab="False"
                                                           Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Canvas>
                                    <local:WebViewFindBar x:Name="PART_FindBar" Visibility="Collapsed"
                                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0 8 12 0"/>
                                    <local:WebViewScriptDialog x:Name="PART_ScriptDialog"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_DevToolsSplitter" Classes="WebViewSplitter"
                                   AutomationProperties.AutomationId="WebDevToolsSplitter"/>
                            <local:WebViewDevToolsView x:Name="PART_DevTools"
                                                       Engine="{TemplateBinding Engine}"
                                                       AllowSharedTexture="{TemplateBinding AllowSharedTexture}"
                                                       AutomationProperties.AutomationId="WebDevTools"/>
                        </local:WebViewDevToolsLayout>
                        <local:WebViewStatusBar x:Name="PART_StatusBar" Grid.Row="1"/>
                        <!-- The page's menu, its rows the page's at each ask. -->
                        <ContextMenu x:Name="PART_PageMenu" AutomationProperties.AutomationId="WebPageMenu"/>
                        <!-- The page's tooltip, beside the pointer: the theme's card, taking neither hover nor press. -->
                        <Popup x:Name="PART_PageTipPopup" Placement="Relative" KeepOpen="True" DismissOnEscape="False">
                            <ToolTip x:Name="PART_PageTip" IsHitTestVisible="False"
                                     AutomationProperties.AutomationId="WebPageTip"/>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <PropertyTrigger Property="ShowStatusBar" Value="false">
                            <Setter TargetName="PART_StatusBar" Property="Visibility" Value="Collapsed"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="IsFindOpen" Value="true">
                            <Setter TargetName="PART_FindBar" Property="Visibility" Value="Visible"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="DevToolsDock" Value="Right">
                            <Setter TargetName="PART_DevToolsSplitter" Property="Cursor" Value="SizeWE"/>
                        </PropertyTrigger>
                        <PropertyTrigger Property="DevToolsDock" Value="Bottom">
                            <Setter TargetName="PART_DevToolsSplitter" Property="Cursor" Value="SizeNS"/>
                        </PropertyTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The DevTools beside a page: only their own surface, no DevTools of their own. -->
    <Style Selector="WebViewDevToolsView">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:WebViewDevToolsView">
                    <Border x:Name="PART_PageHost" ClipToBounds="True">
                        <Grid>
                            <Canvas>
                                <RenderTargetPanel x:Name="PART_Surface" AcceptsTab="False"/>
                                <RenderTargetPanel x:Name="PART_PopupSurface" AcceptsTab="False"
                                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Canvas>
                            <local:WebViewScriptDialog x:Name="PART_ScriptDialog"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The splitter between the page and its DevTools: a bar in the theme's line color, as thick as the layout makes
         it. -->
    <Style Selector="Thumb.WebViewSplitter">
        <Setter Property="Background" Value="{ResourceReference ControlStrokeColorDefault}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</StyleSet>
