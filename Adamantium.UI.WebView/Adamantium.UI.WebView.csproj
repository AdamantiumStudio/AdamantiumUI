<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <!-- CEF itself, downloaded and staged by native/fetch-cef: not part of the project. An application takes it with
             build/Adamantium.UI.WebView.CefRuntime.targets. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);runtimes\**;native\download\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.WebView.Tests" />
        <InternalsVisibleTo Include="Adamantium.UI.WebView.Helper" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="QuantumBinding.Utils" Version="3.0.2" />
    </ItemGroup>

</Project>
