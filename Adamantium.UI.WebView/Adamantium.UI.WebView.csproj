<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>
        <Description>Web pages in Adamantium UI scenes, drawn by Chromium Embedded Framework off screen. CEF comes with Adamantium.UI.WebView.Runtime.&lt;rid&gt;, a package for each platform the application runs on.</Description>
        <PackageTags>adamantium;ui;webview;browser;cef;chromium</PackageTags>
        <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <!-- CEF itself, staged by native/fetch-cef: not part of the project. Applications take it from the runtime
             packages; inside this repository, from build/Adamantium.UI.WebView.CefRuntime.targets. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);runtimes\**;native\download\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.UI.WebView.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="QuantumBinding.Utils" Version="3.0.2" />
    </ItemGroup>

    <!-- The view's style set (Themes/*.auml) is compiled by the markup generator, as in the UI's other libraries. -->
    <ItemGroup>
        <ProjectReference Include="..\Adamantium.UI\Adamantium.UI.csproj" />
        <ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
        <ProjectReference Include="..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Adamantium.UI.Core\Adamantium.UI.Core.csproj" OutputItemType="Analyzer" />
    </ItemGroup>

    <ItemGroup>
        <AdamantiumEngineReference Include="Adamantium.Core" />
        <AdamantiumEngineReference Include="Adamantium.Core.Shared" GeneratePathProperty="true" />
        <AdamantiumEngineReference Include="Adamantium.Core.Shared" Role="NetStandardAnalyzer" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseEngineSource)' != 'true'">
        <Analyzer Include="$(PkgAdamantium_Core_Shared)\lib\netstandard2.0\Adamantium.Core.Shared.dll" Condition="'$(PkgAdamantium_Core_Shared)' != ''" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(ProjectDir)Themes\**\*.auml" />
        <AdditionalFiles Include="$(ProjectDir)Localization\**\*.alang" />
        <CompilerVisibleProperty Include="RootNamespace" />
        <CompilerVisibleProperty Include="NeutralLanguage" />
        <CompilerVisibleProperty Include="OutputType" />
    </ItemGroup>

</Project>
