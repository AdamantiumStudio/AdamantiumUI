<Project Sdk="Microsoft.NET.Sdk">

    <!-- CEF and the WebView helper for one platform: the package Adamantium.UI.WebView.Runtime.<rid> an application
         references for each platform it runs on. Packed once per platform with -p:CefRid=<rid> after native/fetch-cef
         has staged that platform's CEF, with -p:HelperFolder=<folder> the helper published ahead of time for it. CEF
         goes to the package's cef folder, not runtimes/<rid>/native, which NuGet would copy into the application a
         second time; the package's build file copies it into the application's cef folder. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Adamantium.UI.WebView.Runtime.$(CefRid)</PackageId>
        <IsPackable Condition="'$(CefRid)' != ''">true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
        <Description>Chromium Embedded Framework and the Adamantium UI WebView helper for $(CefRid): copied into the application's cef folder when it builds for that platform.</Description>
        <PackageTags>adamantium;ui;webview;cef;chromium</PackageTags>
    </PropertyGroup>

    <ItemGroup Condition="'$(CefRid)' != ''">
        <None Include="..\Adamantium.UI.WebView\runtimes\$(CefRid)\native\cef\**" Pack="true" PackagePath="cef\%(RecursiveDir)" Visible="false" />
        <None Include="$(HelperFolder)\Adamantium.UI.WebView.Helper*" Exclude="$(HelperFolder)\*.pdb;$(HelperFolder)\*.dbg" Pack="true" PackagePath="cef\" Visible="false" Condition="'$(HelperFolder)' != ''" />
        <None Include="Adamantium.UI.WebView.Runtime.targets" Pack="true" PackagePath="buildTransitive\$(PackageId).targets" />
    </ItemGroup>

    <Target Name="RequireStagedCef" BeforeTargets="GenerateNuspec" Condition="'$(CefRid)' != ''">
        <Error Condition="!Exists('..\Adamantium.UI.WebView\runtimes\$(CefRid)\native\cef\LICENSE.txt')" Text="CEF for $(CefRid) is not staged: run native/fetch-cef for it first." />
        <Error Condition="'$(HelperFolder)' == '' or (!Exists('$(HelperFolder)\Adamantium.UI.WebView.Helper') and !Exists('$(HelperFolder)\Adamantium.UI.WebView.Helper.exe'))" Text="No helper published for $(CefRid) in '$(HelperFolder)': publish Adamantium.UI.WebView.Helper for it and pass -p:HelperFolder." />
    </Target>

</Project>
