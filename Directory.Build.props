<Project>

  <PropertyGroup>
    <!-- Single top-level artifacts/ root next to the solution.
         bin is grouped BY TARGET FRAMEWORK: artifacts\bin\<Configuration>\<TargetFramework>\
         - all projects of the same TFM land together (so net8.0 and net10.0 assemblies never mix in
           one folder, which avoids System.Runtime version conflicts);
         - each TFM folder is self-contained, so the executable + its deps are in one predictable place.
         The TFM segment is appended by the SDK (AppendTargetFrameworkToOutputPath) - do NOT bake
         $(TargetFramework) into OutputPath here, it is still empty when Directory.Build.props runs.
         obj is per-project under artifacts\obj\<Project>\; NuGet packages go to artifacts\packages\. -->
    <OutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages\</PackageOutputPath>
  </PropertyGroup>

  <!-- One identity for every assembly and package, the same as in the engine, QuantumBinding and AdamantiumVulkan. -->
  <PropertyGroup>
    <Authors>Adamantium Studio</Authors>
    <Company>Adamantium Studio</Company>
    <Copyright>Copyright © 2019-2026 Adamantium Studio</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AdamantiumStudio/AdamantiumUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamantiumStudio/AdamantiumUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- One version for every package of the UI, as in the engine: they are built together and move together. The only
       place it is set: a release changes it here, in the change it ships with, and the publish workflow packs what it
       says. An empty suffix is a stable release. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
  </PropertyGroup>

  <!-- Off by default, on per project: tests, the sandbox and the editor tools are not products, and a published version
       can be unlisted but never deleted. Content goes to contentFiles only, as in AdamantiumVulkan. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <ContentTargetFolders>contentFiles</ContentTargetFolders>
  </PropertyGroup>

  <!-- The README and each package's icon.png travel only when they exist: naming a file that is not packed breaks the
       pack (NU5039, NU5046). The README is packed by Directory.Build.targets. The icons are generated with the studio's
       brand assets and copied here by their deploy script. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <None Include="$(MSBuildProjectDirectory)\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The engine repository checked out beside this one: its projects are referenced from source.
       They are not in our solutions, so a solution build would hand them no configuration and they would land in
       artifacts\bin\<tfm> of the engine instead of its Debug or Release folder. -->
  <PropertyGroup>
    <AdamantiumEngineDir>$(MSBuildThisFileDirectory)..\AdamantiumEngine\</AdamantiumEngineDir>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!-- With the engine checked out beside this repository the projects reference its source, so an engine change is seen
       at once; without it - a clone of this repository alone, a release - they take the published engine packages of
       this version. -p:UseEngineSource=false builds against the packages even with the engine beside. -->
  <PropertyGroup>
    <UseEngineSource Condition="'$(UseEngineSource)' == ''">$([System.IO.Directory]::Exists('$(AdamantiumEngineDir)'))</UseEngineSource>
    <AdamantiumEngineVersion>0.1.0-alpha.4</AdamantiumEngineVersion>
  </PropertyGroup>

</Project>
