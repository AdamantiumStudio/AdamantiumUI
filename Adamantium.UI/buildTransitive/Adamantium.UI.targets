<Project>

  <!-- What a project needs for its .auml files to become classes: the files handed to the generator, and the two build
       properties it reads. A project that lists its .auml files itself keeps its list: those are not added twice.
       AdamantiumAumlAutoInclude=false turns the automatic list off. -->
  <ItemGroup Condition="'$(AdamantiumAumlAutoInclude)' != 'false'">
    <AdditionalFiles Include="**\*.auml"
                     Exclude="@(AdditionalFiles);bin\**;obj\**;$(BaseIntermediateOutputPath)**;$(BaseOutputPath)**" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <!-- AdditionalFiles are not inputs of the compile or of Visual Studio's up-to-date check, so an edited view would
       leave the build "up to date" running the code generated before. Added inside targets, so an IDE does not list
       every .auml again under each extra item type. -->
  <Target Name="AdamantiumAumlAreCompileInputs" BeforeTargets="CoreCompile">
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="@(AdditionalFiles)" Condition="'%(Extension)' == '.auml'" />
    </ItemGroup>
  </Target>

  <Target Name="AdamantiumAumlAreUpToDateInputs" BeforeTargets="CollectUpToDateCheckInputDesignTime">
    <ItemGroup>
      <UpToDateCheckInput Include="@(AdditionalFiles)" Condition="'%(Extension)' == '.auml'" />
    </ItemGroup>
  </Target>

  <!-- What the designer runs on, written by every build into obj, where the IDE finds it from the project folder: the
       designer host this package carries, and the output the build has just made. The host runs on the project's own
       dependency list, so it previews with the very engine and UI the application runs on. A library has no runtime
       configuration and keeps its packages in the package folder, so that is named too. -->
  <Target Name="WriteAdamantiumDesignerManifest" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_AdamantiumDesignerHost>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\designer\Adamantium.UI.Designer.Host.dll'))</_AdamantiumDesignerHost>
      <_AdamantiumDesignerDeps Condition="'$(ProjectDepsFilePath)' != ''">$([System.IO.Path]::GetFullPath('$(ProjectDepsFilePath)'))</_AdamantiumDesignerDeps>
      <_AdamantiumDesignerRuntimeConfig Condition="'$(ProjectRuntimeConfigFilePath)' != ''">$([System.IO.Path]::GetFullPath('$(ProjectRuntimeConfigFilePath)'))</_AdamantiumDesignerRuntimeConfig>
      <_AdamantiumDesignerPackages Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)'))</_AdamantiumDesignerPackages>
      <_AdamantiumDesignerManifest>{
  "host": "$(_AdamantiumDesignerHost.Replace('\', '\\'))",
  "assembly": "$([System.IO.Path]::GetFullPath('$(TargetPath)').Replace('\', '\\'))",
  "depsFile": "$(_AdamantiumDesignerDeps.Replace('\', '\\'))",
  "runtimeConfig": "$(_AdamantiumDesignerRuntimeConfig.Replace('\', '\\'))",
  "packageFolder": "$(_AdamantiumDesignerPackages.Replace('\', '\\'))"
}</_AdamantiumDesignerManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectExtensionsPath)adamantium.designer.json"
                      Lines="$([MSBuild]::Escape($(_AdamantiumDesignerManifest)))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
