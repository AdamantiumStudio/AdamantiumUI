<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<AssemblyName>Adamantium.UI</AssemblyName>
		<RootNamespace>Adamantium.UI</RootNamespace>
		<PackageId>Adamantium.UI</PackageId>
		<Product>Adamantium.UI</Product>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<IsPackable>true</IsPackable>
		<Description>Adamantium UI: a .NET UI framework on the Adamantium engine's own Vulkan renderer, where a 3D scene and the interface around it are drawn by one renderer in one process. The package to reference: it brings the controls, the themes, AUML markup with its code generator, and MVVM with its generator.</Description>
		<PackageTags>adamantium;ui;vulkan;3d;xaml;auml;mvvm</PackageTags>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.UI.Controls\Adamantium.UI.Controls.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Core\Adamantium.UI.Core.csproj" />
		<!-- The UI's SHADERS, in their own project (the same shape Adamantium.FX has): the .fx/.fxh files and the effect
		     classes the generator makes from them. Split out so they can be referenced on their own, and so a shader
		     edit rebuilds this one project rather than the whole of Adamantium.UI. -->
		<ProjectReference Include="..\Adamantium.UI.FX\Adamantium.UI.FX.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Markup\Adamantium.UI.Markup.csproj" />
		<ProjectReference Include="..\Adamantium.UI.Themes\Adamantium.UI.Themes.csproj" />
		<PackageReference Include="Adamantium.Vulkan.Loader" Version="1.0.2" />
		<PackageReference Include="Adamantium.Vulkan" Version="1.0.3" />
	</ItemGroup>

	<!-- For the applications this package goes into, not for this project: the AUML generator rides in this package -
	     its assemblies in analyzers, its wiring in buildTransitive - and MVVM comes as dependencies, PrivateAssets none so
	     its generator reaches the application too. The generator project is referenced only to be built first. -->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAumlGenerator;PackDesignerHost</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj" ReferenceOutputAssembly="false" />
		<None Include="buildTransitive\Adamantium.UI.targets" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>

	<Target Name="PackAumlGenerator">
		<MSBuild Projects="..\Adamantium.UI.Generators\Adamantium.UI.Generators.csproj" Targets="GetAumlAnalyzerAssemblies" Properties="Configuration=$(Configuration);NoBuild=$(NoBuild)" RemoveProperties="TargetFramework;RuntimeIdentifier">
			<Output TaskParameter="TargetOutputs" ItemName="_AumlAnalyzer" />
		</MSBuild>
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_AumlAnalyzer)" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

	<!-- The designer host, alone: it runs on the dependency list of the project it previews, so the engine and the UI it
	     needs are the application's own and travel no second time. Not a reference - the host references this project -
	     so it is built here, or only asked where its output is under NoBuild. -->
	<Target Name="PackDesignerHost">
		<PropertyGroup>
			<_DesignerHostTarget Condition="'$(NoBuild)' == 'true'">GetTargetPath</_DesignerHostTarget>
			<_DesignerHostTarget Condition="'$(NoBuild)' != 'true'">Build</_DesignerHostTarget>
		</PropertyGroup>
		<MSBuild Projects="..\Adamantium.UI.Designer.Host\Adamantium.UI.Designer.Host.csproj" Targets="$(_DesignerHostTarget)" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier">
			<Output TaskParameter="TargetOutputs" ItemName="_DesignerHost" />
		</MSBuild>
		<Error Condition="!Exists('@(_DesignerHost)')" Text="The designer host is not built: @(_DesignerHost)" />
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_DesignerHost)" PackagePath="tools/designer" />
		</ItemGroup>
	</Target>

	<ItemGroup Condition="'$(UseEngineSource)' == 'true'">
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.MVVM\Adamantium.MVVM.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.MVVM.Generators\Adamantium.MVVM.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="none" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseEngineSource)' != 'true'">
		<PackageReference Include="Adamantium.MVVM" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.MVVM.Generators" Version="$(AdamantiumEngineVersion)" PrivateAssets="none" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseEngineSource)' == 'true'">
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.ECS\Adamantium.ECS.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Multiverse\Adamantium.Multiverse.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.ProceduralGeometry\Adamantium.ProceduralGeometry.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.MacOS\Adamantium.MacOS.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Win32\Adamantium.Win32.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.XInput\Adamantium.XInput.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.GameInput\Adamantium.GameInput.csproj" />
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Core\Adamantium.Core.csproj"/>
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Graphics.Core\Adamantium.Graphics.Core.csproj"/>
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Mathematics\Adamantium.Mathematics.csproj"/>
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.EffectsCompiler\Adamantium.EffectsCompiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Engine.Generators\Adamantium.Engine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<!-- netstandard2.0 analyzer deps for the source generators above (Roslyn analyzers must be netstandard2.0).
		     Analyzer-ONLY so the netstandard2.0 build isn't copied into this net10.0 output - runtime/compile
		     Core+Mathematics come from the normal net10.0 refs above. -->
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Core\Adamantium.Core.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0"/>
		<ProjectReference Include="$(AdamantiumEngineDir)Adamantium.Mathematics\Adamantium.Mathematics.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0"/>
	</ItemGroup>

	<!-- The generator package carries the assemblies it loads, Core and Mathematics among them. -->
	<ItemGroup Condition="'$(UseEngineSource)' != 'true'">
		<PackageReference Include="Adamantium.ECS" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Multiverse" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.ProceduralGeometry" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.MacOS" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Win32" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.XInput" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.GameInput" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Core" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Graphics.Core" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Mathematics" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.EffectsCompiler" Version="$(AdamantiumEngineVersion)" />
		<PackageReference Include="Adamantium.Engine.Generators" Version="$(AdamantiumEngineVersion)" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Drag feedback cursors (arrow + green plus, arrow + link arrow): Windows has no IDC_* for either - the shapes
		     Explorer draws sit in ole32.dll's resources - so ship .cur files and load them via LoadCursorFromFile.
		     Copied next to the app so WindowsCursors resolves them at AppContext.BaseDirectory - from this package too,
		     which is the one an application references, so NuGet copies them into its output the same way. -->
		<Content Include="Resources\dragcopy.cur" PackageCopyToOutput="true">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\draglink.cur" PackageCopyToOutput="true">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Lets the render-cache test harness construct the internal DrawingContext directly. -->
		<InternalsVisibleTo Include="Adamantium.UITests" />
	</ItemGroup>

	<ItemGroup>
		<!-- No .fx/.fxh here any more - they live in Adamantium.UI.FX, which generates the effect classes this project
		     draws through. The generator options stay because other generators in this project read them. -->
		<CompilerVisibleProperty Include="RootNamespace" />
		<AdditionalFiles Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="obj\**" />
	</ItemGroup>
</Project>
