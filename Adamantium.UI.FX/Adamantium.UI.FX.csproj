<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <Nullable>disable</Nullable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <Description>Shaders of Adamantium UI - shapes, text, brushes, effects - compiled into the assembly at build time.</Description>
        <PackageTags>adamantium;ui;shader;effects</PackageTags>
    </PropertyGroup>

    <!-- The Slang runtime rides in this package, so the shader compiler does not need the Vulkan SDK installed. Named
         here only to learn where NuGet put it; the generator is handed the path. -->
    <ItemGroup>
        <PackageReference Include="Adamantium.Vulkan.Slang" Version="1.1.0" GeneratePathProperty="true" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <AdamantiumSlangPath>$(PKGAdamantium_Vulkan_Slang)</AdamantiumSlangPath>
        <!-- Debug builds carry each effect's source path, so a running app can recompile it when it changes. -->
        <AdamantiumShaderHotReload Condition="'$(AdamantiumShaderHotReload)' == '' And '$(Configuration)' == 'Debug'">true</AdamantiumShaderHotReload>
    </PropertyGroup>

    <ItemGroup>
        <AdamantiumEngineReference Include="Adamantium.Core" />
        <AdamantiumEngineReference Include="Adamantium.Graphics.Core" />
        <AdamantiumEngineReference Include="Adamantium.Mathematics" />
        <AdamantiumEngineReference Include="Adamantium.EffectsCompiler" Role="EffectsCompiler" />
        <AdamantiumEngineReference Include="Adamantium.Engine.Generators" Role="Generator" />
        <!-- What the source generators above load: Core.Shared, analyzer-only - the assembly itself comes through Core.
             The generator package carries the assemblies it loads, Core.Shared among them. -->
        <AdamantiumEngineReference Include="Adamantium.Core.Shared" Role="NetStandardAnalyzer" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(ProjectDir)**\*.fx" />
        <AdditionalFiles Include="$(ProjectDir)**\*.fxh" />
        <CompilerVisibleProperty Include="RootNamespace" />
        <!-- The generator places each effect's class by the folder its .fx sits in, and needs the project root. -->
        <CompilerVisibleProperty Include="ProjectDir" />
        <!-- Where the Slang runtime is, so shaders build without the Vulkan SDK installed. -->
        <CompilerVisibleProperty Include="AdamantiumSlangPath" />
        <CompilerVisibleProperty Include="AdamantiumShaderHotReload" />
        <AdditionalFiles Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="obj\**" />
    </ItemGroup>

</Project>
